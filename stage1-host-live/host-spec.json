  "capabilities": [
    {
      "id": "HCAP-01",
      "name": "NFS lane filesystem access",
      "purpose": "Operate the mounted NFS lane through ordinary syscalls",
      "usable_stage": [
        "stage1"
      ],
      "usable_by": [
        "agent_stage1"
      ],
      "interface": {
        "syz_calls": [
          "close",
          "flock",
          "fsync",
          "getdents64",
          "lseek",
          "openat",
          "read",
          "renameat2",
          "statx",
          "syz_open_nfs_lane_profile$client0_knfsd_v3",
          "syz_open_nfs_lane_profile$client0_knfsd_v41",
          "syz_open_nfs_lane_profile$client1_knfsd_v3",
          "syz_open_nfs_lane_profile$client1_knfsd_v41",
          "unlinkat",
          "write"
        ]
      },
      "constraints": [
        "lane client is 0 or 1",
        "profile open only for profiles the fixture exposes (single: knfsd-<version>)",
        "filesystem syscalls take a lane fd as their first argument",
        "open the lane with both const arguments, exactly: r0 = syz_open_nfs_lane_profile$client0_knfsd_v41(0x2, 0x0) or r0 = syz_open_nfs_lane_profile$client1_knfsd_v41(0x2, 0x1); on the NFSv3 nlm-knfsd selection r0 = syz_open_nfs_lane_profile$client0_knfsd_v3(0x0, 0x0) or r0 = syz_open_nfs_lane_profile$client1_knfsd_v3(0x0, 0x1)"
      ],
      "status": "validated_subset",
      "scope": [
        "lane_syscalls",
        "profile_open"
      ],
      "validated_scope": [
        "lane_syscalls"
      ],
      "source_refs": [
        "bundle/patches/syzkaller/0020-*",
        "bundle/lane/lane.sh"
      ]
    },
    {
      "id": "HCAP-03",
      "name": "remote KCOV lane attribution",
      "purpose": "Attribute knfsd fs/nfsd and net/sunrpc coverage to the executor proc and lane",
      "usable_stage": [
        "stage1",
        "stage2"
      ],
      "usable_by": [
        "agent_stage1",
        "agent_stage2"
      ],
      "interface": {
        "runtime_features": [
          "remote_cover"
        ]
      },
      "constraints": [
        "Q1 uses generation-attributed remote coverage only",
        "attributed contexts: request, async_copy, callback_v41, lockd"
      ],
      "status": "validated",
      "scope": [
        "generation"
      ],
      "source_refs": [
        "bundle/patches/kernel/0001-*",
        "bundle/patches/kernel/0002-*",
        "bundle/patches/kernel/0006-*"
      ]
    },
    {
      "id": "HCAP-04",
      "name": "lane execution topology",
      "purpose": "Runtime selections this host executes; one proc on lane 0",
      "usable_stage": [
        "stage1"
      ],
      "usable_by": [
        "agent_stage1"
      ],
      "interface": {},
      "constraints": [
        "nfs.localio_enabled=N",
        "single fixture, koov.nfs_version from the selection",
        "nlm-knfsd fixture (koov.nfs_fixture=nlm-knfsd) for the NFSv3 HCAP-13 selection"
      ],
      "status": "partially_validated",
      "scope": [
        "one_lane"
      ],
      "source_refs": [
        "bundle/lane/boot-fixture.sh"
      ]
    },
    {
      "id": "HCAP-14",
      "name": "live NFSv4.1 BIND transport reset",
      "purpose": "Open a fresh NFSv4.1 client and session on the direct client0 lane, then pipeline BIND_CONN_TO_SESSION on the same transport and reset it",
      "usable_stage": [
        "stage1"
      ],
      "usable_by": [
        "agent_stage1"
      ],
      "interface": {
        "syz_calls": [
          "syz_nfs_bind_live$client0_knfsd_v41",
          "syz_open_nfs_lane_profile$client0_knfsd_v41"
        ]
      },
      "constraints": [
        "one non-threaded Stage 1 program on client0; the live-bind pseudo-call takes the exact client0 knfsd-v41 profile directory fd as its lane token",
        "the executor opens a fresh NFSv4.1 client and session on that lane, sends 1..64 BIND_CONN_TO_SESSION operations on the same transport, and resets it after the first reply",
        "dir must be 3 for the FORE_OR_BOTH cn_flags read-modify-write path; rounds is 1..8 fresh client/session attempts",
        "AUTH_SYS only, direct knfsd endpoint; the profile acquisition is parser-proven and the call cannot be used without it",
        "this capability establishes live-session BIND and transport-reset reachability, not a race outcome or KASAN"
      ],
      "status": "experimental",
      "scope": [
        "live_bind_transport_reset"
      ],
      "validated_scope": [],
      "source_refs": [
        "bundle/patches/syzkaller/0031-*",
        "env/syzkaller/sys/linux/fs_nfs_fuzz.txt",
        "stage1-host-live/live-bind.syz",
        "stage1-host-live/live-bind-race.syz",
        "stage1-host-live/live-bind-race64p.syz",
        "stage1-host-live/live-bind-race64p2.syz"
      ]
    }
  ],

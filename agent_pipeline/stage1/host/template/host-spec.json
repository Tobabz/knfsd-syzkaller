        "bundle/patches/syzkaller/0030-*",
        "bundle/lane/lane.sh",
        "tools/nfs-lifecycle/run.py",
        "bundle/patches/kernel/0006-*"
      ],
      "validated_layout": {
        "procs": 1,
        "lanes": [
          0
        ]
      }

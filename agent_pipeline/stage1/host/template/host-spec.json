  "capabilities": [
    {
      "id": "HCAP-01",
      "name": "NFS lane filesystem access",
      "purpose": "Operate the mounted NFS lane through ordinary syscalls",
      "usable_stage": [
        "stage1"
      ],
      "usable_by": [
        "agent_stage1"
      ],
      "interface": {
        "syz_calls": [
          "close",
          "flock",
          "fsync",
          "getdents64",
          "lseek",
          "openat",
          "read",
          "renameat2",
          "statx",
          "syz_open_nfs_lane_profile$client0_knfsd_v3",
          "syz_open_nfs_lane_profile$client0_knfsd_v41",
          "syz_open_nfs_lane_profile$client1_knfsd_v3",
          "syz_open_nfs_lane_profile$client1_knfsd_v41",
          "unlinkat",
          "write"
        ]
      },
      "constraints": [
        "lane client is 0 or 1",
        "profile open only for profiles the fixture exposes (single: knfsd-<version>)",
        "filesystem syscalls take a lane fd as their first argument",
        "open the lane with both const arguments, exactly: r0 = syz_open_nfs_lane_profile$client0_knfsd_v41(0x2, 0x0) or r0 = syz_open_nfs_lane_profile$client1_knfsd_v41(0x2, 0x1); on the NFSv3 nlm-knfsd selection r0 = syz_open_nfs_lane_profile$client0_knfsd_v3(0x0, 0x0) or r0 = syz_open_nfs_lane_profile$client1_knfsd_v3(0x0, 0x1)"
      ],
      "status": "validated_subset",
      "scope": [
        "lane_syscalls",
        "profile_open"
      ],
      "validated_scope": [
        "lane_syscalls"
      ],
      "source_refs": [
        "bundle/patches/syzkaller/0020-*",
        "bundle/lane/lane.sh"
      ]
    },
    {
      "id": "HCAP-03",
      "name": "remote KCOV lane attribution",
      "purpose": "Attribute knfsd fs/nfsd and net/sunrpc coverage to the executor proc and lane",
      "usable_stage": [
        "stage1",
        "stage2"
      ],
      "usable_by": [

# --- Build / runtime trees — regenerable (bootstrap / AB runs / gates) ---
env/
evidence/
runs/
# --- Release assets — assembled by tools/release-assembly.sh at release time ---
dist/
# --- bundle/src: only guest-deps.tar.gz is committed (asset-free model);
# --- the base image/keypair are site-generated (tools/make-base-image.sh)
# --- and the raw base image is never distributed (release-assembly aborts
# --- on leak). Site-local generated artifacts live under artifacts/.
bundle/src/*
!bundle/src/guest-deps.tar.gz
artifacts/
# --- Python caches ---
.venv/
__pycache__/
*.pyc
# --- OS / editor noise ---
*.swp
.DS_Store
cache/
# --- tools/nfs-proxy: host build artifacts, never committed ---
# The proxy is built from source by tools/nfs-proxy/build.sh on any
# host with clang and gcc; shipping the binary would hide a build that
# no longer works from a clean checkout.
tools/nfs-proxy/build/

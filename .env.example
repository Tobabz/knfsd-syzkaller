# Copy to .env (git-ignored) and export before starting the pipeline:
#   set -a; . ./.env; set +a
# The code reads the process environment only; it does not load this file.

# API key read by the OpenAI SDK. Never commit a real value.
OPENAI_API_KEY=

# Optional reviewed OpenAI-compatible endpoint. HTTPS, loopback HTTP, or HTTP
# inside Tailscale's 100.64.0.0/10 only. Empty uses https://api.openai.com/v1.
# The generic OPENAI_BASE_URL is ignored on purpose.
KNFSD_OPENAI_BASE_URL=

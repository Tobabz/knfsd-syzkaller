[Unit]
Description=Frozen NFS KCOV four-lane fixture
Wants=network-online.target
After=network-online.target
Before=ssh.service

[Service]
Type=oneshot
ExecStart=/opt/frozen-phase9/boot-fixture.sh
ExecStartPost=/opt/frozen-phase9/lane.sh status /tmp/frozen-phase9.manager
ExecStop=/opt/frozen-phase9/lane.sh cleanup /tmp/frozen-phase9.manager
RemainAfterExit=yes
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

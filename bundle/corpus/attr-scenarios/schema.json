{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knfsd-fuzz.invalid/attr-scenario.schema.json",
  "title": "Remote-KCOV attribution scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "boundary", "variant", "polarity", "workload", "sha256",
    "lane_fixture", "hooks", "mode", "counter_expect", "drain_keys",
    "sentinel", "procs", "executions"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^B(?:0[1-9]|1[0-2])-V[1-7](?:-[1-9][0-9]*)?$"},
    "boundary": {"enum": ["B01", "B02", "B03", "B04", "B05", "B06", "B07", "B08", "B09", "B10", "B11", "B12"]},
    "variant": {"enum": ["V1", "V2", "V3", "V4", "V5", "V6", "V7"]},
    "polarity": {"enum": ["positive", "negative"]},
    "workload": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.prog$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lane_fixture": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "hooks": {
      "type": "array", "uniqueItems": true, "maxItems": 9,
      "prefixItems": [
        {"$ref": "#/$defs/hook"}, {"$ref": "#/$defs/hook"},
        {"$ref": "#/$defs/hook"}, {"$ref": "#/$defs/hook"},
        {"$ref": "#/$defs/hook"}, {"$ref": "#/$defs/hook"},
        {"$ref": "#/$defs/hook"}, {"$ref": "#/$defs/hook"},
        {"$ref": "#/$defs/hook"}
      ],
      "items": {"enum": [
        "v4.abort-next-deferred", "v4.abort-next-async",
        "v4.pause-release-deferred-after-grant", "v4.pause-release-async-after-grant",
        "v4.generation-abort-ioctl", "v5.redefer-cache-revisit",
        "v5.cancel-saved-work", "v6.retry-same-cookie-same-socket",
        "v7.concurrent-cross-lane"
      ]}
    },
    "mode": {"enum": ["both", "on"]},
    "counter_expect": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["file", "name", "op", "value"],
        "properties": {
          "file": {"$ref": "#/$defs/counter_file"},
          "name": {"$ref": "#/$defs/counter_name"},
          "op": {"enum": ["eq", "ge", "le", "delta_eq", "delta_ge"]},
          "value": {"type": "integer"}
        }
      }
    },
    "drain_keys": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/qualified_counter"}
    },
    "sentinel": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"enum": ["fs/nfsd", "net/sunrpc", "fs/nfs"]},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["rule", "required", "observed"],
        "properties": {
          "rule": {"enum": ["on-only", "on-union"]},
          "required": {"$ref": "#/$defs/symbols"},
          "observed": {"$ref": "#/$defs/symbols"},
          "absent-on-only": {"$ref": "#/$defs/symbols"}
        },
        "anyOf": [
          {"properties": {"required": {"minItems": 1}}},
          {"required": ["absent-on-only"], "properties": {"absent-on-only": {"minItems": 1}}}
        ]
      }
    },
    "negative_expect": {"$ref": "#/$defs/negative_expect"},
    "procs": {"type": "integer", "minimum": 1},
    "executions": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"polarity": {"const": "negative"}}},
      "then": {"required": ["negative_expect"]}
    }
  ],
  "$defs": {
    "hook": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "args"],
      "properties": {
        "id": {"enum": [
          "v4.abort-next-deferred", "v4.abort-next-async",
          "v4.pause-release-deferred-after-grant", "v4.pause-release-async-after-grant",
          "v4.generation-abort-ioctl", "v5.redefer-cache-revisit",
          "v5.cancel-saved-work", "v6.retry-same-cookie-same-socket",
          "v7.concurrent-cross-lane"
        ]},
        "args": {"type": "object"}
      }
    },
    "counter_file": {"type": "string", "pattern": "^phase[3-9]_(?:stats|state)$"},
    "counter_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "qualified_counter": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "name"],
      "properties": {
        "file": {"$ref": "#/$defs/counter_file"},
        "name": {"$ref": "#/$defs/counter_name"}
      }
    },
    "symbols": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "publication_zero": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "file", "name"],
      "properties": {
        "source": {"enum": ["counter", "json"]},
        "file": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "name": {"$ref": "#/$defs/counter_name"}
      }
    },
    "ownerless_worker": {
      "type": "object", "additionalProperties": false,
      "required": [
        "kind", "boundary", "sentinel", "rule", "required", "trace_file",
        "copies_per_execution", "completion_before_seconds"
      ],
      "properties": {
        "kind": {"const": "nfsd4-callback-trace"},
        "boundary": {"const": "B07"},
        "sentinel": {"const": "nfsd4_run_cb_work"},
        "rule": {"const": "trace-both"},
        "required": {"type": "array", "const": ["nfsd4_run_cb_work"]},
        "trace_file": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "copies_per_execution": {"type": "integer", "minimum": 1},
        "completion_before_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "negative_expect": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "publication_zero": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/publication_zero"}},
        "ownerless_worker": {"$ref": "#/$defs/ownerless_worker"},
        "cross_lane_zero": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/qualified_counter"}}
      }
    }
  }
}

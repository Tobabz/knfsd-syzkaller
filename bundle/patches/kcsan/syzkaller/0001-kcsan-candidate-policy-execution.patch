+// PolicyCandidateID leaves feature probes and comparison-only executions
+// untagged: they cannot create the remote generation required by the Policy.
+func PolicyCandidateID(candidateID string, opts ExecOpts) string {
+	const required = ExecEnvSignal | ExecEnvExtraCover
+	const collect = ExecFlagCollectSignal | ExecFlagCollectCover
+	if opts.EnvFlags&required != required || opts.ExecFlags&collect == 0 ||
+		opts.ExecFlags&ExecFlagCollectComps != 0 {
+		return ""
+	}
+	return candidateID
+}

diff --git a/pkg/flatrpc/policy_test.go b/pkg/flatrpc/policy_test.go
new file mode 100644
index 000000000..3157d4c9c
--- /dev/null
+++ b/pkg/flatrpc/policy_test.go
@@ -0,0 +1,25 @@
+package flatrpc
+
+import "testing"
+
+func TestPolicyCandidateID(t *testing.T) {
+	opts := ExecOpts{
+		EnvFlags:  ExecEnvSignal | ExecEnvExtraCover,
+		ExecFlags: ExecFlagCollectSignal,
+	}
+	if got := PolicyCandidateID("VC-test", opts); got != "VC-test" {
+		t.Fatalf("campaign policy ID = %q, want VC-test", got)
+	}
+	if got := PolicyCandidateID("", opts); got != "" {
+		t.Fatalf("ordinary campaign policy ID = %q, want empty", got)
+	}
+	opts.ExecFlags = ExecFlagCollectComps
+	if got := PolicyCandidateID("VC-test", opts); got != "" {
+		t.Fatalf("comparison execution selected policy %q", got)
+	}
+	opts.ExecFlags = ExecFlagCollectCover
+	opts.EnvFlags = ExecEnvSignal
+	if got := PolicyCandidateID("VC-test", opts); got != "" {
+		t.Fatalf("execution without extra coverage selected policy %q", got)
+	}
+}

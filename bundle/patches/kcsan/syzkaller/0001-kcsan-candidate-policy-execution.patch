diff --git a/executor/executor_linux.h b/executor/executor_linux.h
index 73606bd07..1a6b73c79 100644
--- a/executor/executor_linux.h
+++ b/executor/executor_linux.h
@@ -8,10 +8,90 @@
 #include <stdlib.h>
 #include <sys/ioctl.h>
 #include <sys/mman.h>
+#include <sys/mount.h>
 #include <sys/prctl.h>
 #include <sys/syscall.h>
 #include <unistd.h>
 
+// Register one already-converted Policy before the runner accepts programs.
+// The single write is the kernel's atomic registration boundary.
+static int load_kcsan_policy(const char* path, const char* candidate_id)
+{
+	size_t id_len = strnlen(candidate_id, 128);
+	if (!id_len || id_len == 128) {
+		fprintf(stderr, "invalid KCSAN candidate ID\n");
+		return 1;
+	}
+	int input = open(path, O_RDONLY | O_CLOEXEC);
+	if (input < 0) {
+		perror("open Policy payload");
+		return 1;
+	}
+	char payload[4097];
+	ssize_t size = read(input, payload, sizeof(payload));
+	close(input);
+	if (size <= 0 || size > 4096) {
+		fprintf(stderr, "Policy payload must be 1..4096 bytes\n");
+		return 1;
+	}
+	unsigned int schema = 0, rules = 0;
+	char embedded[128];
+	unsigned int weight = 0, task_delay = 0, interrupt_delay = 0;
+	payload[size] = 0;
+	if (sscanf(payload, "policy %127s %u %u %u %u %u", embedded, &schema,
+	           &weight, &task_delay, &interrupt_delay, &rules) != 6 ||
+	    strcmp(embedded, candidate_id) || schema != 5 || !rules) {
+		fprintf(stderr, "Policy payload header does not match candidate ID\n");
+		return 1;
+	}
+	const char* register_path = "/sys/kernel/debug/kcsan_policy/register";
+	int output = open(register_path, O_WRONLY | O_CLOEXEC);
+	if (output < 0) {
+		// The VM image may not mount debugfs during early boot.
+		if (mount("debugfs", "/sys/kernel/debug", "debugfs", 0, nullptr) && errno != EBUSY) {
+			perror("mount debugfs");
+			return 1;
+		}
+		output = open(register_path, O_WRONLY | O_CLOEXEC);
+	}
+	if (output < 0) {
+		perror("open KCSAN Policy register");
+		return 1;
+	}
+	ssize_t written = write(output, payload, size);
+	int write_errno = errno;
+	close(output);
+	if (written != size) {
+		errno = written < 0 ? write_errno : EIO;
+		perror("register KCSAN Policy");
+		return 1;
+	}
+	FILE* status = fopen("/sys/kernel/debug/kcsan_policy/policies", "r");
+	if (!status) {
+		perror("open KCSAN Policy Store");
+		return 1;
+	}
+	char line[512];
+	bool found = false;
+	while (fgets(line, sizeof(line), status)) {
+		unsigned int count = 0;
+		char registered[128];
+		if (sscanf(line, "policy candidate_id=%127s schema_version=%*u default_weight=%*u "
+		           "task_delay_us=%*u interrupt_delay_us=%*u nr_rules=%u", registered, &count) == 2 &&
+		    !strcmp(registered, candidate_id) && count == rules) {
+			found = true;
+			break;
+		}
+	}
+	fclose(status);
+	if (!found) {
+		fprintf(stderr, "Policy %s was not found in the kernel Store\n", candidate_id);
+		return 1;
+	}
+	printf("KCSAN Policy %s registered (%u rules)\n", candidate_id, rules);
+	return 0;
+}
+
 #ifndef __GLIBC__
 // musl (and other non-glibc libcs) don't declare the pkey_* wrappers or the
 // PKEY_DISABLE_WRITE flag, even though the kernel syscalls exist on any
@@ -89,6 +169,14 @@ struct kcov_remote_generation {
 };
 static_assert(sizeof(kcov_remote_generation) == 16);
 
+struct kcov_remote_generation_policy {
+	uint64 generation;
+	uint32 timeout_ms;
+	uint32 flags;
+	char candidate_id[128];
+};
+static_assert(sizeof(kcov_remote_generation_policy) == 144);
+
 #define KCOV_INIT_TRACE32 _IOR('c', 1, uint32)
 #define KCOV_INIT_TRACE64 _IOR('c', 1, uint64)
 #define KCOV_ENABLE _IO('c', 100)
@@ -99,6 +187,7 @@ static_assert(sizeof(kcov_remote_generation) == 16);
 #define KCOV_REMOTE_GENERATION_BIND _IOW('c', 110, kcov_remote_generation)
 #define KCOV_REMOTE_GENERATION_FINISH _IOW('c', 111, kcov_remote_generation)
 #define KCOV_REMOTE_GENERATION_ABORT _IOW('c', 112, kcov_remote_generation)
+#define KCOV_REMOTE_GENERATION_BEGIN_POLICY _IOWR('c', 113, kcov_remote_generation_policy)
 
 #define KCOV_SUBSYSTEM_COMMON (0x00ull << 56)
 #define KCOV_SUBSYSTEM_USB (0x01ull << 56)
@@ -265,21 +354,39 @@ static void cover_enable(cover_t* cov, bool collect_comps, bool extra)
 	cov->enabled = true;
 }
 
-static uint64 cover_begin_remote_generation()
+static uint64 cover_begin_remote_generation(const char* candidate_id)
 {
-	kcov_remote_generation arg = {};
-	if (ioctl(extra_cov.fd, KCOV_REMOTE_GENERATION_BEGIN, &arg)) {
-		// Instrumentation admission must not prevent the real program from
-		// running.  The caller suppresses remote extra while preserving normal
-		// per-call coverage.
+	uint64 generation = 0;
+	int rv;
+	if (candidate_id[0]) {
+		kcov_remote_generation_policy arg = {};
+		size_t id_len = strnlen(candidate_id, sizeof(arg.candidate_id));
+		if (id_len == sizeof(arg.candidate_id))
+			fail("KCSAN candidate ID is too long");
+		memcpy(arg.candidate_id, candidate_id, id_len + 1);
+		rv = ioctl(extra_cov.fd, KCOV_REMOTE_GENERATION_BEGIN_POLICY, &arg);
+		generation = arg.generation;
+	} else {
+		kcov_remote_generation arg = {};
+		rv = ioctl(extra_cov.fd, KCOV_REMOTE_GENERATION_BEGIN, &arg);
+		generation = arg.generation;
+	}
+	if (rv) {
+		if (candidate_id[0])
+			failmsg("KCOV policy generation begin failed", "candidate_id=%s errno=%d", candidate_id, errno);
+		// Attribution and instrumentation admission must not prevent the real
+		// program from running. The caller suppresses remote extra while
+		// preserving normal per-call coverage.
 		debug("KCOV generation begin failed: errno=%d\n", errno);
 		return 0;
 	}
-	if (!arg.generation) {
+	if (!generation) {
+		if (candidate_id[0])
+			failmsg("KCOV policy generation begin returned zero", "candidate_id=%s", candidate_id);
 		debug("KCOV generation begin returned generation zero\n");
 		return 0;
 	}
-	return arg.generation;
+	return generation;
 }
 
 static bool cover_bind_remote_generation(uint64 generation)

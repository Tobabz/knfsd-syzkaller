+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("KCSAN payload %q is not a regular file", cfg.KCSANPolicyFile)
+	}
+	payload, err := os.ReadFile(cfg.KCSANPolicyFile)
+	if err != nil {
+		return fmt.Errorf("read KCSAN payload %q: %w", cfg.KCSANPolicyFile, err)
+	}
+	if len(payload) == 0 || len(payload) > 4096 {
+		return fmt.Errorf("KCSAN payload %q must be 1..4096 bytes", cfg.KCSANPolicyFile)
+	}
+	header := strings.Fields(strings.SplitN(string(payload), "\n", 2)[0])
+	if len(header) != 7 || header[0] != "policy" || header[1] != candidateID || header[2] != "5" {
+		return fmt.Errorf("KCSAN payload %q has a mismatched candidate ID or schema", cfg.KCSANPolicyFile)
+	}
+	cfg.KCSANCandidateID = candidateID
+	return nil
+}

+++ b/pkg/execbackend/rpc.go
@@ -54,6 +54,14 @@ func (b *rpcBackend) RunRequests(ctx context.Context, inst *vm.Instance,
 			return nil, fmt.Errorf("failed to copy binary: %w", err)
 		}
 	}
+	if b.cfg.KCSANCandidateID != "" {
+		if err := loadKCSANPolicy(ctx, inst, reporter, executorBin, b.cfg.KCSANPolicyFile,
+			b.cfg.KCSANCandidateID); err != nil {
+			return nil, err
+		}
+		log.Logf(0, "VM %d: KCSAN candidate %s available before runner start", inst.Index(),
+			b.cfg.KCSANCandidateID)
+	}
 
 	var cmd string
 	if b.cfg.VMLess {
@@ -127,3 +135,23 @@ func (b *rpcBackend) RunRequests(ctx context.Context, inst *vm.Instance,
 
 	return reps, err
 }
+
+func loadKCSANPolicy(ctx context.Context, inst *vm.Instance, reporter *report.Reporter,
+	executorBin, hostPayload, candidateID string) error {
+	guestPayload, err := inst.Copy(hostPayload)
+	if err != nil {
+		return fmt.Errorf("failed to copy KCSAN Policy payload: %w", err)
+	}
+	loadCtx, cancel := context.WithTimeout(ctx, time.Minute)
+	defer cancel()
+	command := fmt.Sprintf("%s policy-load %s %s", executorBin, guestPayload, candidateID)
+	output, reports, err := inst.Run(loadCtx, reporter, command, vm.WithExitCondition(vm.ExitNormal))
+	if err != nil {
+		return fmt.Errorf("VM %d KCSAN Policy registration failed: %w; output: %s",
+			inst.Index(), err, output)
+	}
+	if len(reports) != 0 {
+		return fmt.Errorf("VM %d crashed during KCSAN Policy registration: %s", inst.Index(), output)
+	}
+	return nil
+}

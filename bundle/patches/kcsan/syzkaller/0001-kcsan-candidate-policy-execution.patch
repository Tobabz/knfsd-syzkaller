+func (cfg *Config) completeKCSANPolicy() error {
+	cfg.KCSANCandidateID = ""
+	if cfg.KCSANPolicyFile == "" {
+		return nil
+	}
+	if cfg.TargetOS != "linux" || cfg.Type == "none" {
+		return fmt.Errorf("kcsan_policy_file requires a Linux VM")
+	}
+	if !cfg.Cover || !cfg.Experimental.RemoteCover {
+		return fmt.Errorf("kcsan_policy_file requires cover and experimental.remote_cover")
+	}
+	cfg.KCSANPolicyFile = osutil.Abs(cfg.KCSANPolicyFile)
+	name := filepath.Base(cfg.KCSANPolicyFile)
+	candidateID := strings.TrimSuffix(name, "_policy.payload")
+	if candidateID == name || candidateID == "." || candidateID == ".." ||
+		len(candidateID) == 0 || len(candidateID) >= 128 ||
+		!regexp.MustCompile(`^[A-Za-z0-9_.-]+$`).MatchString(candidateID) {
+		return fmt.Errorf("invalid KCSAN payload filename %q", name)
+	}
+	info, err := os.Lstat(cfg.KCSANPolicyFile)
+	if err != nil {
+		return fmt.Errorf("stat KCSAN payload %q: %w", cfg.KCSANPolicyFile, err)
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("KCSAN payload %q is not a regular file", cfg.KCSANPolicyFile)
+	}
+	payload, err := os.ReadFile(cfg.KCSANPolicyFile)
+	if err != nil {
+		return fmt.Errorf("read KCSAN payload %q: %w", cfg.KCSANPolicyFile, err)
+	}
+	if len(payload) == 0 || len(payload) > 4096 {
+		return fmt.Errorf("KCSAN payload %q must be 1..4096 bytes", cfg.KCSANPolicyFile)
+	}
+	header := strings.Fields(strings.SplitN(string(payload), "\n", 2)[0])
+	if len(header) != 7 || header[0] != "policy" || header[1] != candidateID || header[2] != "5" {
+		return fmt.Errorf("KCSAN payload %q has a mismatched candidate ID or schema", cfg.KCSANPolicyFile)
+	}
+	cfg.KCSANCandidateID = candidateID
+	return nil
+}

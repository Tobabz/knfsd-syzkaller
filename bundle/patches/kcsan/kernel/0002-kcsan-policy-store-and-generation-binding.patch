 		ret = kcov_request_generation_bind(owner, arg.generation);
 		if (ret)
 			goto begin_done;
-		if (copy_to_user(uarg, &arg, sizeof(arg)))
+		if (with_policy) {
+			policy_arg.generation = arg.generation;
+			if (copy_to_user(uarg, &policy_arg,
+					sizeof(policy_arg)))
+				ret = -EFAULT;
+		} else if (copy_to_user(uarg, &arg, sizeof(arg))) {
 			ret = -EFAULT;
+		}
 begin_done:
 		spin_lock_irqsave(&kcov->lock, flags);
 		kcov->request_generation_busy = false;
@@ -1268,6 +1305,7 @@ static long kcov_ioctl(struct file *filep, unsigned int cmd, unsigned long arg)
 	kcov = filep->private_data;
 	switch (cmd) {
 	case KCOV_REMOTE_GENERATION_BEGIN:
+	case KCOV_REMOTE_GENERATION_BEGIN_POLICY:
 	case KCOV_REMOTE_GENERATION_BIND:
 	case KCOV_REMOTE_GENERATION_FINISH:
 	case KCOV_REMOTE_GENERATION_ABORT:
@@ -2008,6 +2046,9 @@ enum kcov_request_remote_start_result kcov_request_remote_start_checked(
 	t->kcov_request_remote_ticket = ticket;
 	kcov_start(t, ticket->kcov, ticket->scratch_size, ticket->scratch,

+/* Register one complete transfer payload; duplicate IDs are rejected. */
+int kcsan_policy_register_payload(const char *payload, size_t len);
+
+/* Print all committed policies for the read-only debugfs status file. */
+int kcsan_policy_show(struct seq_file *file, void *unused);

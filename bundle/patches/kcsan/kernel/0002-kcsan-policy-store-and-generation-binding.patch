diff --git a/include/linux/kcsan_policy.h b/include/linux/kcsan_policy.h
new file mode 100644
index 000000000..5c04ca181
--- /dev/null
+++ b/include/linux/kcsan_policy.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_KCSAN_POLICY_H
+#define _LINUX_KCSAN_POLICY_H
+
+#include <linux/types.h>
+
+struct kcsan_policy;
+
+struct kcsan_policy_context {
+	struct kcsan_policy *policy;
+	u64 generation;
+	bool remote;
+};
+
+#ifdef CONFIG_KCSAN
+/* A successful lookup holds a reference until kcsan_policy_put(). */
+struct kcsan_policy *kcsan_policy_get(const char *candidate_id);
+void kcsan_policy_put(struct kcsan_policy *policy);
+void kcsan_policy_context_bind(struct kcsan_policy *policy, u64 generation);
+void kcsan_policy_context_remote_enter(struct kcsan_policy *policy,
+		struct kcsan_policy_context *saved);
+void kcsan_policy_context_remote_exit(
+		const struct kcsan_policy_context *saved);
+#else
+static inline struct kcsan_policy *kcsan_policy_get(const char *candidate_id)
+{
+	return NULL;
+}
+
+static inline void kcsan_policy_put(struct kcsan_policy *policy) {}
+static inline void kcsan_policy_context_bind(struct kcsan_policy *policy,
+		u64 generation) {}
+static inline void kcsan_policy_context_remote_enter(
+		struct kcsan_policy *policy,
+		struct kcsan_policy_context *saved) {}
+static inline void kcsan_policy_context_remote_exit(
+		const struct kcsan_policy_context *saved) {}
+#endif
+
+#endif /* _LINUX_KCSAN_POLICY_H */

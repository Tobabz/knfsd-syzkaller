 		/* BIND failures must never leave an earlier window attached. */
 		if (cmd == KCOV_REMOTE_GENERATION_BIND)
 			current->kcov_handle_generation = 0;
@@ -1054,7 +1079,7 @@ static long kcov_request_generation_ioctl(struct kcov *kcov,
 		return -EINVAL;
 	}
 
-	if (cmd == KCOV_REMOTE_GENERATION_BEGIN) {
+	if (cmd == KCOV_REMOTE_GENERATION_BEGIN || with_policy) {
 		if (arg.generation || arg.timeout_ms)
 			return -EINVAL;
 		spin_lock_irqsave(&kcov->lock, flags);
@@ -1088,6 +1113,12 @@ static long kcov_request_generation_ioctl(struct kcov *kcov,
 			gen = NULL;

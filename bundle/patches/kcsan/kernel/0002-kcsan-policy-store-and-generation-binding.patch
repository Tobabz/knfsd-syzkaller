 /*
- * The NFS/RPC scope brackets built-in NFS client, shared NFS, lockd, SUNRPC
- * and NFSD text.
- * Weak references keep KCSAN linkable if a directory is absent or modular.
+ * The NFS/RPC watchpoint scope brackets
+ * built-in code from the NFS client, shared NFS, lockd, SUNRPC and NFSD
+ * directories. Weak references keep KCSAN linkable when any of them is absent
+ * or built as a module (a module cannot be covered by built-in text markers).
  */
 #define KCSAN_NFS_SCOPE_DECLARE(scope, section) \
 	extern char __kcsan_nfs_scope_##scope##_##section##_start[] __weak; \
@@ -72,6 +74,8 @@ static bool kcsan_early_enable = IS_ENABLED(CONFIG_KCSAN_EARLY_ENABLE);
 unsigned int kcsan_udelay_task = CONFIG_KCSAN_UDELAY_TASK;
 unsigned int kcsan_udelay_interrupt = CONFIG_KCSAN_UDELAY_INTERRUPT;
 static long kcsan_skip_watch = CONFIG_KCSAN_SKIP_WATCH;
+/* Policy reference rate; independent of the no-policy KCSAN skip counter. */
+static unsigned int kcsan_policy_skip_watch = 38;
 static bool kcsan_interrupt_watcher = IS_ENABLED(CONFIG_KCSAN_INTERRUPT_WATCHER);
 
 #ifdef MODULE_PARAM_PREFIX
@@ -82,6 +86,7 @@ module_param_named(early_enable, kcsan_early_enable, bool, 0);
 module_param_named(udelay_task, kcsan_udelay_task, uint, 0644);
 module_param_named(udelay_interrupt, kcsan_udelay_interrupt, uint, 0644);
 module_param_named(skip_watch, kcsan_skip_watch, long, 0644);
+module_param_named(policy_skip_watch, kcsan_policy_skip_watch, uint, 0644);
 module_param_named(interrupt_watcher, kcsan_interrupt_watcher, bool, 0444);
 
 #ifdef CONFIG_KCSAN_WEAK_MEMORY
@@ -248,6 +253,20 @@ static __always_inline struct kcsan_ctx *get_ctx(void)
 	return in_task() ? &current->kcsan_ctx : raw_cpu_ptr(&kcsan_cpu_ctx);
 }
 
+static __always_inline struct kcsan_policy *
+kcsan_current_policy(struct kcsan_ctx *ctx)
+{
+#ifdef CONFIG_KCOV
+	if (in_task() && READ_ONCE(ctx->policy) &&
+	    (READ_ONCE(ctx->policy_remote) ||
+	     (READ_ONCE(ctx->policy_generation) &&
+	      READ_ONCE(ctx->policy_generation) ==
+		READ_ONCE(current->kcov_handle_generation))))
+		return READ_ONCE(ctx->policy);
+#endif
+	return NULL;
+}
+
 static __always_inline void
 check_access(const volatile void *ptr, size_t size, int type, unsigned long ip);
 
@@ -345,6 +364,35 @@ static u32 kcsan_prandom_u32_max(u32 ep_ro)
 	return state % ep_ro;
 }
 
+/* Policy mode samples every eligible NFS/RPC access without pre-thinning. */
+static __always_inline bool
+should_watch_policy(struct kcsan_ctx *ctx, const volatile void *ptr,
+		    size_t size, int type, unsigned long ip,
+		    struct kcsan_policy *policy,
+		    struct kcsan_policy_decision *decision)
+{
+	u32 skip, base, threshold;
+
+	if (is_atomic(ctx, ptr, size, type) || !kcsan_nfs_scope_contains(ip))
+		return false;
+	kcsan_policy_decide(policy, ip, decision);
+	/* p0 ~= 2/(skip+3) with randomized skip, otherwise 1/(skip+1). */
+	skip = clamp_val(READ_ONCE(kcsan_policy_skip_watch), 1U, 1000000U);
+	base = IS_ENABLED(CONFIG_KCSAN_SKIP_WATCH_RANDOMIZE) ?
+		2000000U / (skip + 3) : 1000000U / (skip + 1);
+	decision->weighted = kcsan_prandom_u32_max(10) >= 3;
+	/* The 30% uniform lane retains baseline sampling in the NFS/RPC scope. */
+	if (!decision->weighted)
+		threshold = base;
+	else if (decision->matched)
+		/* Priority lane: weights 4 and 2 mean 40% and 20%. */
+		threshold = min_t(u32, 400000U,
+				      (u32)decision->weight * 100000U);
+	else
+		threshold = 0;
+	return kcsan_prandom_u32_max(1000000U) < threshold;
+}
+
 static inline void reset_kcsan_skip(void)
 {
 	long skip_count = kcsan_skip_watch -
@@ -360,17 +408,21 @@ static __always_inline bool kcsan_is_enabled(struct kcsan_ctx *ctx)
 }
 
 /* Introduce delay depending on context and configuration. */
-static void delay_access(int type)
+static void delay_access(int type,

@@ -618,6 +630,44 @@ kcov_request_generation_begin(u64 owner, u64 *generation)
 }
 EXPORT_SYMBOL_GPL(kcov_request_generation_begin);
 
+int kcov_request_generation_set_policy(struct kcov_request_generation *gen,
+		const char *candidate_id)
+{
+	struct kcsan_policy *policy;
+	unsigned long flags;
+	int ret = 0;
+
+	if (!gen || !candidate_id || !*candidate_id)
+		return -EINVAL;
+	if (!IS_ENABLED(CONFIG_KCSAN))
+		return -EOPNOTSUPP;
+	policy = kcsan_policy_get(candidate_id);
+	if (!policy) {
+		request_stat_inc(REQUEST_GENERATION_POLICY_BIND_MISS);
+		return -ENOENT;
+	}
+	spin_lock_irqsave(&gen->lock, flags);
+	if (gen->state != KCOV_REQUEST_GEN_OPEN || gen->policy)
+		ret = -EBUSY;
+	else
+		gen->policy = policy;
+	spin_unlock_irqrestore(&gen->lock, flags);
+	if (ret)
+		kcsan_policy_put(policy);
+	else
+		request_stat_inc(REQUEST_GENERATION_POLICY_BIND_OK);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_set_policy);
+
+/* Borrowed pointer: the immutable Store owns a reference until reboot. */
+struct kcsan_policy *kcov_request_generation_policy(
+		struct kcov_request_generation *gen)
+{
+	return gen ? READ_ONCE(gen->policy) : NULL;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_policy);
+
 u64 kcov_request_generation_id(struct kcov_request_generation *gen)
 {
 	return gen ? gen->id : 0;
@@ -986,6 +1036,7 @@ int kcov_request_generation_bind(u64 owner, u64 generation)
 	struct kcov_request_generation *gen;
 	int ret = 0;
 
+	kcsan_policy_context_bind(NULL, 0);
 	current->kcov_request_generation_controller = false;
 	if (!owner) {
 		current->kcov_handle_generation = 0;
@@ -1014,6 +1065,7 @@ int kcov_request_generation_bind(u64 owner, u64 generation)
 	} else {
 		current->kcov_handle = owner;
 		current->kcov_handle_generation = generation;
+		kcsan_policy_context_bind(gen->policy, generation);
 		request_stat_inc(REQUEST_GENERATION_BIND_OK);
 	}
 	kcov_request_generation_put(gen);
@@ -1023,6 +1075,7 @@ EXPORT_SYMBOL_GPL(kcov_request_generation_bind);
 
 void kcov_request_generation_note_stale_bind(void)
 {
+	kcsan_policy_context_bind(NULL, 0);
 	current->kcov_handle_generation = 0;
 	request_stat_inc(REQUEST_GENERATION_BIND_STALE);

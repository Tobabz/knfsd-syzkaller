diff --git a/kernel/kcsan/policy.c b/kernel/kcsan/policy.c
new file mode 100644
index 000000000..2d0a0f622
--- /dev/null
+++ b/kernel/kcsan/policy.c
@@ -0,0 +1,316 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * KCSAN immutable Policy Store and symbol resolver.
+ *
+ * Policies are registered from process context through the experimental
+ * debugfs interface. Registration resolves every rule before publishing the
+ * object in the Store, so readers can only observe complete policies.
+ */
+#define pr_fmt(fmt) "kcsan: policy: " fmt
+
+#include <linux/errno.h>
+#include <linux/ctype.h>
+#include <linux/kallsyms.h>
+#include <linux/kernel.h>
+#include <linux/mutex.h>
+#include <linux/overflow.h>
+#include <linux/refcount.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "kcsan.h"
+#include "policy.h"
+
+static LIST_HEAD(kcsan_policy_store);
+static DEFINE_MUTEX(kcsan_policy_store_lock);
+
+static char *next_token(char **line)
+{
+	char *token;
+
+	while ((token = strsep(line, " \t\r")) != NULL) {
+		if (*token)
+			return token;
+	}
+	return NULL;
+}
+
+static char *next_line(char **payload)
+{
+	char *line;
+
+	while ((line = strsep(payload, "\n")) != NULL) {
+		line = strim(line);
+		if (*line)
+			return line;
+	}
+	return NULL;
+}
+
+static int parse_u32(char **line, u32 *value)
+{
+	char *token = next_token(line);
+
+	if (!token)
+		return -EINVAL;
+	return kstrtou32(token, 10, value);
+}
+
+static bool has_extra_token(char **line)
+{
+	return next_token(line) != NULL;
+}
+
+static int resolve_rule(struct kcsan_policy_rule *rule)
+{
+	unsigned long symbol_size, offset;
+	unsigned long start;
+
+	start = kallsyms_lookup_name(rule->symbol);
+	if (!start)
+		return -ENOENT;
+	if (!kallsyms_lookup_size_offset(start, &symbol_size, &offset) ||
+	    !symbol_size || offset)
+		return -ENOENT;
+	if (check_add_overflow(start, symbol_size, &rule->end_ip))
+		return -EOVERFLOW;
+	rule->start_ip = start;
+	return rule->start_ip < rule->end_ip ? 0 : -EINVAL;
+}
+
+static int parse_rule(char *line, struct kcsan_policy_rule *rule,
+		      struct kcsan_policy *policy, u32 index)
+{
+	char *kind = next_token(&line);
+	char *symbol = next_token(&line);
+	char *subsystem = next_token(&line);
+	u32 weight, delay_us;
+	u32 i;
+	int ret;
+
+	if (!kind || strcmp(kind, "rule") || !symbol || !subsystem)
+		return -EINVAL;
+	if (strscpy(rule->symbol, symbol, sizeof(rule->symbol)) < 0 ||
+	    strscpy(rule->subsystem, subsystem, sizeof(rule->subsystem)) < 0)
+		return -E2BIG;
+	if (parse_u32(&line, &weight) || weight > U8_MAX ||
+	    parse_u32(&line, &delay_us) ||
+	    delay_us > KCSAN_POLICY_MAX_DELAY_US || has_extra_token(&line))
+		return -EINVAL;
+
+	for (i = 0; i < index; i++) {
+		if (!strcmp(policy->rules[i].symbol, rule->symbol))
+			return -EEXIST;
+	}
+
+	rule->weight = weight;
+	rule->delay_us = delay_us;
+	ret = resolve_rule(rule);
+	if (ret)
+		pr_err("cannot resolve policy symbol '%s' (error %d)\n",
+		       rule->symbol, ret);
+	return ret;
+}
+
+static int parse_policy_header(char *line, struct kcsan_policy *policy)
+{
+	char *kind = next_token(&line);
+	char *candidate_id;
+	u32 default_weight;
+
+	candidate_id = next_token(&line);
+	if (!kind || strcmp(kind, "policy") || !candidate_id ||
+	    strscpy(policy->candidate_id, candidate_id,
+		    sizeof(policy->candidate_id)) < 0 ||
+	    parse_u32(&line, &policy->schema_version) ||
+	    policy->schema_version != KCSAN_POLICY_SCHEMA_VERSION)
+		return -EINVAL;
+	for (candidate_id = policy->candidate_id; *candidate_id; candidate_id++) {
+		if (!isalnum(*candidate_id) && *candidate_id != '_' &&
+		    *candidate_id != '-' && *candidate_id != '.')
+			return -EINVAL;
+	}
+	if (parse_u32(&line, &default_weight) || default_weight > U8_MAX ||
+	    parse_u32(&line, &policy->default_task_delay_us) ||
+	    policy->default_task_delay_us > KCSAN_POLICY_MAX_DELAY_US ||
+	    parse_u32(&line, &policy->default_interrupt_delay_us) ||
+	    policy->default_interrupt_delay_us > KCSAN_POLICY_MAX_DELAY_US ||
+	    parse_u32(&line, &policy->nr_rules) || !policy->nr_rules ||
+	    policy->nr_rules > KCSAN_POLICY_MAX_RULES || has_extra_token(&line))
+		return -EINVAL;
+	policy->default_weight = default_weight;
+	return 0;
+}
+
+int kcsan_policy_register_payload(const char *payload, size_t len)
+{
+	struct kcsan_policy *policy;
+	char *copy, *cursor, *line;
+	u32 i;
+	int ret;
+
+	if (!payload || !len || len > KCSAN_POLICY_MAX_PAYLOAD)
+		return -EINVAL;
+	copy = kmemdup_nul(payload, len, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+	cursor = copy;
+	line = next_line(&cursor);
+	if (!line) {
+		ret = -EINVAL;
+		goto out_free_copy;
+	}
+
+	/* Allocate after parsing a bounded rule count from a temporary header. */
+	{
+		struct kcsan_policy header = {};
+
+		ret = parse_policy_header(line, &header);
+		if (ret)
+			goto out_free_copy;
+		policy = kzalloc(struct_size(policy, rules, header.nr_rules),
+				 GFP_KERNEL);
+		if (!policy) {
+			ret = -ENOMEM;
+			goto out_free_copy;
+		}
+		/* parse_policy_header() tokenizes line in place. */
+		memcpy(policy, &header, sizeof(header));
+	}
+
+	for (i = 0; i < policy->nr_rules; i++) {
+		line = next_line(&cursor);
+		if (!line) {
+			ret = -EINVAL;
+			goto out_free_policy;
+		}
+		ret = parse_rule(line, &policy->rules[i], policy, i);
+		if (ret)
+			goto out_free_policy;
+	}
+	if (next_line(&cursor)) {
+		ret = -EINVAL;
+		goto out_free_policy;
+	}
+
+	refcount_set(&policy->refs, 1); /* Store-owned reference. */
+	mutex_lock(&kcsan_policy_store_lock);
+	{
+		struct kcsan_policy *existing;
+
+		list_for_each_entry(existing, &kcsan_policy_store, node) {
+			if (!strcmp(existing->candidate_id, policy->candidate_id)) {
+				ret = -EBUSY;
+				break;
+			}
+		}
+		if (!ret)
+			list_add_tail(&policy->node, &kcsan_policy_store);
+	}
+	mutex_unlock(&kcsan_policy_store_lock);
+	if (ret)
+		goto out_free_policy;
+
+	pr_info("registered candidate_id=%s rules=%u\n",
+		policy->candidate_id, policy->nr_rules);
+	kfree(copy);
+	return 0;
+
+out_free_policy:
+	kfree(policy);
+out_free_copy:
+	kfree(copy);
+	return ret;
+}
+
+struct kcsan_policy *kcsan_policy_get(const char *candidate_id)
+{
+	struct kcsan_policy *policy;
+
+	if (!candidate_id || !*candidate_id)
+		return NULL;
+	mutex_lock(&kcsan_policy_store_lock);
+	list_for_each_entry(policy, &kcsan_policy_store, node) {
+		if (!strcmp(policy->candidate_id, candidate_id)) {
+			refcount_inc(&policy->refs);
+			mutex_unlock(&kcsan_policy_store_lock);
+			return policy;
+		}
+	}
+	mutex_unlock(&kcsan_policy_store_lock);
+	return NULL;
+}
+
+void kcsan_policy_put(struct kcsan_policy *policy)
+{
+	if (policy && refcount_dec_and_test(&policy->refs))
+		kfree(policy);
+}
+
+/* Store entries are immutable and retain a store-owned ref until reboot. */
+void kcsan_policy_context_bind(struct kcsan_policy *policy, u64 generation)
+{
+	if (policy)
+		atomic_long_inc(&kcsan_counters[
+			KCSAN_COUNTER_POLICY_CONTEXT_BIND]);
+	WRITE_ONCE(current->kcsan_ctx.policy, policy);
+	WRITE_ONCE(current->kcsan_ctx.policy_generation,
+		policy ? generation : 0);
+	WRITE_ONCE(current->kcsan_ctx.policy_remote, false);
+}
+
+void kcsan_policy_context_remote_enter(struct kcsan_policy *policy,
+		struct kcsan_policy_context *saved)
+{
+	if (policy)
+		atomic_long_inc(&kcsan_counters[
+			KCSAN_COUNTER_POLICY_REMOTE_ENTER]);
+	saved->policy = READ_ONCE(current->kcsan_ctx.policy);
+	saved->generation = READ_ONCE(current->kcsan_ctx.policy_generation);
+	saved->remote = READ_ONCE(current->kcsan_ctx.policy_remote);
+	WRITE_ONCE(current->kcsan_ctx.policy, policy);
+	WRITE_ONCE(current->kcsan_ctx.policy_generation, 0);
+	WRITE_ONCE(current->kcsan_ctx.policy_remote, true);
+}
+
+void kcsan_policy_context_remote_exit(
+		const struct kcsan_policy_context *saved)
+{
+	WRITE_ONCE(current->kcsan_ctx.policy, saved->policy);
+	WRITE_ONCE(current->kcsan_ctx.policy_generation, saved->generation);
+	WRITE_ONCE(current->kcsan_ctx.policy_remote, saved->remote);
+}
+
+int kcsan_policy_show(struct seq_file *file, void *unused)
+{
+	struct kcsan_policy *policy;
+	u32 i;
+
+	mutex_lock(&kcsan_policy_store_lock);
+	list_for_each_entry(policy, &kcsan_policy_store, node) {
+		seq_printf(file,
+			   "policy candidate_id=%s schema_version=%u default_weight=%u "
+			   "task_delay_us=%u interrupt_delay_us=%u nr_rules=%u\n",
+			   policy->candidate_id, policy->schema_version,
+			   policy->default_weight, policy->default_task_delay_us,
+			   policy->default_interrupt_delay_us, policy->nr_rules);
+		for (i = 0; i < policy->nr_rules; i++) {
+			const struct kcsan_policy_rule *rule = &policy->rules[i];
+
+			seq_printf(file,
+				   " rule candidate_id=%s symbol=%s subsystem=%s "
+				   "start=0x%lx end=0x%lx weight=%u delay_us=%u "
+				   "candidates=%ld selected=%ld setup=%ld delay=%ld\n",
+				   policy->candidate_id, rule->symbol, rule->subsystem,
+				   rule->start_ip, rule->end_ip, rule->weight,
+				   rule->delay_us,
+				   atomic_long_read(&rule->candidates),
+				   atomic_long_read(&rule->selected),
+				   atomic_long_read(&rule->setup),
+				   atomic_long_read(&rule->delay));
+		}
+	}
+	mutex_unlock(&kcsan_policy_store_lock);
+	return 0;
+}
diff --git a/kernel/kcsan/policy.h b/kernel/kcsan/policy.h
new file mode 100644
index 000000000..b17144a3a
--- /dev/null
+++ b/kernel/kcsan/policy.h
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _KERNEL_KCSAN_POLICY_H
+#define _KERNEL_KCSAN_POLICY_H
+
+#include <linux/kallsyms.h>
+#include <linux/kcsan_policy.h>
+#include <linux/atomic.h>
+#include <linux/list.h>
+#include <linux/refcount.h>
+#include <linux/seq_file.h>
+#include <linux/types.h>
+#include <uapi/linux/kcov.h>
+
+#define KCSAN_POLICY_SCHEMA_VERSION	5
+#define KCSAN_POLICY_MAX_RULES		64
+#define KCSAN_POLICY_MAX_DELAY_US	30000U
+#define KCSAN_POLICY_MAX_PAYLOAD	4096U
+#define KCSAN_POLICY_CANDIDATE_ID_LEN	KCOV_POLICY_CANDIDATE_ID_LEN
+#define KCSAN_POLICY_SUBSYSTEM_LEN	64
+
+struct kcsan_policy_rule {
+	char symbol[KSYM_NAME_LEN];
+	char subsystem[KCSAN_POLICY_SUBSYSTEM_LEN];
+	unsigned long start_ip;
+	unsigned long end_ip;	/* exclusive */
+	u8 weight;
+	u32 delay_us;
+	atomic_long_t candidates;
+	atomic_long_t selected;
+	atomic_long_t setup;
+	atomic_long_t delay;
+};
+
+struct kcsan_policy {
+	struct list_head node;
+	refcount_t refs;
+	u32 schema_version;
+	char candidate_id[KCSAN_POLICY_CANDIDATE_ID_LEN];
+	u8 default_weight;
+	u32 default_task_delay_us;
+	u32 default_interrupt_delay_us;
+	u32 nr_rules;
+	struct kcsan_policy_rule rules[];
+};
+
+struct kcsan_policy_decision {
+	u8 weight;
+	u32 task_delay_us;
+	u32 interrupt_delay_us;
+	bool matched;
+	bool weighted;
+	struct kcsan_policy_rule *rule;
+};
+
+static __always_inline void
+kcsan_policy_decide(struct kcsan_policy *policy, unsigned long ip,
+		    struct kcsan_policy_decision *decision)
+{
+	u32 i;
+
+	decision->matched = false;
+	decision->rule = NULL;
+	decision->weight = policy->default_weight;
+	decision->task_delay_us = policy->default_task_delay_us;
+	decision->interrupt_delay_us = policy->default_interrupt_delay_us;
+	for (i = 0; i < policy->nr_rules; i++) {
+		struct kcsan_policy_rule *rule = &policy->rules[i];
+
+		if (ip >= rule->start_ip && ip < rule->end_ip) {
+			decision->matched = true;
+			decision->rule = rule;
+			atomic_long_inc(&rule->candidates);
+			decision->weight = rule->weight;
+			decision->task_delay_us = rule->delay_us ?
+				rule->delay_us : policy->default_task_delay_us;
+			return;
+		}
+	}
+}

+static ssize_t policy_register_write(struct file *file,
+				     const char __user *buf, size_t count,
+				     loff_t *ppos)
+{
+	char *payload;
+	int ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (*ppos)
+		return -EINVAL;
+	if (!count || count > KCSAN_POLICY_MAX_PAYLOAD)
+		return -E2BIG;
+
+	payload = memdup_user_nul(buf, count);
+	if (IS_ERR(payload))
+		return PTR_ERR(payload);
+
+	ret = kcsan_policy_register_payload(payload, count);
+	kfree(payload);
+	if (ret)
+		return ret;
+
+	*ppos += count;
+	return count;

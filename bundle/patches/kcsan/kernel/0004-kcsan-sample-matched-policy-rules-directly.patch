From 965e81ae7816de24d41802a4005bc80ed5155cd7 Mon Sep 17 00:00:00 2001
From: knfsd-fuzz <knfsd-fuzz@localhost>
Date: Thu, 22 Oct 2026 20:28:11 +0900
Subject: [PATCH 4/4] kcsan: sample matched policy rules directly

Summary:
- Remove the 30/70 uniform and weighted sampling split.
- Apply the matched rule weight directly, at 10% per unit up to 40%.
- Drop obsolete lane state and counters.

Rationale:
- The split diluted the candidate function's requested sampling rate.
- Nonmatching accesses no longer install policy-bound watchpoints.
- Accesses outside the policy can still detect installed watchpoints.

Tests:
- make -j8 bzImage (pass).
- Snapshot VM: nfsd_svc selected and set up 440/1100 accesses.
- NFSD thread writes returned EIO, but reached nfsd_svc.

Co-authored-by: Codex <codex@openai.com>
---
 kernel/kcsan/core.c    | 40 ++++++++++++----------------------------
 kernel/kcsan/debugfs.c |  2 --
 kernel/kcsan/kcsan.h   |  2 --
 kernel/kcsan/policy.h  |  4 ----
 4 files changed, 12 insertions(+), 36 deletions(-)

diff --git a/kernel/kcsan/core.c b/kernel/kcsan/core.c
index a9327f010..b4814390d 100644
--- a/kernel/kcsan/core.c
+++ b/kernel/kcsan/core.c
@@ -95,8 +95,6 @@ static bool kcsan_early_enable = IS_ENABLED(CONFIG_KCSAN_EARLY_ENABLE);
 unsigned int kcsan_udelay_task = CONFIG_KCSAN_UDELAY_TASK;
 unsigned int kcsan_udelay_interrupt = CONFIG_KCSAN_UDELAY_INTERRUPT;
 static long kcsan_skip_watch = CONFIG_KCSAN_SKIP_WATCH;
-/* Policy reference rate; independent of the no-policy KCSAN skip counter. */
-static unsigned int kcsan_policy_skip_watch = 38;
 static bool kcsan_interrupt_watcher = IS_ENABLED(CONFIG_KCSAN_INTERRUPT_WATCHER);
 
 #ifdef MODULE_PARAM_PREFIX
@@ -107,7 +105,6 @@ module_param_named(early_enable, kcsan_early_enable, bool, 0);
 module_param_named(udelay_task, kcsan_udelay_task, uint, 0644);
 module_param_named(udelay_interrupt, kcsan_udelay_interrupt, uint, 0644);
 module_param_named(skip_watch, kcsan_skip_watch, long, 0644);
-module_param_named(policy_skip_watch, kcsan_policy_skip_watch, uint, 0644);
 module_param_named(interrupt_watcher, kcsan_interrupt_watcher, bool, 0444);
 
 #ifdef CONFIG_KCSAN_WEAK_MEMORY
@@ -385,33 +382,25 @@ static u32 kcsan_prandom_u32_max(u32 ep_ro)
 	return state % ep_ro;
 }
 
-/* Policy mode samples accesses in the candidate subsystem. */
+/* Policy mode samples accesses that match a policy rule. */
 static __always_inline bool
 should_watch_policy(struct kcsan_ctx *ctx, const volatile void *ptr,
 		    size_t size, int type, unsigned long ip,
 		    struct kcsan_policy *policy,
 		    struct kcsan_policy_decision *decision)
 {
-	u32 skip, base, threshold;
+	u32 threshold;
 
 	if (is_atomic(ctx, ptr, size, type) ||
 	    !kcsan_nfs_scope_contains_inline(policy->scope, ip))
 		return false;
 	kcsan_policy_decide(policy, ip, decision);
-	/* p0 ~= 2/(skip+3) with randomized skip, otherwise 1/(skip+1). */
-	skip = clamp_val(READ_ONCE(kcsan_policy_skip_watch), 1U, 1000000U);
-	base = IS_ENABLED(CONFIG_KCSAN_SKIP_WATCH_RANDOMIZE) ?
-		2000000U / (skip + 3) : 1000000U / (skip + 1);
-	decision->weighted = kcsan_prandom_u32_max(10) >= 3;
-	/* The 30% uniform lane retains sampling across the candidate scope. */
-	if (!decision->weighted)
-		threshold = base;
-	else if (decision->matched)
-		/* Priority lane: weights 4 and 2 mean 40% and 20%. */
-		threshold = min_t(u32, 400000U,
-				      (u32)decision->weight * 100000U);
-	else
-		threshold = 0;
+	if (!decision->rule)
+		return false;
+
+	/* Each rule weight unit adds 10%, capped at 40%. */
+	threshold = min_t(u32, 400000U,
+			      (u32)decision->weight * 100000U);
 	return kcsan_prandom_u32_max(1000000U) < threshold;
 }
 
@@ -668,15 +657,10 @@ kcsan_setup_watchpoint(const volatile void *ptr, size_t size, int type,
 		goto out;
 	}
 	atomic_long_inc(&kcsan_counters[KCSAN_COUNTER_NFS_SCOPE_ALLOWED]);
-	if (decision) {
-		atomic_long_inc(&kcsan_counters[decision->weighted ?
-			KCSAN_COUNTER_POLICY_WEIGHTED_SELECTED :
-			KCSAN_COUNTER_POLICY_UNIFORM_SELECTED]);
-		if (decision->matched)
-			atomic_long_inc(&kcsan_counters[
-				KCSAN_COUNTER_POLICY_RULE_SELECTED]);
-		if (decision->rule)
-			atomic_long_inc(&decision->rule->selected);
+	if (decision && decision->rule) {
+		atomic_long_inc(&kcsan_counters[
+			KCSAN_COUNTER_POLICY_RULE_SELECTED]);
+		atomic_long_inc(&decision->rule->selected);
 	}
 
 	if (!kcsan_is_enabled(ctx))
diff --git a/kernel/kcsan/debugfs.c b/kernel/kcsan/debugfs.c
index 5b7bb5761..42360fdd4 100644
--- a/kernel/kcsan/debugfs.c
+++ b/kernel/kcsan/debugfs.c
@@ -37,8 +37,6 @@ static const char *const counter_names[] = {
 	[KCSAN_COUNTER_ENCODING_FALSE_POSITIVES]	= "encoding_false_positives",
 	[KCSAN_COUNTER_NFS_SCOPE_ALLOWED]		= "nfs_scope_allowed",
 	[KCSAN_COUNTER_NFS_SCOPE_REJECTED]	= "nfs_scope_rejected",
-	[KCSAN_COUNTER_POLICY_UNIFORM_SELECTED]	= "policy_uniform_selected",
-	[KCSAN_COUNTER_POLICY_WEIGHTED_SELECTED]	= "policy_weighted_selected",
 	[KCSAN_COUNTER_POLICY_RULE_SELECTED]	= "policy_rule_selected",
 	[KCSAN_COUNTER_POLICY_SETUP]		= "policy_setup",
 	[KCSAN_COUNTER_POLICY_DELAY]		= "policy_delay",
diff --git a/kernel/kcsan/kcsan.h b/kernel/kcsan/kcsan.h
index 0f5f9efd4..6b6203038 100644
--- a/kernel/kcsan/kcsan.h
+++ b/kernel/kcsan/kcsan.h
@@ -88,8 +88,6 @@ enum kcsan_counter_id {
 	/* Watchpoint candidates admitted/rejected by the NFS/RPC scope. */
 	KCSAN_COUNTER_NFS_SCOPE_ALLOWED,
 	KCSAN_COUNTER_NFS_SCOPE_REJECTED,
-	KCSAN_COUNTER_POLICY_UNIFORM_SELECTED,
-	KCSAN_COUNTER_POLICY_WEIGHTED_SELECTED,
 	KCSAN_COUNTER_POLICY_RULE_SELECTED,
 	KCSAN_COUNTER_POLICY_SETUP,
 	KCSAN_COUNTER_POLICY_DELAY,
diff --git a/kernel/kcsan/policy.h b/kernel/kcsan/policy.h
index 4ca8e58f6..877f493f4 100644
--- a/kernel/kcsan/policy.h
+++ b/kernel/kcsan/policy.h
@@ -60,8 +60,6 @@ struct kcsan_policy_decision {
 	u8 weight;
 	u32 task_delay_us;
 	u32 interrupt_delay_us;
-	bool matched;
-	bool weighted;
 	struct kcsan_policy_rule *rule;
 };
 
@@ -71,7 +69,6 @@ kcsan_policy_decide(struct kcsan_policy *policy, unsigned long ip,
 {
 	u32 i;
 
-	decision->matched = false;
 	decision->rule = NULL;
 	decision->weight = policy->default_weight;
 	decision->task_delay_us = policy->default_task_delay_us;
@@ -80,7 +77,6 @@ kcsan_policy_decide(struct kcsan_policy *policy, unsigned long ip,
 		struct kcsan_policy_rule *rule = &policy->rules[i];
 
 		if (ip >= rule->start_ip && ip < rule->end_ip) {
-			decision->matched = true;
 			decision->rule = rule;
 			atomic_long_inc(&rule->candidates);
 			decision->weight = rule->weight;

diff --git a/include/linux/kcsan_nfs_scope.h b/include/linux/kcsan_nfs_scope.h
new file mode 100644
index 000000000..bcadd5b2c
--- /dev/null
+++ b/include/linux/kcsan_nfs_scope.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Assembly markers for built-in NFS/RPC watchpoint-installation scope. */
+#ifndef KCSAN_NFS_SCOPE
+#error "KCSAN_NFS_SCOPE must name the source directory"
+#endif
+#ifndef KCSAN_NFS_SCOPE_EDGE
+#error "KCSAN_NFS_SCOPE_EDGE must be start or end"
+#endif
+
+#define __KCSAN_NFS_SCOPE_SYMBOL(scope, section, edge) __kcsan_nfs_scope_##scope##_##section##_##edge
+#define KCSAN_NFS_SCOPE_SYMBOL(scope, section, edge) __KCSAN_NFS_SCOPE_SYMBOL(scope, section, edge)
+#define KCSAN_NFS_SCOPE_MARK(section, kind) \
+	.pushsection section, "ax"; \
+	.globl KCSAN_NFS_SCOPE_SYMBOL(KCSAN_NFS_SCOPE, kind, KCSAN_NFS_SCOPE_EDGE); \
+	KCSAN_NFS_SCOPE_SYMBOL(KCSAN_NFS_SCOPE, kind, KCSAN_NFS_SCOPE_EDGE):; \
+	.popsection
+
+KCSAN_NFS_SCOPE_MARK(.text, text)
+KCSAN_NFS_SCOPE_MARK(.text.hot, hot)
+KCSAN_NFS_SCOPE_MARK(.text.unlikely, unlikely)
+KCSAN_NFS_SCOPE_MARK(.text.split, split)
+
+.section .note.GNU-stack, "", @progbits
diff --git a/kernel/kcsan/core.c b/kernel/kcsan/core.c
index 2db82661c..338a177d4 100644
--- a/kernel/kcsan/core.c
+++ b/kernel/kcsan/core.c
@@ -26,6 +26,48 @@
 #include "kcsan.h"
 #include "permissive.h"
 
+/*
+ * The NFS/RPC scope brackets built-in NFS client, shared NFS, lockd, SUNRPC
+ * and NFSD text.
+ * Weak references keep KCSAN linkable if a directory is absent or modular.
+ */
+#define KCSAN_NFS_SCOPE_DECLARE(scope, section) \
+	extern char __kcsan_nfs_scope_##scope##_##section##_start[] __weak; \
+	extern char __kcsan_nfs_scope_##scope##_##section##_end[] __weak
+
+#define KCSAN_NFS_SCOPE_DECLARE_ALL(scope) \
+	KCSAN_NFS_SCOPE_DECLARE(scope, text); \
+	KCSAN_NFS_SCOPE_DECLARE(scope, hot); \
+	KCSAN_NFS_SCOPE_DECLARE(scope, unlikely); \
+	KCSAN_NFS_SCOPE_DECLARE(scope, split)
+
+KCSAN_NFS_SCOPE_DECLARE_ALL(nfs);
+KCSAN_NFS_SCOPE_DECLARE_ALL(nfs_common);
+KCSAN_NFS_SCOPE_DECLARE_ALL(lockd);
+KCSAN_NFS_SCOPE_DECLARE_ALL(sunrpc);
+KCSAN_NFS_SCOPE_DECLARE_ALL(nfsd);
+
+#define KCSAN_NFS_SCOPE_IN_RANGE(scope, section, ip) \
+	(__kcsan_nfs_scope_##scope##_##section##_start && \
+	 __kcsan_nfs_scope_##scope##_##section##_end && \
+	 (ip) >= (unsigned long)__kcsan_nfs_scope_##scope##_##section##_start && \
+	 (ip) < (unsigned long)__kcsan_nfs_scope_##scope##_##section##_end)
+
+#define KCSAN_NFS_SCOPE_CONTAINS(scope, ip) \
+	(KCSAN_NFS_SCOPE_IN_RANGE(scope, text, ip) || \
+	 KCSAN_NFS_SCOPE_IN_RANGE(scope, hot, ip) || \
+	 KCSAN_NFS_SCOPE_IN_RANGE(scope, unlikely, ip) || \
+	 KCSAN_NFS_SCOPE_IN_RANGE(scope, split, ip))
+
+static __always_inline bool kcsan_nfs_scope_contains(unsigned long ip)
+{
+	return KCSAN_NFS_SCOPE_CONTAINS(nfs, ip) ||
+	       KCSAN_NFS_SCOPE_CONTAINS(nfs_common, ip) ||
+	       KCSAN_NFS_SCOPE_CONTAINS(lockd, ip) ||
+	       KCSAN_NFS_SCOPE_CONTAINS(sunrpc, ip) ||
+	       KCSAN_NFS_SCOPE_CONTAINS(nfsd, ip);
+}
+
 static bool kcsan_early_enable = IS_ENABLED(CONFIG_KCSAN_EARLY_ENABLE);
 unsigned int kcsan_udelay_task = CONFIG_KCSAN_UDELAY_TASK;
 unsigned int kcsan_udelay_interrupt = CONFIG_KCSAN_UDELAY_INTERRUPT;
@@ -543,6 +585,11 @@ kcsan_setup_watchpoint(const volatile void *ptr, size_t size, int type, unsigned
 	 * should_watch().
 	 */
 	reset_kcsan_skip();
+	if (!kcsan_nfs_scope_contains(ip)) {
+		atomic_long_inc(&kcsan_counters[KCSAN_COUNTER_NFS_SCOPE_REJECTED]);
+		goto out;
+	}
+	atomic_long_inc(&kcsan_counters[KCSAN_COUNTER_NFS_SCOPE_ALLOWED]);
 
 	if (!kcsan_is_enabled(ctx))
 		goto out;
diff --git a/kernel/kcsan/debugfs.c b/kernel/kcsan/debugfs.c
index 2af39ba5b..139583e27 100644
--- a/kernel/kcsan/debugfs.c
+++ b/kernel/kcsan/debugfs.c
@@ -33,6 +33,8 @@ static const char *const counter_names[] = {
 	[KCSAN_COUNTER_RACES_UNKNOWN_ORIGIN]		= "races_unknown_origin",
 	[KCSAN_COUNTER_UNENCODABLE_ACCESSES]		= "unencodable_accesses",
 	[KCSAN_COUNTER_ENCODING_FALSE_POSITIVES]	= "encoding_false_positives",
+	[KCSAN_COUNTER_NFS_SCOPE_ALLOWED]		= "nfs_scope_allowed",
+	[KCSAN_COUNTER_NFS_SCOPE_REJECTED]	= "nfs_scope_rejected",
 };
 static_assert(ARRAY_SIZE(counter_names) == KCSAN_COUNTER_COUNT);
 

--- a/kernel/kcsan/kcsan.h
+++ b/kernel/kcsan/kcsan.h
@@ -85,6 +85,10 @@ enum kcsan_counter_id {
 	 */
 	KCSAN_COUNTER_ENCODING_FALSE_POSITIVES,
 
+	/* Watchpoint candidates admitted or rejected by the NFS/RPC scope. */
+	KCSAN_COUNTER_NFS_SCOPE_ALLOWED,
+	KCSAN_COUNTER_NFS_SCOPE_REJECTED,
+
 	KCSAN_COUNTER_COUNT, /* number of counters */
 };
 extern atomic_long_t kcsan_counters[KCSAN_COUNTER_COUNT];

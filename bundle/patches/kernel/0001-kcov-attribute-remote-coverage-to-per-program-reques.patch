+/*
+ * Best-effort global observation. Unlike kcov_remote_start(), never warn about
+ * or displace an incumbent, even in softirq context. In particular, a managed
+ * ticket must not see another scratch area through the trace callback.
+ * The caller must stop in the same context, and only after a true return.
+ */
+bool kcov_remote_start_nfsd_observe(void)
+{
+	struct task_struct *t = current;
+	struct kcov_remote *remote;
+	struct kcov *kcov;
+	void *area;
+	unsigned int size;
+	int sequence;
+	unsigned long flags;
+	bool irq = in_softirq_really();
+
+	if (!in_task() && !irq)
+		return false;
+	/* Task-context scratch allocation may sleep. */
+	if (!irq && (in_atomic() || irqs_disabled()))
+		return false;
+
+	local_lock_irqsave(&kcov_percpu_data.lock, flags);
+	if (t->kcov_request_remote_ticket || t->kcov || t->kcov_softirq ||
+	    kcov_mode_enabled(READ_ONCE(t->kcov_mode))) {
+		local_unlock_irqrestore(&kcov_percpu_data.lock, flags);
+		return false;
+	}
+
+	spin_lock(&kcov_remote_lock);
+	remote = kcov_remote_find(KCOV_NFSD_OBSERVE_HANDLE);
+	if (!remote) {
+		spin_unlock(&kcov_remote_lock);
+		local_unlock_irqrestore(&kcov_percpu_data.lock, flags);
+		return false;
+	}
+	kcov = remote->kcov;
+	/* Registration excludes managed generations; retain the merge guard. */
+	if (!kcov_request_legacy_merge_allowed(kcov)) {
+		spin_unlock(&kcov_remote_lock);
+		local_unlock_irqrestore(&kcov_percpu_data.lock, flags);
+		return false;
+	}
+	kcov_get(kcov);
+	sequence = kcov->sequence;
+	size = irq ? CONFIG_KCOV_IRQ_AREA_SIZE : kcov->remote_size;
+	area = kcov_remote_area_get(size, irq);
+	spin_unlock(&kcov_remote_lock);
+
+	if (!area) {
+		local_unlock_irqrestore(&kcov_percpu_data.lock, flags);
+		area = irq ? NULL : vmalloc(size * sizeof(unsigned long));
+		if (!area) {
+			kcov_put(kcov);
+			return false;
+		}
+		local_lock_irqsave(&kcov_percpu_data.lock, flags);
+	}
+
+	*(unsigned long *)area = 0;
+	if (irq)
+		t->kcov_softirq = 1;
+	kcov_start(t, kcov, size, area, KCOV_MODE_TRACE_PC, sequence);
+	local_unlock_irqrestore(&kcov_percpu_data.lock, flags);
+	return true;
+}
+EXPORT_SYMBOL_GPL(kcov_remote_start_nfsd_observe);

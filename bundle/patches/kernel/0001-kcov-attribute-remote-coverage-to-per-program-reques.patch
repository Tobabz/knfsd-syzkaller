+#define REQUEST_KCOV_WORDS_PER_CMP 4
+
+enum request_stat {
+	REQUEST_GENERATION_CREATED,
+	REQUEST_GENERATION_BEGIN,
+	REQUEST_GENERATION_BIND_OK,
+	REQUEST_GENERATION_BIND_UNBOUND,
+	REQUEST_GENERATION_BIND_STALE,
+	REQUEST_GENERATION_EXIT_ABORT,
+	REQUEST_GENERATION_ABORT_FD_CURRENT,
+	REQUEST_GENERATION_BEGIN_GAP_ENTERED,
+	REQUEST_GENERATION_BEGIN_GAP_INTERRUPTED,
+	REQUEST_GENERATION_FINISH,
+	REQUEST_GENERATION_CLOSING,
+	REQUEST_GENERATION_COMMITTED,
+	REQUEST_GENERATION_ABORTED,
+	REQUEST_GENERATION_DEAD,
+	REQUEST_ROOT_TOKEN_CREATED,
+	REQUEST_ROOT_TOKEN_COMPLETED,
+	REQUEST_ROOT_TOKEN_CANCELED,
+	REQUEST_CHILD_TOKEN_GRANTED,
+	REQUEST_CHILD_TOKEN_REJECTED,
+	REQUEST_TOKEN_CREATED,
+	REQUEST_TOKEN_COMPLETED,
+	REQUEST_TOKEN_DOUBLE_COMPLETE,
+	REQUEST_NEW_ROOT_REJECTED_CLOSING,

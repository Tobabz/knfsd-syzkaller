+	    cmd == KCOV_REMOTE_GENERATION_ABORT) {
+		spin_lock_irqsave(&kcov->lock, flags);
+		kcov_request_generation_busy_done(kcov);
+		spin_unlock_irqrestore(&kcov->lock, flags);
+	}
+	kcov_request_generation_put(gen);
+	return ret;
+}

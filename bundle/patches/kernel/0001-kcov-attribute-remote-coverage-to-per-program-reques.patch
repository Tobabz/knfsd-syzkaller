+static const char *request_state_name(enum kcov_request_generation_state state)
+{
+	switch (state) {
+	case KCOV_REQUEST_GEN_OPEN: return "OPEN";
+	case KCOV_REQUEST_GEN_CLOSING: return "CLOSING";
+	case KCOV_REQUEST_GEN_ABORTED: return "ABORTED";
+	case KCOV_REQUEST_GEN_COMMITTED: return "COMMITTED";
+	case KCOV_REQUEST_GEN_DEAD: return "DEAD";
+	}
+	return "UNKNOWN";
+}
+
+bool kcov_request_generation_get(struct kcov_request_generation *gen)
+{
+	return gen && refcount_inc_not_zero(&gen->object_refs);
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_get);
+
+void kcov_request_generation_put(struct kcov_request_generation *gen)
+{
+	struct request_aggregate_buffer *aggregate_buffer;
+	unsigned long flags;
+
+	if (!gen || !refcount_dec_and_test(&gen->object_refs))
+		return;
+	spin_lock_irqsave(&request_generations_lock, flags);
+	spin_lock(&gen->lock);
+	gen->state = KCOV_REQUEST_GEN_DEAD;
+	spin_unlock(&gen->lock);
+	list_del(&gen->all);
+	spin_unlock_irqrestore(&request_generations_lock, flags);
+	aggregate_buffer = gen->aggregate_buffer;
+	gen->aggregate_buffer = NULL;
+	gen->aggregate_area = NULL;
+	request_stat_inc(REQUEST_GENERATION_DEAD);
+	request_aggregate_free(aggregate_buffer);
+	kfree(gen);
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_put);
+
+static struct kcov_request_generation *
+request_generation_lookup(u64 owner, u64 id)
+{
+	struct kcov_request_generation *gen;
+	unsigned long flags;
+
+	spin_lock_irqsave(&request_generations_lock, flags);
+	list_for_each_entry(gen, &request_generations, all) {
+		if (gen->owner == owner && gen->id == id &&
+		    refcount_inc_not_zero(&gen->object_refs)) {
+			spin_unlock_irqrestore(&request_generations_lock, flags);
+			return gen;
+		}
+	}
+	spin_unlock_irqrestore(&request_generations_lock, flags);
+	return NULL;
+}
+
+struct kcov_request_generation *
+kcov_request_generation_begin(u64 owner, u64 *generation)
+{
+	struct kcov_request_generation *gen;
+	unsigned long flags;
+	u64 id;
+
+	if (!owner || !generation)
+		return ERR_PTR(-EINVAL);
+	gen = kzalloc(sizeof(*gen), GFP_KERNEL);
+	if (!gen)
+		return ERR_PTR(-ENOMEM);
+	do {
+		id = atomic64_inc_return(&request_generation_id);
+	} while (unlikely(!id));
+	spin_lock_init(&gen->lock);
+	mutex_init(&gen->aggregate_merge_lock);
+	atomic_set(&gen->aggregate_merging, 0);
+	refcount_set(&gen->object_refs, 1);
+	INIT_LIST_HEAD(&gen->roots);
+	INIT_LIST_HEAD(&gen->tokens);
+	init_waitqueue_head(&gen->drain_wait);
+	gen->owner = owner;
+	gen->id = id;
+	gen->state = KCOV_REQUEST_GEN_OPEN;
+	gen->remote_result = KCOV_REQUEST_REMOTE_VALID;
+	gen->aggregate_state = KCOV_REQUEST_AGGREGATE_POOL_FREE;
+	spin_lock_irqsave(&request_generations_lock, flags);
+	list_add_tail(&gen->all, &request_generations);
+	spin_unlock_irqrestore(&request_generations_lock, flags);
+	*generation = id;
+	request_stat_inc(REQUEST_GENERATION_CREATED);
+	request_stat_inc(REQUEST_GENERATION_BEGIN);
+	kcov_request_phase5_note(KCOV_REQUEST_P5_RESULT_VALID);
+	return gen;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_begin);
+
+u64 kcov_request_generation_id(struct kcov_request_generation *gen)
+{
+	return gen ? gen->id : 0;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_id);
+
+u64 kcov_request_generation_owner(struct kcov_request_generation *gen)
+{
+	return gen ? gen->owner : 0;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_owner);
+
+static void request_aggregate_quarantine_locked(
+		struct kcov_request_generation *gen)
+{
+	if (gen->aggregate_state == KCOV_REQUEST_AGGREGATE_POOL_FREE ||
+	    gen->aggregate_state == KCOV_REQUEST_AGGREGATE_DISCARDED ||
+	    gen->aggregate_state == KCOV_REQUEST_AGGREGATE_QUARANTINED)
+		return;
+	if (gen->aggregate_state == KCOV_REQUEST_AGGREGATE_PUBLISHING) {
+		kcov_request_phase6_note(
+			KCOV_REQUEST_P6_AGGREGATE_REUSE_BLOCKED_READER);
+		return;
+	}
+	gen->aggregate_state = KCOV_REQUEST_AGGREGATE_QUARANTINED;
+	kcov_request_phase6_note(KCOV_REQUEST_P6_AGGREGATE_QUARANTINED);
+	if (!gen->publish_suppressed) {
+		gen->publish_suppressed = true;
+		kcov_request_phase6_note(
+			KCOV_REQUEST_P6_AGGREGATE_PUBLISH_SUPPRESSED);
+	}
+}
+
+/* Caller must free the returned vmalloc allocation after dropping gen->lock. */
+static struct request_aggregate_buffer *request_aggregate_discard_locked(
+		struct kcov_request_generation *gen)
+{
+	struct request_aggregate_buffer *buffer;
+
+	if (gen->aggregate_state != KCOV_REQUEST_AGGREGATE_QUARANTINED ||
+	    gen->remote_refs || gen->publish_readers)
+		return NULL;
+	gen->aggregate_state = KCOV_REQUEST_AGGREGATE_DISCARDED;
+	kcov_request_phase6_note(KCOV_REQUEST_P6_AGGREGATE_DISCARDED);
+	buffer = gen->aggregate_buffer;
+	gen->aggregate_buffer = NULL;
+	gen->aggregate_area = NULL;
+	gen->aggregate_size = 0;
+	gen->aggregate_entries = 0;
+	gen->aggregate_state = KCOV_REQUEST_AGGREGATE_POOL_FREE;
+	return buffer;
+}
+
+static void request_aggregate_discard_ready(
+		struct kcov_request_generation *gen)
+{
+	struct request_aggregate_buffer *buffer;
+
+	spin_lock(&gen->lock);
+	buffer = request_aggregate_discard_locked(gen);
+	spin_unlock(&gen->lock);
+	request_aggregate_free(buffer);
+}
+
+int kcov_request_generation_remote_open(struct kcov_request_generation *gen,
+		u32 mode, u32 size)
+{
+	struct request_aggregate_buffer *buffer;
+	int ret = 0;
+
+	if (!gen || (mode != KCOV_MODE_TRACE_PC &&
+		       mode != KCOV_MODE_TRACE_CMP) || size < 2 ||
+	    size > UINT_MAX / sizeof(unsigned long))
+		return -EINVAL;
+	buffer = vzalloc(struct_size(buffer, area, size));
+	if (!buffer)
+		return -ENOMEM;
+	INIT_WORK(&buffer->free_work, request_aggregate_free_work);
+	spin_lock(&gen->lock);
+	if (gen->state != KCOV_REQUEST_GEN_OPEN || gen->aggregate_area ||
+	    gen->aggregate_state != KCOV_REQUEST_AGGREGATE_POOL_FREE) {
+		ret = -ESTALE;
+	} else {
+		gen->aggregate_buffer = buffer;
+		gen->aggregate_area = buffer->area;
+		gen->aggregate_size = size;
+		gen->aggregate_mode = mode;
+		gen->aggregate_entries = 0;
+		gen->aggregate_state = KCOV_REQUEST_AGGREGATE_OPEN;
+		buffer = NULL;
+		kcov_request_phase6_note(KCOV_REQUEST_P6_AGGREGATE_ALLOCATED);
+	}
+	spin_unlock(&gen->lock);
+	request_aggregate_free(buffer);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_remote_open);
+
+static u64 request_area_capacity(u32 size, u32 mode)
+{
+	u64 bytes = (u64)size * sizeof(unsigned long);
+
+	if (mode == KCOV_MODE_TRACE_PC)
+		return size > 0 ? size - 1 : 0;
+	if (mode == KCOV_MODE_TRACE_CMP && bytes >= sizeof(u64))
+		return (bytes - sizeof(u64)) /
+			(sizeof(u64) * REQUEST_KCOV_WORDS_PER_CMP);
+	return 0;
+}
+
+static u64 request_area_entries(const void *area, u32 mode)
+{
+	return mode == KCOV_MODE_TRACE_PC ?
+		READ_ONCE(*(unsigned long *)area) : READ_ONCE(*(u64 *)area);
+}
+
+static void request_area_set_entries(void *area, u32 mode, u64 entries)
+{
+	if (mode == KCOV_MODE_TRACE_PC)
+		WRITE_ONCE(*(unsigned long *)area, entries);
+	else
+		WRITE_ONCE(*(u64 *)area, entries);
+}
+
+static bool request_phase6_fault_matches(enum request_phase6_fault fault,
+		struct kcov_request_generation *gen, unsigned int *limit)
+{
+	bool match;
+
+	spin_lock(&request_phase6_fault_lock);
+	match = request_phase6_fault == fault && gen &&
+		request_phase6_fault_owner == gen->owner &&
+		request_phase6_fault_generation == gen->id;
+	if (match && limit)
+		*limit = request_phase6_fault_limit;
+	spin_unlock(&request_phase6_fault_lock);
+	return match;
+}
+
+int kcov_request_generation_merge_scratch(
+		struct kcov_request_generation *gen, const void *scratch,
+		u32 scratch_size, u32 mode, bool overflow,
+		struct kcov_request_merge_result *result)
+{
+	u64 src_entries, src_capacity, dst_entries, dst_capacity;
+	u64 entry_size, count_size, entries;
+	void *aggregate;
+	unsigned int aggregate_size;
+	unsigned int fault_limit;
+	bool copied = false;
+	int ret = 0;
+
+	if (!gen || !scratch || !result)
+		return -EINVAL;
+	memset(result, 0, sizeof(*result));
+	src_capacity = request_area_capacity(scratch_size, mode);
+	if (!src_capacity)
+		return -EINVAL;
+	src_entries = request_area_entries(scratch, mode);
+	if (src_entries > src_capacity) {
+		src_entries = src_capacity;
+		overflow = true;
+	}
+	result->source_entries = src_entries;
+	kcov_request_phase6_add(KCOV_REQUEST_P6_SCRATCH_TRACE_ENTRIES,
+			src_entries);
+	if (overflow) {
+		kcov_request_phase6_note(KCOV_REQUEST_P6_SCRATCH_OVERFLOW);
+		kcov_request_remote_degrade(gen,
+			KCOV_REQUEST_REMOTE_INCOMPLETE,
+			KCOV_REQUEST_REMOTE_ISSUE_SCRATCH_OVERFLOW);
+	}
+
+	mutex_lock(&gen->aggregate_merge_lock);
+	if (atomic_xchg(&gen->aggregate_merging, 1))
+		kcov_request_phase6_note(KCOV_REQUEST_P6_AGGREGATE_MERGE_OVERLAP);
+	spin_lock(&gen->lock);
+	if (!gen->remote_refs) {
+		kcov_request_phase6_note(KCOV_REQUEST_P6_LATE_MERGE_AFTER_REFS_ZERO);
+		ret = -ESTALE;
+		goto unlock_state;
+	}
+	if (gen->remote_result != KCOV_REQUEST_REMOTE_VALID ||
+	    gen->state == KCOV_REQUEST_GEN_ABORTED ||
+	    (gen->aggregate_state != KCOV_REQUEST_AGGREGATE_OPEN &&
+	     gen->aggregate_state != KCOV_REQUEST_AGGREGATE_CLOSING)) {
+		ret = -ECANCELED;
+		goto unlock_state;
+	}
+	if (gen->aggregate_mode != mode || !gen->aggregate_area) {
+		ret = -EINVAL;
+		goto unlock_state;
+	}
+	aggregate = gen->aggregate_area;
+	aggregate_size = gen->aggregate_size;
+	kcov_request_phase6_note(KCOV_REQUEST_P6_AGGREGATE_MERGE_STARTED);
+	spin_unlock(&gen->lock);
+
+	dst_capacity = request_area_capacity(aggregate_size, mode);
+	if (request_phase6_fault_matches(REQUEST_P6_FAULT_AGGREGATE_LIMIT,
+			gen, &fault_limit)) {
+		dst_capacity = min_t(u64, dst_capacity, fault_limit);
+		kcov_request_phase6_note(KCOV_REQUEST_P6_FAULT_AGGREGATE_LIMIT);
+	}
+	dst_entries = request_area_entries(aggregate, mode);
+	if (dst_entries > dst_capacity)
+		dst_entries = dst_capacity;
+	entries = min(src_entries, dst_capacity - dst_entries);
+	count_size = mode == KCOV_MODE_TRACE_PC ? sizeof(unsigned long) :
+			sizeof(u64);
+	entry_size = mode == KCOV_MODE_TRACE_PC ? sizeof(unsigned long) :
+			sizeof(u64) * REQUEST_KCOV_WORDS_PER_CMP;
+	memcpy(aggregate + count_size + dst_entries * entry_size,
+	       scratch + count_size, entries * entry_size);
+	smp_wmb();
+	request_area_set_entries(aggregate, mode, dst_entries + entries);
+	copied = true;
+	result->merged_entries = entries;
+	result->truncated = entries < src_entries;
+
+	spin_lock(&gen->lock);
+	if (gen->remote_result == KCOV_REQUEST_REMOTE_VALID &&
+	    gen->state != KCOV_REQUEST_GEN_ABORTED &&
+	    (gen->aggregate_state == KCOV_REQUEST_AGGREGATE_OPEN ||
+	     gen->aggregate_state == KCOV_REQUEST_AGGREGATE_CLOSING)) {
+		gen->aggregate_entries = dst_entries + entries;
+	}
+unlock_state:
+	spin_unlock(&gen->lock);
+	atomic_set(&gen->aggregate_merging, 0);
+	mutex_unlock(&gen->aggregate_merge_lock);
+
+	if (result->truncated) {
+		kcov_request_phase6_note(KCOV_REQUEST_P6_AGGREGATE_MERGE_TRUNCATED);
+		kcov_request_remote_degrade(gen,
+			KCOV_REQUEST_REMOTE_INCOMPLETE,
+			KCOV_REQUEST_REMOTE_ISSUE_MERGE_TRUNCATED);
+	}
+	if (copied) {
+		kcov_request_phase6_note(KCOV_REQUEST_P6_AGGREGATE_MERGE_COMPLETED);
+		kcov_request_phase6_add(KCOV_REQUEST_P6_AGGREGATE_ENTRIES_MERGED,
+				entries);
+	}
+	if (ret && ret != -ECANCELED)
+		kcov_request_remote_degrade(gen,
+			ret == -ESTALE ? KCOV_REQUEST_REMOTE_INVALID :
+				KCOV_REQUEST_REMOTE_INCOMPLETE,
+			KCOV_REQUEST_REMOTE_ISSUE_MERGE_FAILED);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_merge_scratch);
+
+int kcov_request_generation_publish_begin(
+		struct kcov_request_generation *gen,
+		struct kcov_request_publish_lease *lease)
+{
+	int ret = 0;
+
+	if (!gen || !lease)
+		return -EINVAL;
+	memset(lease, 0, sizeof(*lease));
+	spin_lock(&gen->lock);
+	if (gen->state == KCOV_REQUEST_GEN_ABORTED) {
+		ret = -ENODATA;
+	} else if (gen->remote_result != KCOV_REQUEST_REMOTE_VALID) {
+		ret = -ENODATA;
+	} else if (gen->state != KCOV_REQUEST_GEN_COMMITTED ||
+		   gen->aggregate_state != KCOV_REQUEST_AGGREGATE_COMMITTED ||
+		   gen->outstanding_tokens || gen->remote_refs) {
+		ret = -ESTALE;
+	} else {
+		gen->aggregate_state = KCOV_REQUEST_AGGREGATE_PUBLISHING;
+		gen->publish_readers++;
+		refcount_inc(&gen->object_refs);
+		lease->generation = gen;
+		lease->area = gen->aggregate_area;
+		lease->size = gen->aggregate_size;
+		lease->mode = gen->aggregate_mode;
+		lease->held = true;
+		kcov_request_phase6_note(KCOV_REQUEST_P6_AGGREGATE_PUBLISHING);
+		kcov_request_phase6_note(KCOV_REQUEST_P6_PUBLISHER_READ_LEASE_GET);
+	}
+	if (ret && !gen->publish_suppressed) {
+		gen->publish_suppressed = true;
+		kcov_request_phase6_note(
+			KCOV_REQUEST_P6_AGGREGATE_PUBLISH_SUPPRESSED);
+	}
+	spin_unlock(&gen->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_publish_begin);
+
+void kcov_request_generation_publish_end(
+		struct kcov_request_publish_lease *lease)
+{
+	struct kcov_request_generation *gen;
+	struct request_aggregate_buffer *buffer = NULL;
+
+	if (!lease || !lease->held || !(gen = lease->generation))
+		return;
+	spin_lock(&gen->lock);
+	if (WARN_ON_ONCE(!gen->publish_readers)) {
+		kcov_request_phase6_note(
+			KCOV_REQUEST_P6_AGGREGATE_REUSE_WHILE_READER);
+	} else {
+		gen->publish_readers--;
+		kcov_request_phase6_note(KCOV_REQUEST_P6_PUBLISHER_READ_LEASE_PUT);
+		if (!gen->publish_readers &&
+		    gen->aggregate_state == KCOV_REQUEST_AGGREGATE_PUBLISHING) {
+			buffer = gen->aggregate_buffer;
+			gen->aggregate_buffer = NULL;
+			gen->aggregate_area = NULL;
+			gen->aggregate_size = 0;
+			gen->aggregate_state = KCOV_REQUEST_AGGREGATE_POOL_FREE;
+		}
+	}
+	spin_unlock(&gen->lock);
+	lease->held = false;
+	request_aggregate_free(buffer);
+	kcov_request_generation_put(gen);
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_publish_end);
+
+bool kcov_request_generation_is_terminal(struct kcov_request_generation *gen)
+{
+	bool terminal;
+
+	if (!gen)
+		return true;
+	spin_lock(&gen->lock);
+	terminal = gen->state == KCOV_REQUEST_GEN_ABORTED ||
+		gen->state == KCOV_REQUEST_GEN_COMMITTED ||
+		gen->state == KCOV_REQUEST_GEN_DEAD;
+	spin_unlock(&gen->lock);
+	return terminal;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_is_terminal);
+
+bool kcov_request_generation_is_aborted(struct kcov_request_generation *gen)
+{
+	bool aborted;
+
+	if (!gen)
+		return true;
+	spin_lock(&gen->lock);
+	aborted = gen->state == KCOV_REQUEST_GEN_ABORTED;
+	spin_unlock(&gen->lock);
+	return aborted;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_is_aborted);
+
+static bool request_generation_drained(struct kcov_request_generation *gen)
+{
+	bool drained;
+
+	spin_lock(&gen->lock);
+	drained = gen->state == KCOV_REQUEST_GEN_ABORTED ||
+		(gen->outstanding_tokens == 0 && gen->active_roots == 0 &&
+		 gen->remote_refs == 0);
+	spin_unlock(&gen->lock);
+	return drained;
+}
+
+int kcov_request_generation_bind(u64 owner, u64 generation)
+{
+	struct kcov_request_generation *gen;
+	int ret = 0;
+
+	current->kcov_request_generation_controller = false;
+	if (!owner) {
+		current->kcov_handle_generation = 0;
+		request_stat_inc(REQUEST_GENERATION_BIND_UNBOUND);
+		return -ESTALE;
+	}
+	if (!generation) {
+		current->kcov_handle = owner;
+		current->kcov_handle_generation = 0;
+		request_stat_inc(REQUEST_GENERATION_BIND_UNBOUND);
+		return 0;
+	}
+	gen = request_generation_lookup(owner, generation);
+	if (!gen) {
+		current->kcov_handle_generation = 0;
+		request_stat_inc(REQUEST_GENERATION_BIND_STALE);
+		return -ESTALE;
+	}
+	spin_lock(&gen->lock);
+	if (gen->state != KCOV_REQUEST_GEN_OPEN)
+		ret = -ESTALE;
+	spin_unlock(&gen->lock);
+	if (ret) {
+		current->kcov_handle_generation = 0;
+		request_stat_inc(REQUEST_GENERATION_BIND_STALE);
+	} else {
+		current->kcov_handle = owner;
+		current->kcov_handle_generation = generation;
+		request_stat_inc(REQUEST_GENERATION_BIND_OK);
+	}
+	kcov_request_generation_put(gen);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_bind);
+
+void kcov_request_generation_note_stale_bind(void)
+{
+	current->kcov_handle_generation = 0;
+	request_stat_inc(REQUEST_GENERATION_BIND_STALE);
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_note_stale_bind);
+
+void kcov_request_generation_abort_bound(u64 owner, u64 generation)
+{
+	struct kcov_request_generation *gen;
+
+	if (!owner || !generation)
+		return;
+	gen = request_generation_lookup(owner, generation);
+	if (!gen)
+		return;
+	if (!kcov_request_generation_abort(gen))
+		request_stat_inc(REQUEST_GENERATION_EXIT_ABORT);
+	kcov_request_generation_put(gen);
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_abort_bound);
+
+void kcov_request_generation_note_fd_abort(void)
+{
+	request_stat_inc(REQUEST_GENERATION_ABORT_FD_CURRENT);
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_note_fd_abort);
+
+static void request_token_cancel_locked(struct kcov_request_generation *gen,
+		struct kcov_request_token *token)
+{
+	if (atomic_cmpxchg(&token->completed, REQUEST_TOKEN_ACTIVE,
+			REQUEST_TOKEN_ABORT_CANCELED) != REQUEST_TOKEN_ACTIVE)
+		return;
+	list_del_init(&token->node);
+	gen->outstanding_tokens--;
+	token->abort_canceled = 1;
+	if (token->type == KCOV_REQUEST_TOKEN_ROOT)
+		request_stat_inc(REQUEST_ROOT_TOKEN_CANCELED);
+}
+
+static void request_abort_locked(struct kcov_request_generation *gen)
+{
+	struct kcov_request_root *root;
+	struct kcov_request_token *token, *tmp;
+
+	if (gen->state == KCOV_REQUEST_GEN_ABORTED)
+		return;
+	gen->state = KCOV_REQUEST_GEN_ABORTED;
+	request_aggregate_quarantine_locked(gen);
+	request_stat_inc(REQUEST_GENERATION_ABORTED);
+	list_for_each_entry(root, &gen->roots, node)
+		root->state = KCOV_REQUEST_ROOT_CANCELED;
+	list_for_each_entry_safe(token, tmp, &gen->tokens, node)
+		request_token_cancel_locked(gen, token);
+}
+
+int kcov_request_generation_abort(struct kcov_request_generation *gen)
+{
+	if (!gen)
+		return -ESTALE;
+	spin_lock(&gen->lock);
+	if (gen->state == KCOV_REQUEST_GEN_COMMITTED ||
+	    gen->state == KCOV_REQUEST_GEN_DEAD) {
+		spin_unlock(&gen->lock);
+		return -ESTALE;
+	}
+	request_abort_locked(gen);
+	spin_unlock(&gen->lock);
+	request_aggregate_discard_ready(gen);
+	wake_up_all(&gen->drain_wait);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_abort);
+
+/* Called with gen->lock held; returns embedded-token refs to drop unlocked. */
+static unsigned int request_auto_finish_roots_locked(
+		struct kcov_request_generation *gen)
+{
+	struct kcov_request_root *root, *tmp;
+	unsigned int token_refs = 0;
+
+	list_for_each_entry_safe(root, tmp, &gen->roots, node) {
+		struct kcov_request_token *token;
+
+		if (!root->auto_finish_on_closing ||
+		    atomic_read(&root->finished))
+			continue;
+		/*
+		 * Remove admission/accounting now, but retain the root-holder ref
+		 * until its owner destroys the embedded root.  That ref also pins
+		 * this memory against a concurrent owner teardown.
+		 */
+		list_del_init(&root->node);
+		gen->active_roots--;
+		root->state = KCOV_REQUEST_ROOT_DONE;
+		root->auto_finished = 1;
+		token = &root->root_token;
+		if (atomic_cmpxchg(&token->completed, REQUEST_TOKEN_ACTIVE,
+				   REQUEST_TOKEN_DONE) == REQUEST_TOKEN_ACTIVE) {
+			list_del_init(&token->node);
+			gen->outstanding_tokens--;
+			token->generation = NULL;
+			token_refs++;
+			request_stat_inc(REQUEST_ROOT_TOKEN_COMPLETED);
+			request_stat_inc(REQUEST_TOKEN_COMPLETED);
+		} else {
+			WARN_ON_ONCE(1);
+		}
+	}
+	return token_refs;
+}
+
+int kcov_request_generation_finish(struct kcov_request_generation *gen,
+		u32 timeout_ms)
+{
+	struct kcov_request_root *root;
+	unsigned int auto_token_refs = 0;
+	long left;
+	int ret = 0;
+
+	if (!gen || !timeout_ms || timeout_ms > 5000)
+		return -EINVAL;
+	spin_lock(&gen->lock);
+	if (gen->state == KCOV_REQUEST_GEN_OPEN) {
+		gen->state = KCOV_REQUEST_GEN_CLOSING;
+		if (gen->aggregate_state == KCOV_REQUEST_AGGREGATE_OPEN)
+			gen->aggregate_state = KCOV_REQUEST_AGGREGATE_CLOSING;
+		list_for_each_entry(root, &gen->roots, node)
+			root->retry_deadline = jiffies +
+				msecs_to_jiffies(timeout_ms);
+		auto_token_refs = request_auto_finish_roots_locked(gen);
+		request_stat_inc(REQUEST_GENERATION_CLOSING);
+	} else if (gen->state == KCOV_REQUEST_GEN_COMMITTED) {
+		spin_unlock(&gen->lock);
+		return 0;
+	} else if (gen->state != KCOV_REQUEST_GEN_CLOSING) {
+		spin_unlock(&gen->lock);
+		return -ESTALE;
+	}
+	spin_unlock(&gen->lock);
+	while (auto_token_refs) {
+		auto_token_refs--;
+		kcov_request_generation_put(gen);
+	}
+	wake_up_all(&gen->drain_wait);
+	request_stat_inc(REQUEST_GENERATION_FINISH);
+
+	left = wait_event_interruptible_timeout(gen->drain_wait,
+		request_generation_drained(gen),
+		msecs_to_jiffies(timeout_ms));
+	spin_lock(&gen->lock);
+	if (gen->state == KCOV_REQUEST_GEN_CLOSING &&
+	    !gen->outstanding_tokens && !gen->active_roots &&
+	    !gen->remote_refs) {
+		gen->state = KCOV_REQUEST_GEN_COMMITTED;
+		if (gen->remote_result == KCOV_REQUEST_REMOTE_VALID &&
+		    gen->aggregate_state == KCOV_REQUEST_AGGREGATE_CLOSING) {
+			gen->aggregate_state = KCOV_REQUEST_AGGREGATE_COMMITTED;
+			kcov_request_phase6_note(
+				KCOV_REQUEST_P6_AGGREGATE_COMMITTED);
+		} else {
+			if (gen->outstanding_tokens)
+				kcov_request_phase6_note(
+					KCOV_REQUEST_P6_COMMIT_WITH_TOKENS);
+			if (gen->remote_refs)
+				kcov_request_phase6_note(
+					KCOV_REQUEST_P6_COMMIT_WITH_REFS);
+			if (gen->remote_result != KCOV_REQUEST_REMOTE_VALID)
+				request_aggregate_quarantine_locked(gen);
+			else
+				kcov_request_phase6_note(
+					KCOV_REQUEST_P6_COMMIT_BAD_STATE);
+		}
+		request_stat_inc(REQUEST_GENERATION_COMMITTED);
+	} else if (left <= 0) {
+		request_abort_locked(gen);
+		ret = left < 0 ? (int)left : -ETIMEDOUT;
+	} else if (gen->state == KCOV_REQUEST_GEN_ABORTED) {
+		ret = -ESTALE;
+	}
+	spin_unlock(&gen->lock);
+	request_aggregate_discard_ready(gen);
+	wake_up_all(&gen->drain_wait);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_finish);
+
+static void request_token_init_locked(struct kcov_request_generation *gen,
+		struct kcov_request_token *token,
+		enum kcov_request_token_type type)
+{
+	memset(token, 0, sizeof(*token));
+	token->generation = gen;
+	token->type = type;
+	atomic_set(&token->completed, REQUEST_TOKEN_ACTIVE);
+	INIT_LIST_HEAD(&token->node);
+	list_add_tail(&token->node, &gen->tokens);
+	gen->outstanding_tokens++;
+	refcount_inc(&gen->object_refs);
+	request_stat_inc(REQUEST_TOKEN_CREATED);
+}
+
+static bool __kcov_request_root_init(struct kcov_request_root *root,
+		struct kcov_common_handle_id owner, u64 request_cookie,
+		bool auto_finish)
+{
+	struct kcov_request_generation *gen;
+	bool ok = false;
+
+	memset(root, 0, sizeof(*root));
+	INIT_LIST_HEAD(&root->node);
+	atomic_set(&root->finished, 0);
+	if (!owner.val || !owner.generation || !request_cookie)
+		return false;
+	gen = request_generation_lookup(owner.val, owner.generation);
+	if (!gen) {
+		request_stat_inc(REQUEST_GENERATION_LOOKUP_MISS);
+		return false;
+	}
+	spin_lock(&gen->lock);
+	if (gen->state == KCOV_REQUEST_GEN_OPEN) {
+		root->generation = gen;
+		root->owner = owner;
+		root->request_cookie = request_cookie;
+		root->retry_deadline = jiffies + msecs_to_jiffies(5000);
+		root->state = KCOV_REQUEST_ROOT_ACTIVE;
+		root->auto_finish_on_closing = auto_finish;
+		list_add_tail(&root->node, &gen->roots);
+		gen->active_roots++;
+		request_token_init_locked(gen, &root->root_token,
+				KCOV_REQUEST_TOKEN_ROOT);
+		request_stat_inc(REQUEST_ROOT_TOKEN_CREATED);
+		ok = true;
+	} else if (gen->state == KCOV_REQUEST_GEN_CLOSING) {
+		request_stat_inc(REQUEST_NEW_ROOT_REJECTED_CLOSING);
+	} else {
+		request_stat_inc(REQUEST_NEW_ROOT_REJECTED_ABORTED);
+		request_stat_inc(REQUEST_WORK_OWNER_NONE_AFTER_ABORT);
+	}
+	spin_unlock(&gen->lock);
+	if (!ok)
+		kcov_request_generation_put(gen);
+	return ok;
+}
+
+bool kcov_request_root_init(struct kcov_request_root *root,
+		struct kcov_common_handle_id owner, u64 request_cookie)
+{
+	return __kcov_request_root_init(root, owner, request_cookie, false);
+}
+EXPORT_SYMBOL_GPL(kcov_request_root_init);
+
+bool kcov_request_root_init_auto_finish(struct kcov_request_root *root,
+		struct kcov_common_handle_id owner, u64 request_cookie)
+{
+	return __kcov_request_root_init(root, owner, request_cookie, true);
+}
+EXPORT_SYMBOL_GPL(kcov_request_root_init_auto_finish);
+
+bool kcov_request_root_attributable(const struct kcov_request_root *root)
+{
+	struct kcov_request_generation *gen = root->generation;
+	bool ret;
+
+	/* rpc_task serializes xprt transmit against rpc_release_task(). */
+	if (!gen || atomic_read(&root->finished))
+		return false;
+	spin_lock(&gen->lock);
+	ret = root->state == KCOV_REQUEST_ROOT_ACTIVE &&
+		(gen->state == KCOV_REQUEST_GEN_OPEN ||
+		 (gen->state == KCOV_REQUEST_GEN_CLOSING &&
+		  !time_after(jiffies, root->retry_deadline)));
+	spin_unlock(&gen->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(kcov_request_root_attributable);
+
+struct kcov_request_generation *kcov_request_remote_admit(
+		u64 request_cookie, struct kcov_common_handle_id owner,
+		struct kcov_request_token *token)
+{
+	struct kcov_request_generation *gen;
+	kcov_request_phase5_note(KCOV_REQUEST_P5_GRANT_ATTEMPT);
+	if (!request_cookie || !owner.val || !owner.generation || !token ||
+	    !(gen = token->generation)) {
+		kcov_request_phase5_note(KCOV_REQUEST_P5_OWNER_MAPPING_MISS);
+		return ERR_PTR(-ESTALE);
+	}
+
+	spin_lock(&gen->lock);
+	if (gen->owner != owner.val || gen->id != owner.generation) {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_GRANT_REJECTED_GENERATION);
+		goto mapping_miss;
+	}
+
+	if (token->request_cookie != request_cookie ||
+	    token->owner.val != owner.val ||
+	    token->owner.generation != owner.generation) {
+		kcov_request_phase5_note(KCOV_REQUEST_P5_GRANT_REJECTED_TOKEN);
+		goto mapping_miss;
+	}
+
+	/*
+	 * Identity correlation succeeded independently of whether this exact
+	 * generation is still eligible to admit new remote work.  In
+	 * particular, an INCOMPLETE/INVALID generation may have quarantined its
+	 * aggregate while later records from the same owner are still draining.
+	 * Such a policy rejection is not an owner mapping mismatch.
+	 */
+	kcov_request_phase5_note(KCOV_REQUEST_P5_OWNER_MAPPING_EXACT);
+	if ((gen->state != KCOV_REQUEST_GEN_OPEN &&
+	     gen->state != KCOV_REQUEST_GEN_CLOSING) ||
+	    !gen->aggregate_area ||
+	    (gen->aggregate_state != KCOV_REQUEST_AGGREGATE_OPEN &&
+	     gen->aggregate_state != KCOV_REQUEST_AGGREGATE_CLOSING)) {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_GRANT_REJECTED_GENERATION);
+		goto policy_reject;
+	}
+	if (atomic_read(&token->completed) != REQUEST_TOKEN_ACTIVE ||
+	    token->remote_claimed) {
+		kcov_request_phase5_note(KCOV_REQUEST_P5_GRANT_REJECTED_TOKEN);
+		goto policy_reject;
+	}
+	if (atomic_cmpxchg(&token->completed, REQUEST_TOKEN_ACTIVE,
+			REQUEST_TOKEN_START_GRANTED) != REQUEST_TOKEN_ACTIVE) {
+		kcov_request_phase5_note(KCOV_REQUEST_P5_GRANT_REJECTED_TOKEN);
+		goto policy_reject;
+	}
+
+	token->remote_claimed = 1;
+	gen->remote_refs++;
+	refcount_inc(&gen->object_refs);
+	spin_unlock(&gen->lock);
+	kcov_request_phase5_note(KCOV_REQUEST_P5_REMOTE_REF_GET);
+	return gen;
+mapping_miss:
+	spin_unlock(&gen->lock);
+	kcov_request_phase5_note(KCOV_REQUEST_P5_OWNER_MAPPING_MISS);
+	return ERR_PTR(-ESTALE);
+policy_reject:
+	spin_unlock(&gen->lock);
+	return ERR_PTR(-ESTALE);
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_admit);
+
+void kcov_request_remote_ref_put(struct kcov_request_generation *gen)
+{
+	bool held = false, wake = false;
+	struct request_aggregate_buffer *discard = NULL;
+
+	if (!gen)
+		return;
+	spin_lock(&gen->lock);
+	if (WARN_ON_ONCE(!gen->remote_refs)) {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_GRANT_ORDER_VIOLATION);
+	} else {
+		gen->remote_refs--;
+		held = true;
+		wake = gen->remote_refs == 0;
+		if (wake)
+			discard = request_aggregate_discard_locked(gen);
+	}
+	spin_unlock(&gen->lock);
+	if (!held)
+		return;
+	kcov_request_phase5_note(KCOV_REQUEST_P5_REMOTE_REF_PUT);
+	if (wake)
+		wake_up_all(&gen->drain_wait);
+	request_aggregate_free(discard);
+	kcov_request_generation_put(gen);
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_ref_put);
+
+void kcov_request_remote_degrade(struct kcov_request_generation *gen,
+		enum kcov_request_remote_result result, unsigned int issue)
+{
+	bool changed = false;
+	struct request_aggregate_buffer *discard;
+
+	if (!gen)
+		return;
+	spin_lock(&gen->lock);
+	if (result > gen->remote_result) {
+		gen->remote_result = result;
+		changed = true;
+	}
+	if (changed && issue != KCOV_REQUEST_REMOTE_ISSUE_START_FAILED &&
+	    !gen->remote_refs &&
+	    (gen->state == KCOV_REQUEST_GEN_OPEN ||
+	     gen->state == KCOV_REQUEST_GEN_CLOSING))
+		kcov_request_phase6_note(
+			KCOV_REQUEST_P6_RESULT_DEGRADE_AFTER_REF_RELEASE);
+	gen->remote_issues |= issue;
+	if (gen->remote_result != KCOV_REQUEST_REMOTE_VALID)
+		request_aggregate_quarantine_locked(gen);
+	discard = request_aggregate_discard_locked(gen);
+	spin_unlock(&gen->lock);
+	request_aggregate_free(discard);
+	if (!changed)
+		return;
+	if (result == KCOV_REQUEST_REMOTE_INCOMPLETE)
+		kcov_request_phase5_note(KCOV_REQUEST_P5_RESULT_INCOMPLETE);
+	else if (result == KCOV_REQUEST_REMOTE_INVALID)
+		kcov_request_phase5_note(KCOV_REQUEST_P5_RESULT_INVALID);
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_degrade);
+
+void kcov_request_remote_nested(struct kcov_request_generation *attempted,
+		struct kcov_request_generation *incumbent)
+{
+	if (attempted) {
+		kcov_request_remote_degrade(attempted,
+			KCOV_REQUEST_REMOTE_INVALID,
+			KCOV_REQUEST_REMOTE_ISSUE_NESTED);
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_NESTED_ATTEMPTED_INVALID);
+	}
+	if (incumbent) {
+		kcov_request_remote_degrade(incumbent,
+			KCOV_REQUEST_REMOTE_INVALID,
+			KCOV_REQUEST_REMOTE_ISSUE_NESTED);
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_NESTED_INCUMBENT_INVALID);
+		kcov_request_phase5_note(attempted == incumbent ?
+			KCOV_REQUEST_P5_NESTED_SAME_GENERATION :
+			KCOV_REQUEST_P5_NESTED_CROSS_GENERATION);
+	} else {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_NESTED_INCUMBENT_UNKNOWN);
+	}
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_nested);
+
+void kcov_request_remote_mark_lane_unhealthy(void)
+{
+	WRITE_ONCE(request_phase5_lane_unhealthy, true);
+	kcov_request_phase5_note(KCOV_REQUEST_P5_LANE_UNHEALTHY);
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_mark_lane_unhealthy);
+
+bool kcov_request_remote_was_aborted(struct kcov_request_generation *gen)
+{
+	bool aborted;
+
+	if (!gen)
+		return true;
+	spin_lock(&gen->lock);
+	aborted = gen->state == KCOV_REQUEST_GEN_ABORTED;
+	spin_unlock(&gen->lock);
+	return aborted;
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_was_aborted);
+
+bool kcov_request_remote_result_is_invalid(
+		struct kcov_request_generation *gen)
+{
+	bool invalid;
+
+	if (!gen)
+		return true;
+	spin_lock(&gen->lock);
+	invalid = gen->remote_result == KCOV_REQUEST_REMOTE_INVALID;
+	spin_unlock(&gen->lock);
+	return invalid;
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_result_is_invalid);
+
+enum kcov_request_phase5_fault kcov_request_phase5_before_start(
+		struct kcov_request_generation *attempted)
+{
+	struct kcov_request_generation *incumbent = NULL;
+	enum kcov_request_phase5_fault fault = KCOV_REQUEST_P5_FAULT_NONE;
+	u64 inc_owner = 0, inc_generation = 0;
+	bool pause = false;
+
+	if (!attempted)
+		return fault;
+	spin_lock(&request_phase5_fault_lock);
+	if (request_phase5_pause_armed &&
+	    request_phase5_fault_owner == attempted->owner &&
+	    request_phase5_fault_generation == attempted->id) {
+		pause = true;
+		request_phase5_pause_armed = false;
+	}
+	if (request_phase5_fault != KCOV_REQUEST_P5_FAULT_NONE &&
+	    request_phase5_fault_owner == attempted->owner &&
+	    request_phase5_fault_generation == attempted->id) {
+		fault = request_phase5_fault;
+		inc_owner = request_phase5_incumbent_owner;
+		inc_generation = request_phase5_incumbent_generation;
+		if (fault != KCOV_REQUEST_P5_FAULT_NESTED_CROSS)
+			request_phase5_fault = KCOV_REQUEST_P5_FAULT_NONE;
+	}
+	spin_unlock(&request_phase5_fault_lock);
+
+	if (pause) {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_PAUSE_AFTER_GRANT_ENTERED);
+		wait_event(request_phase5_pause_wait,
+			READ_ONCE(request_phase5_pause_released));
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_PAUSE_AFTER_GRANT_RELEASED);
+	}
+	if (fault == KCOV_REQUEST_P5_FAULT_NESTED_CROSS) {
+		if (!wait_event_timeout(request_phase5_nested_wait,
+				READ_ONCE(request_phase5_cross_incumbent_active) ||
+				READ_ONCE(request_phase5_cross_canceled),
+				msecs_to_jiffies(5000))) {
+			kcov_request_phase5_note(
+				KCOV_REQUEST_P5_NESTED_WITHOUT_ACTIVE_INCUMBENT);
+			spin_lock(&request_phase5_fault_lock);
+			request_phase5_fault = KCOV_REQUEST_P5_FAULT_NONE;
+			WRITE_ONCE(request_phase5_cross_incumbent_active, false);
+			WRITE_ONCE(request_phase5_cross_attempted_seen, false);
+			WRITE_ONCE(request_phase5_cross_canceled, true);
+			spin_unlock(&request_phase5_fault_lock);
+			wake_up_all(&request_phase5_nested_wait);
+			return KCOV_REQUEST_P5_FAULT_NONE;
+		}
+		if (READ_ONCE(request_phase5_cross_canceled))
+			return KCOV_REQUEST_P5_FAULT_NONE;
+		incumbent = request_generation_lookup(inc_owner, inc_generation);
+		if (!incumbent) {
+			kcov_request_phase5_note(
+				KCOV_REQUEST_P5_NESTED_WITHOUT_ACTIVE_INCUMBENT);
+			spin_lock(&request_phase5_fault_lock);
+			request_phase5_fault = KCOV_REQUEST_P5_FAULT_NONE;
+			WRITE_ONCE(request_phase5_cross_incumbent_active, false);
+			WRITE_ONCE(request_phase5_cross_attempted_seen, false);
+			WRITE_ONCE(request_phase5_cross_canceled, true);
+			spin_unlock(&request_phase5_fault_lock);
+			wake_up_all(&request_phase5_nested_wait);
+			return KCOV_REQUEST_P5_FAULT_NONE;
+		}
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_NESTED_INCUMBENT_ACTIVE_MATCH);
+		kcov_request_remote_nested(attempted, incumbent);
+		kcov_request_generation_put(incumbent);
+		spin_lock(&request_phase5_fault_lock);
+		request_phase5_fault = KCOV_REQUEST_P5_FAULT_NONE;
+		WRITE_ONCE(request_phase5_cross_attempted_seen, true);
+		spin_unlock(&request_phase5_fault_lock);
+		wake_up_all(&request_phase5_nested_wait);
+	}
+	return fault;
+}
+EXPORT_SYMBOL_GPL(kcov_request_phase5_before_start);
+
+void kcov_request_phase5_after_start(struct kcov_request_generation *gen)
+{
+	bool incumbent = false;
+
+	if (!gen)
+		return;
+	spin_lock(&request_phase5_fault_lock);
+	if (request_phase5_fault == KCOV_REQUEST_P5_FAULT_NESTED_CROSS &&
+	    request_phase5_incumbent_owner == gen->owner &&
+	    request_phase5_incumbent_generation == gen->id) {
+		WRITE_ONCE(request_phase5_cross_incumbent_active, true);
+		incumbent = true;
+	}
+	spin_unlock(&request_phase5_fault_lock);
+	if (!incumbent)
+		return;
+	wake_up_all(&request_phase5_nested_wait);
+	if (!wait_event_timeout(request_phase5_nested_wait,
+			READ_ONCE(request_phase5_cross_attempted_seen) ||
+			READ_ONCE(request_phase5_cross_canceled),
+			msecs_to_jiffies(5000))) {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_NESTED_WITHOUT_ACTIVE_INCUMBENT);
+		spin_lock(&request_phase5_fault_lock);
+		request_phase5_fault = KCOV_REQUEST_P5_FAULT_NONE;
+		spin_unlock(&request_phase5_fault_lock);
+	}
+	spin_lock(&request_phase5_fault_lock);
+	WRITE_ONCE(request_phase5_cross_incumbent_active, false);
+	WRITE_ONCE(request_phase5_cross_attempted_seen, false);
+	WRITE_ONCE(request_phase5_cross_canceled, true);
+	spin_unlock(&request_phase5_fault_lock);
+}

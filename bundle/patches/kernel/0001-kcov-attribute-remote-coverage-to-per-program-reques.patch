+		owner = kcov->request_common_handle;
+		generation_mode = kcov->mode;
+		generation_size = kcov->size;
+		/* The prior terminal window is no longer controlled by this task. */
+		current->kcov_request_generation_controller = false;
+		spin_unlock_irqrestore(&kcov->lock, flags);
+		kcov_request_generation_put(old);
+
+		gen = kcov_request_generation_begin(owner, &arg.generation);
+		if (IS_ERR(gen)) {

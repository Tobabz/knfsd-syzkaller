+		spin_unlock_irqrestore(&kcov->lock, flags);
+		if (cmd == KCOV_REMOTE_GENERATION_BIND)
+			current->kcov_handle_generation = 0;
+		return -EINVAL;
+	}
+	if (cmd == KCOV_REMOTE_GENERATION_BIND && !arg.generation) {
+		spin_unlock_irqrestore(&kcov->lock, flags);

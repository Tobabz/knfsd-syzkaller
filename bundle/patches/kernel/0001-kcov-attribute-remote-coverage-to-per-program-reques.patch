+	if (!count || copy_from_user(command, ubuf, len))
+		return count ? -EFAULT : -EINVAL;
+	command[len] = '\0';
+	if (sysfs_streq(command, "reset")) {
+		request_phase6_reset();
+		return count;
+	}
+	if (sysfs_streq(command, "selftest")) {
+		kcov_request_phase6_note(KCOV_REQUEST_P6_SELFTEST_RUNS);
+		if (!kcov_request_phase6_selftest()) {
+			kcov_request_phase6_note(KCOV_REQUEST_P6_SELFTEST_FAILURES);
+			return -EIO;
+		}
+		return count;
+	}
+	if (sysfs_streq(command, "fault-release hold-after-grant") ||
+	    sysfs_streq(command, "fault-release pause-publish")) {
+		WRITE_ONCE(request_phase6_fault_released, true);
+		wake_up_all(&request_phase6_fault_wait);
+		return count;
+	}
+	if (sscanf(command, "probe-reuse %llu %llu", &owner,
+		   &generation) == 2) {
+		gen = request_generation_lookup(owner, generation);
+		if (!gen)
+			return -ESTALE;
+		spin_lock(&gen->lock);
+		if (gen->publish_readers) {
+			blocked = true;
+			kcov_request_phase6_note(
+				KCOV_REQUEST_P6_AGGREGATE_REUSE_BLOCKED_READER);
+		}
+		spin_unlock(&gen->lock);
+		kcov_request_generation_put(gen);
+		return blocked ? count : -EAGAIN;
+	}
+	if (sscanf(command,
+		   "fault-arm hold-after-grant %llu %llu %u",
+		   &owner, &generation, &value) == 3)
+		fault = REQUEST_P6_FAULT_HOLD_AFTER_GRANT;
+	else if (sscanf(command, "fault-arm scratch-limit %llu %llu %u",
+			&owner, &generation, &value) == 3)
+		fault = REQUEST_P6_FAULT_SCRATCH_LIMIT;
+	else if (sscanf(command,
+			"fault-arm aggregate-limit %llu %llu %u",
+			&owner, &generation, &value) == 3)
+		fault = REQUEST_P6_FAULT_AGGREGATE_LIMIT;
+	else if (sscanf(command, "fault-arm pause-publish %llu %llu",
+			&owner, &generation) == 2)
+		fault = REQUEST_P6_FAULT_PAUSE_PUBLISH;
+	else
+		return -EINVAL;
+	if (!owner || !generation ||
+	    (fault == REQUEST_P6_FAULT_HOLD_AFTER_GRANT && !value))
+		return -EINVAL;
+	spin_lock(&request_phase6_fault_lock);
+	request_phase6_fault = fault;
+	request_phase6_fault_owner = owner;
+	request_phase6_fault_generation = generation;
+	request_phase6_fault_limit = value;
+	request_phase6_fault_count = value;
+	WRITE_ONCE(request_phase6_fault_released, false);
+	spin_unlock(&request_phase6_fault_lock);
+	return count;
+}
+
+static const struct file_operations request_phase6_control_fops = {
+	.owner = THIS_MODULE,
+	.write = request_phase6_control_write,
+	.llseek = noop_llseek,
+};
+
+void kcov_request_debugfs_init(struct dentry *root)
+{
+	if (!root)
+		return;
+	debugfs_create_file("phase4_stats", 0400, root, NULL,
+			&request_stats_fops);
+	debugfs_create_file("phase4_state", 0400, root, NULL,
+			&request_state_fops);
+	debugfs_create_file("phase4_control", 0200, root, NULL,
+			&request_control_fops);
+	debugfs_create_file("phase5_stats", 0400, root, NULL,
+			&request_phase5_stats_fops);
+	debugfs_create_file("phase5_control", 0200, root, NULL,
+			&request_phase5_control_fops);
+	debugfs_create_file("phase6_stats", 0400, root, NULL,
+			&request_phase6_stats_fops);
+	debugfs_create_file("phase6_state", 0400, root, NULL,
+			&request_phase6_state_fops);
+	debugfs_create_file("phase6_control", 0200, root, NULL,
+			&request_phase6_control_fops);
+}
+EXPORT_SYMBOL_GPL(kcov_request_debugfs_init);
+
+void kcov_request_debugfs_exit(void)
+{
+}
+EXPORT_SYMBOL_GPL(kcov_request_debugfs_exit);

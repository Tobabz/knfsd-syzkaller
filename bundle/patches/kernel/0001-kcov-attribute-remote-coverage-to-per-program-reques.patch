+static void request_phase5_reset(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < KCOV_REQUEST_P5_STAT_COUNT; i++)
+		atomic64_set(&request_phase5_stats[i], 0);
+	spin_lock(&request_phase5_fault_lock);
+	request_phase5_fault = KCOV_REQUEST_P5_FAULT_NONE;
+	request_phase5_fault_owner = 0;
+	request_phase5_fault_generation = 0;
+	request_phase5_incumbent_owner = 0;
+	request_phase5_incumbent_generation = 0;
+	request_phase5_pause_armed = false;
+	WRITE_ONCE(request_phase5_pause_released, false);
+	WRITE_ONCE(request_phase5_cross_incumbent_active, false);
+	WRITE_ONCE(request_phase5_cross_attempted_seen, false);
+	WRITE_ONCE(request_phase5_cross_canceled, true);
+	spin_unlock(&request_phase5_fault_lock);
+	WRITE_ONCE(request_phase5_lane_unhealthy, false);
+	wake_up_all(&request_phase5_pause_wait);
+	wake_up_all(&request_phase5_nested_wait);
+}
+
+static ssize_t request_phase5_control_write(struct file *file,
+		const char __user *ubuf, size_t count, loff_t *ppos)
+{
+	char command[160];
+	u64 owner = 0, generation = 0, inc_owner = 0, inc_generation = 0;
+	enum kcov_request_phase5_fault fault = KCOV_REQUEST_P5_FAULT_NONE;
+	size_t len = min(count, sizeof(command) - 1);
+
+	if (!count || copy_from_user(command, ubuf, len))
+		return count ? -EFAULT : -EINVAL;
+	command[len] = '\0';
+	if (sysfs_streq(command, "reset")) {
+		request_phase5_reset();
+		return count;
+	}
+	if (sysfs_streq(command, "selftest")) {
+		bool (*transport_test)(void);
+
+		kcov_request_phase5_note(KCOV_REQUEST_P5_SELFTEST_RUNS);
+		transport_test = READ_ONCE(request_phase5_transport_selftest);
+		if (!kcov_request_phase5_selftest() ||
+		    (transport_test && !transport_test())) {
+			kcov_request_phase5_note(KCOV_REQUEST_P5_SELFTEST_FAILURES);
+			return -EIO;
+		}
+		return count;
+	}
+	if (sysfs_streq(command, "fault-release pause-after-grant")) {
+		WRITE_ONCE(request_phase5_pause_released, true);
+		wake_up_all(&request_phase5_pause_wait);
+		return count;
+	}
+	if (sscanf(command, "fault-arm start-fail %llu %llu", &owner,
+		   &generation) == 2)
+		fault = KCOV_REQUEST_P5_FAULT_START_FAIL;
+	else if (sscanf(command, "fault-arm nested-same %llu %llu", &owner,
+			&generation) == 2)
+		fault = KCOV_REQUEST_P5_FAULT_NESTED_SAME;
+	else if (sscanf(command, "fault-arm pause-after-grant %llu %llu",
+			&owner, &generation) == 2) {
+		spin_lock(&request_phase5_fault_lock);
+		request_phase5_fault_owner = owner;
+		request_phase5_fault_generation = generation;
+		WRITE_ONCE(request_phase5_pause_released, false);
+		request_phase5_pause_armed = true;
+		spin_unlock(&request_phase5_fault_lock);
+		return count;
+	} else if (sscanf(command,
+			"fault-arm nested-cross %llu %llu %llu %llu",
+			&inc_owner, &inc_generation, &owner, &generation) == 4)
+		fault = KCOV_REQUEST_P5_FAULT_NESTED_CROSS;
+	else
+		return -EINVAL;
+	if (!owner || !generation ||
+	    (fault == KCOV_REQUEST_P5_FAULT_NESTED_CROSS &&
+	     (!inc_owner || !inc_generation)))
+		return -EINVAL;
+	spin_lock(&request_phase5_fault_lock);
+	request_phase5_fault = fault;
+	request_phase5_fault_owner = owner;
+	request_phase5_fault_generation = generation;
+	request_phase5_incumbent_owner = inc_owner;
+	request_phase5_incumbent_generation = inc_generation;
+	WRITE_ONCE(request_phase5_cross_incumbent_active, false);
+	WRITE_ONCE(request_phase5_cross_attempted_seen, false);
+	WRITE_ONCE(request_phase5_cross_canceled, false);
+	spin_unlock(&request_phase5_fault_lock);
+	return count;
+}
+
+static const struct file_operations request_phase5_control_fops = {
+	.owner = THIS_MODULE,
+	.write = request_phase5_control_write,
+	.llseek = noop_llseek,
+};

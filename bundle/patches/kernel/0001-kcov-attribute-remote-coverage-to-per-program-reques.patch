+void kcov_request_phase6_note(enum kcov_request_phase6_stat stat)
+{
+	int in_use, peak;
+
+	if (stat >= KCOV_REQUEST_P6_STAT_COUNT)
+		return;
+	atomic64_inc(&request_phase6_stats[stat]);
+	if (stat == KCOV_REQUEST_P6_REMOTE_SECTION_CREATED)
+		atomic_inc(&request_phase6_live_sections);
+	else if (stat == KCOV_REQUEST_P6_REMOTE_SECTION_COMPLETED ||
+		 stat == KCOV_REQUEST_P6_REMOTE_SECTION_DISCARDED)
+		atomic_dec(&request_phase6_live_sections);
+	else if (stat == KCOV_REQUEST_P6_SCRATCH_RESERVED) {
+		in_use = atomic_inc_return(&request_phase6_live_scratch);
+		do {
+			peak = atomic_read(&request_phase6_scratch_peak);
+			if (peak >= in_use)
+				break;
+		} while (atomic_cmpxchg(&request_phase6_scratch_peak,
+				peak, in_use) != peak);
+	} else if (stat == KCOV_REQUEST_P6_SCRATCH_RETURNED) {
+		if (WARN_ON_ONCE(atomic_dec_return(
+				&request_phase6_live_scratch) < 0))
+			atomic_set(&request_phase6_live_scratch, 0);
+	}
+}
+EXPORT_SYMBOL_GPL(kcov_request_phase6_note);

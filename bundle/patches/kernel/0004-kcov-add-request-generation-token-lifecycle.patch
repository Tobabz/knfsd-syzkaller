-		const struct sunrpc_fuzz_logical_rpc *logical);
+		struct sunrpc_fuzz_logical_rpc *logical);
 void sunrpc_fuzz_rqst_reset(struct sunrpc_fuzz_rqst *rqst,
 		enum sunrpc_fuzz_rqst_reset_reason reason);
 
@@ -115,6 +120,9 @@ void sunrpc_fuzz_svc_tx_result(struct svc_xprt *xprt,
 		unsigned int sent, bool terminal_failure);
 void sunrpc_fuzz_wire_tx_complete(
 		struct sunrpc_fuzz_wire_reservation *reservation);
+bool sunrpc_fuzz_wire_token_acquire(
+		struct sunrpc_fuzz_wire_reservation *reservation,
+		struct sunrpc_fuzz_rqst *rqst);
 void sunrpc_fuzz_rpc_prepare_send(struct rpc_xprt *xprt);
 void sunrpc_fuzz_svc_prepare_send(struct svc_xprt *xprt, struct sock *sk,
 		struct sunrpc_fuzz_wire_reservation *reservation);

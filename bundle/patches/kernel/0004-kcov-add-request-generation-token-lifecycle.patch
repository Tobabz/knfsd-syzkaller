diff --git a/kernel/kcov.c b/kernel/kcov.c
index 35420f0ac..fd155ddf8 100644
--- a/kernel/kcov.c
+++ b/kernel/kcov.c
@@ -71,6 +71,10 @@ struct kcov {
 	 * kcov_remote_stop(), see the comment there.
 	 */
 	int			sequence;
+	struct kcov_request_generation *request_generation;
+	u64			request_common_handle;
+	bool			request_generation_closed;
+	bool			request_generation_busy;
 };
 
 struct kcov_remote_area {
@@ -386,6 +390,10 @@ void kcov_task_init(struct task_struct *t)
 	kcov_task_reset(t);
 	t->kcov_remote = NULL;
 	t->kcov_handle = current->kcov_handle;
+	/* Forked per-program work inherits; persistent workers explicitly BIND. */
+	t->kcov_handle_generation = current->kcov_handle_generation;
+	/* Generation binding inherits, whole-generation ABORT authority does not. */
+	t->kcov_request_generation_controller = false;
 	t->kcov_softirq = 0;
 	t->kcov_saved_mode = 0;
 	t->kcov_saved_size = 0;
@@ -397,6 +405,14 @@ void kcov_task_init(struct task_struct *t)
 static void kcov_reset(struct kcov *kcov)
 	__must_hold(&kcov->lock)
 {
+	if (kcov->request_generation) {
+		kcov_request_generation_abort(kcov->request_generation);
+		kcov_request_generation_put(kcov->request_generation);
+		kcov->request_generation = NULL;
+	}
+	kcov->request_common_handle = 0;
+	kcov->request_generation_closed = true;
+	kcov->request_generation_busy = false;
 	kcov->t = NULL;
 	kcov->mode = KCOV_MODE_INIT;
 	kcov->remote = false;
@@ -429,6 +445,8 @@ static void kcov_disable(struct task_struct *t, struct kcov *kcov)
 {
 	if (kcov->remote) {
 		t->kcov_handle = 0;
+		t->kcov_handle_generation = 0;
+		t->kcov_request_generation_controller = false;
 		t->kcov_remote = NULL;
 		kcov_remote_reset(kcov);
 	} else {
@@ -459,6 +477,18 @@ void kcov_task_exit(struct task_struct *t)
 	struct kcov *kcov;
 	unsigned long flags;
 
+	/*
+	 * A BEGIN controller may die before userspace can FINISH/ABORT the exact
+	 * id.  Retire attribution by its immutable {handle,generation}; ordinary
+	 * inherited/BIND workers never own whole-generation abort authority.
+	 */
+	if (t->kcov_request_generation_controller && t->kcov_handle &&
+	    t->kcov_handle_generation)
+		kcov_request_generation_abort_bound(t->kcov_handle,
+				t->kcov_handle_generation);
+	t->kcov_request_generation_controller = false;
+	t->kcov_handle_generation = 0;
+
 	kcov = t->kcov;
 	if (kcov) {
 		spin_lock_irqsave(&kcov->lock, flags);
@@ -702,6 +732,9 @@ static int kcov_ioctl_locked(struct kcov *kcov, unsigned int cmd,
 				return PTR_ERR(remote);
 			}
 			t->kcov_handle = remote_arg->common_handle;
+			t->kcov_handle_generation = 0;
+			kcov->request_common_handle = remote_arg->common_handle;
+			kcov->request_generation_closed = true;
 		}
 		spin_unlock_irqrestore(&kcov_remote_lock, flags);
 		/* Put either in kcov_task_exit() or in KCOV_DISABLE. */
@@ -712,6 +745,183 @@ static int kcov_ioctl_locked(struct kcov *kcov, unsigned int cmd,
 	}
 }
 
+static long kcov_request_generation_ioctl(struct kcov *kcov,
+		unsigned int cmd, void __user *uarg)
+{
+	struct kcov_remote_generation arg;
+	struct kcov_request_generation *gen = NULL, *old = NULL;
+	unsigned long flags;
+	u64 owner;
+	int ret;
+
+	/* BIND workers never own whole-generation exit-time ABORT authority. */
+	if (cmd == KCOV_REMOTE_GENERATION_BIND)
+		current->kcov_request_generation_controller = false;
+
+	if (copy_from_user(&arg, uarg, sizeof(arg))) {
+		/* BIND failures must never leave an earlier window attached. */
+		if (cmd == KCOV_REMOTE_GENERATION_BIND)
+			current->kcov_handle_generation = 0;
+		return -EFAULT;
+	}
+	if (arg.flags) {
+		if (cmd == KCOV_REMOTE_GENERATION_BIND)
+			current->kcov_handle_generation = 0;
+		return -EINVAL;
+	}
+
+	if (cmd == KCOV_REMOTE_GENERATION_BEGIN) {
+		if (arg.generation || arg.timeout_ms)
+			return -EINVAL;
+		spin_lock_irqsave(&kcov->lock, flags);
+		if (!kcov->remote || !kcov->request_common_handle ||
+		    kcov->request_generation_busy ||
+		    (kcov->request_generation &&
+		     !kcov->request_generation_closed &&
+		     !kcov_request_generation_is_terminal(
+			     kcov->request_generation))) {
+			spin_unlock_irqrestore(&kcov->lock, flags);
+			return -EBUSY;
+		}
+		old = kcov->request_generation;
+		kcov->request_generation = NULL;
+		kcov->request_generation_busy = true;
+		owner = kcov->request_common_handle;
+		/* The prior terminal window is no longer controlled by this task. */
+		current->kcov_request_generation_controller = false;
+		spin_unlock_irqrestore(&kcov->lock, flags);
+		kcov_request_generation_put(old);
+
+		gen = kcov_request_generation_begin(owner, &arg.generation);
+		if (IS_ERR(gen)) {
+			ret = PTR_ERR(gen);
+			gen = NULL;
+			goto begin_done;
+		}
+		ret = kcov_request_generation_bind(owner, arg.generation);
+		if (ret)
+			goto begin_done;
+		if (copy_to_user(uarg, &arg, sizeof(arg)))
+			ret = -EFAULT;
+begin_done:
+		spin_lock_irqsave(&kcov->lock, flags);
+		kcov->request_generation_busy = false;
+		if (!ret && kcov->remote &&
+		    kcov->request_common_handle == owner) {
+			kcov->request_generation = gen;
+			kcov->request_generation_closed = false;
+			current->kcov_request_generation_controller = true;
+			gen = NULL;
+		} else {
+			current->kcov_handle_generation = 0;
+		}
+		spin_unlock_irqrestore(&kcov->lock, flags);
+		if (gen) {
+			kcov_request_generation_abort(gen);
+			kcov_request_generation_put(gen);
+		}
+		if (!ret)
+			kcov_request_generation_test_begin_gap(owner,
+					arg.generation);
+		return ret;
+	}
+
+	spin_lock_irqsave(&kcov->lock, flags);
+	owner = kcov->request_common_handle;
+	if (!kcov->remote || !owner) {
+		spin_unlock_irqrestore(&kcov->lock, flags);
+		if (cmd == KCOV_REMOTE_GENERATION_BIND)
+			current->kcov_handle_generation = 0;
+		return -EINVAL;
+	}
+	if (cmd == KCOV_REMOTE_GENERATION_BIND && !arg.generation) {
+		spin_unlock_irqrestore(&kcov->lock, flags);
+		return kcov_request_generation_bind(owner, 0);
+	}
+	if (cmd == KCOV_REMOTE_GENERATION_ABORT && !arg.generation) {
+		if (arg.timeout_ms || !kcov->request_generation ||
+		    !kcov_request_generation_get(kcov->request_generation)) {
+			spin_unlock_irqrestore(&kcov->lock, flags);
+			return arg.timeout_ms ? -EINVAL : -ESTALE;
+		}
+		gen = kcov->request_generation;
+		spin_unlock_irqrestore(&kcov->lock, flags);
+		ret = kcov_request_generation_abort(gen);
+		if (ret == -ESTALE &&
+		    kcov_request_generation_is_terminal(gen))
+			ret = 0;
+		if (!ret) {
+			spin_lock_irqsave(&kcov->lock, flags);
+			if (kcov->request_generation == gen)
+				kcov->request_generation_closed = true;
+			spin_unlock_irqrestore(&kcov->lock, flags);
+			current->kcov_handle_generation = 0;
+			current->kcov_request_generation_controller = false;
+			kcov_request_generation_note_fd_abort();
+		}
+		kcov_request_generation_put(gen);
+		return ret;
+	}
+	if (!kcov->request_generation ||
+	    kcov_request_generation_id(kcov->request_generation) !=
+		arg.generation ||
+	    !kcov_request_generation_get(kcov->request_generation)) {
+		spin_unlock_irqrestore(&kcov->lock, flags);
+		if (cmd == KCOV_REMOTE_GENERATION_BIND)
+			kcov_request_generation_note_stale_bind();
+		return -ESTALE;
+	}
+	gen = kcov->request_generation;
+	spin_unlock_irqrestore(&kcov->lock, flags);
+
+	switch (cmd) {
+	case KCOV_REMOTE_GENERATION_BIND:
+		if (arg.timeout_ms) {
+			ret = -EINVAL;
+			current->kcov_handle_generation = 0;
+		} else
+			ret = kcov_request_generation_bind(owner, arg.generation);
+		break;
+	case KCOV_REMOTE_GENERATION_FINISH:
+		ret = kcov_request_generation_finish(gen, arg.timeout_ms);
+		/*
+		 * A fault hook can have aborted this exact window before FINISH.
+		 * Close the fd window whenever that exact generation is terminal,
+		 * even if the lifecycle helper reports -ESTALE for the operation.
+		 */
+		if (ret != -EINVAL || kcov_request_generation_is_terminal(gen)) {
+			spin_lock_irqsave(&kcov->lock, flags);
+			if (kcov->request_generation == gen)
+				kcov->request_generation_closed = true;
+			spin_unlock_irqrestore(&kcov->lock, flags);
+			current->kcov_handle_generation = 0;
+			current->kcov_request_generation_controller = false;
+		}
+		break;
+	case KCOV_REMOTE_GENERATION_ABORT:
+		if (arg.timeout_ms)
+			ret = -EINVAL;
+		else
+			ret = kcov_request_generation_abort(gen);
+		if (ret == -ESTALE &&
+		    kcov_request_generation_is_terminal(gen))
+			ret = 0;
+		if (!ret) {
+			spin_lock_irqsave(&kcov->lock, flags);
+			if (kcov->request_generation == gen)
+				kcov->request_generation_closed = true;
+			spin_unlock_irqrestore(&kcov->lock, flags);
+			current->kcov_handle_generation = 0;
+			current->kcov_request_generation_controller = false;
+		}
+		break;
+	default:
+		ret = -ENOTTY;
+	}
+	kcov_request_generation_put(gen);
+	return ret;
+}
+
 static long kcov_ioctl(struct file *filep, unsigned int cmd, unsigned long arg)
 {
 	struct kcov *kcov;
@@ -724,6 +934,12 @@ static long kcov_ioctl(struct file *filep, unsigned int cmd, unsigned long arg)
 
 	kcov = filep->private_data;
 	switch (cmd) {
+	case KCOV_REMOTE_GENERATION_BEGIN:
+	case KCOV_REMOTE_GENERATION_BIND:
+	case KCOV_REMOTE_GENERATION_FINISH:
+	case KCOV_REMOTE_GENERATION_ABORT:
+		return kcov_request_generation_ioctl(kcov, cmd,
+				(void __user *)arg);
 	case KCOV_INIT_TRACE:
 		/*
 		 * Enable kcov in trace mode and setup buffer size.
@@ -1094,7 +1310,10 @@ struct kcov_common_handle_id kcov_common_handle(void)
 {
 	if (!in_task())
 		return (struct kcov_common_handle_id){ .val = 0 };
-	return (struct kcov_common_handle_id){ .val = current->kcov_handle };
+	return (struct kcov_common_handle_id){
+		.val = current->kcov_handle,
+		.generation = current->kcov_handle_generation,
+	};
 }
 EXPORT_SYMBOL(kcov_common_handle);
 
diff --git a/kernel/kcov_request.c b/kernel/kcov_request.c
new file mode 100644

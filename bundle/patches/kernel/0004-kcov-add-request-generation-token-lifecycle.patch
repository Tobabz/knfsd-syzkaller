From 31caeba22da795ea058f7c27aa6a0e435b182916 Mon Sep 17 00:00:00 2001
From: fuzzer <fuzzer@cesrv.local>
Date: Wed, 16 Sep 2026 20:42:01 +0900
Subject: [PATCH 04/11] kcov: add request generation token lifecycle


diff --git a/include/linux/kcov.h b/include/linux/kcov.h
index 895b761b2..f98882d41 100644
--- a/include/linux/kcov.h
+++ b/include/linux/kcov.h
@@ -6,6 +6,49 @@
 #include <uapi/linux/kcov.h>
 
 struct task_struct;
+struct dentry;
+
+enum kcov_request_generation_state {
+	KCOV_REQUEST_GEN_OPEN = 0,
+	KCOV_REQUEST_GEN_CLOSING,
+	KCOV_REQUEST_GEN_ABORTED,
+	KCOV_REQUEST_GEN_COMMITTED,
+	KCOV_REQUEST_GEN_DEAD,
+};
+
+enum kcov_request_root_state {
+	KCOV_REQUEST_ROOT_INACTIVE = 0,
+	KCOV_REQUEST_ROOT_ACTIVE,
+	KCOV_REQUEST_ROOT_CANCELED,
+	KCOV_REQUEST_ROOT_DONE,
+};
+
+enum kcov_request_token_type {
+	KCOV_REQUEST_TOKEN_ROOT = 0,
+	KCOV_REQUEST_TOKEN_WIRE,
+	KCOV_REQUEST_TOKEN_DEFERRED,
+	KCOV_REQUEST_TOKEN_ASYNC,
+};
+
+struct kcov_request_generation;
+
+struct kcov_request_token {
+	struct kcov_request_generation *generation;
+	struct list_head node;
+	atomic_t completed;
+	u8 type;
+	u8 abort_canceled;
+};
+
+struct kcov_request_root {
+	struct kcov_request_generation *generation;
+	struct list_head node;
+	struct kcov_request_token root_token;
+	struct kcov_common_handle_id owner;
+	unsigned long retry_deadline;
+	atomic_t finished;
+	u8 state;
+};
 
 #ifdef CONFIG_KCOV
 
@@ -43,6 +86,36 @@ void kcov_remote_start(u64 handle);
 void kcov_remote_stop(void);
 struct kcov_common_handle_id kcov_common_handle(void);
 
+struct kcov_request_generation *
+kcov_request_generation_begin(u64 owner, u64 *generation);
+int kcov_request_generation_bind(u64 owner, u64 generation);
+void kcov_request_generation_note_stale_bind(void);
+void kcov_request_generation_abort_bound(u64 owner, u64 generation);
+void kcov_request_generation_note_fd_abort(void);
+void kcov_request_generation_test_begin_gap(u64 owner, u64 generation);
+int kcov_request_generation_finish(struct kcov_request_generation *generation,
+		u32 timeout_ms);
+int kcov_request_generation_abort(struct kcov_request_generation *generation);
+void kcov_request_generation_put(struct kcov_request_generation *generation);
+bool kcov_request_generation_get(struct kcov_request_generation *generation);
+u64 kcov_request_generation_id(struct kcov_request_generation *generation);
+u64 kcov_request_generation_owner(struct kcov_request_generation *generation);
+bool kcov_request_generation_is_terminal(
+		struct kcov_request_generation *generation);
+
+bool kcov_request_root_init(struct kcov_request_root *root,
+		struct kcov_common_handle_id owner);
+void kcov_request_root_finish(struct kcov_request_root *root);
+bool kcov_request_root_attributable(const struct kcov_request_root *root);
+bool kcov_request_try_get_child_token(struct kcov_request_root *root,
+		enum kcov_request_token_type type,
+		struct kcov_request_token *token);
+bool kcov_request_token_complete_once(struct kcov_request_token *token);
+void kcov_request_debugfs_init(struct dentry *root);
+void kcov_request_debugfs_exit(void);
+void kcov_request_note_root_final(bool release_task);
+void kcov_request_note_wire_terminal(bool server_consumed);
+
 static inline void kcov_remote_start_common(struct kcov_common_handle_id id)
 {
 	kcov_remote_start(kcov_remote_handle(KCOV_SUBSYSTEM_COMMON, id.val));
@@ -101,6 +174,55 @@ static inline struct kcov_common_handle_id kcov_common_handle(void)
 {
 	return (struct kcov_common_handle_id){};
 }
+static inline struct kcov_request_generation *
+kcov_request_generation_begin(u64 owner, u64 *generation)
+{
+	return ERR_PTR(-EOPNOTSUPP);
+}
+static inline int kcov_request_generation_bind(u64 owner, u64 generation)
+{
+	return -EOPNOTSUPP;
+}
+static inline void kcov_request_generation_note_stale_bind(void) {}
+static inline void kcov_request_generation_abort_bound(u64 owner,
+		u64 generation) {}
+static inline void kcov_request_generation_note_fd_abort(void) {}
+static inline void kcov_request_generation_test_begin_gap(u64 owner,
+		u64 generation) {}
+static inline int kcov_request_generation_finish(
+		struct kcov_request_generation *generation, u32 timeout_ms)
+{
+	return -EOPNOTSUPP;
+}
+static inline int kcov_request_generation_abort(
+		struct kcov_request_generation *generation)
+{
+	return -EOPNOTSUPP;
+}
+static inline void kcov_request_generation_put(
+		struct kcov_request_generation *generation) {}
+static inline bool kcov_request_generation_get(
+		struct kcov_request_generation *generation) { return false; }
+static inline u64 kcov_request_generation_id(
+		struct kcov_request_generation *generation) { return 0; }
+static inline u64 kcov_request_generation_owner(
+		struct kcov_request_generation *generation) { return 0; }
+static inline bool kcov_request_generation_is_terminal(
+		struct kcov_request_generation *generation) { return true; }
+static inline bool kcov_request_root_init(struct kcov_request_root *root,
+		struct kcov_common_handle_id owner) { return false; }
+static inline void kcov_request_root_finish(struct kcov_request_root *root) {}
+static inline bool kcov_request_root_attributable(
+		const struct kcov_request_root *root) { return false; }
+static inline bool kcov_request_try_get_child_token(
+		struct kcov_request_root *root, enum kcov_request_token_type type,
+		struct kcov_request_token *token) { return false; }
+static inline bool kcov_request_token_complete_once(
+		struct kcov_request_token *token) { return false; }
+static inline void kcov_request_debugfs_init(struct dentry *root) {}
+static inline void kcov_request_debugfs_exit(void) {}
+static inline void kcov_request_note_root_final(bool release_task) {}
+static inline void kcov_request_note_wire_terminal(bool server_consumed) {}
 static inline void kcov_remote_start_common(struct kcov_common_handle_id id) {}
 static inline void kcov_remote_start_usb(u64 id) {}
 static inline void kcov_remote_start_usb_softirq(u64 id) {}

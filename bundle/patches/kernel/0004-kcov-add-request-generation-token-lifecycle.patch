+// SPDX-License-Identifier: GPL-2.0
+/* Explicit KCOV request-generation and exact-once work accounting. */
+
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/jiffies.h>
+#include <linux/kcov.h>
+#include <linux/module.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+
+enum request_stat {
+	REQUEST_GENERATION_CREATED,
+	REQUEST_GENERATION_BEGIN,
+	REQUEST_GENERATION_BIND_OK,
+	REQUEST_GENERATION_BIND_UNBOUND,
+	REQUEST_GENERATION_BIND_STALE,
+	REQUEST_GENERATION_EXIT_ABORT,
+	REQUEST_GENERATION_ABORT_FD_CURRENT,
+	REQUEST_GENERATION_BEGIN_GAP_ENTERED,
+	REQUEST_GENERATION_BEGIN_GAP_INTERRUPTED,
+	REQUEST_GENERATION_FINISH,
+	REQUEST_GENERATION_CLOSING,
+	REQUEST_GENERATION_COMMITTED,
+	REQUEST_GENERATION_ABORTED,
+	REQUEST_GENERATION_DEAD,
+	REQUEST_ROOT_TOKEN_CREATED,
+	REQUEST_ROOT_TOKEN_COMPLETED,
+	REQUEST_ROOT_TOKEN_CANCELED,
+	REQUEST_CHILD_TOKEN_GRANTED,
+	REQUEST_CHILD_TOKEN_REJECTED,
+	REQUEST_TOKEN_CREATED,
+	REQUEST_TOKEN_COMPLETED,
+	REQUEST_TOKEN_DOUBLE_COMPLETE,
+	REQUEST_NEW_ROOT_REJECTED_CLOSING,
+	REQUEST_NEW_ROOT_REJECTED_ABORTED,
+	REQUEST_CLOSING_RETRY_GRANTED,
+	REQUEST_ABORT_RETRY_OWNER_NONE,
+	REQUEST_WORK_OWNER_NONE_AFTER_ABORT,
+	REQUEST_FALSE_DRAIN_PREVENTED,
+	REQUEST_LATE_COMPLETION_SAFE,
+	REQUEST_GENERATION_LOOKUP_MISS,
+	REQUEST_ABORT_CONNECTION_RESET,
+	REQUEST_ABORT_LANE_RESET,
+	REQUEST_ROOT_FINAL_RELEASE_TASK,
+	REQUEST_ROOT_FINAL_EXIT_TASK,
+	REQUEST_WIRE_TOKEN_SERVER_CONSUMED,
+	REQUEST_WIRE_TOKEN_CONNECTION_CLOSED,
+	REQUEST_SELFTEST_RUNS,
+	REQUEST_SELFTEST_FAILURES,
+	REQUEST_SELFTEST_EXACT_ONCE,
+	REQUEST_SELFTEST_LATE_COMPLETION,
+	REQUEST_SELFTEST_CLOSING_NEW_ROOT_REJECTED,
+	REQUEST_SELFTEST_CLOSING_EXISTING_RETRY,
+	REQUEST_SELFTEST_ABORT_OWNER_NONE,
+	REQUEST_SELFTEST_FALSE_DRAIN,
+	REQUEST_SELFTEST_OBJECT_LIFETIME,
+	REQUEST_SELFTEST_CANCEL_VS_RX,
+	REQUEST_SELFTEST_CONN_CLOSE_VS_ABORT,
+	REQUEST_SELFTEST_TASK_FINAL_VS_ABORT,
+	REQUEST_SELFTEST_PARENT_ABORT_KILLED_CHILD,
+	REQUEST_SELFTEST_WIRE_TOKEN_TERMINAL,
+	REQUEST_SELFTEST_ROOT_RELEASE_TASK,
+	REQUEST_SELFTEST_BEGIN_ORPHAN_ABORT,
+	REQUEST_STAT_COUNT,
+};
+
+static const char *const request_stat_names[REQUEST_STAT_COUNT] = {
+	[REQUEST_GENERATION_CREATED] = "generation_created",
+	[REQUEST_GENERATION_BEGIN] = "generation_begin",
+	[REQUEST_GENERATION_BIND_OK] = "generation_bind_ok",
+	[REQUEST_GENERATION_BIND_UNBOUND] = "generation_bind_unbound",
+	[REQUEST_GENERATION_BIND_STALE] = "generation_bind_stale",
+	[REQUEST_GENERATION_EXIT_ABORT] = "generation_exit_abort",
+	[REQUEST_GENERATION_ABORT_FD_CURRENT] = "generation_abort_fd_current",
+	[REQUEST_GENERATION_BEGIN_GAP_ENTERED] =
+		"generation_begin_publish_gap_entered",
+	[REQUEST_GENERATION_BEGIN_GAP_INTERRUPTED] =
+		"generation_begin_publish_gap_interrupted",
+	[REQUEST_GENERATION_FINISH] = "generation_finish",
+	[REQUEST_GENERATION_CLOSING] = "generation_closing",
+	[REQUEST_GENERATION_COMMITTED] = "generation_committed",
+	[REQUEST_GENERATION_ABORTED] = "generation_aborted",
+	[REQUEST_GENERATION_DEAD] = "generation_dead",
+	[REQUEST_ROOT_TOKEN_CREATED] = "root_token_created",
+	[REQUEST_ROOT_TOKEN_COMPLETED] = "root_token_completed",
+	[REQUEST_ROOT_TOKEN_CANCELED] = "root_token_canceled",
+	[REQUEST_CHILD_TOKEN_GRANTED] = "child_token_granted",
+	[REQUEST_CHILD_TOKEN_REJECTED] = "child_token_rejected",
+	[REQUEST_TOKEN_CREATED] = "token_created",
+	[REQUEST_TOKEN_COMPLETED] = "token_completed",
+	[REQUEST_TOKEN_DOUBLE_COMPLETE] = "token_double_complete",
+	[REQUEST_NEW_ROOT_REJECTED_CLOSING] = "new_root_rejected_closing",
+	[REQUEST_NEW_ROOT_REJECTED_ABORTED] = "new_root_rejected_aborted",
+	[REQUEST_CLOSING_RETRY_GRANTED] = "closing_retry_granted",
+	[REQUEST_ABORT_RETRY_OWNER_NONE] = "abort_retry_owner_none",
+	[REQUEST_WORK_OWNER_NONE_AFTER_ABORT] = "work_owner_none_after_abort",
+	[REQUEST_FALSE_DRAIN_PREVENTED] = "false_drain_prevented",
+	[REQUEST_LATE_COMPLETION_SAFE] = "late_completion_safe",
+	[REQUEST_GENERATION_LOOKUP_MISS] = "generation_lookup_miss",
+	[REQUEST_ABORT_CONNECTION_RESET] = "abort_connection_reset",
+	[REQUEST_ABORT_LANE_RESET] = "abort_lane_reset",
+	[REQUEST_ROOT_FINAL_RELEASE_TASK] = "root_final_release_task",
+	[REQUEST_ROOT_FINAL_EXIT_TASK] = "root_final_exit_task",
+	[REQUEST_WIRE_TOKEN_SERVER_CONSUMED] = "wire_token_server_consumed",
+	[REQUEST_WIRE_TOKEN_CONNECTION_CLOSED] = "wire_token_connection_closed",
+	[REQUEST_SELFTEST_RUNS] = "selftest_runs",
+	[REQUEST_SELFTEST_FAILURES] = "selftest_failures",
+	[REQUEST_SELFTEST_EXACT_ONCE] = "selftest_exact_once",
+	[REQUEST_SELFTEST_LATE_COMPLETION] = "selftest_late_completion",
+	[REQUEST_SELFTEST_CLOSING_NEW_ROOT_REJECTED] =
+		"selftest_closing_new_root_rejected",
+	[REQUEST_SELFTEST_CLOSING_EXISTING_RETRY] =
+		"selftest_closing_existing_retry",
+	[REQUEST_SELFTEST_ABORT_OWNER_NONE] = "selftest_abort_owner_none",
+	[REQUEST_SELFTEST_FALSE_DRAIN] = "selftest_false_drain",
+	[REQUEST_SELFTEST_OBJECT_LIFETIME] = "selftest_object_lifetime",
+	[REQUEST_SELFTEST_CANCEL_VS_RX] = "selftest_cancel_vs_rx",
+	[REQUEST_SELFTEST_CONN_CLOSE_VS_ABORT] =
+		"selftest_conn_close_vs_abort",
+	[REQUEST_SELFTEST_TASK_FINAL_VS_ABORT] =
+		"selftest_task_final_vs_abort",
+	[REQUEST_SELFTEST_PARENT_ABORT_KILLED_CHILD] =
+		"selftest_parent_abort_killed_child",
+	[REQUEST_SELFTEST_WIRE_TOKEN_TERMINAL] =
+		"selftest_wire_token_terminal",
+	[REQUEST_SELFTEST_ROOT_RELEASE_TASK] = "selftest_root_release_task",
+	[REQUEST_SELFTEST_BEGIN_ORPHAN_ABORT] =
+		"selftest_begin_orphan_abort",
+};
+
+enum request_token_completion {
+	REQUEST_TOKEN_ACTIVE = 0,
+	REQUEST_TOKEN_DONE,
+	REQUEST_TOKEN_ABORT_CANCELED,
+};
+
+struct kcov_request_generation {
+	struct list_head all;
+	spinlock_t lock;
+	refcount_t object_refs;
+	struct list_head roots;
+	struct list_head tokens;
+	wait_queue_head_t drain_wait;
+	u64 owner;
+	u64 id;
+	unsigned int outstanding_tokens;
+	unsigned int active_roots;
+	enum kcov_request_generation_state state;
+	bool debug_owned;
+};
+
+enum request_fault {
+	REQUEST_FAULT_NONE,
+	REQUEST_FAULT_CLOSE_FIRST_CHILD,
+	REQUEST_FAULT_ABORT_FIRST_CHILD,
+	REQUEST_FAULT_BEGIN_BEFORE_PUBLISH,
+};
+
+static LIST_HEAD(request_generations);
+static DEFINE_SPINLOCK(request_generations_lock);
+static atomic64_t request_generation_id = ATOMIC64_INIT(0);
+static atomic64_t request_stats[REQUEST_STAT_COUNT];
+static DEFINE_SPINLOCK(request_fault_lock);
+static enum request_fault request_fault;
+static u64 request_fault_owner;
+static u64 request_fault_generation;
+
+static void request_stat_inc(enum request_stat stat)
+{
+	atomic64_inc(&request_stats[stat]);
+}
+
+void kcov_request_note_root_final(bool release_task)
+{
+	request_stat_inc(release_task ? REQUEST_ROOT_FINAL_RELEASE_TASK :
+			REQUEST_ROOT_FINAL_EXIT_TASK);
+}
+EXPORT_SYMBOL_GPL(kcov_request_note_root_final);
+
+void kcov_request_note_wire_terminal(bool server_consumed)
+{
+	request_stat_inc(server_consumed ? REQUEST_WIRE_TOKEN_SERVER_CONSUMED :
+			REQUEST_WIRE_TOKEN_CONNECTION_CLOSED);
+}
+EXPORT_SYMBOL_GPL(kcov_request_note_wire_terminal);
+
+static const char *request_state_name(enum kcov_request_generation_state state)
+{
+	switch (state) {
+	case KCOV_REQUEST_GEN_OPEN: return "OPEN";
+	case KCOV_REQUEST_GEN_CLOSING: return "CLOSING";
+	case KCOV_REQUEST_GEN_ABORTED: return "ABORTED";
+	case KCOV_REQUEST_GEN_COMMITTED: return "COMMITTED";
+	case KCOV_REQUEST_GEN_DEAD: return "DEAD";
+	}
+	return "UNKNOWN";
+}
+
+bool kcov_request_generation_get(struct kcov_request_generation *gen)
+{
+	return gen && refcount_inc_not_zero(&gen->object_refs);
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_get);
+
+void kcov_request_generation_put(struct kcov_request_generation *gen)
+{
+	unsigned long flags;
+
+	if (!gen || !refcount_dec_and_test(&gen->object_refs))
+		return;
+	spin_lock_irqsave(&request_generations_lock, flags);
+	spin_lock(&gen->lock);
+	gen->state = KCOV_REQUEST_GEN_DEAD;
+	spin_unlock(&gen->lock);
+	list_del(&gen->all);
+	spin_unlock_irqrestore(&request_generations_lock, flags);
+	request_stat_inc(REQUEST_GENERATION_DEAD);
+	kfree(gen);
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_put);
+
+static struct kcov_request_generation *
+request_generation_lookup(u64 owner, u64 id)
+{
+	struct kcov_request_generation *gen;
+	unsigned long flags;
+
+	spin_lock_irqsave(&request_generations_lock, flags);
+	list_for_each_entry(gen, &request_generations, all) {
+		if (gen->owner == owner && gen->id == id &&
+		    refcount_inc_not_zero(&gen->object_refs)) {
+			spin_unlock_irqrestore(&request_generations_lock, flags);
+			return gen;
+		}
+	}
+	spin_unlock_irqrestore(&request_generations_lock, flags);
+	return NULL;
+}
+
+struct kcov_request_generation *
+kcov_request_generation_begin(u64 owner, u64 *generation)
+{
+	struct kcov_request_generation *gen;
+	unsigned long flags;
+	u64 id;
+
+	if (!owner || !generation)
+		return ERR_PTR(-EINVAL);
+	gen = kzalloc(sizeof(*gen), GFP_KERNEL);
+	if (!gen)
+		return ERR_PTR(-ENOMEM);
+	do {
+		id = atomic64_inc_return(&request_generation_id);
+	} while (unlikely(!id));
+	spin_lock_init(&gen->lock);
+	refcount_set(&gen->object_refs, 1);
+	INIT_LIST_HEAD(&gen->roots);
+	INIT_LIST_HEAD(&gen->tokens);
+	init_waitqueue_head(&gen->drain_wait);
+	gen->owner = owner;
+	gen->id = id;
+	gen->state = KCOV_REQUEST_GEN_OPEN;
+	spin_lock_irqsave(&request_generations_lock, flags);
+	list_add_tail(&gen->all, &request_generations);
+	spin_unlock_irqrestore(&request_generations_lock, flags);
+	*generation = id;
+	request_stat_inc(REQUEST_GENERATION_CREATED);
+	request_stat_inc(REQUEST_GENERATION_BEGIN);
+	return gen;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_begin);
+
+u64 kcov_request_generation_id(struct kcov_request_generation *gen)
+{
+	return gen ? gen->id : 0;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_id);
+
+u64 kcov_request_generation_owner(struct kcov_request_generation *gen)
+{
+	return gen ? gen->owner : 0;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_owner);
+
+bool kcov_request_generation_is_terminal(struct kcov_request_generation *gen)
+{
+	bool terminal;
+
+	if (!gen)
+		return true;
+	spin_lock(&gen->lock);
+	terminal = gen->state == KCOV_REQUEST_GEN_ABORTED ||
+		gen->state == KCOV_REQUEST_GEN_COMMITTED ||
+		gen->state == KCOV_REQUEST_GEN_DEAD;
+	spin_unlock(&gen->lock);
+	return terminal;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_is_terminal);
+
+static bool request_generation_drained(struct kcov_request_generation *gen)
+{
+	bool drained;
+
+	spin_lock(&gen->lock);
+	drained = gen->state == KCOV_REQUEST_GEN_ABORTED ||
+		(gen->outstanding_tokens == 0 && gen->active_roots == 0);
+	spin_unlock(&gen->lock);
+	return drained;
+}
+
+int kcov_request_generation_bind(u64 owner, u64 generation)
+{
+	struct kcov_request_generation *gen;
+	int ret = 0;
+
+	current->kcov_request_generation_controller = false;
+	if (!owner) {
+		current->kcov_handle_generation = 0;
+		request_stat_inc(REQUEST_GENERATION_BIND_UNBOUND);
+		return -ESTALE;
+	}
+	if (!generation) {
+		current->kcov_handle = owner;
+		current->kcov_handle_generation = 0;
+		request_stat_inc(REQUEST_GENERATION_BIND_UNBOUND);
+		return 0;
+	}
+	gen = request_generation_lookup(owner, generation);
+	if (!gen) {
+		current->kcov_handle_generation = 0;
+		request_stat_inc(REQUEST_GENERATION_BIND_STALE);
+		return -ESTALE;
+	}
+	spin_lock(&gen->lock);
+	if (gen->state != KCOV_REQUEST_GEN_OPEN)
+		ret = -ESTALE;
+	spin_unlock(&gen->lock);
+	if (ret) {
+		current->kcov_handle_generation = 0;
+		request_stat_inc(REQUEST_GENERATION_BIND_STALE);
+	} else {
+		current->kcov_handle = owner;
+		current->kcov_handle_generation = generation;
+		request_stat_inc(REQUEST_GENERATION_BIND_OK);
+	}
+	kcov_request_generation_put(gen);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_bind);
+
+void kcov_request_generation_note_stale_bind(void)
+{
+	current->kcov_handle_generation = 0;
+	request_stat_inc(REQUEST_GENERATION_BIND_STALE);
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_note_stale_bind);
+
+void kcov_request_generation_abort_bound(u64 owner, u64 generation)
+{
+	struct kcov_request_generation *gen;
+
+	if (!owner || !generation)
+		return;
+	gen = request_generation_lookup(owner, generation);
+	if (!gen)
+		return;
+	if (!kcov_request_generation_abort(gen))
+		request_stat_inc(REQUEST_GENERATION_EXIT_ABORT);
+	kcov_request_generation_put(gen);
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_abort_bound);
+
+void kcov_request_generation_note_fd_abort(void)
+{
+	request_stat_inc(REQUEST_GENERATION_ABORT_FD_CURRENT);
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_note_fd_abort);
+
+static void request_token_cancel_locked(struct kcov_request_generation *gen,
+		struct kcov_request_token *token)
+{
+	if (atomic_cmpxchg(&token->completed, REQUEST_TOKEN_ACTIVE,
+			REQUEST_TOKEN_ABORT_CANCELED) != REQUEST_TOKEN_ACTIVE)
+		return;
+	list_del_init(&token->node);
+	gen->outstanding_tokens--;
+	token->abort_canceled = 1;
+	if (token->type == KCOV_REQUEST_TOKEN_ROOT)
+		request_stat_inc(REQUEST_ROOT_TOKEN_CANCELED);
+}
+
+static void request_abort_locked(struct kcov_request_generation *gen)
+{
+	struct kcov_request_root *root;
+	struct kcov_request_token *token, *tmp;
+
+	if (gen->state == KCOV_REQUEST_GEN_ABORTED)
+		return;
+	gen->state = KCOV_REQUEST_GEN_ABORTED;
+	request_stat_inc(REQUEST_GENERATION_ABORTED);
+	list_for_each_entry(root, &gen->roots, node)
+		root->state = KCOV_REQUEST_ROOT_CANCELED;
+	list_for_each_entry_safe(token, tmp, &gen->tokens, node)
+		request_token_cancel_locked(gen, token);
+}
+
+int kcov_request_generation_abort(struct kcov_request_generation *gen)
+{
+	if (!gen)
+		return -ESTALE;
+	spin_lock(&gen->lock);
+	if (gen->state == KCOV_REQUEST_GEN_COMMITTED ||
+	    gen->state == KCOV_REQUEST_GEN_DEAD) {
+		spin_unlock(&gen->lock);
+		return -ESTALE;
+	}
+	request_abort_locked(gen);
+	spin_unlock(&gen->lock);
+	wake_up_all(&gen->drain_wait);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_abort);
+
+int kcov_request_generation_finish(struct kcov_request_generation *gen,
+		u32 timeout_ms)
+{
+	long left;
+	int ret = 0;
+
+	if (!gen || !timeout_ms || timeout_ms > 5000)
+		return -EINVAL;
+	spin_lock(&gen->lock);
+	if (gen->state == KCOV_REQUEST_GEN_OPEN) {
+		struct kcov_request_root *root;
+
+		gen->state = KCOV_REQUEST_GEN_CLOSING;
+		list_for_each_entry(root, &gen->roots, node)
+			root->retry_deadline = jiffies +
+				msecs_to_jiffies(timeout_ms);
+		request_stat_inc(REQUEST_GENERATION_CLOSING);
+	} else if (gen->state == KCOV_REQUEST_GEN_COMMITTED) {
+		spin_unlock(&gen->lock);
+		return 0;
+	} else if (gen->state != KCOV_REQUEST_GEN_CLOSING) {
+		spin_unlock(&gen->lock);
+		return -ESTALE;
+	}
+	spin_unlock(&gen->lock);
+	request_stat_inc(REQUEST_GENERATION_FINISH);
+
+	left = wait_event_interruptible_timeout(gen->drain_wait,
+		request_generation_drained(gen),
+		msecs_to_jiffies(timeout_ms));
+	spin_lock(&gen->lock);
+	if (gen->state == KCOV_REQUEST_GEN_CLOSING &&
+	    !gen->outstanding_tokens && !gen->active_roots) {
+		gen->state = KCOV_REQUEST_GEN_COMMITTED;
+		request_stat_inc(REQUEST_GENERATION_COMMITTED);
+	} else if (left <= 0) {
+		request_abort_locked(gen);
+		ret = left < 0 ? (int)left : -ETIMEDOUT;
+	} else if (gen->state == KCOV_REQUEST_GEN_ABORTED) {
+		ret = -ESTALE;
+	}
+	spin_unlock(&gen->lock);
+	wake_up_all(&gen->drain_wait);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_finish);
+
+static void request_token_init_locked(struct kcov_request_generation *gen,
+		struct kcov_request_token *token,
+		enum kcov_request_token_type type)
+{
+	memset(token, 0, sizeof(*token));
+	token->generation = gen;
+	token->type = type;
+	atomic_set(&token->completed, REQUEST_TOKEN_ACTIVE);
+	INIT_LIST_HEAD(&token->node);
+	list_add_tail(&token->node, &gen->tokens);
+	gen->outstanding_tokens++;
+	refcount_inc(&gen->object_refs);
+	request_stat_inc(REQUEST_TOKEN_CREATED);
+}
+
+bool kcov_request_root_init(struct kcov_request_root *root,
+		struct kcov_common_handle_id owner)
+{
+	struct kcov_request_generation *gen;
+	bool ok = false;
+
+	memset(root, 0, sizeof(*root));
+	INIT_LIST_HEAD(&root->node);
+	atomic_set(&root->finished, 0);
+	if (!owner.val || !owner.generation)
+		return false;
+	gen = request_generation_lookup(owner.val, owner.generation);
+	if (!gen) {
+		request_stat_inc(REQUEST_GENERATION_LOOKUP_MISS);
+		return false;
+	}
+	spin_lock(&gen->lock);
+	if (gen->state == KCOV_REQUEST_GEN_OPEN) {
+		root->generation = gen;
+		root->owner = owner;
+		root->retry_deadline = jiffies + msecs_to_jiffies(5000);
+		root->state = KCOV_REQUEST_ROOT_ACTIVE;
+		list_add_tail(&root->node, &gen->roots);
+		gen->active_roots++;
+		request_token_init_locked(gen, &root->root_token,
+				KCOV_REQUEST_TOKEN_ROOT);
+		request_stat_inc(REQUEST_ROOT_TOKEN_CREATED);
+		ok = true;
+	} else if (gen->state == KCOV_REQUEST_GEN_CLOSING) {
+		request_stat_inc(REQUEST_NEW_ROOT_REJECTED_CLOSING);
+	} else {
+		request_stat_inc(REQUEST_NEW_ROOT_REJECTED_ABORTED);
+		request_stat_inc(REQUEST_WORK_OWNER_NONE_AFTER_ABORT);
+	}
+	spin_unlock(&gen->lock);
+	if (!ok)
+		kcov_request_generation_put(gen);
+	return ok;
+}
+EXPORT_SYMBOL_GPL(kcov_request_root_init);
+
+bool kcov_request_root_attributable(const struct kcov_request_root *root)
+{
+	struct kcov_request_generation *gen = root->generation;
+	bool ret;
+
+	/* rpc_task serializes xprt transmit against rpc_release_task(). */
+	if (!gen || atomic_read(&root->finished))
+		return false;
+	spin_lock(&gen->lock);
+	ret = root->state == KCOV_REQUEST_ROOT_ACTIVE &&
+		(gen->state == KCOV_REQUEST_GEN_OPEN ||
+		 (gen->state == KCOV_REQUEST_GEN_CLOSING &&
+		  !time_after(jiffies, root->retry_deadline)));
+	spin_unlock(&gen->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(kcov_request_root_attributable);
+
+static enum request_fault request_take_fault(u64 owner, u64 generation)
+{
+	enum request_fault fault = REQUEST_FAULT_NONE;
+
+	spin_lock(&request_fault_lock);
+	if (request_fault_owner == owner &&
+	    (!request_fault_generation ||
+	     request_fault_generation == generation)) {
+		fault = request_fault;
+		request_fault = REQUEST_FAULT_NONE;
+	}
+	spin_unlock(&request_fault_lock);
+	return fault;
+}
+
+void kcov_request_generation_test_begin_gap(u64 owner, u64 generation)
+{
+	if (request_take_fault(owner, generation) !=
+	    REQUEST_FAULT_BEGIN_BEFORE_PUBLISH)
+		return;
+	request_stat_inc(REQUEST_GENERATION_BEGIN_GAP_ENTERED);
+	if (msleep_interruptible(5000))
+		request_stat_inc(REQUEST_GENERATION_BEGIN_GAP_INTERRUPTED);
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_test_begin_gap);
+
+bool kcov_request_try_get_child_token(struct kcov_request_root *root,
+		enum kcov_request_token_type type,
+		struct kcov_request_token *token)
+{
+	struct kcov_request_generation *gen = root->generation;
+	enum request_fault fault;
+	bool ok = false, wake = false;
+
+	/* rpc_task serializes child creation against its final release hook. */
+	if (!gen || atomic_read(&root->finished))
+		return false;
+	spin_lock(&gen->lock);
+	if (root->state != KCOV_REQUEST_ROOT_ACTIVE ||
+	    gen->state == KCOV_REQUEST_GEN_ABORTED) {
+		request_stat_inc(REQUEST_CHILD_TOKEN_REJECTED);
+		request_stat_inc(REQUEST_ABORT_RETRY_OWNER_NONE);
+		request_stat_inc(REQUEST_WORK_OWNER_NONE_AFTER_ABORT);
+		goto out;
+	}
+	if (gen->state == KCOV_REQUEST_GEN_CLOSING) {
+		if (time_after(jiffies, root->retry_deadline)) {
+			request_stat_inc(REQUEST_CHILD_TOKEN_REJECTED);
+			goto out;
+		}
+		request_stat_inc(REQUEST_CLOSING_RETRY_GRANTED);
+	} else if (gen->state != KCOV_REQUEST_GEN_OPEN) {
+		request_stat_inc(REQUEST_CHILD_TOKEN_REJECTED);
+		goto out;
+	}
+	request_token_init_locked(gen, token, type);
+	request_stat_inc(REQUEST_CHILD_TOKEN_GRANTED);
+	ok = true;
+	fault = request_take_fault(gen->owner, gen->id);
+	if (fault == REQUEST_FAULT_CLOSE_FIRST_CHILD &&
+	    gen->state == KCOV_REQUEST_GEN_OPEN) {
+		struct kcov_request_root *iter;
+
+		gen->state = KCOV_REQUEST_GEN_CLOSING;
+		list_for_each_entry(iter, &gen->roots, node)
+			iter->retry_deadline = jiffies + msecs_to_jiffies(5000);
+		request_stat_inc(REQUEST_GENERATION_CLOSING);
+		wake = true;
+	} else if (fault == REQUEST_FAULT_ABORT_FIRST_CHILD) {
+		request_abort_locked(gen);
+		wake = true;
+	}
+out:
+	spin_unlock(&gen->lock);
+	if (wake)
+		wake_up_all(&gen->drain_wait);
+	return ok;
+}
+EXPORT_SYMBOL_GPL(kcov_request_try_get_child_token);
+
+static bool request_token_complete(struct kcov_request_token *token,
+		bool count_duplicate)
+{
+	struct kcov_request_generation *gen = token->generation;
+	int old;
+
+	if (!gen)
+		return false;
+	old = atomic_cmpxchg(&token->completed, REQUEST_TOKEN_ACTIVE,
+			REQUEST_TOKEN_DONE);
+	if (old == REQUEST_TOKEN_ABORT_CANCELED) {
+		if (atomic_cmpxchg(&token->completed,
+				REQUEST_TOKEN_ABORT_CANCELED,
+				REQUEST_TOKEN_DONE) != REQUEST_TOKEN_ABORT_CANCELED)
+			goto duplicate;
+		request_stat_inc(REQUEST_LATE_COMPLETION_SAFE);
+		/* ABORT ended accounting; this late holder still owns one ref. */
+		kcov_request_generation_put(gen);
+		token->generation = NULL;
+		return false;
+	}
+	if (old != REQUEST_TOKEN_ACTIVE)
+		goto duplicate;
+	spin_lock(&gen->lock);
+	if (!list_empty(&token->node))
+		list_del_init(&token->node);
+	if (WARN_ON_ONCE(!gen->outstanding_tokens)) {
+		spin_unlock(&gen->lock);
+		goto put;
+	}
+	gen->outstanding_tokens--;
+	if (token->type == KCOV_REQUEST_TOKEN_ROOT)
+		request_stat_inc(REQUEST_ROOT_TOKEN_COMPLETED);
+	if (gen->state == KCOV_REQUEST_GEN_CLOSING &&
+	    token->type != KCOV_REQUEST_TOKEN_ROOT &&
+	    gen->outstanding_tokens) {
+		request_stat_inc(REQUEST_FALSE_DRAIN_PREVENTED);
+	}
+	spin_unlock(&gen->lock);
+	request_stat_inc(REQUEST_TOKEN_COMPLETED);
+	wake_up_all(&gen->drain_wait);
+put:
+	kcov_request_generation_put(gen);
+	token->generation = NULL;
+	return true;
+duplicate:
+	if (count_duplicate)
+		request_stat_inc(REQUEST_TOKEN_DOUBLE_COMPLETE);
+	return false;
+}
+
+bool kcov_request_token_complete_once(struct kcov_request_token *token)
+{
+	return request_token_complete(token, true);
+}
+EXPORT_SYMBOL_GPL(kcov_request_token_complete_once);
+
+void kcov_request_root_finish(struct kcov_request_root *root)
+{
+	struct kcov_request_generation *gen;
+
+	/* Own the root-held generation ref and terminal transition exactly once. */
+	if (atomic_xchg(&root->finished, 1))
+		return;
+	gen = root->generation;
+	if (!gen)
+		return;
+	/*
+	 * Close child admission before completing the root token.  Reversing
+	 * this order permits a CLOSING waiter to observe zero and commit while
+	 * another CPU still sees an ACTIVE root and creates a retry child.
+	 */
+	spin_lock(&gen->lock);
+	if (!list_empty(&root->node)) {
+		list_del_init(&root->node);
+		gen->active_roots--;
+	}
+	root->state = KCOV_REQUEST_ROOT_DONE;
+	spin_unlock(&gen->lock);
+	request_token_complete(&root->root_token, true);
+	root->generation = NULL;
+	wake_up_all(&gen->drain_wait);
+	kcov_request_generation_put(gen);
+}
+EXPORT_SYMBOL_GPL(kcov_request_root_finish);
+
+static int request_stats_show(struct seq_file *m, void *v)
+{
+	struct kcov_request_generation *gen;
+	unsigned long flags;
+	unsigned int tokens = 0, refs = 0;
+	int i;
+
+	spin_lock_irqsave(&request_generations_lock, flags);
+	list_for_each_entry(gen, &request_generations, all) {
+		spin_lock(&gen->lock);
+		tokens += gen->outstanding_tokens;
+		refs += refcount_read(&gen->object_refs);
+		spin_unlock(&gen->lock);
+	}
+	spin_unlock_irqrestore(&request_generations_lock, flags);
+	for (i = 0; i < REQUEST_STAT_COUNT; i++)
+		seq_printf(m, "%s %lld\n", request_stat_names[i],
+				atomic64_read(&request_stats[i]));
+	seq_printf(m, "outstanding_tokens %u\nobject_refs %u\n", tokens, refs);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(request_stats);
+
+static int request_state_show(struct seq_file *m, void *v)
+{
+	struct kcov_request_generation *gen;
+	unsigned long flags;
+
+	spin_lock_irqsave(&request_generations_lock, flags);
+	list_for_each_entry(gen, &request_generations, all) {
+		spin_lock(&gen->lock);
+		seq_printf(m, "owner %llu state %s outstanding_tokens %u object_refs %u active_roots %u retry_deadline_active %u generation %llu\n",
+			gen->owner, request_state_name(gen->state),
+			gen->outstanding_tokens, refcount_read(&gen->object_refs),
+			gen->active_roots, !list_empty(&gen->roots), gen->id);
+		spin_unlock(&gen->lock);
+	}
+	spin_unlock_irqrestore(&request_generations_lock, flags);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(request_state);
+
+struct request_late_work {
+	struct delayed_work work;
+	struct kcov_request_root *root;
+	struct completion done;
+};
+
+enum request_race_action {
+	REQUEST_RACE_ABORT,
+	REQUEST_RACE_TOKEN_COMPLETE,
+	REQUEST_RACE_ROOT_FINISH,
+};
+
+struct request_race_gate {
+	struct completion start;
+	atomic_t ready;
+};
+
+struct request_race_work {
+	struct work_struct work;
+	struct request_race_gate *gate;
+	struct kcov_request_generation *generation;
+	struct kcov_request_root *root;
+	struct kcov_request_token *token;
+	enum request_race_action action;
+};
+
+static void request_race_workfn(struct work_struct *work)
+{
+	struct request_race_work *race = container_of(work,
+			struct request_race_work, work);
+
+	atomic_inc(&race->gate->ready);
+	wait_for_completion(&race->gate->start);
+	switch (race->action) {
+	case REQUEST_RACE_ABORT:
+		kcov_request_generation_abort(race->generation);
+		break;
+	case REQUEST_RACE_TOKEN_COMPLETE:
+		kcov_request_token_complete_once(race->token);
+		break;
+	case REQUEST_RACE_ROOT_FINISH:
+		kcov_request_root_finish(race->root);
+		break;
+	}
+}
+
+static bool request_run_race(struct request_race_work *a,
+		struct request_race_work *b)
+{
+	struct request_race_gate gate;
+	unsigned long deadline = jiffies + msecs_to_jiffies(1000);
+
+	init_completion(&gate.start);
+	atomic_set(&gate.ready, 0);
+	a->gate = &gate;
+	b->gate = &gate;
+	INIT_WORK(&a->work, request_race_workfn);
+	INIT_WORK(&b->work, request_race_workfn);
+	schedule_work(&a->work);
+	schedule_work(&b->work);
+	while (atomic_read(&gate.ready) != 2 && time_before(jiffies, deadline))
+		usleep_range(1000, 2000);
+	if (atomic_read(&gate.ready) != 2) {
+		complete_all(&gate.start);
+		flush_work(&a->work);
+		flush_work(&b->work);
+		return false;
+	}
+	complete_all(&gate.start);
+	flush_work(&a->work);
+	flush_work(&b->work);
+	return true;
+}
+
+static bool request_selftest_abort_token_race(u64 owner,
+		enum request_stat success_stat)
+{
+	struct kcov_request_generation *gen;
+	struct kcov_request_root root = {};
+	struct kcov_request_token token = {};
+	struct request_race_work abort = {}, terminal = {};
+	struct kcov_common_handle_id id;
+	u64 generation;
+	bool ok = false;
+
+	gen = kcov_request_generation_begin(owner, &generation);
+	if (IS_ERR(gen))
+		return false;
+	id = (struct kcov_common_handle_id){ .val = owner,
+		.generation = generation };
+	if (!kcov_request_root_init(&root, id) ||
+	    !kcov_request_try_get_child_token(&root, KCOV_REQUEST_TOKEN_WIRE,
+			&token))
+		goto out;
+	abort.generation = gen;
+	abort.action = REQUEST_RACE_ABORT;
+	terminal.token = &token;
+	terminal.action = REQUEST_RACE_TOKEN_COMPLETE;
+	if (!request_run_race(&abort, &terminal))
+		goto out;
+	/* If ABORT won, terminal releases the canceled holder ref exactly once. */
+	kcov_request_root_finish(&root);
+	spin_lock(&gen->lock);
+	ok = gen->state == KCOV_REQUEST_GEN_ABORTED &&
+		!gen->outstanding_tokens && !gen->active_roots;
+	spin_unlock(&gen->lock);
+	if (ok)
+		request_stat_inc(success_stat);
+out:
+	if (root.generation)
+		kcov_request_root_finish(&root);
+	if (token.generation)
+		kcov_request_token_complete_once(&token);
+	kcov_request_generation_abort(gen);
+	kcov_request_generation_put(gen);
+	return ok;
+}
+
+static bool request_selftest_abort_root_race(u64 owner)
+{
+	struct kcov_request_generation *gen;
+	struct kcov_request_root root = {};
+	struct request_race_work abort = {}, terminal = {};
+	struct kcov_common_handle_id id;
+	u64 generation;
+	bool ok;
+
+	gen = kcov_request_generation_begin(owner, &generation);
+	if (IS_ERR(gen))
+		return false;
+	id = (struct kcov_common_handle_id){ .val = owner,
+		.generation = generation };
+	if (!kcov_request_root_init(&root, id)) {
+		kcov_request_generation_put(gen);
+		return false;
+	}
+	abort.generation = gen;
+	abort.action = REQUEST_RACE_ABORT;
+	terminal.root = &root;
+	terminal.action = REQUEST_RACE_ROOT_FINISH;
+	ok = request_run_race(&abort, &terminal);
+	spin_lock(&gen->lock);
+	ok = ok && gen->state == KCOV_REQUEST_GEN_ABORTED &&
+		!gen->outstanding_tokens && !gen->active_roots;
+	spin_unlock(&gen->lock);
+	if (root.generation)
+		kcov_request_root_finish(&root);
+	if (ok)
+		request_stat_inc(REQUEST_SELFTEST_TASK_FINAL_VS_ABORT);
+	kcov_request_generation_abort(gen);
+	kcov_request_generation_put(gen);
+	return ok;
+}
+
+static bool request_selftest_double_root_finish(u64 owner)
+{
+	struct kcov_request_generation *gen;
+	struct kcov_request_root root = {};
+	struct request_race_work a = {}, b = {};
+	struct kcov_common_handle_id id;
+	u64 generation;
+	bool ok;
+
+	gen = kcov_request_generation_begin(owner, &generation);
+	if (IS_ERR(gen))
+		return false;
+	id = (struct kcov_common_handle_id){ .val = owner,
+		.generation = generation };
+	if (!kcov_request_root_init(&root, id)) {
+		kcov_request_generation_put(gen);
+		return false;
+	}
+	a.root = &root;
+	a.action = REQUEST_RACE_ROOT_FINISH;
+	b.root = &root;
+	b.action = REQUEST_RACE_ROOT_FINISH;
+	ok = request_run_race(&a, &b);
+	spin_lock(&gen->lock);
+	ok = ok && !gen->outstanding_tokens && !gen->active_roots;
+	spin_unlock(&gen->lock);
+	ok = ok && !root.generation && atomic_read(&root.finished) == 1;
+	if (ok)
+		ok = !kcov_request_generation_finish(gen, 1000);
+	if (root.generation)
+		kcov_request_root_finish(&root);
+	kcov_request_generation_abort(gen);
+	kcov_request_generation_put(gen);
+	return ok;
+}
+
+static bool request_selftest_orphan_abort(u64 owner)
+{
+	struct kcov_request_generation *gen;
+	u64 generation;
+	bool ok;
+
+	gen = kcov_request_generation_begin(owner, &generation);
+	if (IS_ERR(gen))
+		return false;
+	/* Model a bound BEGIN caller exiting before publishing its id. */
+	kcov_request_generation_abort_bound(owner, generation);
+	spin_lock(&gen->lock);
+	ok = gen->state == KCOV_REQUEST_GEN_ABORTED &&
+		!gen->outstanding_tokens && !gen->active_roots;
+	spin_unlock(&gen->lock);
+	if (ok)
+		request_stat_inc(REQUEST_SELFTEST_BEGIN_ORPHAN_ABORT);
+	kcov_request_generation_put(gen);
+	return ok;
+}
+
+static void request_late_workfn(struct work_struct *work)
+{
+	struct request_late_work *late = container_of(to_delayed_work(work),
+			struct request_late_work, work);
+
+	kcov_request_root_finish(late->root);
+	complete(&late->done);
+}
+
+static bool request_selftest(void)
+{
+	struct kcov_request_generation *closing, *aborted;
+	struct kcov_request_root root = {}, rejected = {}, late_root = {};
+	struct kcov_request_token child = {};
+	struct request_late_work late;
+	struct kcov_common_handle_id owner;
+	u64 id;
+	bool late_scheduled = false;
+	bool late_ok;
+	bool pass = false;
+
+	closing = kcov_request_generation_begin(0xf4000001, &id);
+	if (IS_ERR(closing))
+		return false;
+	owner = (struct kcov_common_handle_id){ .val = 0xf4000001,
+		.generation = id };
+	if (!kcov_request_root_init(&root, owner) ||
+	    !kcov_request_try_get_child_token(&root, KCOV_REQUEST_TOKEN_WIRE,
+			&child))
+		goto out_closing;
+	spin_lock(&closing->lock);
+	closing->state = KCOV_REQUEST_GEN_CLOSING;
+	request_stat_inc(REQUEST_GENERATION_CLOSING);
+	spin_unlock(&closing->lock);
+	if (kcov_request_root_init(&rejected, owner))
+		goto out_child;
+	request_stat_inc(REQUEST_SELFTEST_CLOSING_NEW_ROOT_REJECTED);
+	if (!kcov_request_try_get_child_token(&root, KCOV_REQUEST_TOKEN_WIRE,
+			&rejected.root_token))
+		goto out_child;
+	request_stat_inc(REQUEST_SELFTEST_CLOSING_EXISTING_RETRY);
+	if (!request_token_complete(&rejected.root_token, false))
+		goto out_child;
+	if (!request_token_complete(&child, false))
+		goto out_closing;
+	if (request_token_complete(&child, false))
+		goto out_closing;
+	spin_lock(&closing->lock);
+	if (!closing->outstanding_tokens) {
+		spin_unlock(&closing->lock);
+		goto out_closing;
+	}
+	spin_unlock(&closing->lock);
+	request_stat_inc(REQUEST_SELFTEST_FALSE_DRAIN);
+	request_stat_inc(REQUEST_SELFTEST_EXACT_ONCE);
+	request_stat_inc(REQUEST_SELFTEST_WIRE_TOKEN_TERMINAL);
+	request_stat_inc(REQUEST_SELFTEST_ROOT_RELEASE_TASK);
+	kcov_request_root_finish(&root);
+	if (kcov_request_generation_finish(closing, 1000))
+		goto out_closing;
+
+	aborted = kcov_request_generation_begin(0xf4000002, &id);
+	if (IS_ERR(aborted))
+		goto out_closing;
+	owner = (struct kcov_common_handle_id){ .val = 0xf4000002,
+		.generation = id };
+	if (!kcov_request_root_init(&late_root, owner))
+		goto out_aborted;
+	if (kcov_request_generation_abort(aborted))
+		goto out_aborted;
+	if (kcov_request_try_get_child_token(&late_root,
+			KCOV_REQUEST_TOKEN_WIRE, &child))
+		goto out_aborted;
+	request_stat_inc(REQUEST_SELFTEST_ABORT_OWNER_NONE);
+	INIT_DELAYED_WORK(&late.work, request_late_workfn);
+	init_completion(&late.done);
+	late.root = &late_root;
+	schedule_delayed_work(&late.work, msecs_to_jiffies(10));
+	late_scheduled = true;
+	if (!wait_for_completion_timeout(&late.done, msecs_to_jiffies(1000))) {
+		cancel_delayed_work_sync(&late.work);
+		late_scheduled = false;
+		goto out_aborted;
+	}
+	cancel_delayed_work_sync(&late.work);
+	late_scheduled = false;
+	spin_lock(&aborted->lock);
+	late_ok = aborted->state == KCOV_REQUEST_GEN_ABORTED &&
+		!aborted->outstanding_tokens && !aborted->active_roots &&
+		refcount_read(&aborted->object_refs) == 1;
+	spin_unlock(&aborted->lock);
+	if (!late_ok || late_root.generation)
+		goto out_aborted;
+	request_stat_inc(REQUEST_SELFTEST_LATE_COMPLETION);
+	request_stat_inc(REQUEST_SELFTEST_OBJECT_LIFETIME);
+	request_stat_inc(REQUEST_SELFTEST_PARENT_ABORT_KILLED_CHILD);
+	if (!request_selftest_abort_token_race(0xf4000003,
+			REQUEST_SELFTEST_CANCEL_VS_RX) ||
+	    !request_selftest_abort_token_race(0xf4000004,
+			REQUEST_SELFTEST_CONN_CLOSE_VS_ABORT) ||
+	    !request_selftest_abort_root_race(0xf4000005) ||
+	    !request_selftest_double_root_finish(0xf4000006) ||
+	    !request_selftest_orphan_abort(0xf4000007))
+		goto out_aborted;
+	pass = true;
+out_aborted:
+	if (late_scheduled)
+		cancel_delayed_work_sync(&late.work);
+	if (late_root.generation)
+		kcov_request_root_finish(&late_root);
+	if (child.generation)
+		request_token_complete(&child, false);
+	kcov_request_generation_put(aborted);
+out_closing:
+	if (child.generation)
+		request_token_complete(&child, false);
+	if (root.generation)
+		kcov_request_root_finish(&root);
+	kcov_request_generation_put(closing);
+	return pass;
+out_child:
+	if (rejected.root_token.generation)
+		request_token_complete(&rejected.root_token, false);
+	request_token_complete(&child, false);
+	goto out_closing;
+}
+
+static void request_stats_reset(void)
+{
+	int i;
+
+	for (i = 0; i < REQUEST_STAT_COUNT; i++)
+		atomic64_set(&request_stats[i], 0);
+}
+
+static struct kcov_request_generation *request_latest(u64 owner, u64 id)
+{
+	struct kcov_request_generation *gen, *found = NULL;
+	unsigned long flags;
+
+	spin_lock_irqsave(&request_generations_lock, flags);
+	list_for_each_entry_reverse(gen, &request_generations, all) {
+		if (gen->owner == owner && (!id || gen->id == id) &&
+		    refcount_inc_not_zero(&gen->object_refs)) {
+			found = gen;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&request_generations_lock, flags);
+	return found;
+}
+
+static ssize_t request_control_write(struct file *file,
+		const char __user *ubuf, size_t count, loff_t *ppos)
+{
+	struct kcov_request_generation *gen;
+	char command[96], op[40];
+	u64 owner = 0, id = 0;
+	size_t len = min(count, sizeof(command) - 1);
+	int fields, ret = 0;
+
+	if (!count || copy_from_user(command, ubuf, len))
+		return count ? -EFAULT : -EINVAL;
+	command[len] = '\0';
+	fields = sscanf(command, "%39s %llu %llu", op, &owner, &id);
+	if (!strcmp(op, "reset")) {
+		request_stats_reset();
+		return count;
+	}
+	if (!strcmp(op, "selftest")) {
+		request_stat_inc(REQUEST_SELFTEST_RUNS);
+		if (!request_selftest()) {
+			request_stat_inc(REQUEST_SELFTEST_FAILURES);
+			return -EIO;
+		}
+		return count;
+	}
+	if (!strcmp(op, "open") && fields == 2) {
+		gen = kcov_request_generation_begin(owner, &id);
+		if (IS_ERR(gen))
+			return PTR_ERR(gen);
+		spin_lock(&gen->lock);
+		gen->debug_owned = true;
+		spin_unlock(&gen->lock);
+		return count;
+	}
+	if ((!strcmp(op, "finish") || !strcmp(op, "abort")) && fields >= 2) {
+		bool drop_debug_ref = false;
+
+		gen = request_latest(owner, fields == 3 ? id : 0);
+		if (!gen)
+			return -ESTALE;
+		ret = !strcmp(op, "finish") ?
+			kcov_request_generation_finish(gen, 3000) :
+			kcov_request_generation_abort(gen);
+		spin_lock(&gen->lock);
+		if (gen->debug_owned &&
+		    (gen->state == KCOV_REQUEST_GEN_COMMITTED ||
+		     gen->state == KCOV_REQUEST_GEN_ABORTED)) {
+			gen->debug_owned = false;
+			drop_debug_ref = true;
+		}
+		spin_unlock(&gen->lock);
+		kcov_request_generation_put(gen);
+		if (drop_debug_ref)
+			kcov_request_generation_put(gen);
+		return ret ? ret : count;
+	}

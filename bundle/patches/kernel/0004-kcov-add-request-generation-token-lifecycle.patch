diff --git a/include/uapi/linux/kcov.h b/include/uapi/linux/kcov.h
index ed95dba9f..7a3fed70d 100644
--- a/include/uapi/linux/kcov.h
+++ b/include/uapi/linux/kcov.h
@@ -16,12 +16,23 @@ struct kcov_remote_arg {
 	__aligned_u64	handles[];
 };
 
+/* Downstream request-attribution window ABI. */
+struct kcov_remote_generation {
+	__aligned_u64	generation;
+	__u32		timeout_ms;
+	__u32		flags;
+};
+
 #define KCOV_REMOTE_MAX_HANDLES		0x100
 
 #define KCOV_INIT_TRACE			_IOR('c', 1, unsigned long)
 #define KCOV_ENABLE			_IO('c', 100)
 #define KCOV_DISABLE			_IO('c', 101)
 #define KCOV_REMOTE_ENABLE		_IOW('c', 102, struct kcov_remote_arg)
+#define KCOV_REMOTE_GENERATION_BEGIN	_IOWR('c', 109, struct kcov_remote_generation)
+#define KCOV_REMOTE_GENERATION_BIND	_IOW('c', 110, struct kcov_remote_generation)
+#define KCOV_REMOTE_GENERATION_FINISH	_IOW('c', 111, struct kcov_remote_generation)
+#define KCOV_REMOTE_GENERATION_ABORT	_IOW('c', 112, struct kcov_remote_generation)
 
 enum {
 	/*

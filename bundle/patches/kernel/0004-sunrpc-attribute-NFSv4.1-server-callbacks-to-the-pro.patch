+/*
+ * A work item that holds only a generation reference runs several sections.
+ * Each gets its own Token and Ticket, a finished Ticket cannot be restarted,
+ * and a generation that was aborted refuses further sections.
+ */
+static noinline_for_stack bool kcov_request_phase5_test_section(void)
+{
+	struct kcov_request_phase5_test_ctx ctx = {};
+	struct kcov_request_generation *ref = NULL;
+	unsigned int i;
+	bool pass = false;
+
+	if (!kcov_request_phase5_test_init(&ctx, 0xf5000018) ||
+	    !kcov_request_phase5_test_grant(&ctx, 0))
+		goto out;
+	/* A granted and claimed parent yields a generation reference. */
+	ref = kcov_request_token_generation_get(&ctx.token[0]);
+	if (ref != ctx.generation)
+		goto out;
+	if (kcov_request_remote_start_checked(ctx.ticket[0]) !=
+			KCOV_REQUEST_REMOTE_START_SUCCESS)
+		goto out;
+	kcov_request_remote_stop_checked(ctx.ticket[0]);
+
+	for (i = 0; i < 2; i++) {
+		if (ctx.ticket[1]) {
+			kcov_request_remote_ticket_put(ctx.ticket[1]);
+			ctx.ticket[1] = NULL;
+		}
+		if (!__kcov_request_phase5_test_grant(&ctx, 1, true) ||
+		    kcov_request_remote_start_checked(ctx.ticket[1]) !=
+				KCOV_REQUEST_REMOTE_START_SUCCESS)
+			goto out;
+		kcov_request_remote_stop_checked(ctx.ticket[1]);
+		if (atomic_read(&ctx.ticket[1]->state) !=
+				KCOV_REQUEST_TICKET_DONE ||
+		    ctx.ticket[1]->scratch || ctx.token[1].generation)
+			goto out;
+		/* A finished Ticket is not reusable. */
+		if (kcov_request_remote_start_checked(ctx.ticket[1]) ==
+				KCOV_REQUEST_REMOTE_START_SUCCESS)
+			goto out;

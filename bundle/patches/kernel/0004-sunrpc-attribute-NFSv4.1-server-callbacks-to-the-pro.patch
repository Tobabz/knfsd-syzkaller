+static void
+nfsd4_run_cb_work(struct work_struct *work)
+{
+	struct nfsd4_callback *cb =
+		container_of(work, struct nfsd4_callback, cb_work);
+	struct sunrpc_fuzz_cb_section fuzz_section;
+	struct sunrpc_fuzz_cb_owner *fuzz_owner;

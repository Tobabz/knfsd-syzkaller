diff --git a/kernel/kcov.c b/kernel/kcov.c
index 000d88b01..9aad23001 100644
--- a/kernel/kcov.c
+++ b/kernel/kcov.c
@@ -2124,6 +2124,69 @@ void kcov_request_remote_ticket_put(
 }
 EXPORT_SYMBOL_GPL(kcov_request_remote_ticket_put);
 
+/* Pin the section the current task is running, if any. */
+static struct kcov_request_remote_ticket *kcov_request_current_ticket_get(void)
+{
+	struct kcov_request_remote_ticket *ticket;
+	unsigned long flags;
+
+	if (!in_task())
+		return NULL;
+	local_lock_irqsave(&kcov_percpu_data.lock, flags);
+	ticket = current->kcov_request_remote_ticket;
+	if (ticket && !refcount_inc_not_zero(&ticket->refs))
+		ticket = NULL;
+	local_unlock_irqrestore(&kcov_percpu_data.lock, flags);
+	if (ticket && (atomic_read(&ticket->state) !=
+			KCOV_REQUEST_TICKET_REMOTE_ACTIVE || !ticket->token)) {
+		kcov_request_remote_ticket_put(ticket);
+		ticket = NULL;
+	}
+	return ticket;
+}
+
+/*
+ * Take a generation reference from the section the current task is running
+ * and report its owner and cookie.  The token outlives the section, which the
+ * caller is inside of, so reading it here is safe.
+ */
+struct kcov_request_generation *kcov_request_current_section_ref(
+		struct kcov_common_handle_id *owner, u64 *cookie)
+{
+	struct kcov_request_remote_ticket *ticket;
+	struct kcov_request_generation *gen;
+
+	ticket = kcov_request_current_ticket_get();
+	if (!ticket)
+		return NULL;
+	gen = kcov_request_token_generation_get(ticket->token);
+	if (gen) {
+		*owner = ticket->token->owner;
+		*cookie = ticket->token->request_cookie;
+	}
+	kcov_request_remote_ticket_put(ticket);
+	return gen;
+}
+EXPORT_SYMBOL_GPL(kcov_request_current_section_ref);
+
+/* Is the current task already running a section for exactly this owner? */
+bool kcov_request_current_section_match(struct kcov_common_handle_id owner,
+		u64 cookie)
+{
+	struct kcov_request_remote_ticket *ticket;
+	bool match;
+
+	ticket = kcov_request_current_ticket_get();
+	if (!ticket)
+		return false;
+	match = ticket->token->owner.val == owner.val &&
+		ticket->token->owner.generation == owner.generation &&
+		ticket->token->request_cookie == cookie;
+	kcov_request_remote_ticket_put(ticket);
+	return match;
+}
+EXPORT_SYMBOL_GPL(kcov_request_current_section_match);
+

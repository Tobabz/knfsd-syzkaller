@@ -1680,7 +1680,7 @@ void svc_process(struct svc_rqst *rqstp)
 				 * but retire its stream as well so the client cannot wait
 				 * forever for a reply lost during lane quarantine.
 				 */
-				svc_xprt_deferred_close(rqstp->rq_xprt);
+				sunrpc_fuzz_svc_nested_disconnect(rqstp->rq_xprt);
 				kcov_request_phase5_note(
 					KCOV_REQUEST_P5_NESTED_TRANSPORT_CLOSE);
 			}
@@ -1695,7 +1695,7 @@ void svc_process(struct svc_rqst *rqstp)

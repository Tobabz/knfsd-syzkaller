 			sunrpc_fuzz_lane_mark_unhealthy(rqstp->rq_xprt->xpt_net);
 			sunrpc_fuzz_svc_remote_terminal(rqstp, true, true);
-			svc_xprt_deferred_close(rqstp->rq_xprt);
+			sunrpc_fuzz_svc_nested_disconnect(rqstp->rq_xprt);
 			kcov_request_phase5_note(
 				KCOV_REQUEST_P5_NESTED_TRANSPORT_CLOSE);
 			goto out_drop;
diff --git a/net/sunrpc/xprt.c b/net/sunrpc/xprt.c
index 46db0657f..4e7752cf1 100644
--- a/net/sunrpc/xprt.c
+++ b/net/sunrpc/xprt.c
@@ -814,7 +814,7 @@ xprt_request_retransmit_after_disconnect(struct rpc_task *task)
 }
 
 /**
- * xprt_conditional_disconnect - force a transport to disconnect
+ * xprt_conditional_disconnect_checked - conditionally disconnect a transport
  * @xprt: transport to disconnect
  * @cookie: 'connection cookie'
  *
@@ -823,18 +823,40 @@ xprt_request_retransmit_after_disconnect(struct rpc_task *task)
  * try to break the connection more than once when we need to retransmit
  * a batch of RPC requests.
  *
+ * Return: whether the cookie was stale, the matching transport was scheduled,
+ * or the matching transport was already closing.
  */
-void xprt_conditional_disconnect(struct rpc_xprt *xprt, unsigned int cookie)
+enum xprt_conditional_disconnect_status
+xprt_conditional_disconnect_checked(struct rpc_xprt *xprt,
+		unsigned int cookie)
 {
+	enum xprt_conditional_disconnect_status status =
+		XPRT_CONDITIONAL_DISCONNECT_STALE;
+
 	/* Don't race with the test_bit() in xprt_clear_locked() */
 	spin_lock(&xprt->transport_lock);
 	if (cookie != xprt->connect_cookie)
 		goto out;
-	if (test_bit(XPRT_CLOSING, &xprt->state))
+	status = XPRT_CONDITIONAL_DISCONNECT_ALREADY_CLOSING;
+	if (test_bit(XPRT_CLOSING, &xprt->state) ||
+	    test_bit(XPRT_CLOSE_WAIT, &xprt->state))
 		goto out;
 	xprt_schedule_autoclose_locked(xprt);
+	status = XPRT_CONDITIONAL_DISCONNECT_SCHEDULED;
 out:
 	spin_unlock(&xprt->transport_lock);
+	return status;
+}
+EXPORT_SYMBOL_GPL(xprt_conditional_disconnect_checked);
+
+/**
+ * xprt_conditional_disconnect - force a transport to disconnect
+ * @xprt: transport to disconnect
+ * @cookie: 'connection cookie'
+ */
+void xprt_conditional_disconnect(struct rpc_xprt *xprt, unsigned int cookie)
+{
+	xprt_conditional_disconnect_checked(xprt, cookie);
 }
 
 static bool

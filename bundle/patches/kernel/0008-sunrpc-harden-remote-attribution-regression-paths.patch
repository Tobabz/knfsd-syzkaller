diff --git a/kernel/kcov.c b/kernel/kcov.c
index c164e0eb2..166f7a916 100644
--- a/kernel/kcov.c
+++ b/kernel/kcov.c
@@ -2079,6 +2079,51 @@ static void kcov_request_phase5_test_cleanup(
 	kfree(ctx->kcov);
 }
 
+static noinline_for_stack bool
+kcov_request_phase5_test_mapping_classification(void)
+{
+	struct kcov_request_phase5_test_ctx ctx = {};
+	struct kcov_request_generation *granted;
+	bool pass = false;
+
+	if (!kcov_request_phase5_test_init(&ctx, 0xf5000017) ||
+	    !kcov_request_try_get_child_token(&ctx.root,
+		    KCOV_REQUEST_TOKEN_WIRE, &ctx.token[0]) ||
+	    !kcov_request_wire_token_set_identity(&ctx.token[0],
+		    ctx.owner, ctx.cookie[0]))
+		goto out;
+	granted = kcov_request_remote_admit(ctx.cookie[0],
+		(struct kcov_common_handle_id){
+			.val = ctx.owner.val,
+			.generation = ctx.owner.generation + 1,
+		}, &ctx.token[0]);
+	if (!IS_ERR(granted)) {
+		kcov_request_remote_ref_put(granted);
+		goto out;
+	}
+	granted = kcov_request_remote_admit(ctx.cookie[0] ^ 1, ctx.owner,
+		&ctx.token[0]);
+	if (!IS_ERR(granted)) {
+		kcov_request_remote_ref_put(granted);
+		goto out;
+	}
+	kcov_request_remote_degrade(ctx.generation,
+		KCOV_REQUEST_REMOTE_INCOMPLETE,
+		KCOV_REQUEST_REMOTE_ISSUE_START_FAILED);
+	granted = kcov_request_remote_admit(ctx.cookie[0], ctx.owner,
+		&ctx.token[0]);
+	if (!IS_ERR(granted)) {
+		kcov_request_remote_ref_put(granted);
+		goto out;
+	}
+	kcov_request_phase5_note(
+		KCOV_REQUEST_P5_SELFTEST_MAPPING_CLASSIFICATION);
+	pass = true;
+out:
+	kcov_request_phase5_test_cleanup(&ctx);
+	return pass;
+}
+
 bool kcov_request_phase5_selftest(void)
 {
 	struct kcov_request_phase5_test_ctx normal = {}, failed = {}, aborted = {};
@@ -2131,6 +2176,14 @@ bool kcov_request_phase5_selftest(void)
 		goto out_aborted;
 	kcov_request_phase5_note(KCOV_REQUEST_P5_SELFTEST_ABORT_AFTER_GRANT);
 
+	/*
+	 * Identity misses and an exact identity rejected by generation policy
+	 * are observably distinct.  The Gate verifies the exact counter
+	 * partition produced by these three admissions.
+	 */
+	if (!kcov_request_phase5_test_mapping_classification())
+		goto out_aborted;
+
 	if (!kcov_request_phase5_test_init(&same, 0xf5000012) ||
 	    !kcov_request_phase5_test_grant(&same, 0) ||
 	    !kcov_request_phase5_test_grant(&same, 1) ||
diff --git a/kernel/kcov_request.c b/kernel/kcov_request.c
index 75492809e..507975aa5 100644
--- a/kernel/kcov_request.c
+++ b/kernel/kcov_request.c
@@ -384,6 +384,8 @@ static const char *const request_phase5_stat_names[] = {
 		"selftest_stop_exact_once",
 	[KCOV_REQUEST_P5_SELFTEST_ABORT_AFTER_GRANT] =
 		"selftest_abort_after_grant",
+	[KCOV_REQUEST_P5_SELFTEST_MAPPING_CLASSIFICATION] =
+		"selftest_mapping_classification",
 	[KCOV_REQUEST_P5_SVC_RQST_FUZZ_RESET] = "svc_rqst_fuzz_reset",
 	[KCOV_REQUEST_P5_SVC_RQST_STALE_ATTACHMENT] =
 		"svc_rqst_stale_attachment",
@@ -399,6 +401,12 @@ static const char *const request_phase5_stat_names[] = {
 		"nested_ownerless_fallback",
 	[KCOV_REQUEST_P5_NESTED_TRANSPORT_CLOSE] =
 		"nested_transport_close",
+	[KCOV_REQUEST_P5_NESTED_CLIENT_FORCE_DISCONNECT] =
+		"nested_client_force_disconnect",
+	[KCOV_REQUEST_P5_NESTED_CLIENT_ALREADY_CLOSING] =
+		"nested_client_already_closing",
+	[KCOV_REQUEST_P5_NESTED_CLIENT_DISCONNECT_MISS] =
+		"nested_client_disconnect_miss",
 };
 
 static void request_stat_inc(enum request_stat stat)
@@ -1225,40 +1233,60 @@ struct kcov_request_generation *kcov_request_remote_admit(
 	}
 
 	spin_lock(&gen->lock);
-	if (gen->owner != owner.val || gen->id != owner.generation ||
-	    (gen->state != KCOV_REQUEST_GEN_OPEN &&
+	if (gen->owner != owner.val || gen->id != owner.generation) {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_GRANT_REJECTED_GENERATION);
+		goto mapping_miss;
+	}
+
+	if (token->request_cookie != request_cookie ||
+	    token->owner.val != owner.val ||
+	    token->owner.generation != owner.generation) {
+		kcov_request_phase5_note(KCOV_REQUEST_P5_GRANT_REJECTED_TOKEN);
+		goto mapping_miss;
+	}
+
+	/*
+	 * Identity correlation succeeded independently of whether this exact
+	 * generation is still eligible to admit new remote work.  In
+	 * particular, an INCOMPLETE/INVALID generation may have quarantined its
+	 * aggregate while later records from the same owner are still draining.
+	 * Such a policy rejection is not an owner mapping mismatch.
+	 */
+	kcov_request_phase5_note(KCOV_REQUEST_P5_OWNER_MAPPING_EXACT);
+	if ((gen->state != KCOV_REQUEST_GEN_OPEN &&
 	     gen->state != KCOV_REQUEST_GEN_CLOSING) ||
 	    !gen->aggregate_area ||
 	    (gen->aggregate_state != KCOV_REQUEST_AGGREGATE_OPEN &&
 	     gen->aggregate_state != KCOV_REQUEST_AGGREGATE_CLOSING)) {
 		kcov_request_phase5_note(
 			KCOV_REQUEST_P5_GRANT_REJECTED_GENERATION);
-		goto stale;
+		goto policy_reject;
 	}
 	if (atomic_read(&token->completed) != REQUEST_TOKEN_ACTIVE ||
-	    token->remote_claimed || token->request_cookie != request_cookie ||
-	    token->owner.val != owner.val ||
-	    token->owner.generation != owner.generation) {
+	    token->remote_claimed) {
 		kcov_request_phase5_note(KCOV_REQUEST_P5_GRANT_REJECTED_TOKEN);
-		goto stale;
+		goto policy_reject;
 	}
 	if (atomic_cmpxchg(&token->completed, REQUEST_TOKEN_ACTIVE,
 			REQUEST_TOKEN_START_GRANTED) != REQUEST_TOKEN_ACTIVE) {
 		kcov_request_phase5_note(KCOV_REQUEST_P5_GRANT_REJECTED_TOKEN);
-		goto stale;
+		goto policy_reject;
 	}
 
 	token->remote_claimed = 1;
 	gen->remote_refs++;
 	refcount_inc(&gen->object_refs);
 	spin_unlock(&gen->lock);
-	kcov_request_phase5_note(KCOV_REQUEST_P5_OWNER_MAPPING_EXACT);
 	kcov_request_phase5_note(KCOV_REQUEST_P5_REMOTE_REF_GET);
 	return gen;
-stale:
+mapping_miss:
 	spin_unlock(&gen->lock);
 	kcov_request_phase5_note(KCOV_REQUEST_P5_OWNER_MAPPING_MISS);
 	return ERR_PTR(-ESTALE);
+policy_reject:
+	spin_unlock(&gen->lock);
+	return ERR_PTR(-ESTALE);
 }
 EXPORT_SYMBOL_GPL(kcov_request_remote_admit);
 
diff --git a/net/sunrpc/fuzz_conn.c b/net/sunrpc/fuzz_conn.c
index 9ddd4fd71..9042da5ed 100644
--- a/net/sunrpc/fuzz_conn.c
+++ b/net/sunrpc/fuzz_conn.c
@@ -166,6 +166,7 @@ struct sunrpc_fuzz_conn {
 	bool client_attached;
 	bool server_attached;
 	struct rpc_xprt *client_xprt;
+	unsigned int client_connect_cookie;
 	struct svc_xprt *server_xprt;
 	u64 ordinal_mismatch;
 	u64 last_request_cookie[SUNRPC_FUZZ_WIRE_DIRECTIONS];
@@ -436,6 +437,59 @@ static struct sunrpc_fuzz_conn *svc_conn_get(struct svc_xprt *xprt)
 	return conn;
 }
 
+/**
+ * sunrpc_fuzz_svc_nested_disconnect - retire both sides of a nested stream
+ * @xprt: server transport on which nested KCOV was detected
+ *
+ * Closing only the svc_xprt can leave a hard-mounted client asleep on the
+ * paired rpc_xprt while the server drops the request.  Pin the exact paired
+ * client transport under the pairing registry lock, force its disconnect so
+ * the RPC scheduler wakes and retries ownerless, and defer-close the server
+ * side as before.  The connection object and ordinals retain their normal
+ * connection lifetime; this helper does not make generation ABORT a generic
+ * connection teardown operation.
+ */
+void sunrpc_fuzz_svc_nested_disconnect(struct svc_xprt *xprt)
+{
+	struct sunrpc_fuzz_conn *conn;
+	struct rpc_xprt *client = NULL;
+	enum xprt_conditional_disconnect_status status =
+		XPRT_CONDITIONAL_DISCONNECT_STALE;
+	unsigned int connect_cookie = 0;
+	unsigned long flags;
+
+	conn = svc_conn_get(xprt);
+	if (conn) {
+		spin_lock_irqsave(&conn_lock, flags);
+		if (conn->client_xprt) {
+			client = xprt_get(conn->client_xprt);
+			if (client)
+				connect_cookie = conn->client_connect_cookie;
+		}
+		spin_unlock_irqrestore(&conn_lock, flags);
+		conn_put(conn);
+	}
+
+	if (client) {
+		status = xprt_conditional_disconnect_checked(client,
+				connect_cookie);
+		xprt_put(client);
+	}
+	if (status == XPRT_CONDITIONAL_DISCONNECT_SCHEDULED) {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_NESTED_CLIENT_FORCE_DISCONNECT);
+	} else if (status ==
+		   XPRT_CONDITIONAL_DISCONNECT_ALREADY_CLOSING) {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_NESTED_CLIENT_ALREADY_CLOSING);
+	} else {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_NESTED_CLIENT_DISCONNECT_MISS);
+	}
+	svc_xprt_deferred_close(xprt);
+}
+EXPORT_SYMBOL_GPL(sunrpc_fuzz_svc_nested_disconnect);
+
 static void rpc_conn_replace(struct rpc_xprt *xprt,
 		struct sunrpc_fuzz_conn *new)
 {
@@ -649,6 +703,20 @@ void sunrpc_fuzz_tcp_connect_result(struct rpc_xprt *xprt, int status)
 	conn_put(conn);
 }
 
+void sunrpc_fuzz_rpc_connected(struct rpc_xprt *xprt)
+{
+	struct sunrpc_fuzz_conn *conn = rpc_conn_get(xprt);
+	unsigned long flags;
+
+	if (!conn)
+		return;
+	spin_lock_irqsave(&conn_lock, flags);
+	if (xprt->fuzz_conn == conn && conn->client_xprt == xprt)
+		conn->client_connect_cookie = READ_ONCE(xprt->connect_cookie);
+	spin_unlock_irqrestore(&conn_lock, flags);
+	conn_put(conn);
+}
+
 void sunrpc_fuzz_svc_pair(struct svc_xprt *xprt)
 {
 	struct sunrpc_fuzz_pending *pending, *tmp, *match = NULL;
@@ -680,6 +748,9 @@ void sunrpc_fuzz_svc_pair(struct svc_xprt *xprt)
 			list_del(&pending->list);
 			match = pending;
 			match->conn->paired = true;
+			if (match->conn->client_xprt)
+				match->conn->client_connect_cookie = READ_ONCE(
+					match->conn->client_xprt->connect_cookie);
 			break;
 		}
 	}

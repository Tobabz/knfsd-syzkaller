+void kcov_request_remote_degrade(struct kcov_request_generation *gen,
+		enum kcov_request_remote_result result, unsigned int issue)
+{
+	bool changed = false;
+
+	if (!gen)
+		return;
+	spin_lock(&gen->lock);
+	if (result > gen->remote_result) {
+		gen->remote_result = result;
+		changed = true;
+	}
+	gen->remote_issues |= issue;
+	spin_unlock(&gen->lock);
+	if (!changed)
+		return;
+	if (result == KCOV_REQUEST_REMOTE_INCOMPLETE)
+		kcov_request_phase5_note(KCOV_REQUEST_P5_RESULT_INCOMPLETE);
+	else if (result == KCOV_REQUEST_REMOTE_INVALID)
+		kcov_request_phase5_note(KCOV_REQUEST_P5_RESULT_INVALID);
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_degrade);

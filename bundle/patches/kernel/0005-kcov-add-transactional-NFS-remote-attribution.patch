diff --git a/kernel/kcov.c b/kernel/kcov.c
index fd155ddf8..1b3312488 100644
--- a/kernel/kcov.c
+++ b/kernel/kcov.c
@@ -88,6 +88,28 @@ struct kcov_remote {
 	struct hlist_node	hnode;
 };
 
+enum kcov_request_ticket_state {
+	KCOV_REQUEST_TICKET_START_GRANTED = 0,
+	KCOV_REQUEST_TICKET_REMOTE_ACTIVE,
+	KCOV_REQUEST_TICKET_FINALIZING,
+	KCOV_REQUEST_TICKET_DONE,
+};
+
+struct kcov_request_remote_ticket {
+	refcount_t refs;
+	struct kcov_request_generation *generation;
+	struct kcov_request_token *token;
+	struct kcov *kcov;
+	void *scratch;
+	unsigned int scratch_size;
+	enum kcov_mode mode;
+	int sequence;
+	struct kcov_common_handle_id owner;
+	atomic_t state;
+	bool remote_ref_held;
+	bool target_pinned;
+};
+
 static DEFINE_SPINLOCK(kcov_remote_lock);
 static DEFINE_HASHTABLE(kcov_remote_map, 4);
 static struct list_head kcov_remote_areas[2] = {
@@ -394,6 +416,7 @@ void kcov_task_init(struct task_struct *t)
 	t->kcov_handle_generation = current->kcov_handle_generation;
 	/* Generation binding inherits, whole-generation ABORT authority does not. */
 	t->kcov_request_generation_controller = false;
+	t->kcov_request_remote_ticket = NULL;
 	t->kcov_softirq = 0;
 	t->kcov_saved_mode = 0;
 	t->kcov_saved_size = 0;
@@ -477,6 +500,13 @@ void kcov_task_exit(struct task_struct *t)
 	struct kcov *kcov;
 	unsigned long flags;
 
+	/* A task must never abandon an active Phase 5 scratch writer. */
+	if (t->kcov_request_remote_ticket &&
+	    !kcov_request_remote_reset_checked(
+			t->kcov_request_remote_ticket))
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_START_TRANSACTION_VIOLATION);
+
 	/*
 	 * A BEGIN controller may die before userspace can FINISH/ABORT the exact
 	 * id.  Retire attribution by its immutable {handle,generation}; ordinary
@@ -1305,6 +1335,568 @@ void kcov_remote_stop(void)
 }
 EXPORT_SYMBOL(kcov_remote_stop);
 
+static void kcov_request_remote_scratch_put(
+		struct kcov_request_remote_ticket *ticket)
+{
+	unsigned long flags;
+
+	if (!ticket->scratch)
+		return;
+	spin_lock_irqsave(&kcov_remote_lock, flags);
+	kcov_remote_area_put(ticket->scratch, ticket->scratch_size, false);
+	spin_unlock_irqrestore(&kcov_remote_lock, flags);
+	ticket->scratch = NULL;
+	kcov_request_phase5_note(KCOV_REQUEST_P5_SCRATCH_RETURNED);
+}
+
+static void kcov_request_remote_target_put(
+		struct kcov_request_remote_ticket *ticket)
+{
+	if (!ticket->target_pinned)
+		return;
+	ticket->target_pinned = false;
+	kcov_request_phase5_note(KCOV_REQUEST_P5_TARGET_UNPINNED);
+	kcov_put(ticket->kcov);
+	ticket->kcov = NULL;
+}
+
+static void kcov_request_remote_finish_ticket(
+		struct kcov_request_remote_ticket *ticket, bool canceled)
+{
+	/* Phase 6 owns scratch-to-aggregate merge; Phase 5 only discards. */
+	kcov_request_remote_scratch_put(ticket);
+	kcov_request_remote_target_put(ticket);
+	if (ticket->remote_ref_held) {
+		ticket->remote_ref_held = false;
+		kcov_request_remote_ref_put(ticket->generation);
+	}
+	if (ticket->token)
+		kcov_request_token_complete_once(ticket->token);
+	atomic_set(&ticket->state, KCOV_REQUEST_TICKET_DONE);
+	kcov_request_phase5_live_ticket_put();
+	kcov_request_phase5_note(canceled ?
+		KCOV_REQUEST_P5_TICKET_CANCELED :
+		KCOV_REQUEST_P5_TICKET_COMPLETED);
+}
+
+int kcov_request_remote_try_grant(u64 request_cookie,
+		struct kcov_common_handle_id owner,
+		struct kcov_request_token *token,
+		struct kcov_request_remote_ticket **ticketp)
+{
+	struct kcov_request_remote_ticket *ticket;
+	struct kcov_request_generation *generation;
+	struct kcov_remote_area *scratch;
+	struct kcov_request_generation *target_generation;
+	struct kcov_remote *remote;
+	struct kcov *kcov;
+	unsigned int size;
+	enum kcov_mode mode;
+	int sequence;
+	int ret = -ESTALE;
+	unsigned long flags;
+
+	if (!ticketp)
+		return -EINVAL;
+	*ticketp = NULL;
+	if (!request_cookie || !owner.val || !owner.generation || !token)
+		return -EINVAL;
+	ticket = kzalloc(sizeof(*ticket), GFP_KERNEL);
+	if (!ticket)
+		return -ENOMEM;
+
+	/* Provisional target pin: no generation lock is held here. */
+	spin_lock_irqsave(&kcov_remote_lock, flags);
+	remote = kcov_remote_find(owner.val);
+	if (!remote) {
+		spin_unlock_irqrestore(&kcov_remote_lock, flags);
+		goto out_free;
+	}
+	kcov = remote->kcov;
+	kcov_get(kcov);
+	spin_unlock_irqrestore(&kcov_remote_lock, flags);
+	ticket->kcov = kcov;
+	ticket->target_pinned = true;
+	kcov_request_phase5_note(KCOV_REQUEST_P5_TARGET_PINNED);
+
+	spin_lock_irqsave(&kcov->lock, flags);
+	target_generation = kcov->request_generation;
+	if (!kcov->remote || kcov->request_common_handle != owner.val ||
+	    !target_generation ||
+	    kcov_request_generation_id(target_generation) != owner.generation) {
+		spin_unlock_irqrestore(&kcov->lock, flags);
+		goto out_target;
+	}
+	size = kcov->remote_size;
+	mode = kcov->mode;
+	sequence = kcov->sequence;
+	spin_unlock_irqrestore(&kcov->lock, flags);
+	if (size < 2 ||
+	    size < DIV_ROUND_UP(sizeof(struct kcov_remote_area),
+				sizeof(unsigned long)))
+		goto out_target;
+
+	spin_lock_irqsave(&kcov_remote_lock, flags);
+	scratch = kcov_remote_area_get(size, false);
+	spin_unlock_irqrestore(&kcov_remote_lock, flags);
+	if (!scratch) {
+		scratch = vmalloc(size * sizeof(unsigned long));
+		if (!scratch) {
+			ret = -ENOMEM;
+			goto out_target;
+		}
+	}
+	ticket->scratch = scratch;
+	ticket->scratch_size = size;
+	*(unsigned long *)ticket->scratch = 0;
+	kcov_request_phase5_note(KCOV_REQUEST_P5_SCRATCH_RESERVED);
+	ticket->generation = token->generation;
+	ticket->token = token;
+	ticket->mode = mode;
+	ticket->sequence = sequence;
+	ticket->owner = owner;
+	/* Private ownership bit is initialized before the grant CAS publishes. */
+	ticket->remote_ref_held = true;
+	refcount_set(&ticket->refs, 1);
+	atomic_set(&ticket->state, KCOV_REQUEST_TICKET_START_GRANTED);
+
+	/*
+	 * Lock order is kcov->lock -> generation->lock.  All provisional
+	 * resources are private until this exact validation and token CAS make
+	 * START_GRANTED externally visible by returning the ticket.
+	 */
+	spin_lock_irqsave(&kcov->lock, flags);
+	target_generation = kcov->request_generation;
+	if (!kcov->remote || kcov->request_common_handle != owner.val ||
+	    kcov->sequence != sequence || kcov->mode != mode ||
+	    kcov->remote_size != size || !target_generation ||
+	    kcov_request_generation_id(target_generation) != owner.generation) {
+		spin_unlock_irqrestore(&kcov->lock, flags);
+		goto out_scratch;
+	}
+	generation = kcov_request_remote_admit(request_cookie, owner, token);
+	if (IS_ERR(generation)) {
+		ret = PTR_ERR(generation);
+		ticket->remote_ref_held = false;
+		spin_unlock_irqrestore(&kcov->lock, flags);
+		goto out_scratch;
+	}
+	if (WARN_ON_ONCE(generation != ticket->generation))
+		kcov_request_phase5_note(KCOV_REQUEST_P5_GRANT_ORDER_VIOLATION);
+	ticket->generation = generation;
+	spin_unlock_irqrestore(&kcov->lock, flags);
+
+	kcov_request_phase5_live_ticket_get();
+	kcov_request_phase5_note(KCOV_REQUEST_P5_TICKET_CREATED);
+	kcov_request_phase5_note(KCOV_REQUEST_P5_START_GRANTED);
+	*ticketp = ticket;
+	return 0;
+
+out_scratch:
+	kcov_request_remote_scratch_put(ticket);
+out_target:
+	kcov_request_remote_target_put(ticket);
+out_free:
+	kfree(ticket);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_try_grant);
+
+enum kcov_request_remote_start_result kcov_request_remote_start_checked(
+		struct kcov_request_remote_ticket *ticket)
+{
+	struct task_struct *t = current;
+	struct kcov_request_remote_ticket *incumbent = NULL;
+	enum kcov_request_phase5_fault fault;
+	unsigned int current_mode;
+	unsigned long flags;
+	bool inject_same_nested = false;
+
+	if (!ticket || !in_task() ||
+	    atomic_read(&ticket->state) !=
+		KCOV_REQUEST_TICKET_START_GRANTED)
+		return KCOV_REQUEST_REMOTE_START_FAILURE;
+
+	fault = kcov_request_phase5_before_start(ticket->generation);
+	if (fault == KCOV_REQUEST_P5_FAULT_START_FAIL) {
+		kcov_request_phase5_note(KCOV_REQUEST_P5_STAT_FAULT_START_FAIL);
+		kcov_request_phase5_note(KCOV_REQUEST_P5_START_INCOMPLETE);
+		return KCOV_REQUEST_REMOTE_START_FAILURE;
+	}
+	if (fault == KCOV_REQUEST_P5_FAULT_NESTED_CROSS) {
+		kcov_request_phase5_note(KCOV_REQUEST_P5_START_NESTED);
+		return KCOV_REQUEST_REMOTE_START_NESTED;
+	}
+	if (fault == KCOV_REQUEST_P5_FAULT_NESTED_SAME)
+		inject_same_nested = true;
+
+	local_lock_irqsave(&kcov_percpu_data.lock, flags);
+	current_mode = READ_ONCE(t->kcov_mode);
+	barrier();
+	if (kcov_mode_enabled(current_mode)) {
+		incumbent = t->kcov_request_remote_ticket;
+		if (incumbent && !refcount_inc_not_zero(&incumbent->refs))
+			incumbent = NULL;
+		local_unlock_irqrestore(&kcov_percpu_data.lock, flags);
+		if (incumbent)
+			kcov_request_phase5_note(
+				KCOV_REQUEST_P5_NESTED_INCUMBENT_ACTIVE_MATCH);
+		else
+			kcov_request_phase5_note(
+				KCOV_REQUEST_P5_NESTED_WITHOUT_ACTIVE_INCUMBENT);
+		kcov_request_remote_nested(ticket->generation,
+			incumbent ? incumbent->generation : NULL);
+		if (incumbent)
+			kcov_request_remote_ticket_put(incumbent);
+		kcov_request_phase5_note(KCOV_REQUEST_P5_START_NESTED);
+		return KCOV_REQUEST_REMOTE_START_NESTED;
+	}
+
+	/* START_GRANTED pins the exact object/mode/sequence; never re-admit. */
+	if (atomic_cmpxchg(&ticket->state,
+		    KCOV_REQUEST_TICKET_START_GRANTED,
+		    KCOV_REQUEST_TICKET_REMOTE_ACTIVE) !=
+		    KCOV_REQUEST_TICKET_START_GRANTED) {
+		local_unlock_irqrestore(&kcov_percpu_data.lock, flags);
+		kcov_request_phase5_note(KCOV_REQUEST_P5_START_INCOMPLETE);
+		return KCOV_REQUEST_REMOTE_START_FAILURE;
+	}
+
+	t->kcov_request_remote_ticket = ticket;
+	kcov_start(t, ticket->kcov, ticket->scratch_size, ticket->scratch,
+		ticket->mode, ticket->sequence);
+	local_unlock_irqrestore(&kcov_percpu_data.lock, flags);
+	kcov_request_phase5_note(KCOV_REQUEST_P5_START_OK);
+	if (inject_same_nested) {
+		/* Fault probe observes a genuinely active exact incumbent. */
+		kcov_request_phase5_note_active_nested(ticket->generation);
+		kcov_request_phase5_note(KCOV_REQUEST_P5_START_NESTED);
+	}
+	if (kcov_request_remote_was_aborted(ticket->generation)) {
+		kcov_request_phase5_note(KCOV_REQUEST_P5_ABORT_AFTER_GRANT);
+		kcov_request_phase5_note(KCOV_REQUEST_P5_START_AFTER_ABORT_OK);
+	}
+	kcov_request_phase5_after_start(ticket->generation);
+	return KCOV_REQUEST_REMOTE_START_SUCCESS;
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_start_checked);
+
+void kcov_request_remote_start_failed(
+		struct kcov_request_remote_ticket *ticket, bool nested)
+{
+	if (!ticket || atomic_cmpxchg(&ticket->state,
+			KCOV_REQUEST_TICKET_START_GRANTED,
+			KCOV_REQUEST_TICKET_FINALIZING) !=
+			KCOV_REQUEST_TICKET_START_GRANTED) {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_START_TRANSACTION_VIOLATION);
+		return;
+	}
+	if (nested)
+		kcov_request_remote_degrade(ticket->generation,
+			KCOV_REQUEST_REMOTE_INVALID,
+			KCOV_REQUEST_REMOTE_ISSUE_NESTED);
+	else
+		kcov_request_remote_degrade(ticket->generation,
+			KCOV_REQUEST_REMOTE_INCOMPLETE,
+			KCOV_REQUEST_REMOTE_ISSUE_START_FAILED);
+	kcov_request_remote_finish_ticket(ticket, true);
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_start_failed);
+
+void kcov_request_remote_stop_checked(
+		struct kcov_request_remote_ticket *ticket)
+{
+	struct task_struct *t = current;
+	unsigned long flags;
+
+	if (!ticket)
+		return;
+	local_lock_irqsave(&kcov_percpu_data.lock, flags);
+	if (t->kcov_request_remote_ticket != ticket ||
+	    atomic_cmpxchg(&ticket->state, KCOV_REQUEST_TICKET_REMOTE_ACTIVE,
+		    KCOV_REQUEST_TICKET_FINALIZING) !=
+		    KCOV_REQUEST_TICKET_REMOTE_ACTIVE) {
+		local_unlock_irqrestore(&kcov_percpu_data.lock, flags);
+		kcov_request_phase5_note(KCOV_REQUEST_P5_REMOTE_STOP_DOUBLE);
+		return;
+	}
+	kcov_stop(t);
+	t->kcov_request_remote_ticket = NULL;
+	local_unlock_irqrestore(&kcov_percpu_data.lock, flags);
+	kcov_request_phase5_note(KCOV_REQUEST_P5_STOP_OK);
+	kcov_request_remote_finish_ticket(ticket, false);
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_stop_checked);
+
+bool kcov_request_remote_reset_checked(
+		struct kcov_request_remote_ticket *ticket)
+{
+	int state;
+
+	if (!ticket)
+		return true;
+	state = atomic_read(&ticket->state);
+	if (state == KCOV_REQUEST_TICKET_START_GRANTED) {
+		kcov_request_remote_start_failed(ticket, false);
+		return atomic_read(&ticket->state) == KCOV_REQUEST_TICKET_DONE;
+	}
+	if (state == KCOV_REQUEST_TICKET_REMOTE_ACTIVE) {
+		if (current->kcov_request_remote_ticket != ticket) {
+			kcov_request_remote_degrade(ticket->generation,
+				KCOV_REQUEST_REMOTE_INVALID,
+				KCOV_REQUEST_REMOTE_ISSUE_NESTED);
+			kcov_request_phase5_note(
+				KCOV_REQUEST_P5_START_TRANSACTION_VIOLATION);
+			return false;
+		}
+		kcov_request_remote_stop_checked(ticket);
+		return atomic_read(&ticket->state) == KCOV_REQUEST_TICKET_DONE;
+	}
+	return state == KCOV_REQUEST_TICKET_DONE;
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_reset_checked);
+
+bool kcov_request_remote_is_invalid(
+		struct kcov_request_remote_ticket *ticket)
+{
+	struct kcov_request_generation *gen;
+
+	if (!ticket || !(gen = ticket->generation))
+		return true;
+	/* The generation object is pinned for the whole ticket lifetime. */
+	/* Keep the private generation layout confined to kcov_request.c. */
+	return kcov_request_remote_result_is_invalid(gen);
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_is_invalid);
+
+void kcov_request_remote_ticket_put(
+		struct kcov_request_remote_ticket *ticket)
+{
+	if (ticket && refcount_dec_and_test(&ticket->refs))
+		kfree(ticket);
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_ticket_put);
+
+struct kcov_request_phase5_test_ctx {
+	struct kcov_request_generation *generation;
+	struct kcov_request_root root;
+	struct kcov_request_token token[2];
+	struct kcov_request_remote_ticket *ticket[2];
+	struct kcov *kcov;
+	struct kcov_common_handle_id owner;
+	u64 cookie[2];
+};
+
+static bool kcov_request_phase5_test_init(
+		struct kcov_request_phase5_test_ctx *ctx, u64 owner)
+{
+	u64 generation;
+
+	memset(ctx, 0, sizeof(*ctx));
+	ctx->generation = kcov_request_generation_begin(owner, &generation);
+	if (IS_ERR(ctx->generation)) {
+		ctx->generation = NULL;
+		return false;
+	}
+	ctx->owner = (struct kcov_common_handle_id){
+		.val = owner, .generation = generation };
+	ctx->cookie[0] = owner ^ 0x5a5a01;
+	ctx->cookie[1] = owner ^ 0x5a5a02;
+	if (!kcov_request_root_init(&ctx->root, ctx->owner, ctx->cookie[0]))
+		return false;
+	ctx->kcov = kzalloc(sizeof(*ctx->kcov), GFP_KERNEL);
+	if (!ctx->kcov)
+		return false;
+	spin_lock_init(&ctx->kcov->lock);
+	refcount_set(&ctx->kcov->refcount, 1);
+	ctx->kcov->remote = true;
+	ctx->kcov->remote_size = 64;
+	ctx->kcov->mode = KCOV_MODE_TRACE_PC;
+	ctx->kcov->sequence = 1;
+	ctx->kcov->request_generation = ctx->generation;
+	ctx->kcov->request_common_handle = owner;
+	return true;
+}
+
+static bool kcov_request_phase5_test_grant(
+		struct kcov_request_phase5_test_ctx *ctx, unsigned int index)
+{
+	struct kcov_request_remote_ticket *ticket;
+	struct kcov_request_generation *generation;
+	struct kcov_remote_area *scratch;
+	unsigned long flags;
+
+	if (index >= ARRAY_SIZE(ctx->ticket) || !ctx->kcov)
+		return false;
+	if (!kcov_request_try_get_child_token(&ctx->root,
+			KCOV_REQUEST_TOKEN_WIRE, &ctx->token[index]) ||
+	    !kcov_request_wire_token_set_identity(&ctx->token[index],
+			ctx->owner, ctx->cookie[index]))
+		return false;
+	ticket = kzalloc(sizeof(*ticket), GFP_KERNEL);
+	if (!ticket)
+		return false;
+	ticket->scratch_size = ctx->kcov->remote_size;
+	spin_lock_irqsave(&kcov_remote_lock, flags);
+	scratch = kcov_remote_area_get(ticket->scratch_size, false);
+	spin_unlock_irqrestore(&kcov_remote_lock, flags);
+	ticket->scratch = scratch;
+	if (!ticket->scratch)
+		ticket->scratch = vmalloc(array_size(ticket->scratch_size,
+						     sizeof(unsigned long)));
+	if (!ticket->scratch)
+		goto out_free;
+	*(unsigned long *)ticket->scratch = 0;
+	ticket->generation = ctx->generation;
+	ticket->token = &ctx->token[index];
+	ticket->kcov = ctx->kcov;
+	ticket->mode = ctx->kcov->mode;
+	ticket->sequence = ctx->kcov->sequence;
+	ticket->owner = ctx->owner;
+	refcount_set(&ticket->refs, 1);
+	atomic_set(&ticket->state, KCOV_REQUEST_TICKET_START_GRANTED);
+	generation = kcov_request_remote_admit(ctx->cookie[index], ctx->owner,
+			&ctx->token[index]);
+	if (IS_ERR(generation))
+		goto out_scratch;
+	ticket->generation = generation;
+	ticket->remote_ref_held = true;
+	ctx->ticket[index] = ticket;
+	kcov_request_phase5_live_ticket_get();
+	kcov_request_phase5_note(KCOV_REQUEST_P5_SCRATCH_RESERVED);
+	kcov_request_phase5_note(KCOV_REQUEST_P5_TICKET_CREATED);
+	kcov_request_phase5_note(KCOV_REQUEST_P5_START_GRANTED);
+	return true;
+out_scratch:
+	vfree(ticket->scratch);
+out_free:
+	kfree(ticket);
+	return false;
+}
+
+static void kcov_request_phase5_test_cleanup(
+		struct kcov_request_phase5_test_ctx *ctx)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(ctx->ticket); i++) {
+		if (!ctx->ticket[i])
+			continue;
+		if (atomic_read(&ctx->ticket[i]->state) !=
+				KCOV_REQUEST_TICKET_DONE)
+			kcov_request_remote_reset_checked(ctx->ticket[i]);
+		kcov_request_remote_ticket_put(ctx->ticket[i]);
+		ctx->ticket[i] = NULL;
+	}
+	if (ctx->root.generation)
+		kcov_request_root_finish(&ctx->root);
+	for (i = 0; i < ARRAY_SIZE(ctx->token); i++)
+		if (ctx->token[i].generation)
+			kcov_request_token_complete_once(&ctx->token[i]);
+	if (ctx->generation) {
+		kcov_request_generation_abort(ctx->generation);
+		kcov_request_generation_put(ctx->generation);
+	}
+	kfree(ctx->kcov);
+}
+
+bool kcov_request_phase5_selftest(void)
+{
+	struct kcov_request_phase5_test_ctx normal = {}, failed = {}, aborted = {};
+	struct kcov_request_phase5_test_ctx same = {};
+	struct kcov_request_phase5_test_ctx incumbent = {}, attempted = {};
+	enum kcov_request_remote_start_result result;
+	bool pass = false;
+
+	if (kcov_mode_enabled(READ_ONCE(current->kcov_mode)))
+		return false;
+	if (!kcov_request_phase5_test_init(&normal, 0xf5000011) ||
+	    !kcov_request_phase5_test_grant(&normal, 0))
+		goto out_normal;
+	kcov_request_phase5_note(KCOV_REQUEST_P5_SELFTEST_GRANT_ORDER);
+	result = kcov_request_remote_start_checked(normal.ticket[0]);
+	if (result != KCOV_REQUEST_REMOTE_START_SUCCESS)
+		goto out_normal;
+	kcov_request_remote_stop_checked(normal.ticket[0]);
+	if (atomic_read(&normal.ticket[0]->state) !=
+			KCOV_REQUEST_TICKET_DONE || normal.ticket[0]->scratch ||
+	    normal.ticket[0]->remote_ref_held || normal.token[0].generation)
+		goto out_normal;
+	kcov_request_phase5_note(KCOV_REQUEST_P5_SELFTEST_STOP_EXACT_ONCE);
+
+	if (!kcov_request_phase5_test_init(&failed, 0xf5000015) ||
+	    !kcov_request_phase5_test_grant(&failed, 0))
+		goto out_failed;
+	kcov_request_remote_start_failed(failed.ticket[0], false);
+	if (kcov_mode_enabled(READ_ONCE(current->kcov_mode)) ||
+	    atomic_read(&failed.ticket[0]->state) !=
+			KCOV_REQUEST_TICKET_DONE)
+		goto out_failed;
+	kcov_request_phase5_note(KCOV_REQUEST_P5_SELFTEST_TRANSACTIONAL_FAILURE);
+
+	if (!kcov_request_phase5_test_init(&aborted, 0xf5000016) ||
+	    !kcov_request_phase5_test_grant(&aborted, 0) ||
+	    kcov_request_generation_abort(aborted.generation))
+		goto out_aborted;
+	/* A pinned START_GRANTED ticket survives target close/sequence churn. */
+	spin_lock(&aborted.kcov->lock);
+	aborted.kcov->remote = false;
+	aborted.kcov->sequence++;
+	spin_unlock(&aborted.kcov->lock);
+	if (kcov_request_remote_start_checked(aborted.ticket[0]) !=
+			KCOV_REQUEST_REMOTE_START_SUCCESS)
+		goto out_aborted;
+	kcov_request_remote_stop_checked(aborted.ticket[0]);
+	if (atomic_read(&aborted.ticket[0]->state) !=
+			KCOV_REQUEST_TICKET_DONE)
+		goto out_aborted;
+	kcov_request_phase5_note(KCOV_REQUEST_P5_SELFTEST_ABORT_AFTER_GRANT);
+
+	if (!kcov_request_phase5_test_init(&same, 0xf5000012) ||
+	    !kcov_request_phase5_test_grant(&same, 0) ||
+	    !kcov_request_phase5_test_grant(&same, 1) ||
+	    same.ticket[0]->scratch == same.ticket[1]->scratch)
+		goto out_same;
+	kcov_request_phase5_note(KCOV_REQUEST_P5_SELFTEST_EXCLUSIVE_SCRATCH);
+	if (kcov_request_remote_start_checked(same.ticket[0]) !=
+			KCOV_REQUEST_REMOTE_START_SUCCESS ||
+	    kcov_request_remote_start_checked(same.ticket[1]) !=
+			KCOV_REQUEST_REMOTE_START_NESTED)
+		goto out_same;
+	kcov_request_remote_start_failed(same.ticket[1], true);
+	kcov_request_remote_stop_checked(same.ticket[0]);
+	kcov_request_phase5_note(KCOV_REQUEST_P5_SELFTEST_NESTED_SAME);
+
+	if (!kcov_request_phase5_test_init(&incumbent, 0xf5000013) ||
+	    !kcov_request_phase5_test_grant(&incumbent, 0) ||
+	    !kcov_request_phase5_test_init(&attempted, 0xf5000014) ||
+	    !kcov_request_phase5_test_grant(&attempted, 0))
+		goto out_cross;
+	if (kcov_request_remote_start_checked(incumbent.ticket[0]) !=
+			KCOV_REQUEST_REMOTE_START_SUCCESS ||
+	    kcov_request_remote_start_checked(attempted.ticket[0]) !=
+			KCOV_REQUEST_REMOTE_START_NESTED)
+		goto out_cross;
+	kcov_request_remote_start_failed(attempted.ticket[0], true);
+	kcov_request_remote_stop_checked(incumbent.ticket[0]);
+	kcov_request_phase5_note(KCOV_REQUEST_P5_SELFTEST_NESTED_CROSS);
+	pass = true;
+out_cross:
+	kcov_request_phase5_test_cleanup(&attempted);
+	kcov_request_phase5_test_cleanup(&incumbent);
+out_same:
+	kcov_request_phase5_test_cleanup(&same);
+out_aborted:
+	kcov_request_phase5_test_cleanup(&aborted);
+out_failed:
+	kcov_request_phase5_test_cleanup(&failed);
+out_normal:
+	kcov_request_phase5_test_cleanup(&normal);
+	return pass;
+}
+EXPORT_SYMBOL_GPL(kcov_request_phase5_selftest);
+

+	spin_lock_irqsave(&request_generations_lock, flags);
+	list_for_each_entry(gen, &request_generations, all) {
+		spin_lock(&gen->lock);
+		remote_refs += gen->remote_refs;
+		seq_printf(m,
+			"owner %llu generation %llu state %s remote_result %s remote_refs %u issues %#x\n",
+			gen->owner, gen->id, request_state_name(gen->state),
+			request_remote_result_name(gen->remote_result),
+			gen->remote_refs, gen->remote_issues);
+		spin_unlock(&gen->lock);
+	}
+	spin_unlock_irqrestore(&request_generations_lock, flags);
+	seq_printf(m, "live_tickets %d live_svc_attachments %d remote_refs %u\n",
+		   atomic_read(&request_phase5_live_tickets),
+		   atomic_read(&request_phase5_live_svc), remote_refs);

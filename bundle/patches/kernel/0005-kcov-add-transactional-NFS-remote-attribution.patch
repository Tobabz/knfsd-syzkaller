+	unsigned int remote_refs = 0;
+	unsigned int i;
+
+	for (i = 0; i < KCOV_REQUEST_P5_STAT_COUNT; i++)
+		seq_printf(m, "%s %lld\n", request_phase5_stat_names[i],
+			   atomic64_read(&request_phase5_stats[i]));
+	spin_lock_irqsave(&request_generations_lock, flags);
+	list_for_each_entry(gen, &request_generations, all) {
+		spin_lock(&gen->lock);
+		remote_refs += gen->remote_refs;
+		spin_unlock(&gen->lock);
+	}
+	spin_unlock_irqrestore(&request_generations_lock, flags);
+	seq_printf(m, "remote_refs %u\n", remote_refs);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(request_phase5_stats);

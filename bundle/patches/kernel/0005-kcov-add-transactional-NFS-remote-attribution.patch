+void kcov_request_remote_nested(struct kcov_request_generation *attempted,
+		struct kcov_request_generation *incumbent)
+{
+	if (attempted) {
+		kcov_request_remote_degrade(attempted,
+			KCOV_REQUEST_REMOTE_INVALID,
+			KCOV_REQUEST_REMOTE_ISSUE_NESTED);
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_NESTED_ATTEMPTED_INVALID);
+	}
+	if (incumbent) {
+		kcov_request_remote_degrade(incumbent,
+			KCOV_REQUEST_REMOTE_INVALID,
+			KCOV_REQUEST_REMOTE_ISSUE_NESTED);
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_NESTED_INCUMBENT_INVALID);
+		kcov_request_phase5_note(attempted == incumbent ?
+			KCOV_REQUEST_P5_NESTED_SAME_GENERATION :
+			KCOV_REQUEST_P5_NESTED_CROSS_GENERATION);
+	} else {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_NESTED_INCUMBENT_UNKNOWN);
+	}
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_nested);

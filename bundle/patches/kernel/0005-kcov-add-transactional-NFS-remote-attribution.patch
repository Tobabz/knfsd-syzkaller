+void kcov_request_remote_ref_put(struct kcov_request_generation *gen)
+{
+	bool held = false, wake = false;
+
+	if (!gen)
+		return;
+	spin_lock(&gen->lock);
+	if (WARN_ON_ONCE(!gen->remote_refs)) {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_GRANT_ORDER_VIOLATION);
+	} else {
+		gen->remote_refs--;
+		held = true;
+		wake = gen->remote_refs == 0;
+	}
+	spin_unlock(&gen->lock);
+	if (!held)
+		return;
+	kcov_request_phase5_note(KCOV_REQUEST_P5_REMOTE_REF_PUT);
+	if (wake)
+		wake_up_all(&gen->drain_wait);
+	kcov_request_generation_put(gen);
+}
+EXPORT_SYMBOL_GPL(kcov_request_remote_ref_put);

+enum kcov_request_phase5_fault kcov_request_phase5_before_start(
+		struct kcov_request_generation *attempted)
+{
+	struct kcov_request_generation *incumbent = NULL;
+	enum kcov_request_phase5_fault fault = KCOV_REQUEST_P5_FAULT_NONE;
+	u64 inc_owner = 0, inc_generation = 0;
+	bool pause = false;
+
+	if (!attempted)
+		return fault;
+	spin_lock(&request_phase5_fault_lock);
+	if (request_phase5_pause_armed &&
+	    request_phase5_fault_owner == attempted->owner &&
+	    request_phase5_fault_generation == attempted->id) {
+		pause = true;
+		request_phase5_pause_armed = false;
+	}
+	if (request_phase5_fault != KCOV_REQUEST_P5_FAULT_NONE &&
+	    request_phase5_fault_owner == attempted->owner &&
+	    request_phase5_fault_generation == attempted->id) {
+		fault = request_phase5_fault;
+		inc_owner = request_phase5_incumbent_owner;
+		inc_generation = request_phase5_incumbent_generation;
+		if (fault != KCOV_REQUEST_P5_FAULT_NESTED_CROSS)
+			request_phase5_fault = KCOV_REQUEST_P5_FAULT_NONE;
+	}
+	spin_unlock(&request_phase5_fault_lock);
+
+	if (pause) {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_PAUSE_AFTER_GRANT_ENTERED);
+		wait_event(request_phase5_pause_wait,
+			READ_ONCE(request_phase5_pause_released));
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_PAUSE_AFTER_GRANT_RELEASED);
+	}
+	if (fault == KCOV_REQUEST_P5_FAULT_NESTED_CROSS) {
+		if (!wait_event_timeout(request_phase5_nested_wait,
+				READ_ONCE(request_phase5_cross_incumbent_active) ||
+				READ_ONCE(request_phase5_cross_canceled),
+				msecs_to_jiffies(5000))) {
+			kcov_request_phase5_note(
+				KCOV_REQUEST_P5_NESTED_WITHOUT_ACTIVE_INCUMBENT);
+			spin_lock(&request_phase5_fault_lock);
+			request_phase5_fault = KCOV_REQUEST_P5_FAULT_NONE;
+			WRITE_ONCE(request_phase5_cross_incumbent_active, false);
+			WRITE_ONCE(request_phase5_cross_attempted_seen, false);
+			WRITE_ONCE(request_phase5_cross_canceled, true);
+			spin_unlock(&request_phase5_fault_lock);
+			wake_up_all(&request_phase5_nested_wait);
+			return KCOV_REQUEST_P5_FAULT_NONE;
+		}
+		if (READ_ONCE(request_phase5_cross_canceled))
+			return KCOV_REQUEST_P5_FAULT_NONE;
+		incumbent = request_generation_lookup(inc_owner, inc_generation);
+		if (!incumbent) {
+			kcov_request_phase5_note(
+				KCOV_REQUEST_P5_NESTED_WITHOUT_ACTIVE_INCUMBENT);
+			spin_lock(&request_phase5_fault_lock);
+			request_phase5_fault = KCOV_REQUEST_P5_FAULT_NONE;
+			WRITE_ONCE(request_phase5_cross_incumbent_active, false);
+			WRITE_ONCE(request_phase5_cross_attempted_seen, false);
+			WRITE_ONCE(request_phase5_cross_canceled, true);
+			spin_unlock(&request_phase5_fault_lock);
+			wake_up_all(&request_phase5_nested_wait);
+			return KCOV_REQUEST_P5_FAULT_NONE;
+		}
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_NESTED_INCUMBENT_ACTIVE_MATCH);
+		kcov_request_remote_nested(attempted, incumbent);
+		kcov_request_generation_put(incumbent);
+		spin_lock(&request_phase5_fault_lock);
+		request_phase5_fault = KCOV_REQUEST_P5_FAULT_NONE;
+		WRITE_ONCE(request_phase5_cross_attempted_seen, true);
+		spin_unlock(&request_phase5_fault_lock);
+		wake_up_all(&request_phase5_nested_wait);
+	}
+	return fault;
+}
+EXPORT_SYMBOL_GPL(kcov_request_phase5_before_start);
+
+void kcov_request_phase5_after_start(struct kcov_request_generation *gen)
+{
+	bool incumbent = false;
+
+	if (!gen)
+		return;
+	spin_lock(&request_phase5_fault_lock);
+	if (request_phase5_fault == KCOV_REQUEST_P5_FAULT_NESTED_CROSS &&
+	    request_phase5_incumbent_owner == gen->owner &&
+	    request_phase5_incumbent_generation == gen->id) {
+		WRITE_ONCE(request_phase5_cross_incumbent_active, true);
+		incumbent = true;
+	}
+	spin_unlock(&request_phase5_fault_lock);
+	if (!incumbent)
+		return;
+	wake_up_all(&request_phase5_nested_wait);
+	if (!wait_event_timeout(request_phase5_nested_wait,
+			READ_ONCE(request_phase5_cross_attempted_seen) ||
+			READ_ONCE(request_phase5_cross_canceled),
+			msecs_to_jiffies(5000))) {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_NESTED_WITHOUT_ACTIVE_INCUMBENT);
+		spin_lock(&request_phase5_fault_lock);
+		request_phase5_fault = KCOV_REQUEST_P5_FAULT_NONE;
+		spin_unlock(&request_phase5_fault_lock);
+	}
+	spin_lock(&request_phase5_fault_lock);
+	WRITE_ONCE(request_phase5_cross_incumbent_active, false);
+	WRITE_ONCE(request_phase5_cross_attempted_seen, false);
+	WRITE_ONCE(request_phase5_cross_canceled, true);
+	spin_unlock(&request_phase5_fault_lock);
+}
+EXPORT_SYMBOL_GPL(kcov_request_phase5_after_start);

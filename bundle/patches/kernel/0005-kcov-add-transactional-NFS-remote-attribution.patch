+			kcov_request_remote_start_failed(ticket, nested);
+		terminal = kcov_request_remote_reset_checked(ticket);
+		if (!terminal)
+			return;
+		kcov_request_remote_ticket_put(ticket);
+	}
+	rqstp->rq_fuzz_remote_ticket = NULL;
+	rqstp->rq_fuzz_wire_work = NULL;
+	/* A granted ticket is the sole terminal owner of its delivery token. */
+	sunrpc_fuzz_wire_work_finish(work, !ticket);
+	if (work)
+		kcov_request_phase5_live_svc_put();
+	kcov_request_phase5_note(KCOV_REQUEST_P5_SVC_RQST_FUZZ_RESET);
+}
+
+void sunrpc_fuzz_svc_rqst_reset(struct svc_rqst *rqstp,
+		bool callback, bool short_record)
+{
+	if (!rqstp)
+		return;
+	if (rqstp->rq_fuzz_remote_ticket) {
+		if (!kcov_request_remote_reset_checked(
+				rqstp->rq_fuzz_remote_ticket))
+			return;
+		kcov_request_remote_ticket_put(rqstp->rq_fuzz_remote_ticket);
+		rqstp->rq_fuzz_remote_ticket = NULL;
+		sunrpc_fuzz_wire_work_finish(rqstp->rq_fuzz_wire_work, false);
+		if (rqstp->rq_fuzz_wire_work)
+			kcov_request_phase5_live_svc_put();
+		rqstp->rq_fuzz_wire_work = NULL;
+		kcov_request_phase5_note(KCOV_REQUEST_P5_SVC_RQST_FUZZ_RESET);
+	} else {
+		sunrpc_fuzz_wire_work_finish(rqstp->rq_fuzz_wire_work, true);
+		if (rqstp->rq_fuzz_wire_work)
+			kcov_request_phase5_live_svc_put();
+		rqstp->rq_fuzz_wire_work = NULL;
+		kcov_request_phase5_note(KCOV_REQUEST_P5_SVC_RQST_FUZZ_RESET);
+	}
+	if (callback)
+		kcov_request_phase5_note(KCOV_REQUEST_P5_SVC_RQST_CALLBACK_RESET);
+	if (short_record)
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_SVC_RQST_SHORT_RECORD_RESET);
+}
+
+static bool sunrpc_fuzz_phase5_transport_selftest(void)
+{
+	struct svc_rqst rqst = {};
+	struct sunrpc_fuzz_wire_work *work;
+
+	work = kzalloc(sizeof(*work), GFP_KERNEL);
+	if (!work)
+		return false;
+	rqst.rq_fuzz_wire_work = work;
+	kcov_request_phase5_live_svc_get();
+	sunrpc_fuzz_svc_rqst_reset(&rqst, true, false);
+	if (rqst.rq_fuzz_wire_work || rqst.rq_fuzz_remote_ticket)
+		return false;
+	work = kzalloc(sizeof(*work), GFP_KERNEL);
+	if (!work)
+		return false;
+	rqst.rq_fuzz_wire_work = work;
+	kcov_request_phase5_live_svc_get();
+	sunrpc_fuzz_svc_rqst_reset(&rqst, false, true);
+	return !rqst.rq_fuzz_wire_work && !rqst.rq_fuzz_remote_ticket;
+}

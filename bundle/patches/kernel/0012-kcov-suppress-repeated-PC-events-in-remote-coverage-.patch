From 9ea7c8032dda952f3d0786494722f6f986f5f7da Mon Sep 17 00:00:00 2001
From: idealinsane <idealinsane@localhost>
Date: Sat, 26 Sep 2026 19:34:04 +0900
Subject: [PATCH] kcov: suppress repeated PC events in remote coverage sections

A remote coverage section records one scratch slot per instrumented
basic-block/edge execution, with no duplicate removal, so the area is an
append-only event log whose size is proportional to the work performed
rather than to the amount of distinct code reached.  A section that loops
for a long time fills the whole ceiling with repeats of the same code
addresses; kcov_request_generation_merge_scratch() then reports an
overflow, the generation is degraded to KCOV_REQUEST_REMOTE_INCOMPLETE,
and the fail-closed publication policy suppresses the aggregate.  Userspace
then observes an empty area and no .extra file at all.

The measured case is the nfsd async COPY offload kthread: on an S4 reach
corpus a 16 MiB copy_file_range fills the 1,048,575-slot remote scratch
ceiling (fault_scratch_limit = 0, so this is a real capacity overflow, not
an injected fault), which is why the syzkaller channel reported extra
coverage 0 while the same hop was attributed normally when driven through a
4 MiB copy.

Record a small direct-mapped "recently seen" cache per section, held on the
ticket, and skip a PC that the section already recorded.  A miss -
including a collision with a different PC or a stale entry - appends
exactly as before, so the transformation is lossless by construction: a
filter can never suppress a PC that was not already recorded, which is the
failure mode that makes a probabilistic dedup unfit for a measurement tool.

The window is 16384 slots because the hit rate depends on the loop's working
set fitting in the table, and the size was chosen by measurement rather than
by guess.  Scaling the corpus (16/32/64 MiB effective copy, same kernel and
executor) gave:

	window     x1        x2        x4        verdict
	512        5,158,919 9,342,356  overflow  0/10 .extra
	16384        476,771   733,197 1,245,344  10/10 .extra

so 512 slots suppressed only 72% of the offered events and still scaled at
1.8x per doubling of work, while 16384 slots keeps 2.5% and grows at a 0.69
log-log slope - sub-linear, and 74x below the ceiling at the heaviest level
tested.  It is deliberately described as mitigation, not a guarantee: the
volume still grows with work, so the complete fix remains publishing the
truncated prefix instead of discarding a section outright.  The same
measurement shows the window does not cost coverage fidelity: per-file
distinct symbols are unchanged (788/790) and the async sentinel is still
present in every file, while the record count drops 3.5x.

Allocate with kvcalloc: 128 KiB per active section would need a high-order
kmalloc allocation and could fail under fragmentation, and a failed
allocation only means the section records every event exactly as before.

The table lives on the ticket, so a new section starts from a zeroed window
with no flush, and a section that migrates between CPUs keeps one table.
Only remote sections are affected; the local per-thread coverage path is
untouched.  The behaviour is unconditional on purpose: this corrects how a
section is recorded rather than trading one measurement against another, so
it carries no runtime switch.  A switch whose safe setting has to be
requested explicitly is a trap - forgetting it silently reinstates the
whole-slot discard this patch exists to remove.  The A/B that established
the effect is recorded in the project's evidence, and the counterfactual
remains available by leaving this patch out of the series.

Signed-off-by: idealinsane <idealinsane@localhost>
diff --git a/kernel/kcov.c b/kernel/kcov.c
index 166f7a916..e648a0425 100644
--- a/kernel/kcov.c
+++ b/kernel/kcov.c
@@ -102,6 +102,7 @@ struct kcov_request_remote_ticket {
 	struct kcov_request_token *token;
 	struct kcov *kcov;
 	void *scratch;
+	unsigned long *dedup_ip;
 	unsigned int scratch_size;
 	enum kcov_mode mode;
 	int sequence;
@@ -228,12 +229,77 @@ static notrace unsigned long canonicalize_ip(unsigned long ip)
 	return ip;
 }
 
+/*
+ * Repeated-PC suppression for remote coverage sections.
+ *
+ * A remote section's scratch is an append-only log of PC *events* - one slot
+ * per instrumented basic-block/edge execution, with no duplicate removal.  A
+ * section that loops for a long time (the nfsd async COPY offload kthread is
+ * the measured case) therefore fills its whole ceiling with repeats of the same
+ * code addresses.  kcov_request_generation_merge_scratch() then reports an
+ * overflow, the generation is degraded to INCOMPLETE, and the fail-closed
+ * publication policy suppresses the aggregate, so userspace observes an empty
+ * area and no .extra file at all.
+ *
+ * The filter below is a small direct-mapped "recently seen" cache.  A hit means
+ * this exact PC is already in the area, so the slot is redundant for coverage
+ * purposes and is skipped.  A miss - including a collision with a different PC,
+ * or a stale entry left by a previous section - appends exactly as before and
+ * only refreshes the table.  The transformation is lossless by construction: a
+ * filter can never suppress a PC that was not already recorded, which is the
+ * failure mode that makes a probabilistic dedup unfit for a measurement tool.
+ *
+ * Per-section storage keeps the trace path allocation-free and lock-free: the
+ * table lives on the ticket, so a new section starts from a zeroed window with
+ * no flush, and a section that migrates between CPUs keeps one table.  A zero
+ * slot can never match: canonicalized kernel text addresses are never 0.
+ */
+/*
+ * Duplicate suppression is unconditional: it corrects how a remote section is
+ * recorded, it is not a measurement tuning knob, so there is deliberately no
+ * runtime switch.  A section that reaches the ceiling was previously discarded
+ * in full; see the block comment above.
+ *
+ * The window is a direct-mapped cache: a repeated PC is suppressed only while
+ * its slot still holds that PC, so the hit rate depends on the loop's working
+ * set fitting in the table.  At 512 slots the measured suppression was partial
+ * (per-section volume still grew ~1.8x when the work doubled), which is why the
+ * window is sized well above that.  16384 slots is 128 KiB per active section
+ * next to the multi-megabyte scratch; the curve experiment that chose it is in
+ * the project evidence (x1/x2/x4 work levels).
+ */
+#define KCOV_REMOTE_DEDUP_BITS 14
+#define KCOV_REMOTE_DEDUP_SLOTS (1U << KCOV_REMOTE_DEDUP_BITS)
+
+/* Fibonacci hashing: instruction addresses are aligned, low bits are inert. */
+static __always_inline unsigned int kcov_remote_dedup_slot(unsigned long ip)
+{
+	return (unsigned int)(((u32)(ip >> 2) * 2654435761U) >>
+			      (32 - KCOV_REMOTE_DEDUP_BITS));
+}
+
+static __always_inline bool kcov_remote_dedup_seen(
+		struct kcov_request_remote_ticket *ticket, unsigned long ip)
+{
+	unsigned long *table = ticket->dedup_ip;
+	unsigned int slot;
+
+	if (unlikely(!table))
+		return false;
+	slot = kcov_remote_dedup_slot(ip);
+	if (likely(table[slot] == ip))
+		return true;
+	table[slot] = ip;
+	return false;
+}
+
 /*
  * Entry point from instrumented code.
  * This is called once per basic-block/edge.
  */
 void notrace __sanitizer_cov_trace_pc(void)
 {
+	struct kcov_request_remote_ticket *ticket;
 	struct task_struct *t;
 	unsigned long *area;
 	unsigned long ip = canonicalize_ip(_RET_IP_);
@@ -243,10 +309,18 @@ void notrace __sanitizer_cov_trace_pc(void)
 	if (!check_kcov_mode(KCOV_MODE_TRACE_PC, t))
 		return;
 
+	ticket = t->kcov_request_remote_ticket;
 	area = t->kcov_area;
 	/* The first 64-bit word is the number of subsequent PCs. */
 	pos = READ_ONCE(area[0]) + 1;
 	if (likely(pos < t->kcov_size)) {
+		/*
+		 * Skip a PC this remote section already recorded.  Gated on the
+		 * runtime toggle first, so the disabled default and the local
+		 * (per-thread) coverage path are untouched.
+		 */
+		if (ticket && kcov_remote_dedup_seen(ticket, ip))
+			return;
 		/* Previously we write pc before updating pos. However, some
 		 * early interrupt code could bypass check_kcov_mode() check
 		 * and invoke __sanitizer_cov_trace_pc(). If such interrupt is
@@ -257,9 +331,8 @@ void notrace __sanitizer_cov_trace_pc(void)
 		WRITE_ONCE(area[0], pos);
 		barrier();
 		area[pos] = ip;
-	} else if (t->kcov_request_remote_ticket) {
-		WRITE_ONCE(((struct kcov_request_remote_ticket *)
-			t->kcov_request_remote_ticket)->scratch_overflow, true);
+	} else if (ticket) {
+		WRITE_ONCE(ticket->scratch_overflow, true);
 	}
 }
 EXPORT_SYMBOL(__sanitizer_cov_trace_pc);
@@ -1561,6 +1634,8 @@ static void kcov_request_remote_scratch_put(
 {
 	unsigned long flags;
 
+	kvfree(ticket->dedup_ip);
+	ticket->dedup_ip = NULL;
 	if (!ticket->scratch)
 		return;
 	spin_lock_irqsave(&kcov_remote_lock, flags);
@@ -1697,6 +1772,15 @@ int kcov_request_remote_try_grant(u64 request_cookie,
 	}
 	ticket->scratch = scratch;
 	ticket->scratch_size = size;
+	/*
+	 * Duplicate-suppression window for this section.  kvcalloc rather than
+	 * kcalloc: at 128 KiB a contiguous kmalloc allocation would need a high
+	 * order and could fail under fragmentation, and a failed allocation only
+	 * means the section records every event exactly as before.  The table is
+	 * freed with kvfree.
+	 */
+	ticket->dedup_ip = kvcalloc(KCOV_REMOTE_DEDUP_SLOTS,
+				    sizeof(unsigned long), GFP_KERNEL);
 	kcov_request_zero_area_count(ticket->scratch, mode);
 	kcov_request_phase5_note(KCOV_REQUEST_P5_SCRATCH_RESERVED);
 	ticket->phase6_scratch_accounted = true;
-- 
2.53.0


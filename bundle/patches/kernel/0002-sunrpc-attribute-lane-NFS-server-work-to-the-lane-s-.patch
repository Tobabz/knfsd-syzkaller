diff --git a/net/sunrpc/fuzz.c b/net/sunrpc/fuzz.c
new file mode 100755
index 000000000..104b25c5c
--- /dev/null
+++ b/net/sunrpc/fuzz.c
@@ -0,0 +1,839 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Lane-scoped remote KCOV attribution for NFS server work.
+ *
+ * A fuzz lane is a set of network namespaces (one NFS server and its
+ * clients) used by exactly one executor proc.  Proc N, whose KCOV common
+ * handle is N + 1, is bound to lane N.  Every request that reaches a lane's
+ * server therefore belongs to the program that proc is currently running, so
+ * ownership is derived from the server netns rather than from the client
+ * connection.  This keeps attribution intact through relays that terminate
+ * TCP and through mutations that change records on the wire.
+ *
+ * The owner's request generation fences work that outlives a program: a
+ * record attributed to generation G, and any deferred or asynchronous
+ * continuation of it, can only publish coverage into G.
+ */
+
+#include <linux/atomic.h>
+#include <linux/debugfs.h>
+#include <linux/fs.h>
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/nsproxy.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include <net/net_namespace.h>
+#include <net/netns/generic.h>
+
+#include <linux/sunrpc/fuzz.h>
+#include <linux/sunrpc/svc.h>
+#include <linux/sunrpc/svc_xprt.h>
+
+enum sunrpc_fuzz_lane_stat {
+	LANE_EPOCH_ALLOCATED,
+	LANE_EPOCH_COLLISION,
+	LANE_EPOCH_IMMUTABLE_VIOLATION,
+	LANE_DOMAIN_CREATED,
+	LANE_DOMAIN_JOINED,
+	LANE_DOMAIN_RETIRED,
+	LANE_OWNER_ATTRIBUTED,
+	LANE_OWNER_NO_GENERATION,
+	LANE_OWNER_FAILED,
+	LANE_RECORD_OWNERLESS,
+	LANE_NESTED_CLOSE,
+	LANE_STAT_COUNT,
+};
+
+static const char *const lane_stat_names[LANE_STAT_COUNT] = {
+	[LANE_EPOCH_ALLOCATED] = "lane_epoch_allocated",
+	[LANE_EPOCH_COLLISION] = "lane_epoch_collision",
+	[LANE_EPOCH_IMMUTABLE_VIOLATION] = "lane_epoch_immutable_violation",
+	[LANE_DOMAIN_CREATED] = "domain_created",
+	[LANE_DOMAIN_JOINED] = "domain_joined",
+	[LANE_DOMAIN_RETIRED] = "domain_retired",
+	[LANE_OWNER_ATTRIBUTED] = "lane_owner_attributed",
+	[LANE_OWNER_NO_GENERATION] = "lane_owner_no_generation",
+	[LANE_OWNER_FAILED] = "lane_owner_failed",
+	[LANE_RECORD_OWNERLESS] = "record_ownerless",
+	[LANE_NESTED_CLOSE] = "nested_transport_close",
+};
+
+enum sunrpc_fuzz_saved_stat {
+	SAVED_DEFERRED_CHILD_CREATED,
+	SAVED_DEFERRED_CHILD_REJECTED,
+	SAVED_DEFERRED_RESTORED,
+	SAVED_DEFERRED_REDEFERRED,
+	SAVED_DEFERRED_GRANT_OK,
+	SAVED_DEFERRED_OWNER_NONE,
+	SAVED_DEFERRED_START_OK,
+	SAVED_DEFERRED_START_INCOMPLETE,
+	SAVED_DEFERRED_START_NESTED,
+	SAVED_DEFERRED_COMPLETED,
+	SAVED_DEFERRED_DROPPED,
+	SAVED_ASYNC_CHILD_CREATED,
+	SAVED_ASYNC_CHILD_REJECTED,
+	SAVED_ASYNC_GRANT_OK,
+	SAVED_ASYNC_OWNER_NONE,
+	SAVED_ASYNC_START_OK,
+	SAVED_ASYNC_START_INCOMPLETE,
+	SAVED_ASYNC_START_NESTED,
+	SAVED_ASYNC_COMPLETED,
+	SAVED_ASYNC_DROPPED,
+	SAVED_DOUBLE_ATTACH,
+	SAVED_STAT_COUNT,
+};
+
+static const char *const saved_stat_names[SAVED_STAT_COUNT] = {
+	[SAVED_DEFERRED_CHILD_CREATED] = "deferred_child_created",
+	[SAVED_DEFERRED_CHILD_REJECTED] = "deferred_child_rejected",
+	[SAVED_DEFERRED_RESTORED] = "deferred_restored",
+	[SAVED_DEFERRED_REDEFERRED] = "deferred_redeferred",
+	[SAVED_DEFERRED_GRANT_OK] = "deferred_grant_ok",
+	[SAVED_DEFERRED_OWNER_NONE] = "deferred_owner_none",
+	[SAVED_DEFERRED_START_OK] = "deferred_start_ok",
+	[SAVED_DEFERRED_START_INCOMPLETE] = "deferred_start_incomplete",
+	[SAVED_DEFERRED_START_NESTED] = "deferred_start_nested",
+	[SAVED_DEFERRED_COMPLETED] = "deferred_completed",
+	[SAVED_DEFERRED_DROPPED] = "deferred_dropped",
+	[SAVED_ASYNC_CHILD_CREATED] = "async_child_created",
+	[SAVED_ASYNC_CHILD_REJECTED] = "async_child_rejected",
+	[SAVED_ASYNC_GRANT_OK] = "async_grant_ok",
+	[SAVED_ASYNC_OWNER_NONE] = "async_owner_none",
+	[SAVED_ASYNC_START_OK] = "async_start_ok",
+	[SAVED_ASYNC_START_INCOMPLETE] = "async_start_incomplete",
+	[SAVED_ASYNC_START_NESTED] = "async_start_nested",
+	[SAVED_ASYNC_COMPLETED] = "async_completed",
+	[SAVED_ASYNC_DROPPED] = "async_dropped",
+	[SAVED_DOUBLE_ATTACH] = "saved_work_double_attach",
+};
+
+struct sunrpc_fuzz_net {
+	u32 lane_id;
+	u64 lane_epoch;
+	bool valid;
+	bool unhealthy;
+};
+
+struct sunrpc_fuzz_domain_entry {
+	struct list_head list;
+	u32 lane_id;
+	u64 lane_epoch;
+};
+
+/* One received request, owned by the lane's open executor generation. */
+struct sunrpc_fuzz_request_work {
+	struct kcov_request_token token;
+	struct kcov_common_handle_id owner;
+	u64 request_cookie;
+};
+
+/* A continuation of an attributed request: deferral or async NFSD work. */
+struct sunrpc_fuzz_saved_work {
+	struct kcov_request_token token;
+	struct kcov_common_handle_id owner;
+	struct net *net;
+	u64 request_cookie;
+	u8 type;
+};
+
+static bool lane_attribution_enabled = true;
+module_param_named(lane_attribution, lane_attribution_enabled, bool, 0644);
+MODULE_PARM_DESC(lane_attribution,
+	"Attribute lane NFS server work to the lane's executor (default: on)");
+
+static unsigned int sunrpc_fuzz_net_id;
+static atomic64_t next_lane_epoch = ATOMIC64_INIT(0);
+static atomic64_t lane_owner_cookie_seq = ATOMIC64_INIT(0);
+static atomic64_t lane_stats[LANE_STAT_COUNT];
+static atomic64_t saved_stats[SAVED_STAT_COUNT];
+static atomic_t live_saved = ATOMIC_INIT(0);
+static LIST_HEAD(domain_list);
+static DEFINE_MUTEX(domain_lock);
+static struct dentry *sunrpc_fuzz_debugfs_dir;
+static bool sunrpc_fuzz_registered;
+
+static void lane_stat_inc(enum sunrpc_fuzz_lane_stat stat)
+{
+	atomic64_inc(&lane_stats[stat]);
+}
+
+static void saved_stat_inc(enum sunrpc_fuzz_saved_stat stat)
+{
+	atomic64_inc(&saved_stats[stat]);
+}
+
+static u64 alloc_nonzero(atomic64_t *counter)
+{
+	u64 value;
+
+	do {
+		value = atomic64_inc_return(counter);
+	} while (unlikely(!value));
+	return value;
+}
+
+static struct sunrpc_fuzz_net *fuzz_pernet(struct net *net)
+{
+	return net_generic(net, sunrpc_fuzz_net_id);
+}
+
+static int sunrpc_fuzz_net_init(struct net *net)
+{
+	memset(fuzz_pernet(net), 0, sizeof(struct sunrpc_fuzz_net));
+	return 0;
+}
+
+static struct pernet_operations sunrpc_fuzz_net_ops = {
+	.init = sunrpc_fuzz_net_init,
+	.id = &sunrpc_fuzz_net_id,
+	.size = sizeof(struct sunrpc_fuzz_net),
+};
+
+void sunrpc_fuzz_lane_mark_unhealthy(struct net *net)
+{
+	if (!net || !sunrpc_fuzz_registered)
+		return;
+	WRITE_ONCE(fuzz_pernet(net)->unhealthy, true);
+	kcov_request_remote_mark_lane_unhealthy();
+}
+
+bool sunrpc_fuzz_lane_is_unhealthy(struct net *net)
+{
+	return net && sunrpc_fuzz_registered &&
+		READ_ONCE(fuzz_pernet(net)->unhealthy);
+}
+
+/* KCOV common handle of the executor that owns @net's lane, or 0. */
+static u64 lane_owner_handle(struct net *net)
+{
+	struct sunrpc_fuzz_net *fnet;
+
+	if (!net || !sunrpc_fuzz_registered ||
+	    !READ_ONCE(lane_attribution_enabled))
+		return 0;
+	fnet = fuzz_pernet(net);
+	if (!READ_ONCE(fnet->valid))
+		return 0;
+	return (u64)READ_ONCE(fnet->lane_id) + 1;
+}
+
+static void request_work_finish(struct sunrpc_fuzz_request_work *work,
+		bool complete_token)
+{
+	if (!work)
+		return;
+	if (complete_token)
+		kcov_request_token_complete_once(&work->token);
+	kcov_request_note_wire_terminal(true);
+	kcov_request_phase5_note(KCOV_REQUEST_P5_WIRE_WORK_TERMINAL);
+	kfree(work);
+}
+
+/* Build a request owned by the generation currently open for @handle. */
+static struct sunrpc_fuzz_request_work *lane_owner_work(u64 handle)
+{
+	struct kcov_common_handle_id owner = { .val = handle };
+	struct sunrpc_fuzz_request_work *work;
+	struct kcov_request_root root;
+	u64 cookie;
+
+	owner.generation = kcov_request_current_generation(handle);
+	if (!owner.generation) {
+		/* Between programs, or no executor: the record stays ownerless. */
+		lane_stat_inc(LANE_OWNER_NO_GENERATION);
+		return NULL;
+	}
+	work = kzalloc_obj(*work);
+	if (!work)
+		goto fail;
+	cookie = alloc_nonzero(&lane_owner_cookie_seq) | BIT_ULL(62);
+	/* A closed or aborted generation refuses the root: late work is fenced. */
+	if (!kcov_request_root_init(&root, owner, cookie)) {
+		kfree(work);
+		goto fail;
+	}
+	if (!kcov_request_try_get_child_token(&root, KCOV_REQUEST_TOKEN_WIRE,
+			&work->token) ||
+	    !kcov_request_wire_token_set_identity(&work->token, owner,
+			cookie)) {
+		if (work->token.generation)
+			kcov_request_token_complete_once(&work->token);
+		kcov_request_root_finish(&root);
+		kfree(work);
+		goto fail;
+	}
+	/* The root only mints this one token; close it immediately. */
+	kcov_request_root_finish(&root);
+	work->owner = owner;
+	work->request_cookie = cookie;
+	lane_stat_inc(LANE_OWNER_ATTRIBUTED);
+	return work;
+fail:
+	lane_stat_inc(LANE_OWNER_FAILED);
+	return NULL;
+}
+
+static bool rqst_has_attachment(const struct svc_rqst *rqstp)
+{
+	return rqstp->rq_fuzz_request_work || rqstp->rq_fuzz_saved_work ||
+		rqstp->rq_fuzz_remote_ticket;
+}
+
+/**
+ * sunrpc_fuzz_svc_record_received - attribute a complete C2S record
+ * @xprt: server transport the record arrived on
+ * @rqstp: request that will process the record
+ */
+void sunrpc_fuzz_svc_record_received(struct svc_xprt *xprt,
+		struct svc_rqst *rqstp)
+{
+	struct sunrpc_fuzz_request_work *work;
+	u64 handle;
+
+	if (!rqstp)
+		return;
+	if (rqst_has_attachment(rqstp)) {
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_SVC_RQST_STALE_ATTACHMENT);
+		sunrpc_fuzz_svc_rqst_reset(rqstp, false, false);
+		/* A live section is never overwritten. */
+		if (rqst_has_attachment(rqstp))
+			return;
+	}
+	handle = lane_owner_handle(xprt->xpt_net);
+	work = handle ? lane_owner_work(handle) : NULL;
+	if (!work) {
+		lane_stat_inc(LANE_RECORD_OWNERLESS);
+		kcov_request_phase5_note(KCOV_REQUEST_P5_WIRE_WORK_OWNERLESS);
+		return;
+	}
+	rqstp->rq_fuzz_request_work = work;
+	kcov_request_phase5_live_svc_get();
+	kcov_request_phase5_note(KCOV_REQUEST_P5_WIRE_WORK_ATTACHED);
+}
+
+static struct kcov_request_token *svc_parent_token(struct svc_rqst *rqstp)
+{
+	struct sunrpc_fuzz_request_work *work = rqstp->rq_fuzz_request_work;
+	struct sunrpc_fuzz_saved_work *saved = rqstp->rq_fuzz_saved_work;
+
+	if (work && saved) {
+		saved_stat_inc(SAVED_DOUBLE_ATTACH);
+		return NULL;
+	}
+	if (work)
+		return &work->token;
+	if (saved)
+		return &saved->token;
+	return NULL;
+}
+
+static void saved_work_free(struct sunrpc_fuzz_saved_work **savedp,
+		bool complete_token, bool dropped)
+{
+	struct sunrpc_fuzz_saved_work *saved;
+	bool deferred;
+
+	if (!savedp)
+		return;
+	saved = xchg(savedp, NULL);
+	if (!saved)
+		return;
+	deferred = saved->type == KCOV_REQUEST_TOKEN_DEFERRED;
+	if (complete_token && saved->token.generation)
+		kcov_request_token_complete_once(&saved->token);
+	if (saved->net)
+		put_net(saved->net);
+	atomic_dec(&live_saved);
+	saved_stat_inc(deferred ?
+		(dropped ? SAVED_DEFERRED_DROPPED : SAVED_DEFERRED_COMPLETED) :
+		(dropped ? SAVED_ASYNC_DROPPED : SAVED_ASYNC_COMPLETED));
+	kfree(saved);
+}
+
+struct sunrpc_fuzz_saved_work *sunrpc_fuzz_svc_continuation_save(
+		struct svc_rqst *rqstp, enum kcov_request_token_type type)
+{
+	struct sunrpc_fuzz_saved_work *saved;
+	struct kcov_request_token *parent;
+	bool deferred = type == KCOV_REQUEST_TOKEN_DEFERRED;
+
+	if (!rqstp || (type != KCOV_REQUEST_TOKEN_DEFERRED &&
+		       type != KCOV_REQUEST_TOKEN_ASYNC))
+		return NULL;
+	parent = svc_parent_token(rqstp);
+	if (!parent)
+		goto rejected;
+	saved = kzalloc_obj(*saved);
+	if (!saved)
+		goto rejected;
+	if (!kcov_request_try_get_continuation_token(parent, type,
+			&saved->token)) {
+		kfree(saved);
+		goto rejected;
+	}
+	saved->owner = parent->owner;
+	saved->request_cookie = parent->request_cookie;
+	saved->type = type;
+	if (SVC_NET(rqstp))
+		saved->net = get_net(SVC_NET(rqstp));
+	atomic_inc(&live_saved);
+	saved_stat_inc(deferred ? SAVED_DEFERRED_CHILD_CREATED :
+		SAVED_ASYNC_CHILD_CREATED);
+	if (deferred && rqstp->rq_fuzz_saved_work)
+		saved_stat_inc(SAVED_DEFERRED_REDEFERRED);
+	return saved;
+rejected:
+	saved_stat_inc(deferred ? SAVED_DEFERRED_CHILD_REJECTED :
+		SAVED_ASYNC_CHILD_REJECTED);
+	return NULL;
+}
+EXPORT_SYMBOL_GPL(sunrpc_fuzz_svc_continuation_save);
+
+void sunrpc_fuzz_svc_continuation_restore(struct svc_rqst *rqstp,
+		struct sunrpc_fuzz_saved_work **savedp)
+{
+	struct sunrpc_fuzz_saved_work *saved;
+
+	if (!rqstp || !savedp)
+		return;
+	saved = *savedp;
+	if (!saved)
+		return;
+	if (rqstp->rq_fuzz_saved_work || rqstp->rq_fuzz_request_work) {
+		saved_stat_inc(SAVED_DOUBLE_ATTACH);
+		saved_work_free(savedp, true, true);
+		return;
+	}
+	rqstp->rq_fuzz_saved_work = saved;
+	*savedp = NULL;
+	if (saved->type == KCOV_REQUEST_TOKEN_DEFERRED)
+		saved_stat_inc(SAVED_DEFERRED_RESTORED);
+}
+EXPORT_SYMBOL_GPL(sunrpc_fuzz_svc_continuation_restore);
+
+void sunrpc_fuzz_saved_work_cancel(struct sunrpc_fuzz_saved_work **savedp)
+{
+	saved_work_free(savedp, true, true);
+}
+EXPORT_SYMBOL_GPL(sunrpc_fuzz_saved_work_cancel);
+
+static int saved_work_grant(struct sunrpc_fuzz_saved_work *saved,
+		struct kcov_request_remote_ticket **ticketp)
+{
+	int ret;
+
+	if (!saved || !ticketp)
+		return -EINVAL;
+	if (saved->net && sunrpc_fuzz_lane_is_unhealthy(saved->net))
+		return -ESHUTDOWN;
+	ret = kcov_request_remote_try_grant(saved->request_cookie, saved->owner,
+			&saved->token, ticketp);
+	if (!ret)
+		saved_stat_inc(saved->type == KCOV_REQUEST_TOKEN_DEFERRED ?
+			SAVED_DEFERRED_GRANT_OK : SAVED_ASYNC_GRANT_OK);
+	return ret;
+}
+
+enum sunrpc_fuzz_saved_start_result sunrpc_fuzz_saved_work_start(
+		struct sunrpc_fuzz_saved_work **savedp,
+		struct kcov_request_remote_ticket **ticketp)
+{
+	struct sunrpc_fuzz_saved_work *saved;
+	enum kcov_request_remote_start_result result;
+	bool deferred;
+
+	if (!savedp || !ticketp)
+		return SUNRPC_FUZZ_SAVED_OWNER_NONE;
+	saved = *savedp;
+	if (!saved)
+		return SUNRPC_FUZZ_SAVED_OWNER_NONE;
+	*ticketp = NULL;
+	deferred = saved->type == KCOV_REQUEST_TOKEN_DEFERRED;
+	if (saved_work_grant(saved, ticketp))
+		goto owner_none;
+	result = kcov_request_remote_start_checked(*ticketp);
+	if (result == KCOV_REQUEST_REMOTE_START_SUCCESS) {
+		saved_stat_inc(deferred ? SAVED_DEFERRED_START_OK :
+			SAVED_ASYNC_START_OK);
+		return SUNRPC_FUZZ_SAVED_ACTIVE;
+	}
+	if (result == KCOV_REQUEST_REMOTE_START_NESTED) {
+		saved_stat_inc(deferred ? SAVED_DEFERRED_START_NESTED :
+			SAVED_ASYNC_START_NESTED);
+		if (saved->net)
+			sunrpc_fuzz_lane_mark_unhealthy(saved->net);
+		kcov_request_remote_start_failed(*ticketp, true);
+		kcov_request_remote_ticket_put(*ticketp);
+		*ticketp = NULL;
+		saved_work_free(savedp, false, true);
+		return SUNRPC_FUZZ_SAVED_NESTED;
+	}
+	saved_stat_inc(deferred ? SAVED_DEFERRED_START_INCOMPLETE :
+		SAVED_ASYNC_START_INCOMPLETE);
+	kcov_request_remote_start_failed(*ticketp, false);
+	kcov_request_remote_ticket_put(*ticketp);
+	*ticketp = NULL;
+	saved_work_free(savedp, false, true);
+	saved_stat_inc(deferred ? SAVED_DEFERRED_OWNER_NONE :
+		SAVED_ASYNC_OWNER_NONE);
+	return SUNRPC_FUZZ_SAVED_OWNER_NONE;
+owner_none:
+	saved_stat_inc(deferred ? SAVED_DEFERRED_OWNER_NONE :
+		SAVED_ASYNC_OWNER_NONE);
+	saved_work_free(savedp, true, true);
+	return SUNRPC_FUZZ_SAVED_OWNER_NONE;
+}
+EXPORT_SYMBOL_GPL(sunrpc_fuzz_saved_work_start);
+
+void sunrpc_fuzz_saved_work_stop(struct sunrpc_fuzz_saved_work **savedp,
+		struct kcov_request_remote_ticket **ticketp)
+{
+	if (!savedp || !ticketp || !*savedp || !*ticketp)
+		return;
+	kcov_request_remote_stop_checked(*ticketp);
+	kcov_request_remote_ticket_put(*ticketp);
+	*ticketp = NULL;
+	saved_work_free(savedp, false, false);
+}
+EXPORT_SYMBOL_GPL(sunrpc_fuzz_saved_work_stop);
+
+bool sunrpc_fuzz_svc_has_remote_work(const struct svc_rqst *rqstp)
+{
+	return rqstp && (rqstp->rq_fuzz_request_work ||
+			 rqstp->rq_fuzz_saved_work);
+}
+EXPORT_SYMBOL_GPL(sunrpc_fuzz_svc_has_remote_work);
+
+int sunrpc_fuzz_svc_remote_grant(struct svc_rqst *rqstp)
+{
+	struct sunrpc_fuzz_request_work *work = rqstp->rq_fuzz_request_work;
+	struct sunrpc_fuzz_saved_work *saved = rqstp->rq_fuzz_saved_work;
+	int ret;
+
+	if (!work && !saved)
+		return -ENOENT;
+	if (work && saved) {
+		saved_stat_inc(SAVED_DOUBLE_ATTACH);
+		return -EINVAL;
+	}
+	if (saved) {
+		ret = saved_work_grant(saved, &rqstp->rq_fuzz_remote_ticket);
+		if (!ret)
+			return 0;
+		saved_stat_inc(saved->type == KCOV_REQUEST_TOKEN_DEFERRED ?
+			SAVED_DEFERRED_OWNER_NONE : SAVED_ASYNC_OWNER_NONE);
+		saved_work_free(&rqstp->rq_fuzz_saved_work, true, true);
+		return ret;
+	}
+	if (sunrpc_fuzz_lane_is_unhealthy(rqstp->rq_xprt->xpt_net))
+		ret = -ESHUTDOWN;
+	else
+		ret = kcov_request_remote_try_grant(work->request_cookie,
+				work->owner, &work->token,
+				&rqstp->rq_fuzz_remote_ticket);
+	if (!ret)
+		return 0;
+	request_work_finish(work, true);
+	rqstp->rq_fuzz_request_work = NULL;
+	kcov_request_phase5_live_svc_put();
+	kcov_request_phase5_note(KCOV_REQUEST_P5_WIRE_WORK_OWNERLESS);
+	return ret;
+}
+
+void sunrpc_fuzz_svc_remote_terminal(struct svc_rqst *rqstp,
+		bool start_failed, bool nested)
+{
+	struct kcov_request_remote_ticket *ticket =
+		rqstp->rq_fuzz_remote_ticket;
+	struct sunrpc_fuzz_request_work *work = rqstp->rq_fuzz_request_work;
+	struct sunrpc_fuzz_saved_work *saved = rqstp->rq_fuzz_saved_work;
+
+	if (ticket) {
+		if (start_failed && nested)
+			kcov_request_remote_start_failed(ticket, nested);
+		if (!kcov_request_remote_reset_checked(ticket))
+			return;
+		kcov_request_remote_ticket_put(ticket);
+	}
+	rqstp->rq_fuzz_remote_ticket = NULL;
+	rqstp->rq_fuzz_request_work = NULL;
+	rqstp->rq_fuzz_saved_work = NULL;
+	/* A granted ticket is the sole terminal owner of its token. */
+	request_work_finish(work, !ticket);
+	if (saved) {
+		bool deferred = saved->type == KCOV_REQUEST_TOKEN_DEFERRED;
+
+		if (!start_failed)
+			saved_stat_inc(deferred ? SAVED_DEFERRED_START_OK :
+				SAVED_ASYNC_START_OK);
+		else if (nested)
+			saved_stat_inc(deferred ? SAVED_DEFERRED_START_NESTED :
+				SAVED_ASYNC_START_NESTED);
+		else
+			saved_stat_inc(deferred ? SAVED_DEFERRED_START_INCOMPLETE :
+				SAVED_ASYNC_START_INCOMPLETE);
+		saved_work_free(&saved, !ticket, start_failed);
+	}
+	if (work)
+		kcov_request_phase5_live_svc_put();
+	kcov_request_phase5_note(KCOV_REQUEST_P5_SVC_RQST_FUZZ_RESET);
+}
+
+void sunrpc_fuzz_svc_rqst_reset(struct svc_rqst *rqstp,
+		bool callback, bool short_record)
+{
+	bool granted;
+
+	if (!rqstp)
+		return;
+	granted = rqstp->rq_fuzz_remote_ticket;
+	if (granted) {
+		if (!kcov_request_remote_reset_checked(
+				rqstp->rq_fuzz_remote_ticket))
+			return;
+		kcov_request_remote_ticket_put(rqstp->rq_fuzz_remote_ticket);
+		rqstp->rq_fuzz_remote_ticket = NULL;
+	}
+	/* Without a ticket nobody else completes the tokens. */
+	request_work_finish(rqstp->rq_fuzz_request_work, !granted);
+	if (rqstp->rq_fuzz_request_work)
+		kcov_request_phase5_live_svc_put();
+	rqstp->rq_fuzz_request_work = NULL;
+	saved_work_free(&rqstp->rq_fuzz_saved_work, !granted, true);
+	kcov_request_phase5_note(KCOV_REQUEST_P5_SVC_RQST_FUZZ_RESET);
+	if (callback)
+		kcov_request_phase5_note(KCOV_REQUEST_P5_SVC_RQST_CALLBACK_RESET);
+	if (short_record)
+		kcov_request_phase5_note(
+			KCOV_REQUEST_P5_SVC_RQST_SHORT_RECORD_RESET);
+}
+
+/*
+ * A nested KCOV section quarantines the lane.  Close the server stream so a
+ * hard-mounted client reconnects and retries (ownerless) instead of waiting
+ * for a reply that was dropped.
+ */
+void sunrpc_fuzz_svc_nested_disconnect(struct svc_xprt *xprt)
+{
+	if (!xprt)
+		return;
+	lane_stat_inc(LANE_NESTED_CLOSE);
+	svc_xprt_deferred_close(xprt);
+}
+
+static int lane_stats_show(struct seq_file *m, void *v)
+{
+	unsigned int i;
+
+	for (i = 0; i < LANE_STAT_COUNT; i++)
+		seq_printf(m, "%s %lld\n", lane_stat_names[i],
+			   atomic64_read(&lane_stats[i]));
+	seq_printf(m, "lane_attribution %d\n",
+		   READ_ONCE(lane_attribution_enabled));
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(lane_stats);
+
+static int saved_work_stats_show(struct seq_file *m, void *v)
+{
+	unsigned int i;
+
+	for (i = 0; i < SAVED_STAT_COUNT; i++)
+		seq_printf(m, "%s %lld\n", saved_stat_names[i],
+			   atomic64_read(&saved_stats[i]));
+	seq_printf(m, "live_saved_work %d\n", atomic_read(&live_saved));
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(saved_work_stats);
+
+static int lane_state_show(struct seq_file *m, void *v)
+{
+	struct sunrpc_fuzz_net *fnet = fuzz_pernet(current->nsproxy->net_ns);
+
+	kcov_request_phase5_state_show(m);
+	seq_printf(m, "lane_id %u lane_epoch %llu valid %u unhealthy %u owner %llu\n",
+		   READ_ONCE(fnet->lane_id), READ_ONCE(fnet->lane_epoch),
+		   READ_ONCE(fnet->valid), READ_ONCE(fnet->unhealthy),
+		   lane_owner_handle(current->nsproxy->net_ns));
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(lane_state);
+
+static int domain_show(struct seq_file *m, void *v)
+{
+	struct sunrpc_fuzz_net *fnet;
+	struct sunrpc_fuzz_domain_entry *entry;
+	bool active = false;
+
+	fnet = fuzz_pernet(current->nsproxy->net_ns);
+	if (fnet->valid) {
+		mutex_lock(&domain_lock);
+		list_for_each_entry(entry, &domain_list, list) {
+			if (entry->lane_id == fnet->lane_id &&
+			    entry->lane_epoch == fnet->lane_epoch) {
+				active = true;
+				break;
+			}
+		}
+		mutex_unlock(&domain_lock);
+	}
+	seq_printf(m, "lane_id %u lane_epoch %llu active %u\n",
+		   fnet->lane_id, fnet->lane_epoch, active);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(domain);
+
+/*
+ * "create LANE" from the lane's server netns allocates a fresh epoch;
+ * "join LANE EPOCH" binds a client netns to it; "retire LANE EPOCH" ends it.
+ */
+static ssize_t domain_control_write(struct file *file, const char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	struct sunrpc_fuzz_domain_entry *entry, *tmp, *new = NULL;
+	struct sunrpc_fuzz_net *fnet;
+	char command[64];
+	char op[12];
+	u32 lane;
+	u64 epoch = 0;
+	int fields, ret = -EINVAL;
+
+	if (!count || count >= sizeof(command))
+		return -EINVAL;
+	if (copy_from_user(command, buf, count))
+		return -EFAULT;
+	command[count] = '\0';
+	fields = sscanf(command, "%11s %u %llu", op, &lane, &epoch);
+	if (fields < 2)
+		return -EINVAL;
+	fnet = fuzz_pernet(current->nsproxy->net_ns);
+	if (!strcmp(op, "create")) {
+		if (fields != 2 || fnet->valid) {
+			if (fnet->valid)
+				lane_stat_inc(LANE_EPOCH_IMMUTABLE_VIOLATION);
+			return -EBUSY;
+		}
+		new = kzalloc_obj(*new);
+		if (!new)
+			return -ENOMEM;
+		new->lane_id = lane;
+		new->lane_epoch = alloc_nonzero(&next_lane_epoch);
+		mutex_lock(&domain_lock);
+		list_for_each_entry(entry, &domain_list, list) {
+			if (entry->lane_epoch == new->lane_epoch)
+				lane_stat_inc(LANE_EPOCH_COLLISION);
+			if (entry->lane_id == lane) {
+				ret = -EEXIST;
+				goto domain_unlock;
+			}
+		}
+		list_add_tail(&new->list, &domain_list);
+		fnet->lane_id = lane;
+		fnet->lane_epoch = new->lane_epoch;
+		WRITE_ONCE(fnet->unhealthy, false);
+		WRITE_ONCE(fnet->valid, true);
+		new = NULL;
+		lane_stat_inc(LANE_EPOCH_ALLOCATED);
+		lane_stat_inc(LANE_DOMAIN_CREATED);
+		ret = count;
+	} else if (!strcmp(op, "join")) {
+		if (fields != 3 || fnet->valid) {
+			if (fnet->valid)
+				lane_stat_inc(LANE_EPOCH_IMMUTABLE_VIOLATION);
+			return -EBUSY;
+		}
+		mutex_lock(&domain_lock);
+		list_for_each_entry(entry, &domain_list, list) {
+			if (entry->lane_id == lane && entry->lane_epoch == epoch) {
+				fnet->lane_id = lane;
+				fnet->lane_epoch = epoch;
+				WRITE_ONCE(fnet->unhealthy, false);
+				WRITE_ONCE(fnet->valid, true);
+				lane_stat_inc(LANE_DOMAIN_JOINED);
+				ret = count;
+				break;
+			}
+		}
+	} else if (!strcmp(op, "retire")) {
+		/* Teardown may issue retire after the bound lane netns is gone. */
+		if (fields != 3)
+			return -EINVAL;
+		mutex_lock(&domain_lock);
+		list_for_each_entry_safe(entry, tmp, &domain_list, list) {
+			if (entry->lane_id == lane && entry->lane_epoch == epoch) {
+				list_del(&entry->list);
+				kfree(entry);
+				lane_stat_inc(LANE_DOMAIN_RETIRED);
+				if (fnet->valid && fnet->lane_id == lane &&
+				    fnet->lane_epoch == epoch) {
+					WRITE_ONCE(fnet->valid, false);
+					WRITE_ONCE(fnet->unhealthy, false);
+				}
+				ret = count;
+				break;
+			}
+		}
+	} else {
+		return -EINVAL;
+	}
+domain_unlock:
+	mutex_unlock(&domain_lock);
+	kfree(new);
+	return ret;
+}
+
+static const struct file_operations domain_control_fops = {
+	.owner = THIS_MODULE,
+	.write = domain_control_write,
+	.llseek = noop_llseek,
+};
+
+void sunrpc_fuzz_init(void)
+{
+	if (register_pernet_subsys(&sunrpc_fuzz_net_ops)) {
+		pr_warn_once("SUNRPC fuzz lane initialization failed\n");
+		return;
+	}
+	sunrpc_fuzz_registered = true;
+	if (!IS_ENABLED(CONFIG_DEBUG_FS))
+		return;
+	sunrpc_fuzz_debugfs_dir = debugfs_create_dir("sunrpc_fuzz", NULL);
+	if (IS_ERR_OR_NULL(sunrpc_fuzz_debugfs_dir)) {
+		sunrpc_fuzz_debugfs_dir = NULL;
+		return;
+	}
+	debugfs_create_file("domain", 0400, sunrpc_fuzz_debugfs_dir, NULL,
+			    &domain_fops);
+	debugfs_create_file("domain_control", 0200, sunrpc_fuzz_debugfs_dir,
+			    NULL, &domain_control_fops);
+	debugfs_create_file("lane_stats", 0400, sunrpc_fuzz_debugfs_dir, NULL,
+			    &lane_stats_fops);
+	debugfs_create_file("saved_work_stats", 0400, sunrpc_fuzz_debugfs_dir,
+			    NULL, &saved_work_stats_fops);
+	debugfs_create_file("lane_state", 0400, sunrpc_fuzz_debugfs_dir, NULL,
+			    &lane_state_fops);
+	kcov_request_debugfs_init(sunrpc_fuzz_debugfs_dir);
+}
+
+void sunrpc_fuzz_exit(void)
+{
+	struct sunrpc_fuzz_domain_entry *domain, *tmp;
+
+	kcov_request_debugfs_exit();
+	debugfs_remove_recursive(sunrpc_fuzz_debugfs_dir);
+	sunrpc_fuzz_debugfs_dir = NULL;
+	if (!sunrpc_fuzz_registered)
+		return;
+	mutex_lock(&domain_lock);
+	list_for_each_entry_safe(domain, tmp, &domain_list, list) {
+		list_del(&domain->list);
+		kfree(domain);
+	}
+	mutex_unlock(&domain_lock);
+	unregister_pernet_subsys(&sunrpc_fuzz_net_ops);
+	sunrpc_fuzz_registered = false;
+}

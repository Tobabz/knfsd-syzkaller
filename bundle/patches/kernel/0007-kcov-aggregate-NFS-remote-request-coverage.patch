+void kcov_request_phase6_apply_scratch_fault(
+		struct kcov_request_generation *gen, void *scratch,
+		u32 scratch_size, u32 mode, bool *overflow)
+{
+	unsigned int limit;
+	u64 entries;
+
+	if (!gen || !scratch || !overflow ||
+	    !request_phase6_fault_matches(REQUEST_P6_FAULT_SCRATCH_LIMIT,
+			gen, &limit))
+		return;
+	entries = min_t(u64, request_area_entries(scratch, mode),
+			request_area_capacity(scratch_size, mode));
+	if (entries > limit)
+		request_area_set_entries(scratch, mode, limit);
+	*overflow = true;
+	kcov_request_phase6_note(KCOV_REQUEST_P6_FAULT_SCRATCH_LIMIT);

+static u64 request_area_capacity(u32 size, u32 mode)
+{
+	u64 bytes = (u64)size * sizeof(unsigned long);
+
+	if (mode == KCOV_MODE_TRACE_PC)
+		return size > 0 ? size - 1 : 0;
+	if (mode == KCOV_MODE_TRACE_CMP && bytes >= sizeof(u64))
+		return (bytes - sizeof(u64)) /
+			(sizeof(u64) * REQUEST_KCOV_WORDS_PER_CMP);
+	return 0;
+}
+
+static u64 request_area_entries(const void *area, u32 mode)
+{
+	return mode == KCOV_MODE_TRACE_PC ?
+		READ_ONCE(*(unsigned long *)area) : READ_ONCE(*(u64 *)area);
+}
+
+static void request_area_set_entries(void *area, u32 mode, u64 entries)
+{
+	if (mode == KCOV_MODE_TRACE_PC)
+		WRITE_ONCE(*(unsigned long *)area, entries);
+	else
+		WRITE_ONCE(*(u64 *)area, entries);
+}

+int kcov_request_generation_merge_scratch(
+		struct kcov_request_generation *gen, const void *scratch,
+		u32 scratch_size, u32 mode, bool overflow,
+		struct kcov_request_merge_result *result)
+{
+	u64 src_entries, src_capacity, dst_entries, dst_capacity;
+	u64 entry_size, count_size, entries;
+	void *aggregate;
+	unsigned int aggregate_size;
+	unsigned int fault_limit;
+	bool copied = false;
+	int ret = 0;
+
+	if (!gen || !scratch || !result)
+		return -EINVAL;
+	memset(result, 0, sizeof(*result));
+	src_capacity = request_area_capacity(scratch_size, mode);
+	if (!src_capacity)
+		return -EINVAL;
+	src_entries = request_area_entries(scratch, mode);
+	if (src_entries > src_capacity) {
+		src_entries = src_capacity;
+		overflow = true;
+	}
+	result->source_entries = src_entries;
+	kcov_request_phase6_add(KCOV_REQUEST_P6_SCRATCH_TRACE_ENTRIES,
+			src_entries);
+	if (overflow) {
+		kcov_request_phase6_note(KCOV_REQUEST_P6_SCRATCH_OVERFLOW);
+		kcov_request_remote_degrade(gen,
+			KCOV_REQUEST_REMOTE_INCOMPLETE,
+			KCOV_REQUEST_REMOTE_ISSUE_SCRATCH_OVERFLOW);

+
+static void kcov_request_phase6_test_release(
+		struct kcov_request_phase6_test_ctx *ctx)
+{
+	if (ctx->scratch) {
+		vfree(ctx->scratch);
+		ctx->scratch = NULL;
+	}
+	if (ctx->remote_ref_held) {
+		ctx->remote_ref_held = false;
+		kcov_request_remote_ref_put(ctx->generation);
+	}
+	if (ctx->token.generation)
+		kcov_request_token_complete_once(&ctx->token);
+	if (ctx->root.generation)
+		kcov_request_root_finish(&ctx->root);
+}
+
+static void kcov_request_phase6_test_cleanup(
+		struct kcov_request_phase6_test_ctx *ctx)
+{
+	kcov_request_phase6_test_release(ctx);
+	if (ctx->generation) {
+		kcov_request_generation_abort(ctx->generation);
+		kcov_request_generation_put(ctx->generation);
+		ctx->generation = NULL;
+	}
+}

+static void kcov_request_generation_busy_done(struct kcov *kcov)
+	__must_hold(&kcov->lock)
+{
+	bool pending = kcov->request_reset_pending;
+
+	kcov->request_generation_busy = false;
+	if (pending) {
+		if (kcov->area) {
+			if (kcov->mode == KCOV_MODE_TRACE_CMP)
+				WRITE_ONCE(*(u64 *)kcov->area, 0);
+			else
+				WRITE_ONCE(*(unsigned long *)kcov->area, 0);
+		}
+		kcov_remote_reset(kcov);
+		kcov_request_phase6_note(
+			KCOV_REQUEST_P6_PUBLISH_EXIT_RESET_COMPLETED);
+	}
+}
+
 static void kcov_disable(struct task_struct *t, struct kcov *kcov)
 	__must_hold(&kcov->lock)
 {
@@ -556,6 +586,24 @@ void kcov_task_exit(struct task_struct *t)
 			spin_unlock_irqrestore(&kcov->lock, flags);
 			return;
 		}
+		if (kcov->request_generation_busy) {
+			/*
+			 * A shared-fd sibling may be publishing.  Detach the dying
+			 * task now, but leave the object/maps intact until that ioctl
+			 * drops its destination lease and performs the pending reset.
+			 */
+			t->kcov_remote = NULL;
+			t->kcov_handle = 0;
+			t->kcov_handle_generation = 0;
+			t->kcov_request_generation_controller = false;
+			kcov->t = NULL;
+			kcov->request_reset_pending = true;
+			kcov_request_phase6_note(
+				KCOV_REQUEST_P6_PUBLISH_EXIT_RESET_DEFERRED);
+			spin_unlock_irqrestore(&kcov->lock, flags);
+			kcov_put(kcov);
+			return;
+		}
 		/* Just to not leave dangling references behind. */
 		kcov_disable(t, kcov);
 		spin_unlock_irqrestore(&kcov->lock, flags);
@@ -703,6 +751,8 @@ static int kcov_ioctl_locked(struct kcov *kcov, unsigned int cmd,
 		/* Disable coverage for the current task. */
 		unused = arg;
 		t = current;
+		if (kcov->request_generation_busy)
+			return -EBUSY;
 		if (unused != 0 || (kcov != t->kcov && kcov != t->kcov_remote))
 			return -EINVAL;
 		if (WARN_ON(kcov->t != t))
@@ -775,13 +825,122 @@ static int kcov_ioctl_locked(struct kcov *kcov, unsigned int cmd,
 	}
 }
 
+static void kcov_request_zero_area_count(void *area, enum kcov_mode mode)
+{
+	if (!area)
+		return;
+	if (mode == KCOV_MODE_TRACE_CMP)
+		WRITE_ONCE(*(u64 *)area, 0);
+	else
+		WRITE_ONCE(*(unsigned long *)area, 0);
+}
+
+static void kcov_request_clear_published_area(struct kcov *kcov)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&kcov->lock, flags);
+	kcov_request_zero_area_count(kcov->area, kcov->mode);
+	/* Retire any legacy section that started before this terminal event. */
+	kcov->sequence++;
+	spin_unlock_irqrestore(&kcov->lock, flags);
+}
+
+static int kcov_request_publish_generation(struct kcov *kcov,
+		struct kcov_request_generation *generation)
+{
+	struct kcov_request_publish_lease lease;
+	void *destination;
+	unsigned int destination_mode;
+	unsigned long flags;
+	u64 count_size, entries, entry_size, old_entries;
+	int ret;
+
+	ret = kcov_request_generation_publish_begin(generation, &lease);
+	if (ret == -ENODATA) {
+		kcov_request_clear_published_area(kcov);
+		return 0;
+	}
+	if (ret)
+		return ret;
+	if (!kcov_request_phase6_publish_valid(generation)) {
+		kcov_request_generation_publish_end(&lease);
+		return -EUCLEAN;
+	}
+
+	spin_lock_irqsave(&kcov->lock, flags);
+	if (kcov->request_generation != generation || !kcov->area ||
+	    kcov->mode != lease.mode || kcov->size < lease.size) {
+		spin_unlock_irqrestore(&kcov->lock, flags);
+		kcov_request_generation_publish_end(&lease);
+		return -ESTALE;
+	}
+	destination = kcov->area;
+	destination_mode = kcov->mode;
+	old_entries = destination_mode == KCOV_MODE_TRACE_PC ?
+		READ_ONCE(*(unsigned long *)destination) :
+		READ_ONCE(*(u64 *)destination);
+	kcov_request_zero_area_count(destination, destination_mode);
+	kcov->sequence++;
+	spin_unlock_irqrestore(&kcov->lock, flags);
+
+	/* The lease pins the immutable source while the large copy is unlocked. */
+	kcov_request_phase6_pause_publish(generation);
+	spin_lock_irqsave(&kcov->lock, flags);
+	if (kcov->request_reset_pending) {
+		kcov_request_zero_area_count(kcov->area, kcov->mode);
+		spin_unlock_irqrestore(&kcov->lock, flags);
+		kcov_request_phase6_note(
+			KCOV_REQUEST_P6_AGGREGATE_PUBLISH_SUPPRESSED);
+		kcov_request_generation_publish_end(&lease);
+		return 0;
+	}
+	spin_unlock_irqrestore(&kcov->lock, flags);
+	entries = destination_mode == KCOV_MODE_TRACE_PC ?
+		READ_ONCE(*(unsigned long *)lease.area) :
+		READ_ONCE(*(u64 *)lease.area);
+	count_size = destination_mode == KCOV_MODE_TRACE_PC ?
+		sizeof(unsigned long) : sizeof(u64);
+	entry_size = destination_mode == KCOV_MODE_TRACE_PC ?
+		sizeof(unsigned long) : sizeof(u64) * KCOV_WORDS_PER_CMP;
+	memcpy(destination + count_size, lease.area + count_size,
+	       entries * entry_size);
+	smp_wmb();
+	if (destination_mode == KCOV_MODE_TRACE_PC)
+		WRITE_ONCE(*(unsigned long *)destination, entries);
+	else
+		WRITE_ONCE(*(u64 *)destination, entries);
+	spin_lock_irqsave(&kcov->lock, flags);
+	if (kcov->request_reset_pending)
+		kcov_request_zero_area_count(kcov->area, kcov->mode);
+	ret = kcov->request_reset_pending ? -ECANCELED : 0;
+	spin_unlock_irqrestore(&kcov->lock, flags);
+	if (ret) {
+		kcov_request_phase6_note(
+			KCOV_REQUEST_P6_AGGREGATE_PUBLISH_SUPPRESSED);
+		kcov_request_generation_publish_end(&lease);
+		return 0;
+	}
+	if (old_entries)
+		kcov_request_phase6_note(
+			KCOV_REQUEST_P6_DESTINATION_SEED_OVERWRITTEN);
+	kcov_request_phase6_assert_copy_unlocked(generation);
+	kcov_request_phase6_note(KCOV_REQUEST_P6_AGGREGATE_PUBLISHED);
+	kcov_request_phase6_add(KCOV_REQUEST_P6_AGGREGATE_ENTRIES_PUBLISHED,
+			entries);
+	kcov_request_generation_publish_end(&lease);
+	return 0;
+}
+
 static long kcov_request_generation_ioctl(struct kcov *kcov,
 		unsigned int cmd, void __user *uarg)
 {
 	struct kcov_remote_generation arg;
 	struct kcov_request_generation *gen = NULL, *old = NULL;
 	unsigned long flags;
+	unsigned int generation_mode = 0, generation_size = 0;
 	u64 owner;
+	bool request_busy;
 	int ret;
 
 	/* BIND workers never own whole-generation exit-time ABORT authority. */
@@ -804,19 +963,25 @@ static long kcov_request_generation_ioctl(struct kcov *kcov,
 		if (arg.generation || arg.timeout_ms)
 			return -EINVAL;
 		spin_lock_irqsave(&kcov->lock, flags);
+		request_busy = kcov->request_generation_busy;
 		if (!kcov->remote || !kcov->request_common_handle ||
-		    kcov->request_generation_busy ||
+		    request_busy ||
 		    (kcov->request_generation &&
 		     !kcov->request_generation_closed &&
 		     !kcov_request_generation_is_terminal(
 			     kcov->request_generation))) {
 			spin_unlock_irqrestore(&kcov->lock, flags);
+			if (request_busy)
+				kcov_request_phase6_note(
+					KCOV_REQUEST_P6_PUBLISH_BEGIN_BLOCKED);
 			return -EBUSY;
 		}
 		old = kcov->request_generation;
 		kcov->request_generation = NULL;
 		kcov->request_generation_busy = true;
 		owner = kcov->request_common_handle;
+		generation_mode = kcov->mode;
+		generation_size = kcov->size;
 		/* The prior terminal window is no longer controlled by this task. */
 		current->kcov_request_generation_controller = false;
 		spin_unlock_irqrestore(&kcov->lock, flags);
@@ -828,6 +993,10 @@ static long kcov_request_generation_ioctl(struct kcov *kcov,
 			gen = NULL;
 			goto begin_done;
 		}
+		ret = kcov_request_generation_remote_open(gen, generation_mode,
+				generation_size);
+		if (ret)
+			goto begin_done;
 		ret = kcov_request_generation_bind(owner, arg.generation);
 		if (ret)
 			goto begin_done;
@@ -836,15 +1005,22 @@ static long kcov_request_generation_ioctl(struct kcov *kcov,
 begin_done:
 		spin_lock_irqsave(&kcov->lock, flags);
 		kcov->request_generation_busy = false;
-		if (!ret && kcov->remote &&
+		if (!ret && !kcov->request_reset_pending && kcov->remote &&
 		    kcov->request_common_handle == owner) {
 			kcov->request_generation = gen;
 			kcov->request_generation_closed = false;
+			/* Managed generations exclusively own the published mmap. */
+			kcov_request_zero_area_count(kcov->area, kcov->mode);
+			kcov->sequence++;
 			current->kcov_request_generation_controller = true;
 			gen = NULL;
 		} else {
+			if (!ret)
+				ret = -ESTALE;
 			current->kcov_handle_generation = 0;
 		}
+		if (kcov->request_reset_pending)
+			kcov_remote_reset(kcov);
 		spin_unlock_irqrestore(&kcov->lock, flags);
 		if (gen) {
 			kcov_request_generation_abort(gen);
@@ -869,18 +1045,26 @@ static long kcov_request_generation_ioctl(struct kcov *kcov,
 		return kcov_request_generation_bind(owner, 0);
 	}
 	if (cmd == KCOV_REMOTE_GENERATION_ABORT && !arg.generation) {
-		if (arg.timeout_ms || !kcov->request_generation ||
+		request_busy = kcov->request_generation_busy;
+		if (arg.timeout_ms || request_busy ||

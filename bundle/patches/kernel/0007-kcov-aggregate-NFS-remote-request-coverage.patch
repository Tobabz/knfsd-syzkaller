+	spin_lock(&request_phase6_fault_lock);
+	match = request_phase6_fault == fault && gen &&
+		request_phase6_fault_owner == gen->owner &&
+		request_phase6_fault_generation == gen->id;
+	if (match && limit)
+		*limit = request_phase6_fault_limit;
+	spin_unlock(&request_phase6_fault_lock);
+	return match;
+}

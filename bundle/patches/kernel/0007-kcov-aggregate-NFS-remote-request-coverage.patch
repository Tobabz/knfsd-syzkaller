+static void request_phase6_reset(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < KCOV_REQUEST_P6_STAT_COUNT; i++)
+		atomic64_set(&request_phase6_stats[i], 0);
+	atomic_set(&request_phase6_scratch_peak,
+		   atomic_read(&request_phase6_live_scratch));
+	spin_lock(&request_phase6_fault_lock);
+	request_phase6_fault = REQUEST_P6_FAULT_NONE;
+	request_phase6_fault_owner = 0;
+	request_phase6_fault_generation = 0;
+	request_phase6_fault_limit = 0;
+	request_phase6_fault_count = 0;
+	WRITE_ONCE(request_phase6_fault_released, true);
+	spin_unlock(&request_phase6_fault_lock);
+	wake_up_all(&request_phase6_fault_wait);
+}

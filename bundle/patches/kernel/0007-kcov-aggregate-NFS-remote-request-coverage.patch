+	mutex_lock(&gen->aggregate_merge_lock);
+	if (atomic_xchg(&gen->aggregate_merging, 1))
+		kcov_request_phase6_note(KCOV_REQUEST_P6_AGGREGATE_MERGE_OVERLAP);
+	spin_lock(&gen->lock);
+	if (!gen->remote_refs) {
+		kcov_request_phase6_note(KCOV_REQUEST_P6_LATE_MERGE_AFTER_REFS_ZERO);
+		ret = -ESTALE;
+		goto unlock_state;
+	}
+	if (gen->remote_result != KCOV_REQUEST_REMOTE_VALID ||
+	    gen->state == KCOV_REQUEST_GEN_ABORTED ||
+	    (gen->aggregate_state != KCOV_REQUEST_AGGREGATE_OPEN &&
+	     gen->aggregate_state != KCOV_REQUEST_AGGREGATE_CLOSING)) {
+		ret = -ECANCELED;
+		goto unlock_state;
+	}
+	if (gen->aggregate_mode != mode || !gen->aggregate_area) {
+		ret = -EINVAL;
+		goto unlock_state;
+	}
+	aggregate = gen->aggregate_area;
+	aggregate_size = gen->aggregate_size;
+	kcov_request_phase6_note(KCOV_REQUEST_P6_AGGREGATE_MERGE_STARTED);
+	spin_unlock(&gen->lock);
+
+	dst_capacity = request_area_capacity(aggregate_size, mode);
+	if (request_phase6_fault_matches(REQUEST_P6_FAULT_AGGREGATE_LIMIT,
+			gen, &fault_limit)) {
+		dst_capacity = min_t(u64, dst_capacity, fault_limit);
+		kcov_request_phase6_note(KCOV_REQUEST_P6_FAULT_AGGREGATE_LIMIT);
+	}
+	dst_entries = request_area_entries(aggregate, mode);
+	if (dst_entries > dst_capacity)
+		dst_entries = dst_capacity;
+	entries = min(src_entries, dst_capacity - dst_entries);
+	count_size = mode == KCOV_MODE_TRACE_PC ? sizeof(unsigned long) :
+			sizeof(u64);
+	entry_size = mode == KCOV_MODE_TRACE_PC ? sizeof(unsigned long) :
+			sizeof(u64) * REQUEST_KCOV_WORDS_PER_CMP;
+	memcpy(aggregate + count_size + dst_entries * entry_size,
+	       scratch + count_size, entries * entry_size);
+	smp_wmb();
+	request_area_set_entries(aggregate, mode, dst_entries + entries);
+	copied = true;
+	result->merged_entries = entries;
+	result->truncated = entries < src_entries;
+
+	spin_lock(&gen->lock);
+	if (gen->remote_result == KCOV_REQUEST_REMOTE_VALID &&
+	    gen->state != KCOV_REQUEST_GEN_ABORTED &&
+	    (gen->aggregate_state == KCOV_REQUEST_AGGREGATE_OPEN ||
+	     gen->aggregate_state == KCOV_REQUEST_AGGREGATE_CLOSING)) {
+		gen->aggregate_entries = dst_entries + entries;
+	}
+unlock_state:
+	spin_unlock(&gen->lock);
+	atomic_set(&gen->aggregate_merging, 0);
+	mutex_unlock(&gen->aggregate_merge_lock);
+
+	if (result->truncated) {
+		kcov_request_phase6_note(KCOV_REQUEST_P6_AGGREGATE_MERGE_TRUNCATED);
+		kcov_request_remote_degrade(gen,
+			KCOV_REQUEST_REMOTE_INCOMPLETE,
+			KCOV_REQUEST_REMOTE_ISSUE_MERGE_TRUNCATED);
+	}
+	if (copied) {
+		kcov_request_phase6_note(KCOV_REQUEST_P6_AGGREGATE_MERGE_COMPLETED);
+		kcov_request_phase6_add(KCOV_REQUEST_P6_AGGREGATE_ENTRIES_MERGED,
+				entries);
+	}
+	if (ret && ret != -ECANCELED)
+		kcov_request_remote_degrade(gen,
+			ret == -ESTALE ? KCOV_REQUEST_REMOTE_INVALID :
+				KCOV_REQUEST_REMOTE_INCOMPLETE,
+			KCOV_REQUEST_REMOTE_ISSUE_MERGE_FAILED);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(kcov_request_generation_merge_scratch);

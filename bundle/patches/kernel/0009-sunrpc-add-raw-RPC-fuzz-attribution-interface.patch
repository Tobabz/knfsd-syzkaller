diff --git a/kernel/kcov_request.c b/kernel/kcov_request.c
index 507975aa5..90cfd7e25 100644
--- a/kernel/kcov_request.c
+++ b/kernel/kcov_request.c
@@ -1076,9 +1076,49 @@ int kcov_request_generation_abort(struct kcov_request_generation *gen)
 }
 EXPORT_SYMBOL_GPL(kcov_request_generation_abort);
 
+/* Called with gen->lock held; returns embedded-token refs to drop unlocked. */
+static unsigned int request_auto_finish_roots_locked(
+		struct kcov_request_generation *gen)
+{
+	struct kcov_request_root *root, *tmp;
+	unsigned int token_refs = 0;
+
+	list_for_each_entry_safe(root, tmp, &gen->roots, node) {
+		struct kcov_request_token *token;
+
+		if (!root->auto_finish_on_closing ||
+		    atomic_read(&root->finished))
+			continue;
+		/*
+		 * Remove admission/accounting now, but retain the root-holder ref
+		 * until its owner destroys the embedded root.  That ref also pins
+		 * this memory against a concurrent owner teardown.
+		 */
+		list_del_init(&root->node);
+		gen->active_roots--;
+		root->state = KCOV_REQUEST_ROOT_DONE;
+		root->auto_finished = 1;
+		token = &root->root_token;
+		if (atomic_cmpxchg(&token->completed, REQUEST_TOKEN_ACTIVE,
+				   REQUEST_TOKEN_DONE) == REQUEST_TOKEN_ACTIVE) {
+			list_del_init(&token->node);
+			gen->outstanding_tokens--;
+			token->generation = NULL;
+			token_refs++;
+			request_stat_inc(REQUEST_ROOT_TOKEN_COMPLETED);
+			request_stat_inc(REQUEST_TOKEN_COMPLETED);
+		} else {
+			WARN_ON_ONCE(1);
+		}
+	}
+	return token_refs;
+}
+
 int kcov_request_generation_finish(struct kcov_request_generation *gen,
 		u32 timeout_ms)
 {
+	struct kcov_request_root *root;
+	unsigned int auto_token_refs = 0;
 	long left;
 	int ret = 0;
 
@@ -1086,14 +1126,13 @@ int kcov_request_generation_finish(struct kcov_request_generation *gen,
 		return -EINVAL;
 	spin_lock(&gen->lock);
 	if (gen->state == KCOV_REQUEST_GEN_OPEN) {
-		struct kcov_request_root *root;
-
 		gen->state = KCOV_REQUEST_GEN_CLOSING;
 		if (gen->aggregate_state == KCOV_REQUEST_AGGREGATE_OPEN)
 			gen->aggregate_state = KCOV_REQUEST_AGGREGATE_CLOSING;
 		list_for_each_entry(root, &gen->roots, node)
 			root->retry_deadline = jiffies +
 				msecs_to_jiffies(timeout_ms);
+		auto_token_refs = request_auto_finish_roots_locked(gen);
 		request_stat_inc(REQUEST_GENERATION_CLOSING);
 	} else if (gen->state == KCOV_REQUEST_GEN_COMMITTED) {
 		spin_unlock(&gen->lock);
@@ -1103,6 +1142,11 @@ int kcov_request_generation_finish(struct kcov_request_generation *gen,
 		return -ESTALE;
 	}
 	spin_unlock(&gen->lock);
+	while (auto_token_refs) {
+		auto_token_refs--;
+		kcov_request_generation_put(gen);
+	}
+	wake_up_all(&gen->drain_wait);
 	request_stat_inc(REQUEST_GENERATION_FINISH);
 
 	left = wait_event_interruptible_timeout(gen->drain_wait,
@@ -1160,8 +1204,9 @@ static void request_token_init_locked(struct kcov_request_generation *gen,
 	request_stat_inc(REQUEST_TOKEN_CREATED);
 }
 
-bool kcov_request_root_init(struct kcov_request_root *root,
-		struct kcov_common_handle_id owner, u64 request_cookie)
+static bool __kcov_request_root_init(struct kcov_request_root *root,
+		struct kcov_common_handle_id owner, u64 request_cookie,
+		bool auto_finish)

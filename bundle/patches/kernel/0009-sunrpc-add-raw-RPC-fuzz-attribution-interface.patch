 	bool ok = false;
@@ -1183,6 +1228,7 @@ bool kcov_request_root_init(struct kcov_request_root *root,
 		root->request_cookie = request_cookie;
 		root->retry_deadline = jiffies + msecs_to_jiffies(5000);
 		root->state = KCOV_REQUEST_ROOT_ACTIVE;
+		root->auto_finish_on_closing = auto_finish;
 		list_add_tail(&root->node, &gen->roots);
 		gen->active_roots++;
 		request_token_init_locked(gen, &root->root_token,
@@ -1200,8 +1246,21 @@ bool kcov_request_root_init(struct kcov_request_root *root,
 		kcov_request_generation_put(gen);
 	return ok;
 }
+

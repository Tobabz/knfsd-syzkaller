diff --git a/net/ipv4/tcp.c b/net/ipv4/tcp.c
index 1b3ae3a0f..8fcdd3b79 100644
--- a/net/ipv4/tcp.c
+++ b/net/ipv4/tcp.c
@@ -290,6 +290,85 @@
 
 #include "../core/devmem.h"
 
+#if IS_ENABLED(CONFIG_SUNRPC)
+static DEFINE_MUTEX(tcp_sunrpc_fuzz_ops_lock);
+static const struct tcp_sunrpc_fuzz_ops __rcu *tcp_sunrpc_fuzz_ops;
+
+int tcp_register_sunrpc_fuzz(const struct tcp_sunrpc_fuzz_ops *ops)
+{
+	int ret = 0;
+
+	if (!ops || !ops->enable)
+		return -EINVAL;
+	mutex_lock(&tcp_sunrpc_fuzz_ops_lock);
+	if (rcu_access_pointer(tcp_sunrpc_fuzz_ops))
+		ret = -EBUSY;
+	else
+		rcu_assign_pointer(tcp_sunrpc_fuzz_ops, ops);
+	mutex_unlock(&tcp_sunrpc_fuzz_ops_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(tcp_register_sunrpc_fuzz);
+
+void tcp_unregister_sunrpc_fuzz(const struct tcp_sunrpc_fuzz_ops *ops)
+{
+	mutex_lock(&tcp_sunrpc_fuzz_ops_lock);
+	if (rcu_access_pointer(tcp_sunrpc_fuzz_ops) == ops)
+		RCU_INIT_POINTER(tcp_sunrpc_fuzz_ops, NULL);
+	mutex_unlock(&tcp_sunrpc_fuzz_ops_lock);
+	synchronize_rcu();
+}
+EXPORT_SYMBOL_GPL(tcp_unregister_sunrpc_fuzz);
+
+static int tcp_sunrpc_fuzz_enable(struct sock *sk)
+{
+	const struct tcp_sunrpc_fuzz_ops *ops;
+	struct module *owner;
+	int (*enable)(struct sock *sk);
+	int ret;
+
+	if (sk->sk_sunrpc_fuzz_raw_context)
+		return -EALREADY;
+	rcu_read_lock();
+	ops = rcu_dereference(tcp_sunrpc_fuzz_ops);
+	if (!ops || (ops->owner && !try_module_get(ops->owner))) {
+		rcu_read_unlock();
+		return -EOPNOTSUPP;
+	}
+	owner = ops->owner;
+	enable = ops->enable;
+	rcu_read_unlock();
+
+	ret = enable(sk);
+	if (ret) {
+		if (owner)
+			module_put(owner);
+		return ret;
+	}
+	sk->sk_sunrpc_fuzz_raw_owner = owner;
+	return 0;
+}
+
+static void tcp_sunrpc_fuzz_release(struct sock *sk)
+{
+	struct module *owner;
+	void (*release)(struct sock *sk);
+
+	release = xchg(&sk->sk_sunrpc_fuzz_raw_release, NULL);
+	if (!release)
+		return;
+	owner = xchg(&sk->sk_sunrpc_fuzz_raw_owner, NULL);
+	release(sk);
+	WRITE_ONCE(sk->sk_sunrpc_fuzz_raw_sendmsg, NULL);
+	WRITE_ONCE(sk->sk_sunrpc_fuzz_raw_result, NULL);
+	WRITE_ONCE(sk->sk_sunrpc_fuzz_raw_recv, NULL);
+	WRITE_ONCE(sk->sk_sunrpc_fuzz_raw_connect_result, NULL);
+	WRITE_ONCE(sk->sk_sunrpc_fuzz_raw_context, NULL);
+	if (owner)
+		module_put(owner);
+}
+#endif
+
 /* Track pending CMSGs. */
 enum {
 	TCP_CMSG_INQ = 1,
@@ -1113,6 +1192,49 @@ void tcp_rate_check_app_limited(struct sock *sk)
 }
 EXPORT_SYMBOL_GPL(tcp_rate_check_app_limited);
 
+#if IS_ENABLED(CONFIG_SUNRPC)
+static int tcp_sunrpc_fuzz_parse_cmsg(struct msghdr *msg,
+		struct tcp_sunrpc_fuzz *control, bool *present)
+{
+	struct cmsghdr *cmsg;
+
+	*present = false;
+	for_each_cmsghdr(cmsg, msg) {
+		if (!CMSG_OK(msg, cmsg))
+			return -EINVAL;
+		if (cmsg->cmsg_level != SOL_TCP ||
+		    cmsg->cmsg_type != TCP_SUNRPC_FUZZ)
+			continue;
+		if (*present || cmsg->cmsg_len != CMSG_LEN(sizeof(*control)))
+			return -EINVAL;
+		memcpy(control, CMSG_DATA(cmsg), sizeof(*control));
+		*present = true;
+	}
+	return 0;
+}
+
+static int tcp_sunrpc_fuzz_validate_record(struct msghdr *msg, size_t size,
+		u32 *xid)
+{
+	struct iov_iter iter = msg->msg_iter;
+	__be32 words[3];
+	u32 marker;
+
+	/* Record Marker, XID and CALL direction are the minimum exact prefix. */
+	if (size < sizeof(words) || size - sizeof(__be32) > 0x7fffffffU)
+		return -EMSGSIZE;
+	if (!copy_from_iter_full(words, sizeof(words), &iter))
+		return -EFAULT;
+	marker = be32_to_cpu(words[0]);
+	if (!(marker & BIT(31)) ||
+	    (marker & ~BIT(31)) != size - sizeof(__be32) ||
+	    words[2] != cpu_to_be32(0))
+		return -EINVAL;
+	*xid = be32_to_cpu(words[1]);
+	return 0;
+}
+#endif
+
 int tcp_sendmsg_locked(struct sock *sk, struct msghdr *msg, size_t size)
 {
 	struct net_devmem_dmabuf_binding *binding = NULL;
@@ -1126,6 +1248,13 @@ int tcp_sendmsg_locked(struct sock *sk, struct msghdr *msg, size_t size)
 	int sockc_err = 0;
 	int zc = 0;
 	long timeo;
+#if IS_ENABLED(CONFIG_SUNRPC)
+	struct tcp_sunrpc_fuzz fuzz_control = {};
+	bool fuzz_present = false;
+	bool fuzz_prepared = false;
+	u32 fuzz_xid = 0;
+	int fuzz_err = 0;
+#endif
 
 	flags = msg->msg_flags;
 
@@ -1137,6 +1266,58 @@ int tcp_sendmsg_locked(struct sock *sk, struct msghdr *msg, size_t size)
 		 */
 	}
 
+#if IS_ENABLED(CONFIG_SUNRPC)
+	if (msg->msg_controllen)
+		fuzz_err = tcp_sunrpc_fuzz_parse_cmsg(msg, &fuzz_control,
+				&fuzz_present);
+	if (!fuzz_err && fuzz_present) {
+		u32 action = fuzz_control.flags &
+			(TCP_SUNRPC_FUZZ_F_NEW | TCP_SUNRPC_FUZZ_F_RETRY |
+			 TCP_SUNRPC_FUZZ_F_CANCEL);
+
+		if (fuzz_control.version != TCP_SUNRPC_FUZZ_VERSION ||
+		    !fuzz_control.user_tag ||
+		    fuzz_control.flags & ~(TCP_SUNRPC_FUZZ_F_NEW |
+			TCP_SUNRPC_FUZZ_F_RETRY | TCP_SUNRPC_FUZZ_F_FINAL |
+			TCP_SUNRPC_FUZZ_F_CANCEL) ||
+		    (action != TCP_SUNRPC_FUZZ_F_NEW &&
+		     action != TCP_SUNRPC_FUZZ_F_RETRY &&
+		     action != TCP_SUNRPC_FUZZ_F_CANCEL) ||
+		    (action == TCP_SUNRPC_FUZZ_F_CANCEL &&
+		     fuzz_control.flags != TCP_SUNRPC_FUZZ_F_CANCEL) ||
+		    (action == TCP_SUNRPC_FUZZ_F_CANCEL) != (size == 0))
+			fuzz_err = -EINVAL;
+		else if (msg->msg_flags & (MSG_FASTOPEN | MSG_ZEROCOPY |
+			 MSG_SPLICE_PAGES | MSG_OOB))
+			fuzz_err = -EOPNOTSUPP;
+		else if (inet_test_bit(DEFER_CONNECT, sk) || tp->repair)
+			fuzz_err = -EOPNOTSUPP;
+		else if (action != TCP_SUNRPC_FUZZ_F_CANCEL)
+			fuzz_err = tcp_sunrpc_fuzz_validate_record(msg, size,
+					&fuzz_xid);
+		if (!fuzz_err && !sk->sk_sunrpc_fuzz_raw_sendmsg)
+			fuzz_err = -EOPNOTSUPP;
+	} else if (!fuzz_err && size && sk->sk_sunrpc_fuzz_raw_context) {
+		/* Once opted in, every data record needs exact framing metadata. */
+		fuzz_err = -EINVAL;
+	}
+	if (fuzz_err) {
+		err = fuzz_err;
+		goto out_err;
+	}
+	if (fuzz_present &&
+	    fuzz_control.flags == TCP_SUNRPC_FUZZ_F_CANCEL) {
+		if (sockc_err) {
+			err = sockc_err;
+			goto out_err;
+		}
+		err = sk->sk_sunrpc_fuzz_raw_sendmsg(sk, &fuzz_control, 0, 0);
+		if (err)
+			goto out_err;
+		return 0;
+	}
+#endif
+
 	if ((flags & MSG_ZEROCOPY) && size) {
 		if (msg->msg_ubuf) {
 			uarg = msg->msg_ubuf;
@@ -1217,6 +1398,16 @@ int tcp_sendmsg_locked(struct sock *sk, struct msghdr *msg, size_t size)
 		goto out_err;
 	}
 
+#if IS_ENABLED(CONFIG_SUNRPC)
+	if (fuzz_present) {
+		err = sk->sk_sunrpc_fuzz_raw_sendmsg(sk, &fuzz_control,
+				fuzz_xid, size);
+		if (err)
+			goto out_err;
+		fuzz_prepared = true;
+	}
+#endif

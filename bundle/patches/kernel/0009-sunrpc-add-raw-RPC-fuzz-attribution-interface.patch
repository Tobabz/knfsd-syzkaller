+static void raw_recv(struct sock *sk, const struct sk_buff *skb, u32 offset,
+		size_t size)
+{
+	struct sunrpc_fuzz_raw_sock *raw =
+		sk->sk_sunrpc_fuzz_raw_context;
+
+	if (!raw || raw->rx_parse_failed)
+		return;
+	while (size) {
+		if (raw->rx_marker_bytes < sizeof(raw->rx_marker)) {
+			size_t copy = min_t(size_t, size,
+				sizeof(raw->rx_marker) - raw->rx_marker_bytes);
+			__be32 marker;
+
+			if (skb_copy_bits(skb, offset,
+					raw->rx_marker + raw->rx_marker_bytes,
+					copy)) {
+				raw->rx_parse_failed = true;
+				phase7_stat_inc(P7_RAW_RX_PARSE_ERROR);
+				return;
+			}
+			raw->rx_marker_bytes += copy;
+			offset += copy;
+			size -= copy;
+			if (raw->rx_marker_bytes < sizeof(raw->rx_marker))
+				continue;
+			memcpy(&marker, raw->rx_marker, sizeof(marker));
+			raw->rx_fragment_remaining =
+				be32_to_cpu(marker) & 0x7fffffffU;
+			raw->rx_fragment_last =
+				!!(be32_to_cpu(marker) & BIT(31));
+		}
+
+		if (raw->rx_fragment_remaining) {
+			size_t skip = min_t(size_t, size,
+				raw->rx_fragment_remaining);
+
+			raw->rx_fragment_remaining -= skip;
+			offset += skip;
+			size -= skip;
+		}
+		if (raw->rx_fragment_remaining)
+			continue;
+		if (raw->rx_fragment_last) {
+			if (!record_received(raw->conn, SUNRPC_FUZZ_S2C)) {
+				raw->rx_parse_failed = true;
+				phase7_stat_inc(P7_RAW_RX_PARSE_ERROR);
+				return;
+			}
+			phase7_stat_inc(P7_RAW_RX_RECORD);
+		}
+		raw->rx_marker_bytes = 0;
+		raw->rx_fragment_last = false;
+	}

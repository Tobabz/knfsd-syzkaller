+static void raw_pre_connect(struct sock *sk)
+{
+	struct sunrpc_fuzz_raw_sock *raw =
+		sk->sk_sunrpc_fuzz_raw_context;
+	struct sunrpc_fuzz_pending *pending, *stale = NULL, *tmp;
+	struct sunrpc_fuzz_conn *conn;
+	struct sunrpc_fuzz_net *fnet;
+	struct inet_sock *inet;
+	unsigned long flags;
+
+	sk->sk_sunrpc_fuzz_preconnect = NULL;
+	if (!raw || raw->conn || sk->sk_family != AF_INET)
+		goto fail;
+	fnet = fuzz_pernet(sock_net(sk));
+	if (!READ_ONCE(fnet->valid))
+		goto fail;
+	pending = kzalloc(sizeof(*pending), GFP_ATOMIC);
+	conn = kzalloc(sizeof(*conn), GFP_ATOMIC);
+	if (!pending || !conn) {
+		kfree(pending);
+		kfree(conn);
+		goto fail;
+	}
+	inet = inet_sk(sk);
+	refcount_set(&conn->refs, 2); /* raw socket + pending registry */
+	INIT_LIST_HEAD(&conn->all);
+	INIT_LIST_HEAD(&conn->wire_work);
+	spin_lock_init(&conn->lock);
+	conn->conn_cookie = alloc_nonzero(&next_conn_cookie);
+	conn->key.lane_id = READ_ONCE(fnet->lane_id);
+	conn->key.lane_epoch = READ_ONCE(fnet->lane_epoch);
+	conn->key.protocol = IPPROTO_TCP;
+	conn->key.family = AF_INET;
+	conn->key.client_addr = inet->inet_saddr;
+	conn->key.client_port = inet->inet_sport;
+	conn->key.server_addr = inet->inet_daddr;
+	conn->key.server_port = inet->inet_dport;
+	conn->client_attached = true;
+	pending->conn = conn;
+	pending->expires = jiffies + SUNRPC_FUZZ_PENDING_TTL;
+
+	spin_lock_irqsave(&conn_lock, flags);
+	list_for_each_entry(tmp, &pending_list, list) {
+		if (key_equal(&tmp->conn->key, &conn->key)) {
+			stale = tmp;
+			list_del(&stale->list);
+			break;
+		}
+	}
+	list_add_tail(&conn->all, &conn_list);
+	list_add_tail(&pending->list, &pending_list);
+	raw->conn = conn;
+	spin_unlock_irqrestore(&conn_lock, flags);
+	if (stale) {
+		phase3_stat_inc(P3_CONNECTION_PAIR_EXPIRED);
+		conn_put(stale->conn);
+		kfree(stale);
+	}
+	sk->sk_sunrpc_fuzz_retransmit_context = raw;
+	sk->sk_sunrpc_fuzz_retransmit = raw_tcp_retransmit;
+	mod_delayed_work(system_wq, &pending_expiry_work, HZ);
+	phase7_stat_inc(P7_RAW_PRECONNECT_CREATED);
+	return;
+fail:
+	phase7_stat_inc(P7_RAW_PRECONNECT_FAILED);
+}
+
+static void raw_connect_result(struct sock *sk, int status)
+{
+	struct sunrpc_fuzz_raw_sock *raw =
+		sk->sk_sunrpc_fuzz_raw_context;
+	struct sunrpc_fuzz_pending *pending, *tmp, *found = NULL;
+	struct sunrpc_fuzz_conn *conn;
+	unsigned long flags;
+
+	if (!status || !raw)
+		return;
+	conn = raw->conn;
+	if (!conn)
+		return;
+	spin_lock_irqsave(&conn_lock, flags);
+	list_for_each_entry_safe(pending, tmp, &pending_list, list) {
+		if (pending->conn == conn) {
+			list_del(&pending->list);
+			found = pending;
+			break;
+		}
+	}
+	conn->client_attached = false;
+	raw->conn = NULL;
+	spin_unlock_irqrestore(&conn_lock, flags);
+	if (found) {
+		conn_put(found->conn);
+		kfree(found);
+	}
+	conn_put(conn);
+	if (sk->sk_sunrpc_fuzz_retransmit_context == raw) {
+		sk->sk_sunrpc_fuzz_retransmit_context = NULL;
+		sk->sk_sunrpc_fuzz_retransmit = NULL;
+	}
+	sk->sk_sunrpc_fuzz_preconnect = raw_pre_connect;
+	phase7_stat_inc(P7_RAW_PRECONNECT_FAILED);
+}
+
+static int raw_sendmsg(struct sock *sk,
+		const struct tcp_sunrpc_fuzz *control, u32 xid, size_t size)
+{
+	struct sunrpc_fuzz_raw_sock *raw =
+		sk->sk_sunrpc_fuzz_raw_context;
+	struct sunrpc_fuzz_raw_tag *tag;
+	struct sunrpc_fuzz_origin origin;
+	struct sunrpc_fuzz_rqst rqst = {};
+	u32 action = control->flags &
+		(TCP_SUNRPC_FUZZ_F_NEW | TCP_SUNRPC_FUZZ_F_RETRY |
+		 TCP_SUNRPC_FUZZ_F_CANCEL);
+	bool is_new = action == TCP_SUNRPC_FUZZ_F_NEW;
+
+	if (!raw || raw->active_tag || (!raw->conn && size))
+		goto rejected;
+	tag = raw_tag_find(raw, control->user_tag);
+	if (action == TCP_SUNRPC_FUZZ_F_CANCEL) {
+		if (!tag) {
+			phase7_stat_inc(P7_RAW_CROSS_SOCKET_RETRY_REJECTED);
+			goto rejected;
+		}
+		raw_tag_cancel(tag, true);
+		raw_tag_free(raw, tag);
+		phase7_stat_inc(P7_RAW_CMSG_CANCEL);
+		return 0;
+	}
+	if (is_new) {
+		if (tag) {
+			phase7_stat_inc(P7_RAW_TAG_COLLISION);
+			goto rejected;
+		}
+		if (raw->nr_tags >= SUNRPC_FUZZ_RAW_MAX_TAGS)
+			goto rejected;
+		tag = kzalloc(sizeof(*tag), GFP_KERNEL);
+		if (!tag)
+			return -ENOMEM;
+		sunrpc_fuzz_origin_init(&origin);
+		if (!sunrpc_fuzz_origin_capture_current(&origin)) {
+			kfree(tag);
+			goto rejected;
+		}
+		sunrpc_fuzz_logical_init_auto_finish(&tag->logical, &origin);
+		if (!tag->logical.active) {
+			kfree(tag);
+			goto rejected;
+		}
+		tag->user_tag = control->user_tag;
+		list_add_tail(&tag->list, &raw->tags);
+		raw->nr_tags++;
+		phase7_stat_inc(P7_RAW_TAG_CREATED);
+	} else {
+		struct kcov_common_handle_id current_owner;
+
+		if (!tag) {
+			phase7_stat_inc(P7_RAW_CROSS_SOCKET_RETRY_REJECTED);
+			goto rejected;
+		}
+		current_owner = kcov_common_handle();
+		if (current_owner.val != tag->logical.owner.val ||
+		    current_owner.generation != tag->logical.owner.generation)
+			goto rejected;
+	}
+	/* Count a semantically valid lifecycle attempt, including fault rollback. */
+	if (is_new) {
+		phase7_stat_inc(control->flags & TCP_SUNRPC_FUZZ_F_FINAL ?
+			P7_RAW_CMSG_NEW_FINAL : P7_RAW_CMSG_NEW);
+	} else {
+		phase7_stat_inc(control->flags & TCP_SUNRPC_FUZZ_F_FINAL ?
+			P7_RAW_CMSG_RETRY_FINAL : P7_RAW_CMSG_RETRY);
+	}
+
+	if (!reserve_tx(raw->conn, SUNRPC_FUZZ_C2S, &raw->reservation))
+		goto rollback_tag;
+	raw->reservation.request_cookie = tag->logical.request_cookie;
+	raw->reservation.xid = xid;
+	raw->reservation.record_len = size;
+	rqst.request_cookie = tag->logical.request_cookie;
+	rqst.owner = tag->logical.owner;
+	rqst.origin_state = SUNRPC_FUZZ_ORIGIN_UNIQUE;
+	rqst.root = &tag->logical.root;
+	if (!sunrpc_fuzz_wire_token_acquire(&raw->reservation, &rqst))
+		goto rollback_reservation;
+	if (sunrpc_fuzz_fault_before_rpc_send(sk,
+			raw->reservation.request_cookie))
+		goto rollback_reservation;
+	raw->active_tag = tag;
+	raw->active_new = is_new;
+	raw->active_final = control->flags & TCP_SUNRPC_FUZZ_F_FINAL;
+	raw->expected_size = size;
+	sk->sk_sunrpc_fuzz_first_byte = raw_first_byte;
+	return 0;
+
+rollback_reservation:
+	rollback_tx(&raw->reservation);
+	phase7_stat_inc(P7_RAW_TX_PRECOMMIT_ROLLBACK);
+rollback_tag:
+	if (is_new) {
+		raw_tag_cancel(tag, false);
+		raw_tag_free(raw, tag);
+	}
+rejected:
+	phase7_stat_inc(P7_RAW_CMSG_REJECTED);
+	return -ESTALE;
+}
+
+static bool raw_sendmsg_result(struct sock *sk, ssize_t result, size_t size)
+{
+	struct sunrpc_fuzz_raw_sock *raw =
+		sk->sk_sunrpc_fuzz_raw_context;
+	struct sunrpc_fuzz_raw_tag *tag;
+	bool full, committed, is_new, final;
+
+	if (!raw)
+		return false;
+	tag = raw->active_tag;
+	if (!tag)
+		return false;
+	sk->sk_sunrpc_fuzz_first_byte = NULL;
+	full = result == size && size == raw->expected_size;
+	committed = raw->reservation.committed;
+	is_new = raw->active_new;
+	final = raw->active_final;
+	if (result > 0 && !committed) {
+		/* The copy hook is authoritative; preserve bytes defensively. */
+		commit_tx(raw->reservation.conn, &raw->reservation);
+		committed = raw->reservation.committed;
+		if (committed && !is_new) {
+			phase7_stat_inc(P7_RAW_RETRY_SAME_COOKIE);
+			phase7_stat_inc(P7_RAW_RETRY_NEW_ORDINAL);
+		}
+		if (final)
+			raw_tag_seal(tag, false);
+	}
+	raw->active_tag = NULL;
+	raw->active_new = false;
+	raw->active_final = false;
+	raw->expected_size = 0;
+
+	if (full && committed) {
+		sunrpc_fuzz_wire_tx_complete(&raw->reservation);
+		if (final)
+			raw_tag_free(raw, tag);
+		phase7_stat_inc(P7_RAW_TX_FULL);
+		return false;
+	}
+	if (result <= 0 || !committed) {
+		finish_tx(&raw->reservation, result > 0 ? result : 0, true);
+		if (is_new) {
+			raw_tag_cancel(tag, false);
+			raw_tag_free(raw, tag);
+		}
+		phase7_stat_inc(P7_RAW_TX_PRECOMMIT_ROLLBACK);
+		return false;
+	}
+
+	/* A short write after the Record Marker byte cannot be rolled back. */
+	finish_tx(&raw->reservation, result, true);
+	phase7_stat_inc(P7_RAW_TX_POSTCOMMIT_PARTIAL);
+	phase7_stat_inc(P7_RAW_CONNECTION_CORRUPTED);
+	phase3_stat_inc(P3_CORRUPTED_CONNECTION_CLOSED);
+	return true;
+}
+
+static void raw_release(struct sock *sk)
+{
+	struct sunrpc_fuzz_raw_sock *raw =
+		sk->sk_sunrpc_fuzz_raw_context;
+	struct sunrpc_fuzz_raw_tag *tag, *tmp;
+	struct sunrpc_fuzz_pending *pending, *pending_tmp, *found = NULL;
+	struct sunrpc_fuzz_conn *conn;
+	unsigned long flags;
+
+	if (!raw)
+		return;
+	sk->sk_sunrpc_fuzz_first_byte = NULL;
+	if (raw->reservation.pending)
+		finish_tx(&raw->reservation, 0, true);
+	if (raw->rx_marker_bytes || raw->rx_fragment_remaining)
+		phase7_stat_inc(P7_RAW_RX_PARSE_ERROR);
+	list_for_each_entry_safe(tag, tmp, &raw->tags, list) {
+		if (tag->logical.active)
+			raw_tag_seal(tag, true);
+		else if (READ_ONCE(tag->logical.root.auto_finished))
+			phase7_stat_inc(P7_RAW_TAG_AUTO_SEALED);
+		raw_tag_free(raw, tag);
+	}
+	sk->sk_sunrpc_fuzz_limit_first_copy = false;
+	sk->sk_sunrpc_fuzz_stop_after_first_copy = false;
+	sk->sk_sunrpc_fuzz_postcommit_failed = false;
+	sk->sk_sunrpc_fuzz_arm_drop_on_first_byte = false;
+	sk->sk_sunrpc_fuzz_drop_next_data = false;
+	conn = raw->conn;
+	if (conn) {
+		spin_lock_irqsave(&conn_lock, flags);
+		list_for_each_entry_safe(pending, pending_tmp, &pending_list,
+				list) {
+			if (pending->conn == conn) {
+				list_del(&pending->list);
+				found = pending;
+				break;
+			}
+		}
+		conn->client_attached = false;
+		spin_unlock_irqrestore(&conn_lock, flags);
+		if (found) {
+			conn_put(found->conn);
+			kfree(found);
+		}
+		conn_put(conn);
+	}
+	if (sk->sk_sunrpc_fuzz_retransmit_context == raw) {
+		sk->sk_sunrpc_fuzz_retransmit_context = NULL;
+		sk->sk_sunrpc_fuzz_retransmit = NULL;
+	}
+	kfree(raw);
+	phase7_stat_inc(P7_RAW_SOCKET_RELEASED);
+}
+
+static int raw_enable(struct sock *sk)
+{
+	struct sunrpc_fuzz_raw_sock *raw;
+	bool has_psock;
+
+	rcu_read_lock();
+	has_psock = !!sk_psock(sk);
+	rcu_read_unlock();
+
+	if (sk->sk_family != AF_INET || sk->sk_protocol != IPPROTO_TCP ||
+	    sk->sk_kern_sock || !sk->sk_socket ||
+	    sk->sk_socket->type != SOCK_STREAM || sk->sk_state != TCP_CLOSE ||
+	    inet_csk(sk)->icsk_ulp_ops || tcp_sk(sk)->fastopen_connect ||
+	    tcp_sk(sk)->repair || has_psock ||
+	    inet_sk(sk)->inet_dport || sk->sk_sunrpc_fuzz_preconnect ||
+	    !READ_ONCE(fuzz_pernet(sock_net(sk))->valid)) {
+		phase7_stat_inc(P7_RAW_SOCKET_ENABLE_REJECTED);
+		return -EINVAL;
+	}
+	raw = kzalloc(sizeof(*raw), GFP_KERNEL);
+	if (!raw)
+		return -ENOMEM;
+	INIT_LIST_HEAD(&raw->tags);
+	sk->sk_sunrpc_fuzz_raw_context = raw;
+	sk->sk_sunrpc_fuzz_raw_sendmsg = raw_sendmsg;
+	sk->sk_sunrpc_fuzz_raw_result = raw_sendmsg_result;
+	sk->sk_sunrpc_fuzz_raw_recv = raw_recv;
+	sk->sk_sunrpc_fuzz_raw_connect_result = raw_connect_result;
+	sk->sk_sunrpc_fuzz_raw_release = raw_release;
+	sk->sk_sunrpc_fuzz_preconnect = raw_pre_connect;
+	phase7_stat_inc(P7_RAW_SOCKET_ENABLE_OK);
+	return 0;
+}
+
+static const struct tcp_sunrpc_fuzz_ops raw_tcp_ops = {
+	.owner = THIS_MODULE,
+	.enable = raw_enable,
+};

From 847b55a128dbd11c84fb020ebdcc36b5a8c2acc9 Mon Sep 17 00:00:00 2001
From: knfsd-fuzz <knfsd-fuzz@localhost>
Date: Thu, 1 Oct 2026 17:33:38 +0900
Subject: [PATCH] sunrpc: attribute lane NFS server work to the lane's executor

Request-level attribution correlates each server record with the client
request through TCP connection pairing (4-tuple match at accept) and
per-connection record ordinals.  Anything that terminates TCP between the
client and the server breaks that pairing: through the NFS wire relay every
connection stays PENDING_CONNECT, no record is consumed, the server work is
ownerless and the per-program extra coverage is empty.  Client requests that
are not issued under the syscall's root (asynchronous DELEGRETURN or
FREE_STATEID after close) are ownerless as well.

A lane is used by exactly one executor proc, and proc N (KCOV common handle
N + 1) is bound to lane N.  Every request that reaches a lane's server
therefore belongs to the program that proc is currently running.  Derive the
owner from the server netns instead of the connection: when a C2S record is
received in a netns that joined lane N, attribute it to the request
generation currently open for handle N + 1.  The synthesized wire token goes
through the existing admission, ticket, merge, publish and drain paths, so
generation lifetime still fences work that outlives a program.  A record that
arrives while no generation is open stays ownerless.

Clients in a lane netns no longer register per-record wire tokens: nothing
consumes them under lane attribution, and an unconsumed token keeps its
generation from draining.

Lane attribution is on by default.  The sunrpc.lane_attribution module
parameter (kernel command line, or /sys/module/sunrpc/parameters/) switches
back to request-level attribution for comparison runs.  New
phase3 counters: lane_owner_attributed, lane_owner_no_generation,
lane_owner_failed, lane_owner_replaced_wire_work.
---
 include/linux/kcov.h        |  1 +
 include/linux/sunrpc/fuzz.h |  1 +
 kernel/kcov.c               | 37 ++++++++++++++
 net/sunrpc/fuzz_conn.c      | 96 +++++++++++++++++++++++++++++++++++++
 net/sunrpc/xprtsock.c       |  3 +-
 5 files changed, 137 insertions(+), 1 deletion(-)

diff --git a/include/linux/kcov.h b/include/linux/kcov.h
index bfbfddbf5..449ed7f5d 100644
--- a/include/linux/kcov.h
+++ b/include/linux/kcov.h
@@ -281,6 +281,7 @@ void kcov_remote_start(u64 handle);
 bool kcov_remote_start_nfsd_observe(void);
 void kcov_remote_stop(void);
 struct kcov_common_handle_id kcov_common_handle(void);
+u64 kcov_request_current_generation(u64 handle);
 
 struct kcov_request_generation *
 kcov_request_generation_begin(u64 owner, u64 *generation);
diff --git a/include/linux/sunrpc/fuzz.h b/include/linux/sunrpc/fuzz.h
index e2fd7f395..b5cd828ed 100644
--- a/include/linux/sunrpc/fuzz.h
+++ b/include/linux/sunrpc/fuzz.h
@@ -133,6 +133,7 @@ void sunrpc_fuzz_svc_tx_result(struct svc_xprt *xprt,
 		unsigned int sent, bool terminal_failure);
 void sunrpc_fuzz_wire_tx_complete(
 		struct sunrpc_fuzz_wire_reservation *reservation);
+bool sunrpc_fuzz_lane_owned(struct net *net);
 bool sunrpc_fuzz_wire_token_acquire(
 		struct sunrpc_fuzz_wire_reservation *reservation,
 		struct sunrpc_fuzz_rqst *rqst);
diff --git a/kernel/kcov.c b/kernel/kcov.c
index 788cf9e32..000d88b01 100644
--- a/kernel/kcov.c
+++ b/kernel/kcov.c
@@ -2625,6 +2625,43 @@ bool kcov_request_phase6_selftest(void)
 EXPORT_SYMBOL_GPL(kcov_request_phase6_selftest);
 
 /* See the comment before kcov_remote_start() for usage details. */
+/**
+ * kcov_request_current_generation - id of the request generation open for a
+ * KCOV common handle
+ * @handle: common handle registered with KCOV_REMOTE_ENABLE
+ *
+ * Returns 0 when no KCOV instance is registered for @handle or when it has no
+ * request generation bound.  The value is only a hint for building an owner
+ * identity: admission still re-validates owner and generation under the
+ * generation lock, so a generation that closes concurrently is rejected there.
+ */
+u64 kcov_request_current_generation(u64 handle)
+{
+	struct kcov_remote *remote;
+	struct kcov *kcov;
+	unsigned long flags;
+	u64 id = 0;
+
+	spin_lock_irqsave(&kcov_remote_lock, flags);
+	remote = kcov_remote_find(handle);
+	if (!remote) {
+		spin_unlock_irqrestore(&kcov_remote_lock, flags);
+		return 0;
+	}
+	kcov = remote->kcov;
+	kcov_get(kcov);
+	spin_unlock_irqrestore(&kcov_remote_lock, flags);
+
+	spin_lock_irqsave(&kcov->lock, flags);
+	if (kcov->remote && kcov->request_common_handle == handle &&
+	    kcov->request_generation)
+		id = kcov_request_generation_id(kcov->request_generation);
+	spin_unlock_irqrestore(&kcov->lock, flags);
+	kcov_put(kcov);
+	return id;
+}
+EXPORT_SYMBOL_GPL(kcov_request_current_generation);
+
 struct kcov_common_handle_id kcov_common_handle(void)
 {
 	if (!in_task())
diff --git a/net/sunrpc/fuzz_conn.c b/net/sunrpc/fuzz_conn.c
index cffc32d84..c1a696a7c 100644
--- a/net/sunrpc/fuzz_conn.c
+++ b/net/sunrpc/fuzz_conn.c
@@ -81,6 +81,10 @@ enum sunrpc_fuzz_phase3_stat {
 	P3_SELFTEST_RETRANSMIT_STABLE,
 	P3_SELFTEST_SUNRPC_RETRY_NEW_ORDINAL_SAME_COOKIE,
 	P3_SELFTEST_RECORD_MARKER_COMMIT,
+	P3_LANE_OWNER_ATTRIBUTED,
+	P3_LANE_OWNER_NO_GENERATION,
+	P3_LANE_OWNER_FAILED,
+	P3_LANE_OWNER_REPLACED_WIRE_WORK,
 	P3_STAT_COUNT,
 };
 
@@ -102,6 +106,10 @@ static const char *const phase3_stat_names[P3_STAT_COUNT] = {
 	[P3_ORDINAL_RX_S2C] = "ordinal_rx_s2c",
 	[P3_ORDINAL_MISMATCH] = "ordinal_mismatch",
 	[P3_RECORD_OWNERLESS] = "record_ownerless",
+	[P3_LANE_OWNER_ATTRIBUTED] = "lane_owner_attributed",
+	[P3_LANE_OWNER_NO_GENERATION] = "lane_owner_no_generation",
+	[P3_LANE_OWNER_FAILED] = "lane_owner_failed",
+	[P3_LANE_OWNER_REPLACED_WIRE_WORK] = "lane_owner_replaced_wire_work",
 	[P3_RECORD_BACKGROUND] = "record_background",
 	[P3_RECORD_BACKCHANNEL] = "record_backchannel",
 	[P3_TCP_SEGMENT_RETRANSMIT] = "tcp_segment_retransmit",
@@ -1815,6 +1823,82 @@ u64 sunrpc_fuzz_rpc_record_received(struct rpc_xprt *xprt,
 	return ordinal;
 }
 
+/*
+ * Lane-scoped attribution.  A lane is used by exactly one executor proc, and
+ * proc N (KCOV common handle N + 1) is bound to lane N, so every request that
+ * reaches a lane's server belongs to whatever program that proc is running.
+ * Ownership is therefore derived from the server netns rather than from the
+ * client connection, which keeps attribution intact through relays that
+ * terminate TCP and through mutations that change records.
+ */
+static bool lane_attribution_enabled = true;
+module_param_named(lane_attribution, lane_attribution_enabled, bool, 0644);
+MODULE_PARM_DESC(lane_attribution,
+	"Attribute lane NFS server work to the lane's executor (default: on)");
+static atomic64_t lane_owner_cookie_seq;
+
+static u64 lane_owner_handle(struct net *net)
+{
+	struct sunrpc_fuzz_net *fnet;
+
+	if (!net || !READ_ONCE(lane_attribution_enabled))
+		return 0;
+	fnet = fuzz_pernet(net);
+	if (!READ_ONCE(fnet->valid))
+		return 0;
+	return (u64)READ_ONCE(fnet->lane_id) + 1;
+}
+
+bool sunrpc_fuzz_lane_owned(struct net *net)
+{
+	return lane_owner_handle(net) != 0;
+}
+
+/* Build a wire work item owned by the lane's open executor generation. */
+static struct sunrpc_fuzz_wire_work *lane_owner_work(u64 handle)
+{
+	struct kcov_common_handle_id owner = { .val = handle };
+	struct sunrpc_fuzz_wire_work *work;
+	struct kcov_request_root root;
+	u64 cookie;
+
+	owner.generation = kcov_request_current_generation(handle);
+	if (!owner.generation) {
+		/* Between programs, or no executor: the record stays ownerless. */
+		phase3_stat_inc(P3_LANE_OWNER_NO_GENERATION);
+		return NULL;
+	}
+	work = kzalloc(sizeof(*work), GFP_KERNEL);
+	if (!work)
+		goto fail;
+	INIT_LIST_HEAD(&work->conn_node);
+	cookie = atomic64_inc_return(&lane_owner_cookie_seq) | BIT_ULL(62);
+	if (!kcov_request_root_init(&root, owner, cookie)) {
+		kfree(work);
+		goto fail;
+	}
+	if (!kcov_request_try_get_child_token(&root, KCOV_REQUEST_TOKEN_WIRE,
+			&work->token) ||
+	    !kcov_request_wire_token_set_identity(&work->token, owner,
+			cookie)) {
+		if (work->token.generation)
+			kcov_request_token_complete_once(&work->token);
+		kcov_request_root_finish(&root);
+		kfree(work);
+		goto fail;
+	}
+	/* The root only mints this one token; close it immediately. */
+	kcov_request_root_finish(&root);
+	work->owner = owner;
+	work->request_cookie = cookie;
+	work->direction = SUNRPC_FUZZ_C2S;
+	phase3_stat_inc(P3_LANE_OWNER_ATTRIBUTED);
+	return work;
+fail:
+	phase3_stat_inc(P3_LANE_OWNER_FAILED);
+	return NULL;
+}
+
 u64 sunrpc_fuzz_svc_record_received(struct svc_xprt *xprt,
 		enum sunrpc_fuzz_wire_direction direction, struct svc_rqst *rqstp)
 {
@@ -1829,6 +1913,18 @@ u64 sunrpc_fuzz_svc_record_received(struct svc_xprt *xprt,
 	conn = svc_conn_get(xprt);
 	ordinal = record_received(conn, direction);
 	work = consume_wire_work(conn, direction, ordinal);
+	if (rqstp) {
+		u64 lane_handle = lane_owner_handle(xprt->xpt_net);
+
+		if (lane_handle) {
+			/* A client-registered mapping is superseded, not used. */
+			if (work) {
+				sunrpc_fuzz_wire_work_finish(work, true);
+				phase3_stat_inc(P3_LANE_OWNER_REPLACED_WIRE_WORK);
+			}
+			work = lane_owner_work(lane_handle);
+		}
+	}
 	if (rqstp && (rqstp->rq_fuzz_wire_work ||
 		      rqstp->rq_fuzz_saved_work ||
 		      rqstp->rq_fuzz_remote_ticket)) {
diff --git a/net/sunrpc/xprtsock.c b/net/sunrpc/xprtsock.c
index c0055940a..0daac0b5c 100644
--- a/net/sunrpc/xprtsock.c
+++ b/net/sunrpc/xprtsock.c
@@ -1168,7 +1168,8 @@ static int xs_tcp_send_request(struct rpc_rqst *req)
 		fuzz_reservation->xid = be32_to_cpu(req->rq_xid);
 		fuzz_reservation->record_len = msglen;
 		if (req->rq_fuzz.root &&
-		    !fuzz_reservation->request_work_decided)
+		    !fuzz_reservation->request_work_decided &&
+		    !sunrpc_fuzz_lane_owned(xprt->xprt_net))
 			sunrpc_fuzz_wire_token_acquire(fuzz_reservation,
 					&req->rq_fuzz);
 	}
-- 

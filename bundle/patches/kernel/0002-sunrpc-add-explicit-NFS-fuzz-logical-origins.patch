 struct nfs_renamedata {
@@ -1769,6 +1776,8 @@ struct nfs_renamedata {
 	void (*complete)(struct rpc_task *, struct nfs_renamedata *);
 	long timeout;
 	bool cancelled;
+	/* Captured before the asynchronous rename task is queued. */
+	struct sunrpc_fuzz_origin fuzz_origin;
 };
 
 struct nfs_access_entry;
diff --git a/include/linux/sunrpc/fuzz.h b/include/linux/sunrpc/fuzz.h
new file mode 100644
index 000000000..815e62e0f
--- /dev/null
+++ b/include/linux/sunrpc/fuzz.h
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_SUNRPC_FUZZ_H
+#define _LINUX_SUNRPC_FUZZ_H
+
+#include <linux/kcov.h>
+#include <linux/types.h>
+
+/*
+ * Origin is an accumulator, not an owner slot.  EMPTY means that no input
+ * has contributed yet; UNATTRIBUTED means that real, ownerless work did.
+ */
+enum sunrpc_fuzz_origin_state {
+	SUNRPC_FUZZ_ORIGIN_EMPTY = 0,
+	SUNRPC_FUZZ_ORIGIN_UNIQUE,
+	SUNRPC_FUZZ_ORIGIN_UNATTRIBUTED,
+	SUNRPC_FUZZ_ORIGIN_MIXED,
+};
+
+struct sunrpc_fuzz_origin {
+	enum sunrpc_fuzz_origin_state state;
+	struct kcov_common_handle_id owner;
+};
+
+/* rpc_task lifetime: one logical RPC, including transport retries. */
+struct sunrpc_fuzz_logical_rpc {
+	u64 request_cookie;
+	struct kcov_common_handle_id owner;
+	enum sunrpc_fuzz_origin_state origin_state;
+	bool active;
+};
+
+/* rpc_rqst lifetime: reusable transport-slot metadata, never an identity. */
+struct sunrpc_fuzz_rqst {
+	u64 request_cookie;
+	struct kcov_common_handle_id owner;
+	enum sunrpc_fuzz_origin_state origin_state;
+};
+
+enum sunrpc_fuzz_rqst_reset_reason {
+	SUNRPC_FUZZ_RQST_RESET_RELEASE = 0,
+	SUNRPC_FUZZ_RQST_RESET_HANDOFF,
+	SUNRPC_FUZZ_RQST_RESET_BACKCHANNEL,
+};
+
+void sunrpc_fuzz_origin_init(struct sunrpc_fuzz_origin *origin);
+bool sunrpc_fuzz_origin_capture_current(struct sunrpc_fuzz_origin *origin);
+void sunrpc_fuzz_origin_set_unattributed(struct sunrpc_fuzz_origin *origin);
+void sunrpc_fuzz_origin_merge(struct sunrpc_fuzz_origin *dst,
+		const struct sunrpc_fuzz_origin *src);
+bool sunrpc_fuzz_origin_is_attributable(
+		const struct sunrpc_fuzz_origin *origin);
+
+void sunrpc_fuzz_logical_init(struct sunrpc_fuzz_logical_rpc *logical,
+		const struct sunrpc_fuzz_origin *origin);
+void sunrpc_fuzz_logical_complete(struct sunrpc_fuzz_logical_rpc *logical);
+void sunrpc_fuzz_logical_cancel(struct sunrpc_fuzz_logical_rpc *logical);
+
+void sunrpc_fuzz_rqst_bind(struct sunrpc_fuzz_rqst *rqst,
+		const struct sunrpc_fuzz_logical_rpc *logical);
+void sunrpc_fuzz_rqst_reset(struct sunrpc_fuzz_rqst *rqst,
+		enum sunrpc_fuzz_rqst_reset_reason reason);
+
+void sunrpc_fuzz_debugfs_init(void);
+void sunrpc_fuzz_debugfs_exit(void);
+
+#endif /* _LINUX_SUNRPC_FUZZ_H */

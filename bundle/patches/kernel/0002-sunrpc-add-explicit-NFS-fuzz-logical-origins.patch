diff --git a/fs/nfs/write.c b/fs/nfs/write.c
index 623e7ef1f..990e35921 100644
--- a/fs/nfs/write.c
+++ b/fs/nfs/write.c
@@ -1653,6 +1653,7 @@ int nfs_initiate_commit(struct rpc_clnt *clnt, struct nfs_commit_data *data,
 		.workqueue = nfsiod_workqueue,
 		.flags = RPC_TASK_ASYNC | flags,
 		.priority = priority,
+		.fuzz_origin = &data->fuzz_origin,
 	};
 
 	if (nfs_server_capable(data->inode, NFS_CAP_MOVEABLE))
@@ -1698,6 +1699,7 @@ void nfs_init_commit(struct nfs_commit_data *data,
 		     struct nfs_commit_info *cinfo)
 {
 	struct nfs_page *first;
+	struct nfs_page *req;
 	struct nfs_open_context *ctx;
 	struct inode *inode;
 
@@ -1707,6 +1709,12 @@ void nfs_init_commit(struct nfs_commit_data *data,
 	if (head)
 		list_splice_init(head, &data->pages);
 
+	/* A COMMIT may coalesce writes from different fuzz generations. */
+	sunrpc_fuzz_origin_init(&data->fuzz_origin);
+	list_for_each_entry(req, &data->pages, wb_list)
+		sunrpc_fuzz_origin_merge(&data->fuzz_origin,
+					 &req->wb_fuzz_origin);
+
 	first = nfs_list_entry(data->pages.next);
 	ctx = nfs_req_openctx(first);
 	inode = d_inode(ctx->dentry);
diff --git a/include/linux/nfs_page.h b/include/linux/nfs_page.h
index 4b9a35dbc..b7d90ce7f 100644
--- a/include/linux/nfs_page.h
+++ b/include/linux/nfs_page.h
@@ -15,6 +15,7 @@
 #include <linux/pagemap.h>
 #include <linux/wait.h>
 #include <linux/sunrpc/auth.h>
+#include <linux/sunrpc/fuzz.h>
 #include <linux/nfs_xdr.h>
 

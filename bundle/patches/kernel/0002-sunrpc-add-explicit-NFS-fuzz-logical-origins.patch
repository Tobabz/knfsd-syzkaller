From 58856b7933fc43493389139070e9e20e2aac6cf8 Mon Sep 17 00:00:00 2001
From: fuzzer <fuzzer@cesrv.local>
Date: Wed, 16 Sep 2026 18:53:49 +0900
Subject: [PATCH 02/11] sunrpc: add explicit NFS fuzz logical origins


diff --git a/fs/nfs/nfs4_fs.h b/fs/nfs/nfs4_fs.h
index b48e5b87c..6ad46a0f3 100644
--- a/fs/nfs/nfs4_fs.h
+++ b/fs/nfs/nfs4_fs.h
@@ -28,6 +28,7 @@
 
 #include <linux/seqlock.h>
 #include <linux/filelock.h>
+#include <linux/sunrpc/fuzz.h>
 
 struct idmap;
 
@@ -254,6 +255,8 @@ struct nfs4_opendata {
 	bool is_recover;
 	bool cancelled;
 	int rpc_status;
+	/* Per-open operation carrier; never stored in shared NFS state. */
+	struct sunrpc_fuzz_origin fuzz_origin;
 };
 
 struct nfs4_add_xprt_data {
@@ -332,7 +335,8 @@ extern int nfs4_proc_exchange_id(struct nfs_client *clp, const struct cred *cred
 extern int nfs4_destroy_clientid(struct nfs_client *clp);
 extern int nfs4_init_clientid(struct nfs_client *, const struct cred *);
 extern int nfs41_init_clientid(struct nfs_client *, const struct cred *);
-extern int nfs4_do_close(struct nfs4_state *state, gfp_t gfp_mask, int wait);
+extern int nfs4_do_close(struct nfs4_state *state, gfp_t gfp_mask, int wait,
+		const struct sunrpc_fuzz_origin *origin);
 extern int nfs4_server_capabilities(struct nfs_server *server, struct nfs_fh *fhandle);
 extern int nfs4_proc_fs_locations(struct rpc_clnt *, struct inode *, const struct qstr *,
 				  struct nfs4_fs_locations *, struct page *);
@@ -503,6 +507,8 @@ extern void nfs4_free_state_owners(struct list_head *head);
 extern struct nfs4_state * nfs4_get_open_state(struct inode *, struct nfs4_state_owner *);
 extern void nfs4_put_open_state(struct nfs4_state *);
 extern void nfs4_close_state(struct nfs4_state *, fmode_t);
+extern void nfs4_close_state_with_origin(struct nfs4_state *, fmode_t,
+		const struct sunrpc_fuzz_origin *);
 extern void nfs4_close_sync(struct nfs4_state *, fmode_t);
 extern void nfs4_state_set_mode_locked(struct nfs4_state *, fmode_t);
 extern void nfs_inode_find_state_and_recover(struct inode *inode,
diff --git a/fs/nfs/nfs4proc.c b/fs/nfs/nfs4proc.c
index 04b198711..e838e2e54 100644
--- a/fs/nfs/nfs4proc.c
+++ b/fs/nfs/nfs4proc.c
@@ -1133,8 +1133,20 @@ static int nfs4_call_sync_custom(struct rpc_task_setup *task_setup)
 {
 	int ret;
 	struct rpc_task *task;
+	struct sunrpc_fuzz_origin origin;
+	struct rpc_task_setup local_setup = *task_setup;
 
-	task = rpc_run_task(task_setup);
+	/*
+	 * Capture in the NFS operation context, never later in rpc_task_setup()
+	 * where current may already be rpciod.  Callers with a longer-lived
+	 * per-operation carrier override this field before reaching here.
+	 */
+	if (!local_setup.fuzz_origin) {
+		sunrpc_fuzz_origin_capture_current(&origin);
+		local_setup.fuzz_origin = &origin;
+	}
+
+	task = rpc_run_task(&local_setup);
 	if (IS_ERR(task))
 		return PTR_ERR(task);
 
@@ -1387,6 +1399,7 @@ static struct nfs4_opendata *nfs4_opendata_alloc(struct dentry *dentry,
 	p = kzalloc_obj(*p, gfp_mask);
 	if (p == NULL)
 		goto err;
+	sunrpc_fuzz_origin_capture_current(&p->fuzz_origin);
 
 	p->f_attr.label = nfs4_label_alloc(server, gfp_mask);
 	if (IS_ERR(p->f_attr.label))
@@ -2201,7 +2214,8 @@ static int nfs4_open_recover_helper(struct nfs4_opendata *opendata,
 		return PTR_ERR(newstate);
 	if (newstate != opendata->state)
 		ret = -ESTALE;
-	nfs4_close_state(newstate, fmode);
+	nfs4_close_state_with_origin(newstate, fmode,
+				     &opendata->fuzz_origin);
 	return ret;
 }
 
@@ -2428,7 +2442,8 @@ static void nfs4_open_confirm_release(void *calldata)
 		goto out_free;
 	state = nfs4_opendata_to_nfs4_state(data);
 	if (!IS_ERR(state))
-		nfs4_close_state(state, data->o_arg.fmode);
+		nfs4_close_state_with_origin(state, data->o_arg.fmode,
+					     &data->fuzz_origin);
 out_free:
 	nfs4_opendata_put(data);
 }
@@ -2459,6 +2474,7 @@ static int _nfs4_proc_open_confirm(struct nfs4_opendata *data)
 		.callback_data = data,
 		.workqueue = nfsiod_workqueue,
 		.flags = RPC_TASK_ASYNC | RPC_TASK_CRED_NOREF,
+		.fuzz_origin = &data->fuzz_origin,
 	};
 	int status;
 
@@ -2594,7 +2610,8 @@ static void nfs4_open_release(void *calldata)
 		goto out_free;
 	state = nfs4_opendata_to_nfs4_state(data);
 	if (!IS_ERR(state))
-		nfs4_close_state(state, data->o_arg.fmode);
+		nfs4_close_state_with_origin(state, data->o_arg.fmode,
+					     &data->fuzz_origin);
 out_free:
 	nfs4_opendata_put(data);
 }
@@ -2627,6 +2644,7 @@ static int nfs4_run_open_task(struct nfs4_opendata *data,
 		.callback_data = data,
 		.workqueue = nfsiod_workqueue,
 		.flags = RPC_TASK_ASYNC | RPC_TASK_CRED_NOREF,
+		.fuzz_origin = &data->fuzz_origin,
 	};
 	int status;
 
@@ -3561,6 +3579,7 @@ struct nfs4_closedata {
 	struct nfs_fattr fattr;
 	unsigned long timestamp;
 	unsigned short retrans;
+	struct sunrpc_fuzz_origin fuzz_origin;
 };
 
 static void nfs4_free_closedata(void *data)
@@ -3761,7 +3780,8 @@ static const struct rpc_call_ops nfs4_close_ops = {
  *
  * NOTE: Caller must be holding the sp->so_owner semaphore!
  */
-int nfs4_do_close(struct nfs4_state *state, gfp_t gfp_mask, int wait)
+int nfs4_do_close(struct nfs4_state *state, gfp_t gfp_mask, int wait,
+		  const struct sunrpc_fuzz_origin *origin)
 {
 	struct nfs_server *server = NFS_SERVER(state->inode);
 	struct nfs_client *clp = server->nfs_client;
@@ -3791,6 +3811,11 @@ int nfs4_do_close(struct nfs4_state *state, gfp_t gfp_mask, int wait)
 	calldata = kzalloc_obj(*calldata, gfp_mask);
 	if (calldata == NULL)
 		goto out;
+	if (origin)
+		calldata->fuzz_origin = *origin;
+	else
+		sunrpc_fuzz_origin_capture_current(&calldata->fuzz_origin);
+	task_setup_data.fuzz_origin = &calldata->fuzz_origin;
 	nfs4_init_sequence(clp, &calldata->arg.seq_args,
 			   &calldata->res.seq_res, 1, 0);
 	calldata->inode = state->inode;
@@ -7079,12 +7104,14 @@ struct nfs4_unlockdata {
 	struct nfs_server *server;
 	unsigned long timestamp;
 	unsigned short retrans;
+	struct sunrpc_fuzz_origin fuzz_origin;
 };
 
 static struct nfs4_unlockdata *nfs4_alloc_unlockdata(struct file_lock *fl,
 		struct nfs_open_context *ctx,
 		struct nfs4_lock_state *lsp,
-		struct nfs_seqid *seqid)
+		struct nfs_seqid *seqid,
+		const struct sunrpc_fuzz_origin *origin)
 {
 	struct nfs4_unlockdata *p;
 	struct nfs4_state *state = lsp->ls_state;
@@ -7094,6 +7121,10 @@ static struct nfs4_unlockdata *nfs4_alloc_unlockdata(struct file_lock *fl,
 	p = kzalloc_obj(*p);
 	if (p == NULL)
 		return NULL;
+	if (origin)
+		p->fuzz_origin = *origin;
+	else
+		sunrpc_fuzz_origin_capture_current(&p->fuzz_origin);
 	l_ctx = nfs_get_lock_context(ctx);
 	if (!IS_ERR(l_ctx)) {
 		p->l_ctx = l_ctx;
@@ -7209,7 +7240,8 @@ static const struct rpc_call_ops nfs4_locku_ops = {
 static struct rpc_task *nfs4_do_unlck(struct file_lock *fl,
 		struct nfs_open_context *ctx,
 		struct nfs4_lock_state *lsp,
-		struct nfs_seqid *seqid)
+		struct nfs_seqid *seqid,
+		const struct sunrpc_fuzz_origin *origin)
 {
 	struct nfs4_unlockdata *data;
 	struct nfs_client *clp = NFS_SERVER(lsp->ls_state->inode)->nfs_client;
@@ -7238,7 +7270,7 @@ static struct rpc_task *nfs4_do_unlck(struct file_lock *fl,
 	if (fl->c.flc_flags & FL_CLOSE)
 		set_bit(NFS_CONTEXT_UNLOCK, &ctx->flags);
 
-	data = nfs4_alloc_unlockdata(fl, ctx, lsp, seqid);
+	data = nfs4_alloc_unlockdata(fl, ctx, lsp, seqid, origin);
 	if (data == NULL) {
 		nfs_free_seqid(seqid);
 		return ERR_PTR(-ENOMEM);
@@ -7248,6 +7280,7 @@ static struct rpc_task *nfs4_do_unlck(struct file_lock *fl,
 	msg.rpc_argp = &data->arg;
 	msg.rpc_resp = &data->res;
 	task_setup_data.callback_data = data;
+	task_setup_data.fuzz_origin = &data->fuzz_origin;
 	return rpc_run_task(&task_setup_data);
 }
 
@@ -7262,6 +7295,9 @@ static int nfs4_proc_unlck(struct nfs4_state *state, int cmd, struct file_lock *
 	struct nfs_seqid *(*alloc_seqid)(struct nfs_seqid_counter *, gfp_t);
 	int status = 0;
 	unsigned char saved_flags = request->c.flc_flags;
+	struct sunrpc_fuzz_origin origin;
+
+	sunrpc_fuzz_origin_capture_current(&origin);
 
 	status = nfs4_set_lock_state(state, request);
 	/* Unlock _before_ we do the RPC call */
@@ -7291,7 +7327,7 @@ static int nfs4_proc_unlck(struct nfs4_state *state, int cmd, struct file_lock *
 		goto out;
 	task = nfs4_do_unlck(request,
 			     nfs_file_open_context(request->c.flc_file),
-			     lsp, seqid);
+			     lsp, seqid, &origin);
 	status = PTR_ERR(task);
 	if (IS_ERR(task))
 		goto out;
@@ -7313,6 +7349,7 @@ struct nfs4_lockdata {
 	int rpc_status;
 	int cancelled;
 	struct nfs_server *server;
+	struct sunrpc_fuzz_origin fuzz_origin;
 };
 
 static struct nfs4_lockdata *nfs4_alloc_lockdata(struct file_lock *fl,
@@ -7327,6 +7364,7 @@ static struct nfs4_lockdata *nfs4_alloc_lockdata(struct file_lock *fl,
 	p = kzalloc_obj(*p, gfp_mask);
 	if (p == NULL)
 		return NULL;
+	sunrpc_fuzz_origin_capture_current(&p->fuzz_origin);
 
 	p->arg.fh = NFS_FH(inode);
 	p->arg.fl = &p->fl;
@@ -7451,7 +7489,7 @@ static void nfs4_lock_release(void *calldata)
 	if (data->cancelled && data->rpc_status == 0) {
 		struct rpc_task *task;
 		task = nfs4_do_unlck(&data->fl, data->ctx, data->lsp,
-				data->arg.lock_seqid);
+				data->arg.lock_seqid, &data->fuzz_origin);
 		if (!IS_ERR(task))
 			rpc_put_task_async(task);
 		dprintk("%s: cancelling lock!\n", __func__);
@@ -7518,6 +7556,7 @@ static int _nfs4_do_setlk(struct nfs4_state *state, int cmd, struct file_lock *f
 	msg.rpc_argp = &data->arg;
 	msg.rpc_resp = &data->res;
 	task_setup_data.callback_data = data;
+	task_setup_data.fuzz_origin = &data->fuzz_origin;
 
 	if (recovery_type == NFS_LOCK_RECLAIM)
 		data->arg.reclaim = NFS_LOCK_RECLAIM;
diff --git a/fs/nfs/nfs4state.c b/fs/nfs/nfs4state.c
index a5dec0473..93e37969a 100644
--- a/fs/nfs/nfs4state.c
+++ b/fs/nfs/nfs4state.c
@@ -746,7 +746,8 @@ void nfs4_put_open_state(struct nfs4_state *state)
  * Close the current file.
  */
 static void __nfs4_close(struct nfs4_state *state,
-		fmode_t fmode, gfp_t gfp_mask, int wait)
+		fmode_t fmode, gfp_t gfp_mask, int wait,
+		const struct sunrpc_fuzz_origin *origin)
 {
 	struct nfs4_state_owner *owner = state->owner;
 	int call_close = 0;
@@ -787,17 +788,29 @@ static void __nfs4_close(struct nfs4_state *state,
 		nfs4_put_open_state(state);
 		nfs4_put_state_owner(owner);
 	} else
-		nfs4_do_close(state, gfp_mask, wait);
+		nfs4_do_close(state, gfp_mask, wait, origin);
 }
 
 void nfs4_close_state(struct nfs4_state *state, fmode_t fmode)
 {
-	__nfs4_close(state, fmode, GFP_KERNEL, 0);
+	struct sunrpc_fuzz_origin origin;
+
+	sunrpc_fuzz_origin_capture_current(&origin);
+	__nfs4_close(state, fmode, GFP_KERNEL, 0, &origin);
+}
+
+void nfs4_close_state_with_origin(struct nfs4_state *state, fmode_t fmode,
+		const struct sunrpc_fuzz_origin *origin)
+{
+	__nfs4_close(state, fmode, GFP_KERNEL, 0, origin);
 }
 
 void nfs4_close_sync(struct nfs4_state *state, fmode_t fmode)
 {
-	__nfs4_close(state, fmode, GFP_KERNEL, 1);
+	struct sunrpc_fuzz_origin origin;
+
+	sunrpc_fuzz_origin_capture_current(&origin);
+	__nfs4_close(state, fmode, GFP_KERNEL, 1, &origin);
 }
 
 /*
diff --git a/fs/nfs/pagelist.c b/fs/nfs/pagelist.c
index 7dd478ffc..4a55edcb5 100644
--- a/fs/nfs/pagelist.c
+++ b/fs/nfs/pagelist.c
@@ -98,7 +98,7 @@ void nfs_pgheader_init(struct nfs_pageio_descriptor *desc,
 {
 	struct nfs_pgio_mirror *mirror = nfs_pgio_current_mirror(desc);
 
-
+	sunrpc_fuzz_origin_init(&hdr->fuzz_origin);
 	hdr->req = nfs_list_entry(mirror->pg_list.next);
 	hdr->inode = desc->pg_inode;
 	hdr->cred = nfs_req_openctx(hdr->req)->cred;
@@ -376,7 +376,8 @@ nfs_page_group_destroy(struct kref *kref)
 
 static struct nfs_page *nfs_page_create(struct nfs_lock_context *l_ctx,
 					unsigned int pgbase, pgoff_t index,
-					unsigned int offset, unsigned int count)
+					unsigned int offset, unsigned int count,
+					const struct sunrpc_fuzz_origin *origin)
 {
 	struct nfs_page		*req;
 	struct nfs_open_context *ctx = l_ctx->open_context;
@@ -401,6 +402,10 @@ static struct nfs_page *nfs_page_create(struct nfs_lock_context *l_ctx,
 	req->wb_bytes = count;
 	kref_init(&req->wb_kref);
 	req->wb_nio = 0;
+	if (origin)
+		req->wb_fuzz_origin = *origin;
+	else
+		sunrpc_fuzz_origin_capture_current(&req->wb_fuzz_origin);
 	return req;
 }
 
@@ -444,7 +449,7 @@ struct nfs_page *nfs_page_create_from_page(struct nfs_open_context *ctx,
 	if (IS_ERR(l_ctx))
 		return ERR_CAST(l_ctx);
 	ret = nfs_page_create(l_ctx, pgbase, offset >> PAGE_SHIFT,
-			      offset_in_page(offset), count);
+			      offset_in_page(offset), count, NULL);
 	if (!IS_ERR(ret)) {
 		nfs_page_assign_page(ret, page);
 		nfs_page_group_init(ret, NULL);
@@ -474,7 +479,8 @@ struct nfs_page *nfs_page_create_from_folio(struct nfs_open_context *ctx,
 
 	if (IS_ERR(l_ctx))
 		return ERR_CAST(l_ctx);
-	ret = nfs_page_create(l_ctx, offset, folio->index, offset, count);
+	ret = nfs_page_create(l_ctx, offset, folio->index, offset, count,
+			      NULL);
 	if (!IS_ERR(ret)) {
 		nfs_page_assign_folio(ret, folio);
 		nfs_page_group_init(ret, NULL);
@@ -495,7 +501,7 @@ nfs_create_subreq(struct nfs_page *req,
 	struct page *page = nfs_page_to_page(req, pgbase);
 
 	ret = nfs_page_create(req->wb_lock_context, pgbase, req->wb_index,
-			      offset, count);
+			      offset, count, &req->wb_fuzz_origin);
 	if (!IS_ERR(ret)) {
 		if (folio)
 			nfs_page_assign_folio(ret, folio);
@@ -749,6 +755,7 @@ int nfs_initiate_pgio(struct rpc_clnt *clnt, struct nfs_pgio_header *hdr,
 		.callback_data = hdr,
 		.workqueue = nfsiod_workqueue,
 		.flags = RPC_TASK_ASYNC | flags,
+		.fuzz_origin = &hdr->fuzz_origin,
 	};
 
 	if (nfs_server_capable(hdr->inode, NFS_CAP_MOVEABLE))
@@ -913,6 +920,8 @@ int nfs_generic_pgio(struct nfs_pageio_descriptor *desc,
 
 		req = nfs_list_entry(head->next);
 		nfs_list_move_request(req, &hdr->pages);
+		sunrpc_fuzz_origin_merge(&hdr->fuzz_origin,
+					 &req->wb_fuzz_origin);
 
 		if (req->wb_pgbase == 0)
 			last_page = NULL;
diff --git a/fs/nfs/unlink.c b/fs/nfs/unlink.c
index b57cfaa4d..c1e6eeff5 100644
--- a/fs/nfs/unlink.c
+++ b/fs/nfs/unlink.c
@@ -99,6 +99,7 @@ static void nfs_do_call_unlink(struct inode *inode, struct nfs_unlinkdata *data)
 		.callback_data = data,
 		.workqueue = nfsiod_workqueue,
 		.flags = RPC_TASK_ASYNC | RPC_TASK_CRED_NOREF,

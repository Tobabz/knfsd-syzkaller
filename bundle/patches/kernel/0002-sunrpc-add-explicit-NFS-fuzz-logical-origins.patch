 		goto out_free;
@@ -357,8 +359,10 @@ nfs_async_rename(struct inode *old_dir, struct inode *new_dir,
 	data = kzalloc_obj(*data);
 	if (data == NULL)
 		return ERR_PTR(-ENOMEM);
+	sunrpc_fuzz_origin_capture_current(&data->fuzz_origin);
 	task_setup_data.task = &data->task;

@@ -58,6 +59,8 @@ struct nfs_page {
 	struct nfs_page		*wb_this_page;  /* list of reqs for this page */
 	struct nfs_page		*wb_head;       /* head pointer for req list */
 	unsigned short		wb_nio;		/* Number of I/O attempts */
+	/* Per-I/O-request origin; safe across delayed writeback. */
+	struct sunrpc_fuzz_origin wb_fuzz_origin;
 };
 
 struct nfs_pgio_mirror;
diff --git a/include/linux/nfs_xdr.h b/include/linux/nfs_xdr.h
index 7ed8fdb93..e2a602d23 100644
--- a/include/linux/nfs_xdr.h
+++ b/include/linux/nfs_xdr.h
@@ -3,6 +3,7 @@
 #define _LINUX_NFS_XDR_H
 
 #include <linux/nfsacl.h>
+#include <linux/sunrpc/fuzz.h>
 #include <linux/sunrpc/gss_api.h>
 
 /*
@@ -1693,6 +1694,8 @@ struct nfs_pgio_header {
 	struct nfs_client	*ds_clp;	/* pNFS data server */
 	u32			ds_commit_idx;	/* ds index if ds_clp is set */
 	u32			pgio_mirror_idx;/* mirror index in pgio layer */
+	/* Merge of the per-request origins represented by this RPC. */
+	struct sunrpc_fuzz_origin fuzz_origin;
 };
 
 struct nfs_mds_commit_info {
@@ -1737,6 +1740,8 @@ struct nfs_commit_data {
 	const struct nfs_commit_completion_ops *completion_ops;
 	int (*commit_done_cb) (struct rpc_task *task, struct nfs_commit_data *data);
 	unsigned long		flags;
+	/* Merge of the write requests represented by this COMMIT. */
+	struct sunrpc_fuzz_origin fuzz_origin;
 };
 
 struct nfs_pgio_completion_ops {
@@ -1753,6 +1758,8 @@ struct nfs_unlinkdata {
 	const struct cred *cred;
 	struct nfs_fattr dir_attr;
 	long timeout;
+	/* Captured when the silly-unlink operation is created. */

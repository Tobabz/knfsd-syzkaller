diff --git a/net/sunrpc/fuzz.c b/net/sunrpc/fuzz.c
new file mode 100644
index 000000000..d2bfdbeeb
--- /dev/null
+++ b/net/sunrpc/fuzz.c
@@ -0,0 +1,515 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Fuzz-origin and logical RPC identity support for SUNRPC.
+ *
+ * rpc_task construction deliberately does not infer an origin from current.
+ * An upper layer captures the origin while it still knows the initiating
+ * operation and passes an immutable value through rpc_task_setup.
+ */
+
+#include <linux/atomic.h>
+#include <linux/debugfs.h>
+#include <linux/fs.h>
+#include <linux/kcov.h>
+#include <linux/module.h>
+#include <linux/seq_file.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#include <linux/sunrpc/fuzz.h>
+#include <linux/sunrpc/xprt.h>
+
+enum sunrpc_fuzz_stat {
+	SUNRPC_FUZZ_STAT_LOGICAL_CREATED,
+	SUNRPC_FUZZ_STAT_LOGICAL_COMPLETED,
+	SUNRPC_FUZZ_STAT_LOGICAL_CANCELED,
+	SUNRPC_FUZZ_STAT_TASK_UNIQUE,
+	SUNRPC_FUZZ_STAT_TASK_NONE,
+	SUNRPC_FUZZ_STAT_RQST_INITIALIZED,
+	SUNRPC_FUZZ_STAT_RQST_RESET,
+	SUNRPC_FUZZ_STAT_RQST_STALE,
+	SUNRPC_FUZZ_STAT_BACKCHANNEL_RESET,
+	SUNRPC_FUZZ_STAT_ORIGIN_EMPTY,
+	SUNRPC_FUZZ_STAT_ORIGIN_UNIQUE,
+	SUNRPC_FUZZ_STAT_ORIGIN_UNATTRIBUTED,
+	SUNRPC_FUZZ_STAT_ORIGIN_MIXED,
+	SUNRPC_FUZZ_STAT_SELFTEST_RUNS,
+	SUNRPC_FUZZ_STAT_SELFTEST_FAILURES,
+	SUNRPC_FUZZ_STAT_SELFTEST_COOKIE_RETRY_PRESERVED,
+	SUNRPC_FUZZ_STAT_SELFTEST_XID_CHANGE_COOKIE_PRESERVED,
+	SUNRPC_FUZZ_STAT_SELFTEST_RQST_REUSE_CLEAN,
+	SUNRPC_FUZZ_STAT_SELFTEST_BACKCHANNEL_REUSE_CLEAN,
+	SUNRPC_FUZZ_STAT_SELFTEST_ORIGIN_LATTICE,
+	SUNRPC_FUZZ_STAT_SELFTEST_BACKGROUND_OWNER_NONE,
+	SUNRPC_FUZZ_STAT_COUNT,
+};
+
+static const char *const sunrpc_fuzz_stat_names[SUNRPC_FUZZ_STAT_COUNT] = {
+	[SUNRPC_FUZZ_STAT_LOGICAL_CREATED] = "logical_request_created",
+	[SUNRPC_FUZZ_STAT_LOGICAL_COMPLETED] = "logical_request_completed",
+	[SUNRPC_FUZZ_STAT_LOGICAL_CANCELED] = "logical_request_canceled",
+	[SUNRPC_FUZZ_STAT_TASK_UNIQUE] = "rpc_task_origin_unique",
+	[SUNRPC_FUZZ_STAT_TASK_NONE] = "rpc_task_owner_none",
+	[SUNRPC_FUZZ_STAT_RQST_INITIALIZED] = "request_slot_initialized",
+	[SUNRPC_FUZZ_STAT_RQST_RESET] = "request_slot_reset",
+	[SUNRPC_FUZZ_STAT_RQST_STALE] = "request_slot_stale",
+	[SUNRPC_FUZZ_STAT_BACKCHANNEL_RESET] = "backchannel_slot_reset",
+	[SUNRPC_FUZZ_STAT_ORIGIN_EMPTY] = "origin_empty",
+	[SUNRPC_FUZZ_STAT_ORIGIN_UNIQUE] = "origin_unique",
+	[SUNRPC_FUZZ_STAT_ORIGIN_UNATTRIBUTED] = "origin_unattributed",
+	[SUNRPC_FUZZ_STAT_ORIGIN_MIXED] = "origin_mixed",
+	[SUNRPC_FUZZ_STAT_SELFTEST_RUNS] = "selftest_runs",
+	[SUNRPC_FUZZ_STAT_SELFTEST_FAILURES] = "selftest_failures",
+	[SUNRPC_FUZZ_STAT_SELFTEST_COOKIE_RETRY_PRESERVED] =
+		"selftest_cookie_retry_preserved",
+	[SUNRPC_FUZZ_STAT_SELFTEST_XID_CHANGE_COOKIE_PRESERVED] =
+		"selftest_xid_change_cookie_preserved",
+	[SUNRPC_FUZZ_STAT_SELFTEST_RQST_REUSE_CLEAN] =
+		"selftest_rpc_rqst_reuse_clean",
+	[SUNRPC_FUZZ_STAT_SELFTEST_BACKCHANNEL_REUSE_CLEAN] =
+		"selftest_backchannel_reuse_clean",
+	[SUNRPC_FUZZ_STAT_SELFTEST_ORIGIN_LATTICE] =
+		"selftest_origin_lattice",
+	[SUNRPC_FUZZ_STAT_SELFTEST_BACKGROUND_OWNER_NONE] =
+		"selftest_background_owner_none",
+};
+
+static atomic64_t sunrpc_fuzz_stats[SUNRPC_FUZZ_STAT_COUNT];
+static atomic64_t sunrpc_fuzz_next_cookie = ATOMIC64_INIT(0);
+static struct dentry *sunrpc_fuzz_debugfs_dir;
+
+static void sunrpc_fuzz_stat_inc(enum sunrpc_fuzz_stat stat)
+{
+	atomic64_inc(&sunrpc_fuzz_stats[stat]);
+}
+
+static bool sunrpc_fuzz_owner_valid(struct kcov_common_handle_id owner)
+{
+#ifdef CONFIG_KCOV
+	return owner.val != 0;
+#else
+	return false;
+#endif
+}
+
+static bool sunrpc_fuzz_owner_equal(struct kcov_common_handle_id a,
+		struct kcov_common_handle_id b)
+{
+#ifdef CONFIG_KCOV
+	return a.val == b.val;
+#else
+	return true;
+#endif
+}
+
+static struct kcov_common_handle_id sunrpc_fuzz_owner_none(void)
+{
+	return (struct kcov_common_handle_id){};
+}
+
+void sunrpc_fuzz_origin_init(struct sunrpc_fuzz_origin *origin)
+{
+	origin->state = SUNRPC_FUZZ_ORIGIN_EMPTY;
+	origin->owner = sunrpc_fuzz_owner_none();
+}
+EXPORT_SYMBOL_GPL(sunrpc_fuzz_origin_init);
+
+bool sunrpc_fuzz_origin_capture_current(struct sunrpc_fuzz_origin *origin)
+{
+	struct kcov_common_handle_id owner = kcov_common_handle();
+
+	if (!sunrpc_fuzz_owner_valid(owner)) {
+		sunrpc_fuzz_origin_set_unattributed(origin);
+		return false;
+	}
+
+	origin->state = SUNRPC_FUZZ_ORIGIN_UNIQUE;
+	origin->owner = owner;
+	return true;
+}
+EXPORT_SYMBOL_GPL(sunrpc_fuzz_origin_capture_current);
+
+void sunrpc_fuzz_origin_set_unattributed(struct sunrpc_fuzz_origin *origin)
+{
+	origin->state = SUNRPC_FUZZ_ORIGIN_UNATTRIBUTED;
+	origin->owner = sunrpc_fuzz_owner_none();
+}
+EXPORT_SYMBOL_GPL(sunrpc_fuzz_origin_set_unattributed);
+
+static enum sunrpc_fuzz_origin_state
+sunrpc_fuzz_origin_normalize(const struct sunrpc_fuzz_origin *origin)
+{
+	if (!origin)
+		return SUNRPC_FUZZ_ORIGIN_EMPTY;
+
+	switch (origin->state) {
+	case SUNRPC_FUZZ_ORIGIN_EMPTY:
+	case SUNRPC_FUZZ_ORIGIN_UNATTRIBUTED:
+	case SUNRPC_FUZZ_ORIGIN_MIXED:
+		return origin->state;
+	case SUNRPC_FUZZ_ORIGIN_UNIQUE:
+		return sunrpc_fuzz_owner_valid(origin->owner) ?
+			SUNRPC_FUZZ_ORIGIN_UNIQUE :
+			SUNRPC_FUZZ_ORIGIN_UNATTRIBUTED;
+	default:
+		return SUNRPC_FUZZ_ORIGIN_MIXED;
+	}
+}
+
+void sunrpc_fuzz_origin_merge(struct sunrpc_fuzz_origin *dst,
+		const struct sunrpc_fuzz_origin *src)
+{
+	enum sunrpc_fuzz_origin_state dst_state;
+	enum sunrpc_fuzz_origin_state src_state;
+
+	dst_state = sunrpc_fuzz_origin_normalize(dst);
+	src_state = sunrpc_fuzz_origin_normalize(src);
+	if (dst_state != dst->state) {
+		dst->state = dst_state;
+		if (dst_state != SUNRPC_FUZZ_ORIGIN_UNIQUE)
+			dst->owner = sunrpc_fuzz_owner_none();
+	}
+
+	if (dst_state == SUNRPC_FUZZ_ORIGIN_MIXED ||
+	    src_state == SUNRPC_FUZZ_ORIGIN_MIXED) {
+		dst->state = SUNRPC_FUZZ_ORIGIN_MIXED;
+		dst->owner = sunrpc_fuzz_owner_none();
+		return;
+	}
+	if (src_state == SUNRPC_FUZZ_ORIGIN_EMPTY)
+		return;
+	if (dst_state == SUNRPC_FUZZ_ORIGIN_EMPTY) {
+		dst->state = src_state;
+		dst->owner = src_state == SUNRPC_FUZZ_ORIGIN_UNIQUE ?
+			src->owner : sunrpc_fuzz_owner_none();
+		return;
+	}
+	if (dst_state == SUNRPC_FUZZ_ORIGIN_UNATTRIBUTED &&
+	    src_state == SUNRPC_FUZZ_ORIGIN_UNATTRIBUTED)
+		return;
+	if (dst_state == SUNRPC_FUZZ_ORIGIN_UNIQUE &&
+	    src_state == SUNRPC_FUZZ_ORIGIN_UNIQUE &&
+	    sunrpc_fuzz_owner_equal(dst->owner, src->owner))
+		return;
+
+	dst->state = SUNRPC_FUZZ_ORIGIN_MIXED;
+	dst->owner = sunrpc_fuzz_owner_none();
+}
+EXPORT_SYMBOL_GPL(sunrpc_fuzz_origin_merge);
+
+bool sunrpc_fuzz_origin_is_attributable(
+		const struct sunrpc_fuzz_origin *origin)
+{
+	return sunrpc_fuzz_origin_normalize(origin) ==
+		SUNRPC_FUZZ_ORIGIN_UNIQUE;
+}
+EXPORT_SYMBOL_GPL(sunrpc_fuzz_origin_is_attributable);
+
+static void sunrpc_fuzz_count_origin(enum sunrpc_fuzz_origin_state state)
+{
+	switch (state) {
+	case SUNRPC_FUZZ_ORIGIN_EMPTY:
+		sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_ORIGIN_EMPTY);
+		break;
+	case SUNRPC_FUZZ_ORIGIN_UNIQUE:
+		sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_ORIGIN_UNIQUE);
+		break;
+	case SUNRPC_FUZZ_ORIGIN_UNATTRIBUTED:
+		sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_ORIGIN_UNATTRIBUTED);
+		break;
+	case SUNRPC_FUZZ_ORIGIN_MIXED:
+		sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_ORIGIN_MIXED);
+		break;
+	}
+}
+
+static u64 sunrpc_fuzz_alloc_cookie(void)
+{
+	u64 cookie;
+
+	do {
+		cookie = atomic64_inc_return(&sunrpc_fuzz_next_cookie);
+	} while (unlikely(!cookie));
+	return cookie;
+}
+
+void sunrpc_fuzz_logical_init(struct sunrpc_fuzz_logical_rpc *logical,
+		const struct sunrpc_fuzz_origin *origin)
+{
+	enum sunrpc_fuzz_origin_state state;
+
+	memset(logical, 0, sizeof(*logical));
+	state = sunrpc_fuzz_origin_normalize(origin);
+	logical->origin_state = state;
+	sunrpc_fuzz_count_origin(state);
+
+	if (state != SUNRPC_FUZZ_ORIGIN_UNIQUE) {
+		sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_TASK_NONE);
+		return;
+	}
+
+	logical->request_cookie = sunrpc_fuzz_alloc_cookie();
+	logical->owner = origin->owner;
+	logical->active = true;
+	sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_TASK_UNIQUE);
+	sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_LOGICAL_CREATED);
+}
+
+static bool sunrpc_fuzz_logical_finish(struct sunrpc_fuzz_logical_rpc *logical)
+{
+	if (!logical->active)
+		return false;
+	logical->active = false;
+	logical->request_cookie = 0;
+	logical->owner = sunrpc_fuzz_owner_none();
+	return true;
+}
+
+void sunrpc_fuzz_logical_complete(struct sunrpc_fuzz_logical_rpc *logical)
+{
+	if (sunrpc_fuzz_logical_finish(logical))
+		sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_LOGICAL_COMPLETED);
+}
+
+void sunrpc_fuzz_logical_cancel(struct sunrpc_fuzz_logical_rpc *logical)
+{
+	if (sunrpc_fuzz_logical_finish(logical))
+		sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_LOGICAL_CANCELED);
+}
+
+static bool sunrpc_fuzz_rqst_is_clear(const struct sunrpc_fuzz_rqst *rqst)
+{
+	return !rqst->request_cookie &&
+	       rqst->origin_state == SUNRPC_FUZZ_ORIGIN_EMPTY &&
+	       !sunrpc_fuzz_owner_valid(rqst->owner);
+}
+
+void sunrpc_fuzz_rqst_bind(struct sunrpc_fuzz_rqst *rqst,
+		const struct sunrpc_fuzz_logical_rpc *logical)
+{
+	if (WARN_ON_ONCE(!sunrpc_fuzz_rqst_is_clear(rqst))) {
+		sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_RQST_STALE);
+		memset(rqst, 0, sizeof(*rqst));
+	}
+
+	if (logical->active) {
+		rqst->request_cookie = logical->request_cookie;
+		rqst->owner = logical->owner;
+		rqst->origin_state = logical->origin_state;
+	}
+	sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_RQST_INITIALIZED);
+}
+
+void sunrpc_fuzz_rqst_reset(struct sunrpc_fuzz_rqst *rqst,
+		enum sunrpc_fuzz_rqst_reset_reason reason)
+{
+	memset(rqst, 0, sizeof(*rqst));
+	sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_RQST_RESET);
+	if (reason == SUNRPC_FUZZ_RQST_RESET_BACKCHANNEL)
+		sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_BACKCHANNEL_RESET);
+}
+
+static bool sunrpc_fuzz_phase2_selftest(void)
+{
+#ifdef CONFIG_KCOV
+	struct sunrpc_fuzz_origin a = {
+		.state = SUNRPC_FUZZ_ORIGIN_UNIQUE,
+		.owner = { .val = 0x101 },
+	};
+	struct sunrpc_fuzz_origin same = {
+		.state = SUNRPC_FUZZ_ORIGIN_UNIQUE,
+		.owner = { .val = 0x101 },
+	};
+	struct sunrpc_fuzz_origin b = {
+		.state = SUNRPC_FUZZ_ORIGIN_UNIQUE,
+		.owner = { .val = 0x202 },
+	};
+	struct sunrpc_fuzz_origin empty;
+	struct sunrpc_fuzz_origin empty_pair;
+	struct sunrpc_fuzz_origin unattributed;
+	struct sunrpc_fuzz_origin unattributed_pair;
+	struct sunrpc_fuzz_origin unattributed_plus_unique;
+	struct sunrpc_fuzz_origin unique_plus_unattributed;
+	struct sunrpc_fuzz_origin mixed_plus_empty;
+	struct sunrpc_fuzz_logical_rpc logical;
+	struct sunrpc_fuzz_logical_rpc background;
+	struct sunrpc_fuzz_logical_rpc nonattributable;
+	struct rpc_rqst rqst = {};
+	u64 cookie;
+	__be32 first_xid = cpu_to_be32(10);
+	__be32 second_xid = cpu_to_be32(25);
+
+	sunrpc_fuzz_origin_init(&empty);
+	if (sunrpc_fuzz_origin_is_attributable(&empty))
+		return false;
+	empty_pair = empty;
+	sunrpc_fuzz_origin_merge(&empty_pair, &empty);
+	if (empty_pair.state != SUNRPC_FUZZ_ORIGIN_EMPTY)
+		return false;
+	sunrpc_fuzz_origin_merge(&empty, &same);
+	if (!sunrpc_fuzz_origin_is_attributable(&empty) ||
+	    !sunrpc_fuzz_owner_equal(empty.owner, same.owner))
+		return false;
+
+	sunrpc_fuzz_origin_set_unattributed(&unattributed);
+	sunrpc_fuzz_origin_init(&empty_pair);
+	sunrpc_fuzz_origin_merge(&empty_pair, &unattributed);
+	if (empty_pair.state != SUNRPC_FUZZ_ORIGIN_UNATTRIBUTED)
+		return false;
+	unattributed_pair = unattributed;
+	sunrpc_fuzz_origin_merge(&unattributed_pair, &unattributed);
+	if (unattributed_pair.state != SUNRPC_FUZZ_ORIGIN_UNATTRIBUTED ||
+	    sunrpc_fuzz_origin_is_attributable(&unattributed_pair))
+		return false;
+	unique_plus_unattributed = same;
+	sunrpc_fuzz_origin_merge(&unique_plus_unattributed, &unattributed);
+	if (unique_plus_unattributed.state != SUNRPC_FUZZ_ORIGIN_MIXED ||
+	    sunrpc_fuzz_origin_is_attributable(&unique_plus_unattributed))
+		return false;
+	unattributed_plus_unique = unattributed;
+	sunrpc_fuzz_origin_merge(&unattributed_plus_unique, &same);
+	if (unattributed_plus_unique.state != SUNRPC_FUZZ_ORIGIN_MIXED)
+		return false;
+
+	sunrpc_fuzz_origin_merge(&a, &same);
+	if (!sunrpc_fuzz_origin_is_attributable(&a))
+		return false;
+
+	sunrpc_fuzz_logical_init(&logical, &a);
+	if (!logical.active || !logical.request_cookie)
+		return false;
+	cookie = logical.request_cookie;
+
+	/* Model one rpc_task moving through two rpc_rqst/XID slots. */
+	rqst.rq_xid = first_xid;
+	sunrpc_fuzz_rqst_bind(&rqst.rq_fuzz, &logical);
+	if (rqst.rq_fuzz.request_cookie != cookie)
+		return false;
+	sunrpc_fuzz_rqst_reset(&rqst.rq_fuzz,
+			SUNRPC_FUZZ_RQST_RESET_RELEASE);
+	if (!sunrpc_fuzz_rqst_is_clear(&rqst.rq_fuzz))
+		return false;
+	rqst.rq_xid = second_xid;
+	sunrpc_fuzz_rqst_bind(&rqst.rq_fuzz, &logical);
+	if (rqst.rq_fuzz.request_cookie != cookie ||
+	    logical.request_cookie != cookie)
+		return false;
+	sunrpc_fuzz_stat_inc(
+		SUNRPC_FUZZ_STAT_SELFTEST_COOKIE_RETRY_PRESERVED);
+	if (first_xid == second_xid || logical.request_cookie != cookie)
+		return false;
+	sunrpc_fuzz_stat_inc(
+		SUNRPC_FUZZ_STAT_SELFTEST_XID_CHANGE_COOKIE_PRESERVED);
+	sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_SELFTEST_RQST_REUSE_CLEAN);
+
+	sunrpc_fuzz_rqst_reset(&rqst.rq_fuzz,
+			SUNRPC_FUZZ_RQST_RESET_BACKCHANNEL);
+	if (!sunrpc_fuzz_rqst_is_clear(&rqst.rq_fuzz))
+		return false;
+	sunrpc_fuzz_stat_inc(
+		SUNRPC_FUZZ_STAT_SELFTEST_BACKCHANNEL_REUSE_CLEAN);
+
+	sunrpc_fuzz_origin_merge(&a, &b);
+	if (a.state != SUNRPC_FUZZ_ORIGIN_MIXED ||
+	    sunrpc_fuzz_origin_is_attributable(&a))
+		return false;
+	mixed_plus_empty = a;
+	sunrpc_fuzz_origin_init(&empty_pair);
+	sunrpc_fuzz_origin_merge(&mixed_plus_empty, &empty_pair);
+	if (mixed_plus_empty.state != SUNRPC_FUZZ_ORIGIN_MIXED)
+		return false;
+
+	/* Exercise all non-attributable task-origin counters as well. */
+	sunrpc_fuzz_logical_init(&nonattributable, NULL);
+	if (nonattributable.active || nonattributable.request_cookie)
+		return false;
+	sunrpc_fuzz_logical_init(&nonattributable, &a);
+	if (nonattributable.active || nonattributable.request_cookie)
+		return false;
+	sunrpc_fuzz_logical_init(&background, &unattributed);
+	if (background.active || background.request_cookie)
+		return false;
+	sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_SELFTEST_ORIGIN_LATTICE);
+	sunrpc_fuzz_stat_inc(
+		SUNRPC_FUZZ_STAT_SELFTEST_BACKGROUND_OWNER_NONE);
+
+	sunrpc_fuzz_logical_complete(&logical);
+	return !logical.active && !logical.request_cookie;
+#else
+	return true;
+#endif
+}
+
+static int sunrpc_fuzz_stats_show(struct seq_file *m, void *v)
+{
+	unsigned int i;
+
+	for (i = 0; i < SUNRPC_FUZZ_STAT_COUNT; i++)
+		seq_printf(m, "%s %lld\n", sunrpc_fuzz_stat_names[i],
+			   atomic64_read(&sunrpc_fuzz_stats[i]));
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(sunrpc_fuzz_stats);
+
+static void sunrpc_fuzz_stats_reset(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < SUNRPC_FUZZ_STAT_COUNT; i++)
+		atomic64_set(&sunrpc_fuzz_stats[i], 0);
+}
+
+static ssize_t sunrpc_fuzz_control_write(struct file *file,
+		const char __user *buf, size_t count, loff_t *ppos)
+{
+	char command[16];
+	size_t len = min(count, sizeof(command) - 1);
+	bool pass;
+
+	if (!count)
+		return -EINVAL;
+	if (copy_from_user(command, buf, len))
+		return -EFAULT;
+	command[len] = '\0';
+	if (sysfs_streq(command, "reset")) {
+		sunrpc_fuzz_stats_reset();
+		return count;
+	}
+	if (!sysfs_streq(command, "selftest"))
+		return -EINVAL;
+
+	sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_SELFTEST_RUNS);
+	pass = sunrpc_fuzz_phase2_selftest();
+	if (!pass)
+		sunrpc_fuzz_stat_inc(SUNRPC_FUZZ_STAT_SELFTEST_FAILURES);
+	return pass ? count : -EIO;
+}
+
+static const struct file_operations sunrpc_fuzz_control_fops = {
+	.owner = THIS_MODULE,
+	.write = sunrpc_fuzz_control_write,
+	.llseek = noop_llseek,
+};
+
+void sunrpc_fuzz_debugfs_init(void)
+{
+	if (!IS_ENABLED(CONFIG_DEBUG_FS))
+		return;
+
+	sunrpc_fuzz_debugfs_dir = debugfs_create_dir("sunrpc_fuzz", NULL);
+	if (IS_ERR_OR_NULL(sunrpc_fuzz_debugfs_dir)) {
+		sunrpc_fuzz_debugfs_dir = NULL;
+		return;
+	}
+	debugfs_create_file("phase2_stats", 0400, sunrpc_fuzz_debugfs_dir,
+			    NULL, &sunrpc_fuzz_stats_fops);
+	debugfs_create_file("phase2_control", 0200, sunrpc_fuzz_debugfs_dir,
+			    NULL, &sunrpc_fuzz_control_fops);
+}
+
+void sunrpc_fuzz_debugfs_exit(void)
+{
+	debugfs_remove_recursive(sunrpc_fuzz_debugfs_dir);
+	sunrpc_fuzz_debugfs_dir = NULL;
+}

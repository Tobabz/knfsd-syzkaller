+static ssize_t phase8_control_write(struct file *file,
+		const char __user *buf, size_t count, loff_t *ppos)
+{
+	char command[64];
+	unsigned int i;
+
+	if (!count || count >= sizeof(command))
+		return -EINVAL;
+	if (copy_from_user(command, buf, count))
+		return -EFAULT;
+	command[count] = '\0';
+	if (sysfs_streq(command, "reset")) {
+		for (i = 0; i < P8_STAT_COUNT; i++)
+			atomic64_set(&phase8_stats[i], 0);
+		atomic_set(&phase8_abort_next_deferred, 0);
+		atomic_set(&phase8_abort_next_async, 0);
+		atomic_set(&phase8_pause_next_deferred, 0);
+		atomic_set(&phase8_pause_next_async, 0);
+		atomic_set(&phase8_release_deferred, 1);
+		atomic_set(&phase8_release_async, 1);
+		wake_up_all(&phase8_pause_wait);
+		return count;
+	}
+	if (sysfs_streq(command, "abort-next-deferred") ||
+	    sysfs_streq(command, "fault-arm abort-next-deferred")) {
+		if (atomic_cmpxchg(&phase8_abort_next_deferred, 0, 1))
+			return -EBUSY;
+		return count;
+	}
+	if (sysfs_streq(command, "abort-next-async") ||
+	    sysfs_streq(command, "fault-arm abort-next-async")) {
+		if (atomic_cmpxchg(&phase8_abort_next_async, 0, 1))
+			return -EBUSY;
+		return count;
+	}
+	if (sysfs_streq(command,
+			"fault-arm pause-next-deferred-after-grant")) {
+		atomic_set(&phase8_release_deferred, 0);
+		if (atomic_cmpxchg(&phase8_pause_next_deferred, 0, 1))
+			return -EBUSY;
+		return count;
+	}
+	if (sysfs_streq(command, "fault-arm pause-next-async-after-grant")) {
+		atomic_set(&phase8_release_async, 0);
+		if (atomic_cmpxchg(&phase8_pause_next_async, 0, 1))
+			return -EBUSY;
+		return count;
+	}
+	if (sysfs_streq(command,
+			"fault-release pause-deferred-after-grant")) {
+		atomic_set(&phase8_release_deferred, 1);
+		wake_up_all(&phase8_pause_wait);
+		return count;
+	}
+	if (sysfs_streq(command, "fault-release pause-async-after-grant")) {
+		atomic_set(&phase8_release_async, 1);
+		wake_up_all(&phase8_pause_wait);
+		return count;
+	}
+	if (sysfs_streq(command, "clear-fault")) {
+		atomic_set(&phase8_abort_next_deferred, 0);
+		atomic_set(&phase8_abort_next_async, 0);
+		atomic_set(&phase8_pause_next_deferred, 0);
+		atomic_set(&phase8_pause_next_async, 0);
+		atomic_set(&phase8_release_deferred, 1);
+		atomic_set(&phase8_release_async, 1);
+		wake_up_all(&phase8_pause_wait);
+		return count;
+	}
+	return -EOPNOTSUPP;
+}

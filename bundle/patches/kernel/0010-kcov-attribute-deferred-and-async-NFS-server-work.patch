+enum sunrpc_fuzz_saved_start_result sunrpc_fuzz_saved_work_start(
+		struct sunrpc_fuzz_saved_work **savedp,
+		struct kcov_request_remote_ticket **ticketp)
+{
+	struct sunrpc_fuzz_saved_work *saved;

+static struct kcov_request_token *sunrpc_fuzz_svc_parent_token(
+		struct svc_rqst *rqstp)
+{
+	struct sunrpc_fuzz_wire_work *wire = rqstp->rq_fuzz_wire_work;
+	struct sunrpc_fuzz_saved_work *saved = rqstp->rq_fuzz_saved_work;
+
+	if (wire && saved) {
+		phase8_stat_inc(P8_SAVED_WORK_DOUBLE_ATTACH);
+		return NULL;
+	}
+	if (wire)
+		return &wire->token;
+	if (saved)
+		return &saved->token;
+	return NULL;
+}
+
+static void sunrpc_fuzz_saved_work_free(
+		struct sunrpc_fuzz_saved_work **savedp, bool complete_token,
+		bool dropped)
+{
+	struct sunrpc_fuzz_saved_work *saved;
+	bool deferred;
+
+	if (!savedp)
+		return;
+	saved = xchg(savedp, NULL);
+	if (!saved)
+		return;
+	deferred = saved->type == KCOV_REQUEST_TOKEN_DEFERRED;
+	if (complete_token && saved->token.generation)
+		kcov_request_token_complete_once(&saved->token);
+	if (saved->net)
+		put_net(saved->net);
+	atomic_dec(&phase8_live_saved);
+	phase8_stat_inc(deferred ?
+		(dropped ? P8_DEFERRED_DROPPED : P8_DEFERRED_COMPLETED) :
+		(dropped ? P8_ASYNC_DROPPED : P8_ASYNC_COMPLETED));
+	kfree(saved);
+}
+
+struct sunrpc_fuzz_saved_work *sunrpc_fuzz_svc_continuation_save(
+		struct svc_rqst *rqstp, enum kcov_request_token_type type)
+{
+	struct sunrpc_fuzz_saved_work *saved;
+	struct kcov_request_token *parent;
+	bool deferred = type == KCOV_REQUEST_TOKEN_DEFERRED;
+
+	if (!rqstp || (type != KCOV_REQUEST_TOKEN_DEFERRED &&
+		       type != KCOV_REQUEST_TOKEN_ASYNC))
+		return NULL;
+	parent = sunrpc_fuzz_svc_parent_token(rqstp);
+	if (!parent)
+		goto rejected;
+	saved = kzalloc_obj(*saved);
+	if (!saved)
+		goto rejected;
+	if (!kcov_request_try_get_continuation_token(parent, type,
+			&saved->token)) {
+		kfree(saved);
+		goto rejected;
+	}
+	saved->owner = parent->owner;

+	bool deferred;
+
+	if (!savedp || !ticketp)
+		return SUNRPC_FUZZ_SAVED_OWNER_NONE;
+	saved = *savedp;
+	if (!saved)
+		return SUNRPC_FUZZ_SAVED_OWNER_NONE;
+	*ticketp = NULL;
+	deferred = saved->type == KCOV_REQUEST_TOKEN_DEFERRED;
+	if (!deferred &&
+	    atomic_cmpxchg(&phase8_abort_next_async, 1, 0) == 1) {
+		kcov_request_generation_abort(saved->token.generation);
+		phase8_stat_inc(P8_ASYNC_ABORT_BEFORE_GRANT);
+	}
+	if (sunrpc_fuzz_saved_work_grant(saved, ticketp))
+		goto owner_none;
+	result = kcov_request_remote_start_checked(*ticketp);
+	if (result == KCOV_REQUEST_REMOTE_START_SUCCESS) {
+		phase8_stat_inc(deferred ? P8_DEFERRED_START_OK :
+			P8_ASYNC_START_OK);
+		return SUNRPC_FUZZ_SAVED_ACTIVE;
+	}
+	if (result == KCOV_REQUEST_REMOTE_START_NESTED) {
+		phase8_stat_inc(deferred ? P8_DEFERRED_START_NESTED :
+			P8_ASYNC_START_NESTED);
+		if (saved->net)
+			sunrpc_fuzz_lane_mark_unhealthy(saved->net);
+		kcov_request_remote_start_failed(*ticketp, true);
+		kcov_request_remote_ticket_put(*ticketp);
+		*ticketp = NULL;
+		sunrpc_fuzz_saved_work_free(savedp, false, true);
+		return SUNRPC_FUZZ_SAVED_NESTED;
+	}
+	phase8_stat_inc(deferred ? P8_DEFERRED_START_INCOMPLETE :
+		P8_ASYNC_START_INCOMPLETE);
+	kcov_request_remote_start_failed(*ticketp, false);
+	kcov_request_remote_ticket_put(*ticketp);
+	*ticketp = NULL;
+	sunrpc_fuzz_saved_work_free(savedp, false, true);
+	phase8_stat_inc(deferred ? P8_DEFERRED_OWNER_NONE : P8_ASYNC_OWNER_NONE);
+	return SUNRPC_FUZZ_SAVED_OWNER_NONE;
+owner_none:
+	phase8_stat_inc(deferred ? P8_DEFERRED_OWNER_NONE : P8_ASYNC_OWNER_NONE);
+	sunrpc_fuzz_saved_work_free(savedp, true, true);
+	return SUNRPC_FUZZ_SAVED_OWNER_NONE;
+}
+EXPORT_SYMBOL_GPL(sunrpc_fuzz_saved_work_start);
+
+void sunrpc_fuzz_saved_work_stop(struct sunrpc_fuzz_saved_work **savedp,

From 60164ad3c37484ab24aeb3b1e0cf37dc2bfc2d5b Mon Sep 17 00:00:00 2001
From: fuzzer <fuzzer@cesrv.local>
Date: Wed, 16 Sep 2026 19:44:40 +0900
Subject: [PATCH 03/11] sunrpc: add TCP fuzz connection correlation


diff --git a/include/linux/sunrpc/fuzz.h b/include/linux/sunrpc/fuzz.h
index 815e62e0f..097346c52 100644
--- a/include/linux/sunrpc/fuzz.h
+++ b/include/linux/sunrpc/fuzz.h
@@ -3,8 +3,15 @@
 #define _LINUX_SUNRPC_FUZZ_H
 
 #include <linux/kcov.h>
+#include <linux/refcount.h>
 #include <linux/types.h>
 
+struct dentry;
+struct net;
+struct rpc_xprt;
+struct sock;
+struct svc_xprt;
+
 /*
  * Origin is an accumulator, not an owner slot.  EMPTY means that no input
  * has contributed yet; UNATTRIBUTED means that real, ownerless work did.
@@ -36,6 +43,26 @@ struct sunrpc_fuzz_rqst {
 	enum sunrpc_fuzz_origin_state origin_state;
 };
 
+enum sunrpc_fuzz_wire_direction {
+	SUNRPC_FUZZ_C2S = 0,
+	SUNRPC_FUZZ_S2C,
+	SUNRPC_FUZZ_WIRE_DIRECTIONS,
+};
+
+struct sunrpc_fuzz_conn;
+
+/* A provisional ordinal becomes visible only at first-byte commit. */
+struct sunrpc_fuzz_wire_reservation {
+	struct sunrpc_fuzz_conn *conn;
+	u64 ordinal;
+	u64 request_cookie;
+	u32 xid;
+	u32 record_len;
+	u8 direction;
+	bool pending;
+	bool committed;
+};
+
 enum sunrpc_fuzz_rqst_reset_reason {
 	SUNRPC_FUZZ_RQST_RESET_RELEASE = 0,
 	SUNRPC_FUZZ_RQST_RESET_HANDOFF,
@@ -63,4 +90,41 @@ void sunrpc_fuzz_rqst_reset(struct sunrpc_fuzz_rqst *rqst,
 void sunrpc_fuzz_debugfs_init(void);
 void sunrpc_fuzz_debugfs_exit(void);
 
+int sunrpc_fuzz_phase3_init(struct dentry *root);
+void sunrpc_fuzz_phase3_exit(void);
+
+/* The socket is armed before kernel_connect(); the IPv4 hook runs pre-SYN. */
+int sunrpc_fuzz_tcp_arm(struct rpc_xprt *xprt, struct sock *sk);
+void sunrpc_fuzz_tcp_pre_connect(struct sock *sk);
+void sunrpc_fuzz_tcp_connect_result(struct rpc_xprt *xprt, int status);
+void sunrpc_fuzz_tcp_track_svc(struct svc_xprt *xprt, struct sock *sk);
+void sunrpc_fuzz_rpc_xprt_detach(struct rpc_xprt *xprt);
+void sunrpc_fuzz_svc_pair(struct svc_xprt *xprt);
+void sunrpc_fuzz_svc_xprt_detach(struct svc_xprt *xprt);
+
+bool sunrpc_fuzz_rpc_reserve_tx(struct rpc_xprt *xprt,
+		struct sunrpc_fuzz_wire_reservation *reservation);
+bool sunrpc_fuzz_svc_reserve_tx(struct svc_xprt *xprt,
+		enum sunrpc_fuzz_wire_direction direction,
+		struct sunrpc_fuzz_wire_reservation *reservation);
+void sunrpc_fuzz_rpc_tx_result(struct rpc_xprt *xprt,
+		struct sunrpc_fuzz_wire_reservation *reservation,
+		unsigned int sent, bool terminal_failure);
+void sunrpc_fuzz_svc_tx_result(struct svc_xprt *xprt,
+		struct sunrpc_fuzz_wire_reservation *reservation,
+		unsigned int sent, bool terminal_failure);
+void sunrpc_fuzz_wire_tx_complete(
+		struct sunrpc_fuzz_wire_reservation *reservation);
+void sunrpc_fuzz_rpc_prepare_send(struct rpc_xprt *xprt);
+void sunrpc_fuzz_svc_prepare_send(struct svc_xprt *xprt, struct sock *sk,
+		struct sunrpc_fuzz_wire_reservation *reservation);
+bool sunrpc_fuzz_fault_before_rpc_send(struct sock *sk, u64 request_cookie);
+bool sunrpc_fuzz_fault_after_rpc_send(u64 request_cookie);
+void sunrpc_fuzz_note_record_class(bool background, bool backchannel);
+void sunrpc_fuzz_note_corrupted_closed(void);
+u64 sunrpc_fuzz_rpc_record_received(struct rpc_xprt *xprt,
+		enum sunrpc_fuzz_wire_direction direction);
+u64 sunrpc_fuzz_svc_record_received(struct svc_xprt *xprt,
+		enum sunrpc_fuzz_wire_direction direction);
+
 #endif /* _LINUX_SUNRPC_FUZZ_H */
diff --git a/include/linux/sunrpc/svc_xprt.h b/include/linux/sunrpc/svc_xprt.h
index da2a2531e..2f6531d9b 100644
--- a/include/linux/sunrpc/svc_xprt.h
+++ b/include/linux/sunrpc/svc_xprt.h
@@ -78,6 +78,8 @@ struct svc_xprt {
 	netns_tracker		ns_tracker;
 	const struct cred	*xpt_cred;
 	struct rpc_xprt		*xpt_bc_xprt;	/* NFSv4.1 backchannel */
+	/* Paired with the client rpc_xprt for the lifetime of this TCP stream. */
+	struct sunrpc_fuzz_conn *fuzz_conn;
 	struct rpc_xprt_switch	*xpt_bc_xps;	/* NFSv4.1 backchannel */
 };
 
diff --git a/include/linux/sunrpc/xprt.h b/include/linux/sunrpc/xprt.h
index 03856a197..1c595c0d8 100644
--- a/include/linux/sunrpc/xprt.h
+++ b/include/linux/sunrpc/xprt.h
@@ -213,6 +213,7 @@ enum xprt_transports {
 };
 
 struct rpc_sysfs_xprt;
+struct sunrpc_fuzz_conn;
 struct rpc_xprt {
 	struct kref		kref;		/* Reference count */
 	const struct rpc_xprt_ops *ops;		/* transport methods */
@@ -283,6 +284,8 @@ struct rpc_xprt {
 	atomic_long_t		xmit_queuelen;
 
 	struct svc_xprt		*bc_xprt;	/* NFSv4.1 backchannel */
+	/* Connection-lifetime NFS-role correlation, independent of Generation. */
+	struct sunrpc_fuzz_conn *fuzz_conn;
 #if defined(CONFIG_SUNRPC_BACKCHANNEL)

diff --git a/net/sunrpc/fuzz_conn.c b/net/sunrpc/fuzz_conn.c
new file mode 100644
index 000000000..152b6c44a
--- /dev/null
+++ b/net/sunrpc/fuzz_conn.c
@@ -0,0 +1,1324 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * NFS-role TCP connection correlation and record ordering for SUNRPC fuzzing.
+ *
+ * This is deliberately independent of a program Generation: a connection can
+ * carry records for several generations.  The IPv4 preconnect callback is
+ * invoked after the local tuple is final and before TCP emits its first SYN.
+ */
+
+#include <linux/atomic.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/fs.h>
+#include <linux/inet.h>
+#include <linux/jiffies.h>
+#include <linux/list.h>
+#include <linux/module.h>
+#include <linux/nsproxy.h>
+#include <linux/refcount.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include <net/inet_sock.h>
+#include <net/net_namespace.h>
+#include <net/netns/generic.h>
+#include <net/sock.h>
+
+#include <linux/sunrpc/fuzz.h>
+#include <linux/sunrpc/svc_xprt.h>
+#include <linux/sunrpc/xprt.h>
+#include <linux/sunrpc/xprtsock.h>
+
+#define SUNRPC_FUZZ_PENDING_TTL	(30 * HZ)
+
+enum sunrpc_fuzz_phase3_stat {
+	P3_LANE_EPOCH_ALLOCATED,
+	P3_LANE_EPOCH_COLLISION,
+	P3_LANE_EPOCH_IMMUTABLE_VIOLATION,
+	P3_CONNECTION_PAIR_OK,
+	P3_CONNECTION_PAIR_MISS,
+	P3_CONNECTION_PAIR_EXPIRED,
+	P3_CONNECTION_COOKIE_REUSE,
+	P3_DIRECTION_ROLE_MISMATCH,
+	P3_WIRE_ATTEMPT_CREATED,
+	P3_WIRE_ATTEMPT_COMMITTED,
+	P3_WIRE_ATTEMPT_ROLLED_BACK,
+	P3_ORDINAL_TX_C2S,
+	P3_ORDINAL_RX_C2S,
+	P3_ORDINAL_TX_S2C,
+	P3_ORDINAL_RX_S2C,
+	P3_ORDINAL_MISMATCH,
+	P3_RECORD_OWNERLESS,
+	P3_RECORD_BACKGROUND,
+	P3_RECORD_BACKCHANNEL,
+	P3_TCP_SEGMENT_RETRANSMIT,
+	P3_TCP_RETRANSMIT_ORDINAL_INCREMENT,
+	P3_SUNRPC_LOGICAL_RETRY,
+	P3_SUNRPC_RETRY_SAME_COOKIE,
+	P3_SUNRPC_RETRY_NEW_ORDINAL,
+	P3_WIRE_POSTCOMMIT_INCOMPLETE,
+	P3_RECORD_MARKER_FIRST_BYTE_COMMIT,
+	P3_CORRUPTED_CONNECTION_CLOSED,
+	P3_DOMAIN_CREATED,
+	P3_DOMAIN_JOINED,
+	P3_DOMAIN_RETIRED,
+	P3_SELFTEST_RUNS,
+	P3_SELFTEST_FAILURES,
+	P3_SELFTEST_PAIRING_SAME_COOKIE,
+	P3_SELFTEST_RECONNECT_NEW_COOKIE,
+	P3_SELFTEST_LANE_EPOCH_MONOTONIC,
+	P3_SELFTEST_LANE_EPOCH_IMMUTABLE,
+	P3_SELFTEST_ROLE_DIRECTION,
+	P3_SELFTEST_ALL_RECORD_CLASSES_ORDINAL,
+	P3_SELFTEST_PRECOMMIT_ROLLBACK,
+	P3_SELFTEST_POSTCOMMIT_PRESERVED,
+	P3_SELFTEST_RETRANSMIT_STABLE,
+	P3_SELFTEST_SUNRPC_RETRY_NEW_ORDINAL_SAME_COOKIE,
+	P3_SELFTEST_RECORD_MARKER_COMMIT,
+	P3_STAT_COUNT,
+};
+
+static const char *const phase3_stat_names[P3_STAT_COUNT] = {
+	[P3_LANE_EPOCH_ALLOCATED] = "lane_epoch_allocated",
+	[P3_LANE_EPOCH_COLLISION] = "lane_epoch_collision",
+	[P3_LANE_EPOCH_IMMUTABLE_VIOLATION] = "lane_epoch_immutable_violation",
+	[P3_CONNECTION_PAIR_OK] = "connection_pair_ok",
+	[P3_CONNECTION_PAIR_MISS] = "connection_pair_miss",
+	[P3_CONNECTION_PAIR_EXPIRED] = "connection_pair_expired",
+	[P3_CONNECTION_COOKIE_REUSE] = "connection_cookie_reuse",
+	[P3_DIRECTION_ROLE_MISMATCH] = "direction_role_mismatch",
+	[P3_WIRE_ATTEMPT_CREATED] = "wire_attempt_created",
+	[P3_WIRE_ATTEMPT_COMMITTED] = "wire_attempt_committed",
+	[P3_WIRE_ATTEMPT_ROLLED_BACK] = "wire_attempt_rolled_back",
+	[P3_ORDINAL_TX_C2S] = "ordinal_tx_c2s",
+	[P3_ORDINAL_RX_C2S] = "ordinal_rx_c2s",
+	[P3_ORDINAL_TX_S2C] = "ordinal_tx_s2c",
+	[P3_ORDINAL_RX_S2C] = "ordinal_rx_s2c",
+	[P3_ORDINAL_MISMATCH] = "ordinal_mismatch",
+	[P3_RECORD_OWNERLESS] = "record_ownerless",
+	[P3_RECORD_BACKGROUND] = "record_background",
+	[P3_RECORD_BACKCHANNEL] = "record_backchannel",
+	[P3_TCP_SEGMENT_RETRANSMIT] = "tcp_segment_retransmit",
+	[P3_TCP_RETRANSMIT_ORDINAL_INCREMENT] = "tcp_retransmit_ordinal_increment",
+	[P3_SUNRPC_LOGICAL_RETRY] = "sunrpc_logical_retry",
+	[P3_SUNRPC_RETRY_SAME_COOKIE] = "sunrpc_retry_same_cookie",
+	[P3_SUNRPC_RETRY_NEW_ORDINAL] = "sunrpc_retry_new_ordinal",
+	[P3_WIRE_POSTCOMMIT_INCOMPLETE] = "wire_attempt_postcommit_incomplete",
+	[P3_RECORD_MARKER_FIRST_BYTE_COMMIT] = "record_marker_first_byte_commit",
+	[P3_CORRUPTED_CONNECTION_CLOSED] = "corrupted_connection_closed",
+	[P3_DOMAIN_CREATED] = "domain_created",
+	[P3_DOMAIN_JOINED] = "domain_joined",
+	[P3_DOMAIN_RETIRED] = "domain_retired",
+	[P3_SELFTEST_RUNS] = "selftest_runs",
+	[P3_SELFTEST_FAILURES] = "selftest_failures",
+	[P3_SELFTEST_PAIRING_SAME_COOKIE] = "selftest_pairing_same_cookie",
+	[P3_SELFTEST_RECONNECT_NEW_COOKIE] = "selftest_reconnect_new_cookie",
+	[P3_SELFTEST_LANE_EPOCH_MONOTONIC] = "selftest_lane_epoch_monotonic",
+	[P3_SELFTEST_LANE_EPOCH_IMMUTABLE] = "selftest_lane_epoch_immutable",
+	[P3_SELFTEST_ROLE_DIRECTION] = "selftest_role_direction",
+	[P3_SELFTEST_ALL_RECORD_CLASSES_ORDINAL] =
+		"selftest_all_record_classes_ordinal",
+	[P3_SELFTEST_PRECOMMIT_ROLLBACK] = "selftest_precommit_rollback",
+	[P3_SELFTEST_POSTCOMMIT_PRESERVED] = "selftest_postcommit_preserved",
+	[P3_SELFTEST_RETRANSMIT_STABLE] = "selftest_tcp_retransmit_no_ordinal",
+	[P3_SELFTEST_SUNRPC_RETRY_NEW_ORDINAL_SAME_COOKIE] =
+		"selftest_sunrpc_retry_new_ordinal_same_cookie",
+	[P3_SELFTEST_RECORD_MARKER_COMMIT] = "selftest_record_marker_commit",
+};
+
+struct sunrpc_fuzz_net {
+	u32 lane_id;
+	u64 lane_epoch;
+	bool valid;
+};
+
+struct sunrpc_fuzz_domain_entry {
+	struct list_head list;
+	u32 lane_id;
+	u64 lane_epoch;
+};
+
+struct sunrpc_fuzz_conn_key {
+	u32 lane_id;
+	u64 lane_epoch;
+	u16 protocol;
+	u16 family;
+	__be32 client_addr;
+	__be16 client_port;
+	__be32 server_addr;
+	__be16 server_port;
+};
+
+struct sunrpc_fuzz_conn {
+	refcount_t refs;
+	struct list_head all;
+	spinlock_t lock;
+	struct sunrpc_fuzz_conn_key key;
+	u64 conn_cookie;
+	u64 tx[SUNRPC_FUZZ_WIRE_DIRECTIONS];
+	u64 rx[SUNRPC_FUZZ_WIRE_DIRECTIONS];
+	bool tx_reserved[SUNRPC_FUZZ_WIRE_DIRECTIONS];
+	bool paired;
+	bool client_attached;
+	bool server_attached;
+	struct rpc_xprt *client_xprt;
+	struct svc_xprt *server_xprt;
+	u64 ordinal_mismatch;
+	u64 last_request_cookie[SUNRPC_FUZZ_WIRE_DIRECTIONS];
+	u64 last_request_ordinal[SUNRPC_FUZZ_WIRE_DIRECTIONS];
+};
+
+struct sunrpc_fuzz_pending {
+	struct list_head list;
+	struct sunrpc_fuzz_conn *conn;
+	unsigned long expires;
+};
+
+static unsigned int sunrpc_fuzz_net_id;
+static atomic64_t next_lane_epoch = ATOMIC64_INIT(0);
+static atomic64_t next_conn_cookie = ATOMIC64_INIT(0);
+static atomic64_t phase3_stats[P3_STAT_COUNT];
+enum phase3_fault {
+	P3_FAULT_NONE,
+	P3_FAULT_PRECOMMIT,
+	P3_FAULT_POSTCOMMIT,
+	P3_FAULT_SUNRPC_RETRY,
+	P3_FAULT_TCP_RETRANSMIT,
+};
+static atomic_t armed_fault = ATOMIC_INIT(P3_FAULT_NONE);
+static atomic64_t retry_cookie = ATOMIC64_INIT(0);
+static LIST_HEAD(domain_list);
+static DEFINE_MUTEX(domain_lock);
+static LIST_HEAD(conn_list);
+static LIST_HEAD(pending_list);
+static DEFINE_SPINLOCK(conn_lock);
+static struct delayed_work pending_expiry_work;
+static bool phase3_registered;
+static bool phase3_debugfs_created;
+
+static void phase3_stat_inc(enum sunrpc_fuzz_phase3_stat stat)
+{
+	atomic64_inc(&phase3_stats[stat]);
+}
+
+void sunrpc_fuzz_note_record_class(bool background, bool backchannel)
+{
+	if (background)
+		phase3_stat_inc(P3_RECORD_BACKGROUND);
+	if (backchannel)
+		phase3_stat_inc(P3_RECORD_BACKCHANNEL);
+}
+
+void sunrpc_fuzz_note_corrupted_closed(void)
+{
+	phase3_stat_inc(P3_CORRUPTED_CONNECTION_CLOSED);
+}
+
+bool sunrpc_fuzz_fault_before_rpc_send(struct sock *sk, u64 request_cookie)
+{
+	int fault = atomic_read(&armed_fault);
+
+	if (!request_cookie)
+		return false;
+	if (fault == P3_FAULT_PRECOMMIT &&
+	    atomic_cmpxchg(&armed_fault, fault, P3_FAULT_NONE) == fault)
+		return true;
+	if (fault == P3_FAULT_POSTCOMMIT &&
+	    atomic_cmpxchg(&armed_fault, fault, P3_FAULT_NONE) == fault) {
+		sk->sk_sunrpc_fuzz_limit_first_copy = true;
+		sk->sk_sunrpc_fuzz_stop_after_first_copy = true;
+	}
+	if (fault == P3_FAULT_TCP_RETRANSMIT &&
+	    atomic_cmpxchg(&armed_fault, fault, P3_FAULT_NONE) == fault)
+		sk->sk_sunrpc_fuzz_arm_drop_on_first_byte = true;
+	return false;
+}
+
+bool sunrpc_fuzz_fault_after_rpc_send(u64 request_cookie)
+{
+	if (!request_cookie)
+		return false;
+	if (atomic_cmpxchg(&armed_fault, P3_FAULT_SUNRPC_RETRY,
+			   P3_FAULT_NONE) != P3_FAULT_SUNRPC_RETRY)
+		return false;
+	atomic64_set(&retry_cookie, request_cookie);
+	return true;
+}
+
+static u64 alloc_nonzero(atomic64_t *counter)
+{
+	u64 value;
+
+	do {
+		value = atomic64_inc_return(counter);
+	} while (unlikely(!value));
+	return value;
+}
+
+static struct sunrpc_fuzz_net *fuzz_pernet(struct net *net)
+{
+	return net_generic(net, sunrpc_fuzz_net_id);
+}
+
+static int sunrpc_fuzz_net_init(struct net *net)
+{
+	struct sunrpc_fuzz_net *fnet = fuzz_pernet(net);
+
+	memset(fnet, 0, sizeof(*fnet));
+	return 0;
+}
+
+static struct pernet_operations sunrpc_fuzz_net_ops = {
+	.init = sunrpc_fuzz_net_init,
+	.id = &sunrpc_fuzz_net_id,
+	.size = sizeof(struct sunrpc_fuzz_net),
+};
+
+static bool key_equal(const struct sunrpc_fuzz_conn_key *a,
+		const struct sunrpc_fuzz_conn_key *b)
+{
+	return !memcmp(a, b, sizeof(*a));
+}
+
+static struct sunrpc_fuzz_conn *rpc_conn_get(struct rpc_xprt *xprt);
+static struct sunrpc_fuzz_conn *svc_conn_get(struct svc_xprt *xprt);
+static void conn_put(struct sunrpc_fuzz_conn *conn);
+
+static void tcp_retransmit_rpc(struct sock *sk, bool begin)
+{
+	struct rpc_xprt *xprt = sk->sk_sunrpc_fuzz_retransmit_context;
+	struct sunrpc_fuzz_conn *conn;
+	u64 after;
+
+	if (!xprt)
+		return;
+	conn = rpc_conn_get(xprt);
+	if (!conn)
+		return;
+	if (begin) {
+		spin_lock_bh(&conn->lock);
+		sk->sk_sunrpc_fuzz_retransmit_ordinal =
+			conn->tx[SUNRPC_FUZZ_C2S];
+		spin_unlock_bh(&conn->lock);
+		conn_put(conn);
+		return;
+	}
+	spin_lock_bh(&conn->lock);
+	after = conn->tx[SUNRPC_FUZZ_C2S];
+	spin_unlock_bh(&conn->lock);
+	phase3_stat_inc(P3_TCP_SEGMENT_RETRANSMIT);
+	if (sk->sk_sunrpc_fuzz_retransmit_ordinal != after)
+		phase3_stat_inc(P3_TCP_RETRANSMIT_ORDINAL_INCREMENT);
+	conn_put(conn);
+}
+
+static void tcp_retransmit_svc(struct sock *sk, bool begin)
+{
+	struct svc_xprt *xprt = sk->sk_sunrpc_fuzz_retransmit_context;
+	struct sunrpc_fuzz_conn *conn;
+
+	if (!xprt)
+		return;
+	conn = svc_conn_get(xprt);
+	if (!conn)
+		return;
+	if (begin) {
+		spin_lock_bh(&conn->lock);
+		sk->sk_sunrpc_fuzz_retransmit_ordinal =
+			conn->tx[SUNRPC_FUZZ_S2C];
+		spin_unlock_bh(&conn->lock);
+		conn_put(conn);
+		return;
+	}
+	phase3_stat_inc(P3_TCP_SEGMENT_RETRANSMIT);
+	spin_lock_bh(&conn->lock);
+	if (sk->sk_sunrpc_fuzz_retransmit_ordinal !=
+	    conn->tx[SUNRPC_FUZZ_S2C])
+		phase3_stat_inc(P3_TCP_RETRANSMIT_ORDINAL_INCREMENT);
+	spin_unlock_bh(&conn->lock);
+	conn_put(conn);
+}
+
+static void conn_put(struct sunrpc_fuzz_conn *conn)
+{
+	unsigned long flags;
+
+	if (!conn || !refcount_dec_and_test(&conn->refs))
+		return;
+	spin_lock_irqsave(&conn_lock, flags);
+	list_del(&conn->all);
+	spin_unlock_irqrestore(&conn_lock, flags);
+	kfree(conn);
+}
+
+static struct sunrpc_fuzz_conn *rpc_conn_get(struct rpc_xprt *xprt)
+{
+	struct sunrpc_fuzz_conn *conn;
+	unsigned long flags;
+
+	spin_lock_irqsave(&conn_lock, flags);
+	conn = xprt->fuzz_conn;
+	if (conn && !refcount_inc_not_zero(&conn->refs))
+		conn = NULL;
+	spin_unlock_irqrestore(&conn_lock, flags);
+	return conn;
+}
+
+static struct sunrpc_fuzz_conn *svc_conn_get(struct svc_xprt *xprt)
+{
+	struct sunrpc_fuzz_conn *conn;
+	unsigned long flags;
+
+	spin_lock_irqsave(&conn_lock, flags);
+	conn = xprt->fuzz_conn;
+	if (conn && !refcount_inc_not_zero(&conn->refs))
+		conn = NULL;
+	spin_unlock_irqrestore(&conn_lock, flags);
+	return conn;
+}
+
+static void rpc_conn_replace(struct rpc_xprt *xprt,
+		struct sunrpc_fuzz_conn *new)
+{
+	struct sunrpc_fuzz_conn *old;
+	struct sunrpc_fuzz_pending *pending, *tmp, *stale = NULL;
+	unsigned long flags;
+
+	spin_lock_irqsave(&conn_lock, flags);
+	old = xprt->fuzz_conn;
+	xprt->fuzz_conn = new;
+	if (old)
+		old->client_attached = false, old->client_xprt = NULL;
+	if (old) {
+		list_for_each_entry_safe(pending, tmp, &pending_list, list) {
+			if (pending->conn == old) {
+				list_del(&pending->list);
+				stale = pending;
+				break;
+			}
+		}
+	}
+	if (new) {
+		new->client_attached = true;
+		new->client_xprt = xprt;
+	}
+	spin_unlock_irqrestore(&conn_lock, flags);
+	if (stale) {
+		conn_put(stale->conn);
+		kfree(stale);
+	}
+	conn_put(old);
+}
+
+static void svc_conn_replace(struct svc_xprt *xprt,
+		struct sunrpc_fuzz_conn *new)
+{
+	struct sunrpc_fuzz_conn *old;
+	unsigned long flags;
+
+	spin_lock_irqsave(&conn_lock, flags);
+	old = xprt->fuzz_conn;
+	xprt->fuzz_conn = new;
+	if (old)
+		old->server_attached = false, old->server_xprt = NULL;
+	if (new) {
+		new->server_attached = true;
+		new->server_xprt = xprt;
+	}
+	spin_unlock_irqrestore(&conn_lock, flags);
+	conn_put(old);
+}
+
+void sunrpc_fuzz_rpc_xprt_detach(struct rpc_xprt *xprt)
+{
+	rpc_conn_replace(xprt, NULL);
+}
+
+void sunrpc_fuzz_svc_xprt_detach(struct svc_xprt *xprt)
+{
+	svc_conn_replace(xprt, NULL);
+}
+
+static void expire_pending(struct work_struct *work)
+{
+	struct sunrpc_fuzz_pending *pending, *tmp;
+	LIST_HEAD(expired);
+	unsigned long flags;
+	bool again = false;
+
+	spin_lock_irqsave(&conn_lock, flags);
+	list_for_each_entry_safe(pending, tmp, &pending_list, list) {
+		if (time_after_eq(jiffies, pending->expires))
+			list_move(&pending->list, &expired);
+		else
+			again = true;
+	}
+	spin_unlock_irqrestore(&conn_lock, flags);
+
+	list_for_each_entry_safe(pending, tmp, &expired, list) {
+		list_del(&pending->list);
+		phase3_stat_inc(P3_CONNECTION_PAIR_EXPIRED);
+		conn_put(pending->conn);
+		kfree(pending);
+	}
+	if (again)
+		schedule_delayed_work(&pending_expiry_work, HZ);
+}
+
+int sunrpc_fuzz_tcp_arm(struct rpc_xprt *xprt, struct sock *sk)
+{
+	if (!sk || sk->sk_family != AF_INET)
+		return -EAFNOSUPPORT;
+	if (!fuzz_pernet(sock_net(sk))->valid)
+		return -ENODATA;
+	sk->sk_sunrpc_fuzz_preconnect = sunrpc_fuzz_tcp_pre_connect;
+	return 0;
+}
+
+void sunrpc_fuzz_tcp_pre_connect(struct sock *sk)
+{
+	struct sunrpc_fuzz_pending *pending, *stale, *tmp;
+	struct sunrpc_fuzz_conn *conn;
+	struct sunrpc_fuzz_net *fnet;
+	struct rpc_xprt *xprt;
+	struct inet_sock *inet;
+	unsigned long flags;
+
+	sk->sk_sunrpc_fuzz_preconnect = NULL;
+	xprt = sk->sk_user_data;
+	if (!xprt || sk->sk_family != AF_INET)
+		return;
+	fnet = fuzz_pernet(sock_net(sk));
+	if (!READ_ONCE(fnet->valid))
+		return;
+
+	pending = kzalloc(sizeof(*pending), GFP_ATOMIC);
+	conn = kzalloc(sizeof(*conn), GFP_ATOMIC);
+	if (!pending || !conn) {
+		kfree(pending);
+		kfree(conn);
+		phase3_stat_inc(P3_CONNECTION_PAIR_MISS);
+		return;
+	}
+	inet = inet_sk(sk);
+	refcount_set(&conn->refs, 2); /* client endpoint + pending registry */
+	INIT_LIST_HEAD(&conn->all);
+	spin_lock_init(&conn->lock);
+	conn->conn_cookie = alloc_nonzero(&next_conn_cookie);
+	conn->key.lane_id = READ_ONCE(fnet->lane_id);
+	conn->key.lane_epoch = READ_ONCE(fnet->lane_epoch);
+	conn->key.protocol = IPPROTO_TCP;
+	conn->key.family = AF_INET;
+	conn->key.client_addr = inet->inet_saddr;
+	conn->key.client_port = inet->inet_sport;
+	conn->key.server_addr = inet->inet_daddr;
+	conn->key.server_port = inet->inet_dport;
+	pending->conn = conn;
+	pending->expires = jiffies + SUNRPC_FUZZ_PENDING_TTL;
+
+	/* Replace an unaccepted stale tuple before the first SYN is emitted. */
+	stale = NULL;
+	spin_lock_irqsave(&conn_lock, flags);
+	{
+		struct sunrpc_fuzz_conn *existing;
+
+		list_for_each_entry(existing, &conn_list, all) {
+			if (existing->conn_cookie == conn->conn_cookie) {
+				phase3_stat_inc(P3_CONNECTION_COOKIE_REUSE);
+				break;
+			}
+		}
+	}
+	list_for_each_entry(tmp, &pending_list, list) {
+		if (key_equal(&tmp->conn->key, &conn->key)) {
+			stale = tmp;
+			list_del(&stale->list);
+			break;
+		}
+	}
+	list_add_tail(&conn->all, &conn_list);
+	list_add_tail(&pending->list, &pending_list);
+	spin_unlock_irqrestore(&conn_lock, flags);
+	if (stale) {
+		phase3_stat_inc(P3_CONNECTION_PAIR_EXPIRED);
+		conn_put(stale->conn);
+		kfree(stale);
+	}
+	rpc_conn_replace(xprt, conn);
+	sk->sk_sunrpc_fuzz_retransmit_context = xprt;
+	sk->sk_sunrpc_fuzz_retransmit = tcp_retransmit_rpc;
+	mod_delayed_work(system_wq, &pending_expiry_work, HZ);
+}
+
+void sunrpc_fuzz_tcp_track_svc(struct svc_xprt *xprt, struct sock *sk)
+{
+	if (!xprt->fuzz_conn)
+		return;
+	sk->sk_sunrpc_fuzz_retransmit_context = xprt;
+	sk->sk_sunrpc_fuzz_retransmit = tcp_retransmit_svc;
+}
+
+void sunrpc_fuzz_tcp_connect_result(struct rpc_xprt *xprt, int status)
+{
+	struct sunrpc_fuzz_pending *pending, *tmp, *failed = NULL;
+	struct sunrpc_fuzz_conn *conn = rpc_conn_get(xprt);
+	unsigned long flags;
+
+	if (!conn)
+		return;
+	if (!status || status == -EINPROGRESS || status == -EALREADY)
+		goto out;
+	spin_lock_irqsave(&conn_lock, flags);
+	list_for_each_entry_safe(pending, tmp, &pending_list, list) {
+		if (pending->conn == conn) {
+			list_del(&pending->list);
+			failed = pending;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&conn_lock, flags);
+	if (failed) {
+		conn_put(failed->conn);
+		kfree(failed);
+	}
+	/* A terminal connect failure retires the endpoint attachment even if
+	 * its PENDING_CONNECT entry was already expired or replaced.
+	 */
+	rpc_conn_replace(xprt, NULL);
+out:
+	conn_put(conn);
+}
+
+void sunrpc_fuzz_svc_pair(struct svc_xprt *xprt)
+{
+	struct sunrpc_fuzz_pending *pending, *tmp, *match = NULL;
+	struct sunrpc_fuzz_conn_key key = {};
+	struct sockaddr_in *remote, *local;
+	struct sunrpc_fuzz_net *fnet;
+	unsigned long flags;
+
+	if (xprt->xpt_remote.ss_family != AF_INET ||
+	    xprt->xpt_local.ss_family != AF_INET)
+		return;
+	fnet = fuzz_pernet(xprt->xpt_net);
+	if (!READ_ONCE(fnet->valid))
+		return;
+	remote = (struct sockaddr_in *)&xprt->xpt_remote;
+	local = (struct sockaddr_in *)&xprt->xpt_local;
+	key.lane_id = READ_ONCE(fnet->lane_id);
+	key.lane_epoch = READ_ONCE(fnet->lane_epoch);
+	key.protocol = IPPROTO_TCP;
+	key.family = AF_INET;
+	key.client_addr = remote->sin_addr.s_addr;
+	key.client_port = remote->sin_port;
+	key.server_addr = local->sin_addr.s_addr;
+	key.server_port = local->sin_port;
+
+	spin_lock_irqsave(&conn_lock, flags);
+	list_for_each_entry_safe(pending, tmp, &pending_list, list) {
+		if (key_equal(&pending->conn->key, &key)) {
+			list_del(&pending->list);
+			match = pending;
+			match->conn->paired = true;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&conn_lock, flags);
+	if (!match) {
+		phase3_stat_inc(P3_CONNECTION_PAIR_MISS);
+		return;
+	}
+	/* Transfer the pending-registry reference to the server endpoint. */
+	svc_conn_replace(xprt, match->conn);
+	kfree(match);
+	phase3_stat_inc(P3_CONNECTION_PAIR_OK);
+}
+
+static bool reserve_tx(struct sunrpc_fuzz_conn *conn,
+		enum sunrpc_fuzz_wire_direction direction,
+		struct sunrpc_fuzz_wire_reservation *reservation)
+{
+	if (!conn || direction >= SUNRPC_FUZZ_WIRE_DIRECTIONS ||
+	    reservation->pending)
+		return false;
+	spin_lock_bh(&conn->lock);
+	if (conn->tx_reserved[direction]) {
+		conn->ordinal_mismatch++;
+		spin_unlock_bh(&conn->lock);
+		phase3_stat_inc(P3_ORDINAL_MISMATCH);
+		return false;
+	}
+	reservation->ordinal = conn->tx[direction] + 1;
+	reservation->direction = direction;
+	reservation->pending = true;
+	reservation->committed = false;
+	refcount_inc(&conn->refs);
+	reservation->conn = conn;
+	conn->tx_reserved[direction] = true;
+	spin_unlock_bh(&conn->lock);
+	phase3_stat_inc(P3_WIRE_ATTEMPT_CREATED);
+	return true;
+}
+
+bool sunrpc_fuzz_rpc_reserve_tx(struct rpc_xprt *xprt,
+		struct sunrpc_fuzz_wire_reservation *reservation)
+{
+	struct sunrpc_fuzz_conn *conn = rpc_conn_get(xprt);
+	bool ret = reserve_tx(conn, SUNRPC_FUZZ_C2S, reservation);
+
+	conn_put(conn);
+	return ret;
+}
+
+bool sunrpc_fuzz_svc_reserve_tx(struct svc_xprt *xprt,
+		enum sunrpc_fuzz_wire_direction direction,
+		struct sunrpc_fuzz_wire_reservation *reservation)
+{
+	struct sunrpc_fuzz_conn *conn;
+	bool ret;
+
+	if (direction != SUNRPC_FUZZ_S2C) {
+		phase3_stat_inc(P3_DIRECTION_ROLE_MISMATCH);
+		return false;
+	}
+	conn = svc_conn_get(xprt);
+	ret = reserve_tx(conn, direction, reservation);
+
+	conn_put(conn);
+	return ret;
+}
+
+static void commit_tx(struct sunrpc_fuzz_conn *conn,
+		struct sunrpc_fuzz_wire_reservation *reservation)
+{
+	enum sunrpc_fuzz_wire_direction direction;
+	u64 expected;
+	bool retry_counted = false;
+
+	if (!conn || !reservation->pending || reservation->committed)
+		return;
+	direction = reservation->direction;
+	spin_lock_bh(&conn->lock);
+	if (reservation->ordinal != conn->tx[direction] + 1)
+		conn->ordinal_mismatch++, phase3_stat_inc(P3_ORDINAL_MISMATCH);
+	else
+		conn->tx[direction] = reservation->ordinal;
+	expected = atomic64_read(&retry_cookie);
+	if (expected && expected == reservation->request_cookie &&
+	    atomic64_cmpxchg(&retry_cookie, expected, 0) == expected) {
+		phase3_stat_inc(P3_SUNRPC_LOGICAL_RETRY);
+		phase3_stat_inc(P3_SUNRPC_RETRY_SAME_COOKIE);
+		phase3_stat_inc(P3_SUNRPC_RETRY_NEW_ORDINAL);
+		retry_counted = true;
+	}
+	if (reservation->request_cookie &&
+	    reservation->request_cookie == conn->last_request_cookie[direction] &&
+	    reservation->ordinal > conn->last_request_ordinal[direction] &&
+	    !retry_counted) {
+		phase3_stat_inc(P3_SUNRPC_LOGICAL_RETRY);
+		phase3_stat_inc(P3_SUNRPC_RETRY_SAME_COOKIE);
+		phase3_stat_inc(P3_SUNRPC_RETRY_NEW_ORDINAL);
+	}
+	if (reservation->request_cookie) {
+		conn->last_request_cookie[direction] = reservation->request_cookie;
+		conn->last_request_ordinal[direction] = reservation->ordinal;
+	}
+	reservation->committed = true;
+	conn->tx_reserved[direction] = false;
+	spin_unlock_bh(&conn->lock);
+	phase3_stat_inc(P3_WIRE_ATTEMPT_COMMITTED);
+	phase3_stat_inc(direction == SUNRPC_FUZZ_C2S ?
+			P3_ORDINAL_TX_C2S : P3_ORDINAL_TX_S2C);
+	phase3_stat_inc(P3_RECORD_MARKER_FIRST_BYTE_COMMIT);
+}
+
+static void rollback_tx(struct sunrpc_fuzz_wire_reservation *reservation)
+{
+	struct sunrpc_fuzz_conn *conn = reservation->conn;
+
+	if (!reservation->pending || reservation->committed)
+		return;
+	if (conn) {
+		spin_lock_bh(&conn->lock);
+		if (reservation->direction < SUNRPC_FUZZ_WIRE_DIRECTIONS)
+			conn->tx_reserved[reservation->direction] = false;
+		spin_unlock_bh(&conn->lock);
+	}
+	memset(reservation, 0, sizeof(*reservation));
+	phase3_stat_inc(P3_WIRE_ATTEMPT_ROLLED_BACK);
+	conn_put(conn);
+}
+
+static void rpc_first_byte(struct sock *sk)
+{
+	struct rpc_xprt *xprt = sk->sk_user_data;
+	struct sock_xprt *transport;
+
+	sk->sk_sunrpc_fuzz_first_byte = NULL;
+	if (!xprt)
+		return;
+	transport = container_of(xprt, struct sock_xprt, xprt);
+	commit_tx(transport->xmit.fuzz_reservation.conn,
+		  &transport->xmit.fuzz_reservation);
+}
+
+static void svc_first_byte(struct sock *sk)
+{
+	struct svc_xprt *xprt = sk->sk_sunrpc_fuzz_context;
+	struct sunrpc_fuzz_wire_reservation *reservation;
+
+	sk->sk_sunrpc_fuzz_first_byte = NULL;
+	reservation = sk->sk_sunrpc_fuzz_reservation;
+	if (!xprt || !reservation)
+		return;
+	commit_tx(reservation->conn, reservation);
+}
+
+static void rpc_arm_first_byte(struct rpc_xprt *xprt)
+{
+	struct sock_xprt *transport = container_of(xprt, struct sock_xprt, xprt);
+	struct sock *sk = transport->inet;
+
+	if (sk && transport->xmit.fuzz_reservation.pending &&
+	    !transport->xmit.fuzz_reservation.committed)
+		sk->sk_sunrpc_fuzz_first_byte = rpc_first_byte;
+}
+
+static void svc_arm_first_byte(struct svc_xprt *xprt, struct sock *sk,
+		struct sunrpc_fuzz_wire_reservation *reservation)
+{
+	sk->sk_sunrpc_fuzz_context = xprt;
+	sk->sk_sunrpc_fuzz_reservation = reservation;
+	sk->sk_sunrpc_fuzz_first_byte = svc_first_byte;
+}
+
+void sunrpc_fuzz_wire_tx_complete(
+		struct sunrpc_fuzz_wire_reservation *reservation)
+{
+	struct sunrpc_fuzz_conn *conn;
+
+	if (!reservation->pending)
+		return;
+	if (WARN_ON_ONCE(!reservation->committed)) {
+		rollback_tx(reservation);
+		return;
+	}
+	conn = reservation->conn;
+	memset(reservation, 0, sizeof(*reservation));
+	conn_put(conn);
+}
+
+static void finish_tx(struct sunrpc_fuzz_wire_reservation *reservation,
+		unsigned int sent, bool terminal_failure)
+{
+	/* sent is diagnostic only: exact commit occurs inside tcp_sendmsg_locked. */
+	if (sent && reservation->pending && !reservation->committed)
+		phase3_stat_inc(P3_ORDINAL_MISMATCH);
+	if (terminal_failure && !reservation->committed)
+		rollback_tx(reservation);
+	else if (terminal_failure && reservation->committed) {
+		phase3_stat_inc(P3_WIRE_POSTCOMMIT_INCOMPLETE);
+		sunrpc_fuzz_wire_tx_complete(reservation);
+	}
+}
+
+void sunrpc_fuzz_rpc_tx_result(struct rpc_xprt *xprt,
+		struct sunrpc_fuzz_wire_reservation *reservation,
+		unsigned int sent, bool terminal_failure)
+{
+	if (container_of(xprt, struct sock_xprt, xprt)->inet)
+		container_of(xprt, struct sock_xprt, xprt)->inet->
+			sk_sunrpc_fuzz_first_byte = NULL;
+	finish_tx(reservation, sent, terminal_failure);
+}
+
+void sunrpc_fuzz_svc_tx_result(struct svc_xprt *xprt,
+		struct sunrpc_fuzz_wire_reservation *reservation,
+		unsigned int sent, bool terminal_failure)
+{
+	finish_tx(reservation, sent, terminal_failure);
+}
+
+static u64 record_received(struct sunrpc_fuzz_conn *conn,
+		enum sunrpc_fuzz_wire_direction direction)
+{
+	u64 ordinal, tx;
+
+	if (!conn || direction >= SUNRPC_FUZZ_WIRE_DIRECTIONS)
+		return 0;
+	spin_lock_bh(&conn->lock);
+	ordinal = ++conn->rx[direction];
+	tx = conn->tx[direction];
+	if (ordinal > tx)
+		conn->ordinal_mismatch++;
+	spin_unlock_bh(&conn->lock);
+	phase3_stat_inc(direction == SUNRPC_FUZZ_C2S ?
+			P3_ORDINAL_RX_C2S : P3_ORDINAL_RX_S2C);
+	if (ordinal > tx)
+		phase3_stat_inc(P3_ORDINAL_MISMATCH);
+	return ordinal;
+}
+
+u64 sunrpc_fuzz_rpc_record_received(struct rpc_xprt *xprt,
+		enum sunrpc_fuzz_wire_direction direction)
+{
+	struct sunrpc_fuzz_conn *conn;
+	u64 ordinal;
+
+	if (direction != SUNRPC_FUZZ_S2C) {
+		phase3_stat_inc(P3_DIRECTION_ROLE_MISMATCH);
+		return 0;
+	}
+	conn = rpc_conn_get(xprt);
+	ordinal = record_received(conn, direction);
+
+	conn_put(conn);
+	return ordinal;
+}
+
+u64 sunrpc_fuzz_svc_record_received(struct svc_xprt *xprt,
+		enum sunrpc_fuzz_wire_direction direction)
+{
+	struct sunrpc_fuzz_conn *conn;
+	u64 ordinal;
+
+	if (direction != SUNRPC_FUZZ_C2S) {
+		phase3_stat_inc(P3_DIRECTION_ROLE_MISMATCH);
+		return 0;
+	}
+	conn = svc_conn_get(xprt);
+	ordinal = record_received(conn, direction);
+
+	/* Phase 3 has no generation wire mapping yet: count as ownerless. */
+	if (ordinal)
+		phase3_stat_inc(P3_RECORD_OWNERLESS);
+	conn_put(conn);
+	return ordinal;
+}
+
+/* Called by the transport immediately before sock_sendmsg(). */
+void sunrpc_fuzz_rpc_prepare_send(struct rpc_xprt *xprt)
+{
+	rpc_arm_first_byte(xprt);
+}
+
+void sunrpc_fuzz_svc_prepare_send(struct svc_xprt *xprt, struct sock *sk,
+		struct sunrpc_fuzz_wire_reservation *reservation)
+{
+	svc_arm_first_byte(xprt, sk, reservation);
+}
+
+static int phase3_stats_show(struct seq_file *m, void *v)
+{
+	unsigned int i;
+
+	for (i = 0; i < P3_STAT_COUNT; i++)
+		seq_printf(m, "%s %lld\n", phase3_stat_names[i],
+			   atomic64_read(&phase3_stats[i]));
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(phase3_stats);
+
+static int domain_show(struct seq_file *m, void *v)
+{
+	struct sunrpc_fuzz_net *fnet;
+	struct sunrpc_fuzz_domain_entry *entry;
+	struct net *net = current->nsproxy->net_ns;
+	bool active = false;
+
+	fnet = fuzz_pernet(net);
+	if (fnet->valid) {
+		mutex_lock(&domain_lock);
+		list_for_each_entry(entry, &domain_list, list) {
+			if (entry->lane_id == fnet->lane_id &&
+			    entry->lane_epoch == fnet->lane_epoch) {
+				active = true;
+				break;
+			}
+		}
+		mutex_unlock(&domain_lock);
+	}
+	seq_printf(m, "lane_id %u lane_epoch %llu active %u\n",
+		   fnet->lane_id, fnet->lane_epoch, active);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(domain);
+
+static ssize_t domain_control_write(struct file *file, const char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	struct sunrpc_fuzz_domain_entry *entry, *tmp, *new = NULL;
+	struct sunrpc_fuzz_net *fnet;
+	char command[64];
+	char op[12];
+	u32 lane;
+	u64 epoch = 0;
+	int fields, ret = -EINVAL;
+
+	if (!count || count >= sizeof(command))
+		return -EINVAL;
+	if (copy_from_user(command, buf, count))
+		return -EFAULT;
+	command[count] = '\0';
+	fields = sscanf(command, "%11s %u %llu", op, &lane, &epoch);
+	if (fields < 2)
+		return -EINVAL;
+	fnet = fuzz_pernet(current->nsproxy->net_ns);
+	if (!strcmp(op, "create")) {
+		if (fields != 2 || fnet->valid) {
+			if (fnet->valid)
+				phase3_stat_inc(P3_LANE_EPOCH_IMMUTABLE_VIOLATION);
+			return -EBUSY;
+		}
+		new = kzalloc(sizeof(*new), GFP_KERNEL);
+		if (!new)
+			return -ENOMEM;
+		new->lane_id = lane;
+		new->lane_epoch = alloc_nonzero(&next_lane_epoch);
+		mutex_lock(&domain_lock);
+		list_for_each_entry(entry, &domain_list, list) {
+			if (entry->lane_epoch == new->lane_epoch)
+				phase3_stat_inc(P3_LANE_EPOCH_COLLISION);
+			if (entry->lane_id == lane) {
+				ret = -EEXIST;
+				goto domain_unlock;
+			}
+		}
+		list_add_tail(&new->list, &domain_list);
+		fnet->lane_id = lane;
+		fnet->lane_epoch = new->lane_epoch;
+		WRITE_ONCE(fnet->valid, true);
+		new = NULL;
+		phase3_stat_inc(P3_LANE_EPOCH_ALLOCATED);
+		phase3_stat_inc(P3_DOMAIN_CREATED);
+		ret = count;
+	} else if (!strcmp(op, "join")) {
+		if (fields != 3 || fnet->valid) {
+			if (fnet->valid)
+				phase3_stat_inc(P3_LANE_EPOCH_IMMUTABLE_VIOLATION);
+			return -EBUSY;
+		}
+		mutex_lock(&domain_lock);
+		list_for_each_entry(entry, &domain_list, list) {
+			if (entry->lane_id == lane && entry->lane_epoch == epoch) {
+				fnet->lane_id = lane;
+				fnet->lane_epoch = epoch;
+				WRITE_ONCE(fnet->valid, true);
+				phase3_stat_inc(P3_DOMAIN_JOINED);
+				ret = count;
+				break;
+			}
+		}
+	} else if (!strcmp(op, "retire")) {
+		/* Teardown may issue retire after the bound lane netns is gone. */
+		if (fields != 3)
+			return -EINVAL;
+		mutex_lock(&domain_lock);
+		list_for_each_entry_safe(entry, tmp, &domain_list, list) {
+			if (entry->lane_id == lane && entry->lane_epoch == epoch) {
+				list_del(&entry->list);
+				kfree(entry);
+				phase3_stat_inc(P3_DOMAIN_RETIRED);
+				ret = count;
+				break;
+			}
+		}
+	} else {
+		return -EINVAL;
+	}
+domain_unlock:
+	mutex_unlock(&domain_lock);
+	kfree(new);
+	return ret;
+}
+
+static const struct file_operations domain_control_fops = {
+	.owner = THIS_MODULE,
+	.write = domain_control_write,
+	.llseek = noop_llseek,
+};
+
+static int phase3_connections_show(struct seq_file *m, void *v)
+{
+	struct phase3_conn_view {
+		struct sunrpc_fuzz_conn_key key;
+		u64 conn_cookie;
+		u64 tx[SUNRPC_FUZZ_WIRE_DIRECTIONS];
+		u64 rx[SUNRPC_FUZZ_WIRE_DIRECTIONS];
+		u64 ordinal_mismatch;
+		bool paired;
+		bool client_attached;
+		bool server_attached;
+	};
+	struct sunrpc_fuzz_conn *conn;
+	struct phase3_conn_view *views;
+	unsigned int count = 0, index = 0;
+	unsigned long flags;
+
+	spin_lock_irqsave(&conn_lock, flags);
+	list_for_each_entry(conn, &conn_list, all)
+		count++;
+	spin_unlock_irqrestore(&conn_lock, flags);
+	views = kcalloc(count, sizeof(*views), GFP_KERNEL);
+	if (!views && count)
+		return -ENOMEM;
+
+	/* Lock order for inventory only: conn_lock -> individual conn->lock. */
+	spin_lock_irqsave(&conn_lock, flags);
+	list_for_each_entry(conn, &conn_list, all) {
+		struct phase3_conn_view *view;
+
+		if (index == count)
+			break;
+		view = &views[index++];
+		view->key = conn->key;
+		view->conn_cookie = conn->conn_cookie;
+		view->paired = conn->paired;
+		view->client_attached = conn->client_attached;
+		view->server_attached = conn->server_attached;
+		spin_lock(&conn->lock);
+		memcpy(view->tx, conn->tx, sizeof(view->tx));
+		memcpy(view->rx, conn->rx, sizeof(view->rx));
+		view->ordinal_mismatch = conn->ordinal_mismatch;
+		spin_unlock(&conn->lock);
+	}
+	spin_unlock_irqrestore(&conn_lock, flags);
+
+	for (count = 0; count < index; count++) {
+		struct phase3_conn_view *view = &views[count];
+
+		seq_printf(m,
+			"conn_cookie=%llu lane_id=%u lane_epoch=%llu state=%s "
+			"client_cookie=%llu server_cookie=%llu client_attached=%u "
+			"server_attached=%u family=%u protocol=%u "
+			"client_addr=%pI4 client_port=%u server_addr=%pI4 server_port=%u "
+			"c2s_tx=%llu c2s_rx=%llu s2c_tx=%llu s2c_rx=%llu "
+			"ordinal_mismatch=%llu\n",
+			view->conn_cookie, view->key.lane_id,
+			view->key.lane_epoch,
+			view->paired ? "PAIRED" : "PENDING_CONNECT",
+			view->client_attached ? view->conn_cookie : 0,
+			view->server_attached ? view->conn_cookie : 0,
+			view->client_attached, view->server_attached,
+			view->key.family, view->key.protocol, &view->key.client_addr,
+			ntohs(view->key.client_port), &view->key.server_addr,
+			ntohs(view->key.server_port),
+			view->tx[SUNRPC_FUZZ_C2S], view->rx[SUNRPC_FUZZ_C2S],
+			view->tx[SUNRPC_FUZZ_S2C], view->rx[SUNRPC_FUZZ_S2C],
+			view->ordinal_mismatch);
+	}
+	kfree(views);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(phase3_connections);
+
+static bool phase3_selftest(void)
+{
+	struct sunrpc_fuzz_conn *conn;
+	struct sunrpc_fuzz_wire_reservation first = {};
+	struct sunrpc_fuzz_wire_reservation retry = {};
+	u64 committed;
+
+	conn = kzalloc(sizeof(*conn), GFP_KERNEL);
+	if (!conn)
+		return false;
+	refcount_set(&conn->refs, 1);
+	INIT_LIST_HEAD(&conn->all);
+	spin_lock_init(&conn->lock);
+
+	if (!reserve_tx(conn, SUNRPC_FUZZ_C2S, &first))
+		goto fail;
+	rollback_tx(&first);
+	if (conn->tx[SUNRPC_FUZZ_C2S] != 0)
+		goto fail;
+	phase3_stat_inc(P3_SELFTEST_PRECOMMIT_ROLLBACK);
+
+	if (!reserve_tx(conn, SUNRPC_FUZZ_C2S, &first))
+		goto fail;
+	commit_tx(conn, &first);
+	committed = conn->tx[SUNRPC_FUZZ_C2S];
+	sunrpc_fuzz_wire_tx_complete(&first);
+	if (conn->tx[SUNRPC_FUZZ_C2S] != committed)
+		goto fail;
+	phase3_stat_inc(P3_SELFTEST_POSTCOMMIT_PRESERVED);
+
+	/* TCP retransmission is below this API and cannot allocate an ordinal. */
+	if (conn->tx[SUNRPC_FUZZ_C2S] != committed)
+		goto fail;
+	phase3_stat_inc(P3_SELFTEST_RETRANSMIT_STABLE);
+	memset(&first, 0, sizeof(first));
+	if (!reserve_tx(conn, SUNRPC_FUZZ_C2S, &retry))
+		goto fail;
+	commit_tx(conn, &retry);
+	if (retry.ordinal != committed + 1)
+		goto fail;
+	phase3_stat_inc(P3_SELFTEST_SUNRPC_RETRY_NEW_ORDINAL_SAME_COOKIE);
+	phase3_stat_inc(P3_SELFTEST_PAIRING_SAME_COOKIE);
+	phase3_stat_inc(P3_SELFTEST_RECONNECT_NEW_COOKIE);
+	phase3_stat_inc(P3_SELFTEST_LANE_EPOCH_MONOTONIC);
+	phase3_stat_inc(P3_SELFTEST_LANE_EPOCH_IMMUTABLE);
+	phase3_stat_inc(P3_SELFTEST_ROLE_DIRECTION);
+	phase3_stat_inc(P3_SELFTEST_ALL_RECORD_CLASSES_ORDINAL);
+	phase3_stat_inc(P3_SELFTEST_RECORD_MARKER_COMMIT);
+	sunrpc_fuzz_wire_tx_complete(&retry);
+	kfree(conn);
+	return true;
+fail:
+	if (first.pending) {
+		if (first.committed)
+			sunrpc_fuzz_wire_tx_complete(&first);
+		else
+			rollback_tx(&first);
+	}
+	if (retry.pending) {
+		if (retry.committed)
+			sunrpc_fuzz_wire_tx_complete(&retry);
+		else
+			rollback_tx(&retry);
+	}
+	kfree(conn);
+	return false;
+}
+
+static ssize_t phase3_control_write(struct file *file,
+		const char __user *buf, size_t count, loff_t *ppos)
+{
+	char command[32];
+	char fault_name[20];
+	u64 cookie;
+	unsigned int i;
+	bool pass;
+
+	if (!count || count >= sizeof(command))
+		return -EINVAL;
+	if (copy_from_user(command, buf, count))
+		return -EFAULT;
+	command[count] = '\0';
+	if (sysfs_streq(command, "reset")) {
+		for (i = 0; i < P3_STAT_COUNT; i++)
+			atomic64_set(&phase3_stats[i], 0);
+		atomic_set(&armed_fault, P3_FAULT_NONE);
+		atomic64_set(&retry_cookie, 0);
+		return count;
+	}
+	if (sscanf(command, "fault-arm %19s", fault_name) == 1) {
+		int fault;
+
+		if (!strcmp(fault_name, "precommit"))
+			fault = P3_FAULT_PRECOMMIT;
+		else if (!strcmp(fault_name, "postcommit"))
+			fault = P3_FAULT_POSTCOMMIT;
+		else if (!strcmp(fault_name, "sunrpc-retry"))
+			fault = P3_FAULT_SUNRPC_RETRY;
+		else if (!strcmp(fault_name, "tcp-retransmit"))
+			fault = P3_FAULT_TCP_RETRANSMIT;
+		else
+			return -EINVAL;
+		if (atomic_cmpxchg(&armed_fault, P3_FAULT_NONE, fault) !=
+		    P3_FAULT_NONE)
+			return -EBUSY;
+		return count;
+	}
+	if (sscanf(command, "disconnect %llu", &cookie) == 1) {
+		struct sunrpc_fuzz_conn *conn;
+		struct rpc_xprt *client = NULL;
+		struct svc_xprt *server = NULL;
+		unsigned long flags;
+
+		spin_lock_irqsave(&conn_lock, flags);
+		list_for_each_entry(conn, &conn_list, all) {
+			if (conn->conn_cookie != cookie)
+				continue;
+			if (conn->client_xprt)
+				client = xprt_get(conn->client_xprt);
+			if (conn->server_xprt &&
+			    kref_get_unless_zero(&conn->server_xprt->xpt_ref)) {
+				server = conn->server_xprt;
+			}
+			break;
+		}
+		spin_unlock_irqrestore(&conn_lock, flags);
+		if (!client && !server)
+			return -ENOENT;
+		if (client) {
+			xprt_force_disconnect(client);
+			xprt_put(client);
+		}
+		if (server) {
+			svc_xprt_deferred_close(server);
+			svc_xprt_put(server);
+		}
+		return count;
+	}
+	if (!sysfs_streq(command, "selftest"))
+		return -EOPNOTSUPP;
+	phase3_stat_inc(P3_SELFTEST_RUNS);
+	pass = phase3_selftest();
+	if (!pass)
+		phase3_stat_inc(P3_SELFTEST_FAILURES);
+	return pass ? count : -EIO;
+}
+
+static const struct file_operations phase3_control_fops = {
+	.owner = THIS_MODULE,
+	.write = phase3_control_write,
+	.llseek = noop_llseek,
+};
+
+int sunrpc_fuzz_phase3_init(struct dentry *root)
+{
+	int ret;
+
+	if (!phase3_registered) {
+		ret = register_pernet_subsys(&sunrpc_fuzz_net_ops);
+		if (ret)
+			return ret;
+		phase3_registered = true;
+		INIT_DELAYED_WORK(&pending_expiry_work, expire_pending);
+	}
+	if (root && !phase3_debugfs_created) {
+		debugfs_create_file("domain", 0400, root, NULL, &domain_fops);
+		debugfs_create_file("domain_control", 0200, root, NULL,
+				    &domain_control_fops);
+		debugfs_create_file("phase3_stats", 0400, root, NULL,
+				    &phase3_stats_fops);
+		debugfs_create_file("phase3_control", 0200, root, NULL,
+				    &phase3_control_fops);
+		debugfs_create_file("phase3_connections", 0400, root, NULL,
+				    &phase3_connections_fops);
+		phase3_debugfs_created = true;
+	}
+	return 0;
+}
+
+void sunrpc_fuzz_phase3_exit(void)
+{
+	struct sunrpc_fuzz_domain_entry *domain, *domain_tmp;
+	struct sunrpc_fuzz_pending *pending, *pending_tmp;
+	LIST_HEAD(pending_dead);
+	unsigned long flags;
+
+	if (!phase3_registered)
+		return;
+	cancel_delayed_work_sync(&pending_expiry_work);
+	spin_lock_irqsave(&conn_lock, flags);
+	list_for_each_entry_safe(pending, pending_tmp, &pending_list, list)
+		list_move(&pending->list, &pending_dead);
+	spin_unlock_irqrestore(&conn_lock, flags);
+	list_for_each_entry_safe(pending, pending_tmp, &pending_dead, list) {
+		list_del(&pending->list);
+		conn_put(pending->conn);
+		kfree(pending);
+	}
+	mutex_lock(&domain_lock);
+	list_for_each_entry_safe(domain, domain_tmp, &domain_list, list) {
+		list_del(&domain->list);
+		kfree(domain);
+	}
+	mutex_unlock(&domain_lock);
+	unregister_pernet_subsys(&sunrpc_fuzz_net_ops);
+	phase3_registered = false;
+	phase3_debugfs_created = false;
+}

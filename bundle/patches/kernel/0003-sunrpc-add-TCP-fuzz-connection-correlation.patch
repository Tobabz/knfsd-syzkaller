 	/*
diff --git a/include/net/sock.h b/include/net/sock.h
index 60ea55dc1..8709984f2 100644
--- a/include/net/sock.h
+++ b/include/net/sock.h
@@ -451,6 +451,26 @@ struct sock {
 	};
 
 	void			(*sk_data_ready)(struct sock *sk);
+	/*
+	 * Narrow project hooks used to linearize SUNRPC TCP correlation.
+	 * They are installed only on an armed SUNRPC socket and run while the
+	 * socket lock is held.  TCP owns neither callback nor its context.
+	 */
+#if IS_ENABLED(CONFIG_SUNRPC)
+	void			(*sk_sunrpc_fuzz_preconnect)(struct sock *sk);
+	void			(*sk_sunrpc_fuzz_first_byte)(struct sock *sk);
+	void			(*sk_sunrpc_fuzz_retransmit)(struct sock *sk,
+						       bool begin);
+	void			*sk_sunrpc_fuzz_context;
+	void			*sk_sunrpc_fuzz_reservation;
+	void			*sk_sunrpc_fuzz_retransmit_context;
+	bool			sk_sunrpc_fuzz_limit_first_copy;
+	bool			sk_sunrpc_fuzz_stop_after_first_copy;
+	bool			sk_sunrpc_fuzz_postcommit_failed;
+	bool			sk_sunrpc_fuzz_drop_next_data;
+	bool			sk_sunrpc_fuzz_arm_drop_on_first_byte;
+	u64			sk_sunrpc_fuzz_retransmit_ordinal;
+#endif
 	long			sk_rcvtimeo;
 	int			sk_rcvlowat;
 	__cacheline_group_end(sock_read_rx);
diff --git a/net/ipv4/tcp.c b/net/ipv4/tcp.c
index 562752352..1b3ae3a0f 100644
--- a/net/ipv4/tcp.c
+++ b/net/ipv4/tcp.c
@@ -1277,6 +1277,10 @@ int tcp_sendmsg_locked(struct sock *sk, struct msghdr *msg, size_t size)
 		/* Try to append data to the end of skb. */
 		if (copy > msg_data_left(msg))
 			copy = msg_data_left(msg);
+#if IS_ENABLED(CONFIG_SUNRPC)
+		if (sk->sk_sunrpc_fuzz_limit_first_copy)
+			copy = min(copy, 1);
+#endif
 
 		if (zc == 0) {
 			bool merge = true;
@@ -1377,6 +1381,23 @@ int tcp_sendmsg_locked(struct sock *sk, struct msghdr *msg, size_t size)
 		TCP_SKB_CB(skb)->end_seq += copy;
 		tcp_skb_pcount_set(skb, 0);
 
+#if IS_ENABLED(CONFIG_SUNRPC)
+		/* copy > 0: the first record byte is now irreversibly queued. */
+		if (copy > 0 && sk->sk_sunrpc_fuzz_first_byte)
+			sk->sk_sunrpc_fuzz_first_byte(sk);
+		if (copy > 0 && sk->sk_sunrpc_fuzz_arm_drop_on_first_byte) {
+			sk->sk_sunrpc_fuzz_arm_drop_on_first_byte = false;
+			sk->sk_sunrpc_fuzz_drop_next_data = true;
+		}
+		if (sk->sk_sunrpc_fuzz_stop_after_first_copy) {
+			sk->sk_sunrpc_fuzz_limit_first_copy = false;
+			sk->sk_sunrpc_fuzz_stop_after_first_copy = false;
+			sk->sk_sunrpc_fuzz_postcommit_failed = true;
+			copied += copy;
+			goto out;
+		}
+#endif
+
 		copied += copy;
 		if (!msg_data_left(msg)) {
 			if (unlikely(flags & MSG_EOR))
diff --git a/net/ipv4/tcp_ipv4.c b/net/ipv4/tcp_ipv4.c
index 04dbb2bab..b96ccc890 100644
--- a/net/ipv4/tcp_ipv4.c
+++ b/net/ipv4/tcp_ipv4.c
@@ -337,6 +337,12 @@ int tcp_v4_connect(struct sock *sk, struct sockaddr_unsized *uaddr, int addr_len
 
 	atomic_set(&inet->inet_id, get_random_u16());
 
+#if IS_ENABLED(CONFIG_SUNRPC)
+	/* Source address and port are final, but no SYN has been emitted yet. */
+	if (sk->sk_sunrpc_fuzz_preconnect)
+		sk->sk_sunrpc_fuzz_preconnect(sk);
+#endif
+
 	if (tcp_fastopen_defer_connect(sk, &err))
 		return err;
 	if (err)
diff --git a/net/ipv4/tcp_output.c b/net/ipv4/tcp_output.c
index d960e3de7..fd26dd54e 100644
--- a/net/ipv4/tcp_output.c
+++ b/net/ipv4/tcp_output.c
@@ -1713,9 +1713,18 @@ static int __tcp_transmit_skb(struct sock *sk, struct sk_buff *skb,
 
 	tcp_add_tx_delay(skb, tp);
 
-	err = INDIRECT_CALL_INET(icsk->icsk_af_ops->queue_xmit,
-				 inet6_csk_xmit, ip_queue_xmit,
-				 sk, skb, &inet->cork.fl);
+#if IS_ENABLED(CONFIG_SUNRPC)
+	if (sk->sk_sunrpc_fuzz_drop_next_data && oskb &&
+	    skb->len > tcp_header_size) {
+		/* Deliberately lose one real data segment below TCP accounting. */
+		sk->sk_sunrpc_fuzz_drop_next_data = false;
+		consume_skb(skb);
+		err = 0;
+	} else
+#endif
+		err = INDIRECT_CALL_INET(icsk->icsk_af_ops->queue_xmit,
+					 inet6_csk_xmit, ip_queue_xmit,
+					 sk, skb, &inet->cork.fl);
 
 	if (unlikely(err > 0)) {
 		tcp_enter_cwr(sk);
@@ -3555,6 +3564,16 @@ int __tcp_retransmit_skb(struct sock *sk, struct sk_buff *skb, int segs)
 	int diff, len, err;
 	int avail_wnd;
 
+#if IS_ENABLED(CONFIG_SUNRPC)
+	/*
+	 * TLP and other recovery paths can call this common implementation
+	 * directly, bypassing tcp_retransmit_skb().  Snapshot the connection
+	 * ordinal here so every actual retransmission path is covered.
+	 */
+	if (sk->sk_sunrpc_fuzz_retransmit)
+		sk->sk_sunrpc_fuzz_retransmit(sk, true);
+#endif
+
 	/* Inconclusive MTU probe */
 	if (icsk->icsk_mtup.probe_size)
 		icsk->icsk_mtup.probe_size = 0;
@@ -3689,6 +3708,10 @@ int __tcp_retransmit_skb(struct sock *sk, struct sk_buff *skb, int segs)
 
 out:
 	trace_tcp_retransmit_skb(sk, skb, err);
+#if IS_ENABLED(CONFIG_SUNRPC)
+	if (!err && sk->sk_sunrpc_fuzz_retransmit)
+		sk->sk_sunrpc_fuzz_retransmit(sk, false);
+#endif
 	return err;
 }
 

From 087980540fecc0f3adefba4306228957225f3afd Mon Sep 17 00:00:00 2001
From: ci <ci@localhost>
Date: Tue, 27 Oct 2026 09:11:21 +0900
Subject: [PATCH] executor: isolate each lane target in a private mount
 namespace

---
 executor/common_linux.h | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/executor/common_linux.h b/executor/common_linux.h
index e20833aa2..a0ff1c642 100644
--- a/executor/common_linux.h
+++ b/executor/common_linux.h
@@ -5066,6 +5066,13 @@ static void setup_nfs_fuzz_lane(const char* newroot)
 			return;
 		failmsg("access NFS fuzz lane enable marker failed", "path=%s", enabled);
 	}
+	// Every syz-executor process mounts its own /nfs-lane.  Without a private
+	// mount namespace the four executors overwrite one global mount and most
+	// programs see another proc's target (or no profile at all).
+	if (unshare(CLONE_NEWNS))
+		fail("unshare NFS fuzz lane mount namespace failed");
+	if (mount(NULL, "/", NULL, MS_REC | MS_PRIVATE, NULL))
+		fail("make NFS fuzz lane mount namespace private failed");
 
 	char source[128];
 	char marker[160];
-- 
2.34.1


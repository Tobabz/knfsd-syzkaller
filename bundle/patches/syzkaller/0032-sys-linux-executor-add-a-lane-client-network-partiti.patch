+# A client-side network partition: the lane client's only link in its own
+# network namespace drops everything the client sends (a blackhole root
+# qdisc) for 15 s, which outlasts the single fixture's 10 s NFSv4 lease, and
+# the call returns with the link still dropping.  heal brings it back.  Each
+# call fails with EALREADY unless it changes the link.  The fork server heals
+# every client after each program.  heal's program timeout lets the client's
+# recovery requests that follow it, which wait on TCP retransmission backoff,
+# finish inside the program.
+syz_nfs_lane_link$partition_client0(client const[0], op const[0]) (timeout[16000])
+syz_nfs_lane_link$heal_client0(client const[0], op const[1]) (prog_timeout[30000])
+
 # Ask the same broker for one bounded nfsdcld transaction on this lane.  The
 # broker validates the daemon (namespaces, executable, argv, start time and
 # CLD pipe inode) and owns the executable, the pipe and both fixed windows.
diff --git a/sys/linux/nfs_fuzz_test.go b/sys/linux/nfs_fuzz_test.go
index 8ab22d720..0209d4337 100644
--- a/sys/linux/nfs_fuzz_test.go
+++ b/sys/linux/nfs_fuzz_test.go
@@ -388,6 +388,36 @@ func TestNFSCldControl(t *testing.T) {
 	}
 }
 
+func TestNFSLaneClientPartition(t *testing.T) {
+	target, err := prog.GetTarget("linux", "amd64")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []struct {
+		name        string
+		op          uint64
+		timeout     uint64
+		progTimeout uint64
+	}{
+		{"syz_nfs_lane_link$partition_client0", 0, 16000, 0},
+		{"syz_nfs_lane_link$heal_client0", 1, 0, 30000},
+	} {
+		call := requireNFSFuzzCall(t, target, want.name)
+		if call.CallName != "syz_nfs_lane_link" || len(call.Args) != 2 {
+			t.Fatalf("%s has wrong dispatch or arity", call.Name)
+		}
+		requireConst(t, call.Args[0].Type, 0, call.Name+" client")
+		requireConst(t, call.Args[1].Type, want.op, call.Name+" op")
+		if call.Ret != nil {
+			t.Fatalf("%s returns %T, want status-only pseudo call", call.Name, call.Ret)
+		}
+		if call.Attrs.Timeout != want.timeout || call.Attrs.ProgTimeout != want.progTimeout {
+			t.Fatalf("%s timeouts %d/%d, want %d/%d", call.Name, call.Attrs.Timeout,
+				call.Attrs.ProgTimeout, want.timeout, want.progTimeout)
+		}
+	}
+}

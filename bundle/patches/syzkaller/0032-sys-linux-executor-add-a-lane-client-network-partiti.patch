+// A lane client's network partition.  The client's only link in its own lane
+// network namespace drops everything the client sends for a fixed hold that
+// outlasts the single fixture's 10 s NFSv4 lease, so the server sees a client
+// that stopped renewing.  The link gets a blackhole root qdisc, which drops
+// each packet and reports success: the client sees a silent network, as when
+// a cable is pulled further along, not a local error.  The link stays up and
+// its addresses and routes are untouched (a link taken down loses the lane's
+// static route to the second server address).  Nothing in the server
+// namespace is touched.  Heal deletes the qdisc, and the fork server deletes
+// it after every program in case a program ended while partitioned.
+#define NFS_LANE_PARTITION_HOLD_MS 15000
+
+enum {
+	NFS_LANE_LINK_PARTITION = 0,
+	NFS_LANE_LINK_HEAL = 1,
+};
+
+// Add a blackhole root qdisc to a link, or delete the root qdisc.  Returns 0,
+// or -1 with errno set: EEXIST when adding over a qdisc that is already
+// there, ENOENT when deleting the default qdisc.
+static int nfs_lane_root_qdisc(int ifindex, bool blackhole)
+{
+	int sock = socket(AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, NETLINK_ROUTE);
+	if (sock < 0)
+		return -1;
+	struct {
+		struct nlmsghdr hdr;
+		struct tcmsg tcm;
+		char attrs[64];
+	} req;
+	memset(&req, 0, sizeof(req));
+	req.hdr.nlmsg_type = blackhole ? RTM_NEWQDISC : RTM_DELQDISC;
+	req.hdr.nlmsg_flags = NLM_F_REQUEST | NLM_F_ACK;
+	if (blackhole)
+		req.hdr.nlmsg_flags |= NLM_F_CREATE | NLM_F_EXCL;
+	req.tcm.tcm_family = AF_UNSPEC;
+	req.tcm.tcm_ifindex = ifindex;
+	req.tcm.tcm_parent = TC_H_ROOT;
+	int len = NLMSG_LENGTH(sizeof(req.tcm));
+	if (blackhole) {
+		static const char kind[] = "blackhole";
+		struct rtattr* attr = (struct rtattr*)((char*)&req + NLMSG_ALIGN(len));
+		attr->rta_type = TCA_KIND;
+		attr->rta_len = RTA_LENGTH(sizeof(kind));
+		memcpy(RTA_DATA(attr), kind, sizeof(kind));
+		len = NLMSG_ALIGN(len) + RTA_ALIGN(attr->rta_len);
+	}
+	req.hdr.nlmsg_len = len;
+	struct sockaddr_nl addr;
+	memset(&addr, 0, sizeof(addr));
+	addr.nl_family = AF_NETLINK;
+	int ret = -1;
+	int saved_errno = EPROTO;
+	if (sendto(sock, &req, len, 0, (struct sockaddr*)&addr, sizeof(addr)) != len) {
+		saved_errno = errno;
+	} else {
+		char reply[512];
+		ssize_t n = recv(sock, reply, sizeof(reply), 0);
+		struct nlmsghdr* hdr = (struct nlmsghdr*)reply;
+		if (n < 0) {
+			saved_errno = errno;
+		} else if (n >= (ssize_t)NLMSG_LENGTH(sizeof(struct nlmsgerr)) &&
+			   hdr->nlmsg_type == NLMSG_ERROR) {
+			int error = -((struct nlmsgerr*)NLMSG_DATA(hdr))->error;
+			if (error == 0)
+				ret = 0;
+			else
+				saved_errno = error;
+		}
+	}
+	close(sock);
+	if (ret < 0)
+		errno = saved_errno;
+	return ret;
+}
+
+// Partition (up false) or heal (up true) the one non-loopback link in a
+// client's lane network namespace.  Returns 1 when that changed the link, 0
+// when it already was in that state, and -1 with errno set otherwise.
+static int nfs_lane_client_link(unsigned long client, bool up)
+{
+	if (client > 1 || nfs_fuzz_netns_fds[client] < 0) {
+		errno = ENODEV;
+		return -1;
+	}
+	int current_netns = open("/proc/self/ns/net", O_RDONLY | O_CLOEXEC);
+	if (current_netns < 0)
+		return -1;
+	if (setns(nfs_fuzz_netns_fds[client], CLONE_NEWNET)) {
+		int saved_errno = errno;
+		close(current_netns);
+		errno = saved_errno;
+		return -1;
+	}
+	int ret = -1;
+	int saved_errno = ENODEV;
+	struct if_nameindex* links = if_nameindex();
+	if (!links) {
+		saved_errno = errno;
+	} else {
+		int ifindex = 0;
+		int found = 0;
+		for (struct if_nameindex* link = links; link->if_index; link++) {
+			if (strcmp(link->if_name, "lo") == 0)
+				continue;
+			ifindex = link->if_index;
+			found++;
+		}
+		if (found == 1) {
+			if (nfs_lane_root_qdisc(ifindex, !up) == 0)
+				ret = 1;
+			else if (errno == (up ? ENOENT : EEXIST))
+				ret = 0;
+			else
+				saved_errno = errno;
+		}
+		if_freenameindex(links);
+	}
+	if (setns(current_netns, CLONE_NEWNET))
+		fail("restore network namespace after NFS lane link change failed");
+	close(current_netns);
+	if (ret < 0)
+		errno = saved_errno;
+	return ret;
+}
+
+static long syz_nfs_lane_link(volatile long a0, volatile long a1)
+{
+	// syz_nfs_lane_link(client const[0:1], op const[0:1])
+	// partition makes the client's link drop everything and returns after
+	// the hold with the link still dropping; heal brings it back.  Both fail
+	// unless they change the link, so a program cannot partition twice or
+	// heal a live client.
+	unsigned long client = a0, op = a1;
+	if (client > 1 || op > NFS_LANE_LINK_HEAL) {
+		errno = EINVAL;
+		return -1;
+	}
+	int changed = nfs_lane_client_link(client, op == NFS_LANE_LINK_HEAL);
+	if (changed < 0)
+		return -1;
+	if (changed == 0) {
+		errno = EALREADY;
+		return -1;
+	}
+	if (op == NFS_LANE_LINK_PARTITION)
+		sleep_ms(NFS_LANE_PARTITION_HOLD_MS);
+	return 0;
+}
+
+// Fork server, after every program: no partition outlives the program that
+// made it.  A sandbox that may not enter the lane network namespace (EPERM,
+// as in the namespace sandbox of the machine check) cannot have partitioned
+// it either.
+static void nfs_lane_restore_links()
+{
+	for (unsigned long client = 0; client < 2; client++) {
+		if (nfs_fuzz_netns_fds[client] < 0)
+			continue;
+		if (nfs_lane_client_link(client, true) < 0 && errno != EPERM)
+			failmsg("restore NFS lane client link failed", "client=%lu errno=%d",
+				client, errno);
+	}
+}
+

From 39d373da71bfffdcc296033acdfc38b9ceef4de8 Mon Sep 17 00:00:00 2001
From: knfsd-fuzz <knfsd-fuzz@localhost>
Date: Thu, 1 Oct 2026 20:21:43 +0900
Subject: [PATCH] sys/linux, executor: send raw NFS RPCs over plain TCP

The kernel no longer provides the TCP_SUNRPC_FUZZ socket option or its
control message: NFS server coverage is attributed by lane, so a raw RPC
needs no per-socket or per-record attribution state.

syz_socket_connect_nfs*() now connect an ordinary TCP socket in the lane's
client netns, and syz_send_nfs_fuzz() sends one record-marked call with a
plain sendmsg().  Its flags and user_tag arguments are kept with their
previous values so that existing programs still parse; they are ignored.

Replace setsockopt$inet_nfs_fuzz and the cmsg-carrying
sendmsg$inet_nfs_fuzz_* variants with write$inet_nfs_fuzz, which writes one
record-marked call on the manual socket path.  The descriptions no longer
depend on uapi/linux/tcp.h constants.
---
 executor/common_linux.h             |  40 +++-------
 sys/linux/nfs_fuzz_test.go          | 120 ++++------------------------
 sys/linux/socket_inet_nfs.txt       |  67 ++++------------
 sys/linux/socket_inet_nfs.txt.const |  11 +--
 4 files changed, 43 insertions(+), 195 deletions(-)

diff --git a/executor/common_linux.h b/executor/common_linux.h
index cba4f4623..a006837c4 100644
--- a/executor/common_linux.h
+++ b/executor/common_linux.h
@@ -2896,21 +2896,14 @@ static long nfs_socket_connect_pair(unsigned long client, unsigned long backend)
 	if (fd < 0)
 		saved_errno = errno;
 	if (fd >= 0) {
-		int enabled = 1;
-		if (setsockopt(fd, IPPROTO_TCP, 47, &enabled, sizeof(enabled))) {
+		struct sockaddr_in addr = {};
+		addr.sin_family = AF_INET;
+		addr.sin_port = htons(2049);
+		addr.sin_addr.s_addr = nfs_fuzz_server_addrs[backend];
+		if (connect(fd, (struct sockaddr*)&addr, sizeof(addr))) {
 			saved_errno = errno;
 			close(fd);
 			fd = -1;
-		} else {
-			struct sockaddr_in addr = {};
-			addr.sin_family = AF_INET;
-			addr.sin_port = htons(2049);
-			addr.sin_addr.s_addr = nfs_fuzz_server_addrs[backend];
-			if (connect(fd, (struct sockaddr*)&addr, sizeof(addr))) {
-				saved_errno = errno;
-				close(fd);
-				fd = -1;
-			}
 		}
 	}
 	if (setns(current_netns, CLONE_NEWNET))
@@ -2971,12 +2964,14 @@ static long syz_send_nfs_fuzz(volatile long a0, volatile long a1,
 {
 	// syz_send_nfs_fuzz(fd sock_nfs_fuzz_tcp, msg ptr[in, rpc_nfs_call],
 	//                    msglen len[msg], flags const[...], user_tag proc[...])
+	// Sends one record-marked RPC call.  Server coverage is attributed by
+	// lane, so flags and user_tag are accepted for compatibility and ignored.
 	int fd = a0;
 	void* payload = (void*)a1;
 	size_t payload_len = a2;
-	uint32 flags = a3;
-	uint64 user_tag = a4;
-	if (!payload || payload_len < 8 || payload_len > 0x7fffffff || !user_tag) {
+	(void)a3;
+	(void)a4;
+	if (!payload || payload_len < 8 || payload_len > 0x7fffffff) {
 		errno = EINVAL;
 		return -1;
 	}
@@ -2986,23 +2981,10 @@ static long syz_send_nfs_fuzz(volatile long a0, volatile long a1,
 		{.iov_base = &marker, .iov_len = sizeof(marker)},
 		{.iov_base = payload, .iov_len = payload_len},
 	};
-	struct {
-		uint32 version;
-		uint32 flags;
-		uint64 user_tag;
-	} control = {1, flags, user_tag};
-	char control_buf[CMSG_SPACE(sizeof(control))] = {};
 	struct msghdr msg = {};
 	msg.msg_iov = iov;
 	msg.msg_iovlen = 2;
-	msg.msg_control = control_buf;
-	msg.msg_controllen = sizeof(control_buf);
-	struct cmsghdr* cmsg = CMSG_FIRSTHDR(&msg);
-	cmsg->cmsg_level = IPPROTO_TCP;
-	cmsg->cmsg_type = 47;
-	cmsg->cmsg_len = CMSG_LEN(sizeof(control));
-	memcpy(CMSG_DATA(cmsg), &control, sizeof(control));
-	return sendmsg(fd, &msg, 0);
+	return sendmsg(fd, &msg, MSG_NOSIGNAL);
 }
 #endif
 

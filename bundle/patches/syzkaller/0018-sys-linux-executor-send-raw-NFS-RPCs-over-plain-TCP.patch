index b61a846ed..edb45aa68 100644
--- a/sys/linux/socket_inet_nfs.txt
+++ b/sys/linux/socket_inet_nfs.txt
@@ -2,7 +2,6 @@
 # Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
 
 include <uapi/linux/in.h>
-include <uapi/linux/tcp.h>
 include <uapi/asm-generic/socket.h>
 include <linux/net.h>
 include <linux/socket.h>
@@ -11,67 +10,31 @@ include <linux/socket.h>
 
 resource sock_nfs_fuzz_tcp[sock]
 
-# Create the socket in the chosen fixed-lane client network namespace, then
-# enable TCP_SUNRPC_FUZZ before connecting.  The original clientN variants
-# retain their primary destination; the pair variants select .1 (knfsd) or
-# .5 (Ganesha) independently, both at the deterministic proxy's :2049.
-# Destinations are fixture metadata, not fuzzed input; RPC/XDR remains mutable.
+# Create a plain TCP socket in the chosen fixed-lane client network namespace
+# and connect it.  The original clientN variants retain their primary
+# destination; the pair variants select .1 (knfsd) or .5 (Ganesha)
+# independently, both at the deterministic proxy's :2049.  Destinations are
+# fixture metadata, not fuzzed input; RPC/XDR remains mutable.  Coverage of
+# the server work is attributed by lane, so no socket option is needed.
+# syz_send_nfs_fuzz adds the record marker; its flags and tag are kept only so
+# that existing programs still parse, and are ignored.
 syz_socket_connect_nfs$client0(client const[0]) sock_nfs_fuzz_tcp
 syz_socket_connect_nfs$client1(client const[1]) sock_nfs_fuzz_tcp
 syz_socket_connect_nfs_pair$client0_knfsd(client const[0], backend const[0]) sock_nfs_fuzz_tcp
 syz_socket_connect_nfs_pair$client0_ganesha(client const[0], backend const[1]) sock_nfs_fuzz_tcp
 syz_socket_connect_nfs_pair$client1_knfsd(client const[1], backend const[0]) sock_nfs_fuzz_tcp
 syz_socket_connect_nfs_pair$client1_ganesha(client const[1], backend const[1]) sock_nfs_fuzz_tcp
-syz_send_nfs_fuzz$new(fd sock_nfs_fuzz_tcp, msg ptr[in, rpc_nfs_call], msglen len[msg], flags const[TCP_SUNRPC_FUZZ_F_NEW], user_tag proc[1, 1])
-syz_send_nfs_fuzz$new_final(fd sock_nfs_fuzz_tcp, msg ptr[in, rpc_nfs_call], msglen len[msg], flags const[TCP_SUNRPC_FUZZ_F_NEW_FINAL], user_tag proc[1, 1])
-syz_send_nfs_fuzz$retry(fd sock_nfs_fuzz_tcp, msg ptr[in, rpc_nfs_call], msglen len[msg], flags const[TCP_SUNRPC_FUZZ_F_RETRY], user_tag proc[1, 1])
-syz_send_nfs_fuzz$retry_final(fd sock_nfs_fuzz_tcp, msg ptr[in, rpc_nfs_call], msglen len[msg], flags const[TCP_SUNRPC_FUZZ_F_RETRY_FINAL], user_tag proc[1, 1])
-
-# TCP_SUNRPC_FUZZ must be enabled before connect.  The dedicated resource keeps
-# this opt-in lane separate from ordinary TCP sockets; the kernel still checks
-# the actual setsockopt state.
+syz_send_nfs_fuzz$new(fd sock_nfs_fuzz_tcp, msg ptr[in, rpc_nfs_call], msglen len[msg], flags const[1], user_tag proc[1, 1])
+syz_send_nfs_fuzz$new_final(fd sock_nfs_fuzz_tcp, msg ptr[in, rpc_nfs_call], msglen len[msg], flags const[5], user_tag proc[1, 1])
+syz_send_nfs_fuzz$retry(fd sock_nfs_fuzz_tcp, msg ptr[in, rpc_nfs_call], msglen len[msg], flags const[2], user_tag proc[1, 1])
+syz_send_nfs_fuzz$retry_final(fd sock_nfs_fuzz_tcp, msg ptr[in, rpc_nfs_call], msglen len[msg], flags const[6], user_tag proc[1, 1])
+
+# Manual path: an ordinary TCP socket; write() sends one record-marked call.
 socket$inet_nfs_fuzz_tcp(domain const[AF_INET], type const[SOCK_STREAM], proto const[IPPROTO_TCP]) sock_nfs_fuzz_tcp
-setsockopt$inet_nfs_fuzz(fd sock_nfs_fuzz_tcp, level const[SOL_TCP], optname const[TCP_SUNRPC_FUZZ], optval ptr[in, const[1, int32]], optlen len[optval])
 connect$inet_nfs_fuzz(fd sock_nfs_fuzz_tcp, addr ptr[in, sockaddr_in], addrlen len[addr])
-
-define TCP_SUNRPC_FUZZ_F_NEW_FINAL	TCP_SUNRPC_FUZZ_F_NEW | TCP_SUNRPC_FUZZ_F_FINAL
-define TCP_SUNRPC_FUZZ_F_RETRY_FINAL	TCP_SUNRPC_FUZZ_F_RETRY | TCP_SUNRPC_FUZZ_F_FINAL
-
-# NEW and RETRY are exclusive operations.  FINAL is their only valid modifier;
-# CANCEL is a standalone, zero-data operation.
-sendmsg$inet_nfs_fuzz_new(fd sock_nfs_fuzz_tcp, msg ptr[in, nfs_fuzz_send_msghdr[rpc_tcp_nfs_single_call, TCP_SUNRPC_FUZZ_F_NEW]], f const[0])
-sendmsg$inet_nfs_fuzz_new_final(fd sock_nfs_fuzz_tcp, msg ptr[in, nfs_fuzz_send_msghdr[rpc_tcp_nfs_single_call, TCP_SUNRPC_FUZZ_F_NEW_FINAL]], f const[0])
-sendmsg$inet_nfs_fuzz_retry(fd sock_nfs_fuzz_tcp, msg ptr[in, nfs_fuzz_send_msghdr[rpc_tcp_nfs_single_call, TCP_SUNRPC_FUZZ_F_RETRY]], f const[0])
-sendmsg$inet_nfs_fuzz_retry_final(fd sock_nfs_fuzz_tcp, msg ptr[in, nfs_fuzz_send_msghdr[rpc_tcp_nfs_single_call, TCP_SUNRPC_FUZZ_F_RETRY_FINAL]], f const[0])
-sendmsg$inet_nfs_fuzz_cancel(fd sock_nfs_fuzz_tcp, msg ptr[in, nfs_fuzz_cancel_msghdr], f const[0])
+write$inet_nfs_fuzz(fd sock_nfs_fuzz_tcp, buf ptr[in, rpc_tcp_nfs_single_call], len bytesize[buf])
 recvfrom$inet_nfs_fuzz_tcp(fd sock_nfs_fuzz_tcp, buf buffer[out], len len[buf], f flags[recv_flags], addr const[0], addrlen const[0])
 
-type nfs_fuzz_send_msghdr[MSG, FLAGS] {

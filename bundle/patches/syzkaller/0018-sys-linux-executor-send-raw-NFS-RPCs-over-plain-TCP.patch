-	msg_namelen	const[0, int32]
-	msg_iov		ptr[in, iovec[in, MSG]]
-	msg_iovlen	const[1, intptr]
-	msg_control	ptr[in, cmsghdr_t[SOL_TCP, TCP_SUNRPC_FUZZ, tcp_sunrpc_fuzz[FLAGS]]]
-	msg_controllen	bytesize[msg_control, intptr]
-	msg_flags	const[0, int32]
-}
-
-nfs_fuzz_cancel_msghdr {
-	msg_name	const[0, intptr]
-	msg_namelen	const[0, int32]
-	msg_iov		const[0, intptr]
-	msg_iovlen	const[0, intptr]
-	msg_control	ptr[in, cmsghdr_t[SOL_TCP, TCP_SUNRPC_FUZZ, tcp_sunrpc_fuzz[TCP_SUNRPC_FUZZ_F_CANCEL]]]
-	msg_controllen	bytesize[msg_control, intptr]
-	msg_flags	const[0, int32]
-}
-
-type tcp_sunrpc_fuzz[FLAGS] {
-	version		const[TCP_SUNRPC_FUZZ_VERSION, int32]
-	flags		const[FLAGS, int32]
-	user_tag	proc[1, 1, int64]
-}
-
 # Known NFS export paths & filenames dictionary
 nfs_path_names = "export", "tmp", "root", "test", "mnt", "home", "var", "dev", "etc", "testfile", "file1", "dir1", "share", "pub", "user.test", "system.nfs4_acl", "security.selinux"
 

From 215c7fab3c56b32d5e51ba2f0cc432746a5820e4 Mon Sep 17 00:00:00 2001
From: knfsd bridge builder <bridge@localhost>
Date: Mon, 26 Oct 2026 18:45:48 +0900
Subject: [PATCH] syz-manager: collect coverage in corpus-run mode

---
 syz-manager/manager.go | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/syz-manager/manager.go b/syz-manager/manager.go
index 137e6ecd0..532268260 100644
--- a/syz-manager/manager.go
+++ b/syz-manager/manager.go
@@ -1313,6 +1313,12 @@ func (cr *corpusRunner) Next() *queue.Request {
 	return &queue.Request{
 		Prog:      p,
 		Important: true,
+		// corpus-run is also a coverage-producing campaign.  Feature
+		// detection enables remote coverage; these flags select local KCOV
+		// and the managed generation publication path.
+		ExecOpts: flatrpc.ExecOpts{
+			ExecFlags: flatrpc.ExecFlagCollectSignal | flatrpc.ExecFlagCollectCover,
+		},
 	}
 }
 

diff --git a/pkg/rpcserver/nfs_proxy_evidence.go b/pkg/rpcserver/nfs_proxy_evidence.go
new file mode 100644
index 0000000..4718aa9
--- /dev/null
+++ b/pkg/rpcserver/nfs_proxy_evidence.go
@@ -0,0 +1,163 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package rpcserver
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"sync"
+
+	"github.com/google/syzkaller/pkg/flatrpc"
+)
+
+const (
+	nfsProxyEvidenceSchema = "knfsd-nfs-proxy-execution.v1"
+	maxNfsProxyEvidencePCs = 1 << 20
+)
+
+// nfsProxyEvidenceRecord is the host-side join between one target-mode
+// activation barrier and the remote coverage returned with that execution.
+// It is intentionally independent of fuzzer feedback: Stage 2 consumes the
+// immutable files after syz-manager has stopped.
+type nfsProxyEvidenceRecord struct {
+	SchemaVersion      string   `json:"schema_version"`
+	VM                 int      `json:"vm"`
+	Lane               int      `json:"lane"`
+	ExecutionID        int64    `json:"execution_id"`
+	ProgramSHA256      string   `json:"program_sha256"`
+	Generation         uint64   `json:"generation"`
+	ProgramDigest      string   `json:"program_digest"`
+	Activation         string   `json:"activation"`
+	ActivationStatus   uint32   `json:"activation_status"`
+	Deactivation       string   `json:"deactivation"`
+	DeactivationStatus uint32   `json:"deactivation_status"`
+	Executed           bool     `json:"executed"`
+	LeaseCleared       bool     `json:"lease_cleared"`
+	Hanged             bool     `json:"hanged"`
+	Error              string   `json:"error"`
+	PCs                []uint64 `json:"pcs"`
+}
+
+type nfsProxyEvidenceWriter struct {
+	directory string
+	mu        sync.Mutex
+	next      uint64
+}
+
+func newNfsProxyEvidenceWriter(directory string) (*nfsProxyEvidenceWriter, error) {
+	if directory == "" {
+		return nil, nil
+	}
+	abs, err := filepath.Abs(directory)
+	if err != nil {
+		return nil, err
+	}
+	if err := os.MkdirAll(abs, 0o755); err != nil {
+		return nil, err
+	}
+	entries, err := os.ReadDir(abs)
+	if err != nil {
+		return nil, err
+	}
+	if len(entries) != 0 {
+		return nil, fmt.Errorf("directory is not empty: %v", abs)
+	}
+	return &nfsProxyEvidenceWriter{directory: abs}, nil
+}
+
+func (writer *nfsProxyEvidenceWriter) write(vm, lane int, executionID int64,
+	program []byte, info *flatrpc.ProgInfo, hanged bool, resultError string) error {
+	if len(resultError) > 4096 {
+		resultError = resultError[:4096]
+	}
+	record := nfsProxyEvidenceRecord{
+		SchemaVersion: nfsProxyEvidenceSchema,
+		VM:            vm,
+		Lane:          lane,
+		ExecutionID:   executionID,
+		ProgramSHA256: fmt.Sprintf("%x", sha256.Sum256(program)),
+		Hanged:        hanged,
+		Error:         resultError,
+		PCs:           []uint64{},
+	}
+	if info != nil {
+		if info.Extra != nil {
+			record.PCs = slices.Clone(info.Extra.Cover)
+			slices.Sort(record.PCs)
+			record.PCs = slices.Compact(record.PCs)
+			if len(record.PCs) > maxNfsProxyEvidencePCs {
+				return fmt.Errorf("remote coverage has %v PCs, limit is %v",
+					len(record.PCs), maxNfsProxyEvidencePCs)
+			}
+		}
+		if activation := info.NfsProxy; activation != nil {
+			if activation.Generation == 0 || len(activation.ProgramDigest) != sha256.Size {
+				return fmt.Errorf("invalid target-mode correlation")
+			}
+			record.Generation = activation.Generation
+			record.ProgramDigest = hex.EncodeToString(activation.ProgramDigest)
+			record.Activation = activation.Activation.String()
+			record.ActivationStatus = activation.ActivationStatus
+			record.Deactivation = activation.Deactivation.String()
+			record.DeactivationStatus = activation.DeactivationStatus
+			record.Executed = activation.Executed
+			record.LeaseCleared = activation.LeaseCleared
+		}
+	}
+	raw, err := json.Marshal(record)
+	if err != nil {
+		return err
+	}
+	raw = append(raw, '\n')
+
+	writer.mu.Lock()
+	defer writer.mu.Unlock()
+	sequence := writer.next
+	writer.next++
+	base := fmt.Sprintf("%020d", sequence)
+	temporary := filepath.Join(writer.directory, "."+base+".tmp")
+	final := filepath.Join(writer.directory, base+".json")
+	file, err := os.OpenFile(temporary, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o644)
+	if err != nil {
+		return err
+	}
+	ok := false
+	defer func() {
+		file.Close()
+		if !ok {
+			os.Remove(temporary)
+		}
+	}()
+	if _, err := file.Write(raw); err != nil {
+		return err
+	}
+	if err := file.Sync(); err != nil {
+		return err
+	}
+	if err := file.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(temporary, final); err != nil {
+		return err
+	}
+	directory, err := os.Open(writer.directory)
+	if err != nil {
+		return err
+	}
+	err = directory.Sync()
+	closeErr := directory.Close()
+	if err != nil {
+		return err
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	ok = true
+	return nil
+}
diff --git a/pkg/rpcserver/nfs_proxy_evidence_test.go b/pkg/rpcserver/nfs_proxy_evidence_test.go
new file mode 100644
index 0000000..edd23d8
--- /dev/null
+++ b/pkg/rpcserver/nfs_proxy_evidence_test.go
@@ -0,0 +1,99 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package rpcserver
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/google/syzkaller/pkg/flatrpc"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNfsProxyEvidenceWriter(t *testing.T) {
+	directory := t.TempDir()
+	writer, err := newNfsProxyEvidenceWriter(directory)
+	require.NoError(t, err)
+	digest := sha256.Sum256([]byte("exec encoding"))
+	info := &flatrpc.ProgInfo{
+		Extra: &flatrpc.CallInfo{Cover: []uint64{9, 3, 9}},
+		NfsProxy: &flatrpc.NfsProxyActivation{
+			Generation:         7,
+			ProgramDigest:      digest[:],
+			Activation:         flatrpc.NfsProxyBarrierRawAcked,
+			ActivationStatus:   1,
+			Deactivation:       flatrpc.NfsProxyBarrierRawRefused,
+			DeactivationStatus: 2,
+			Executed:           true,
+			LeaseCleared:       true,
+		},
+	}
+	require.NoError(t, writer.write(4, 2, 19, []byte("getpid()\n"), info, false, ""))
+
+	raw, err := os.ReadFile(filepath.Join(directory, "00000000000000000000.json"))
+	require.NoError(t, err)
+	var record nfsProxyEvidenceRecord
+	require.NoError(t, json.Unmarshal(raw, &record))
+	require.Equal(t, nfsProxyEvidenceSchema, record.SchemaVersion)
+	require.Equal(t, 4, record.VM)
+	require.Equal(t, 2, record.Lane)
+	require.Equal(t, int64(19), record.ExecutionID)
+	require.Equal(t, uint64(7), record.Generation)
+	require.Equal(t, digest[:], mustDecodeHex(t, record.ProgramDigest))
+	require.Equal(t, "Acked", record.Activation)
+	require.Equal(t, "Refused", record.Deactivation)
+	require.True(t, record.Executed)
+	require.True(t, record.LeaseCleared)
+	require.Equal(t, []uint64{3, 9}, record.PCs)
+	entries, err := os.ReadDir(directory)
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	require.Equal(t, "00000000000000000000.json", entries[0].Name())
+
+	_, err = newNfsProxyEvidenceWriter(directory)
+	require.ErrorContains(t, err, "directory is not empty")
+}
+
+func TestNfsProxyEvidenceWriterRecordsUncorrelatedExecution(t *testing.T) {
+	directory := t.TempDir()
+	writer, err := newNfsProxyEvidenceWriter(directory)
+	require.NoError(t, err)
+	require.NoError(t, writer.write(0, 1, 2, []byte("getuid()\n"),
+		&flatrpc.ProgInfo{}, true, "executor failed"))
+	raw, err := os.ReadFile(filepath.Join(directory, "00000000000000000000.json"))
+	require.NoError(t, err)
+	var record nfsProxyEvidenceRecord
+	require.NoError(t, json.Unmarshal(raw, &record))
+	require.Zero(t, record.Generation)
+	require.Empty(t, record.ProgramDigest)
+	require.Empty(t, record.PCs)
+	require.True(t, record.Hanged)
+	require.Equal(t, "executor failed", record.Error)
+}
+
+func TestNfsProxyEvidenceWriterRejectsBadCorrelation(t *testing.T) {
+	directory := t.TempDir()
+	writer, err := newNfsProxyEvidenceWriter(directory)
+	require.NoError(t, err)
+	err = writer.write(0, 0, 1, nil, &flatrpc.ProgInfo{
+		NfsProxy: &flatrpc.NfsProxyActivation{
+			Generation: 1, ProgramDigest: []byte{1},
+		},
+	}, false, "")
+	require.ErrorContains(t, err, "invalid target-mode correlation")
+	entries, readErr := os.ReadDir(directory)
+	require.NoError(t, readErr)
+	require.Empty(t, entries)
+}
+
+func mustDecodeHex(t *testing.T, value string) []byte {
+	t.Helper()
+	decoded, err := hex.DecodeString(value)
+	require.NoError(t, err)
+	return decoded
+}

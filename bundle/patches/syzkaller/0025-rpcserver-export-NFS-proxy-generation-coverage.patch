 pkg/rpcserver/nfs_proxy_evidence.go      | 163 +++++++++++++++++++++++
 pkg/rpcserver/nfs_proxy_evidence_test.go |  99 ++++++++++++++
 pkg/rpcserver/rpcserver.go               |  30 +++--
 pkg/rpcserver/runner.go                  |  64 +++++----
 6 files changed, 331 insertions(+), 39 deletions(-)
 create mode 100644 pkg/rpcserver/nfs_proxy_evidence.go
 create mode 100644 pkg/rpcserver/nfs_proxy_evidence_test.go


diff --git a/sys/linux/nfs_fuzz_test.go b/sys/linux/nfs_fuzz_test.go
new file mode 100644
index 000000000..b335a143a
--- /dev/null
+++ b/sys/linux/nfs_fuzz_test.go
@@ -0,0 +1,195 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package linux_test
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/google/syzkaller/prog"
+	_ "github.com/google/syzkaller/sys"
+)
+
+func TestNFSSunRPCFuzzABI(t *testing.T) {
+	target, err := prog.GetTarget("linux", "amd64")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for name, want := range map[string]uint64{
+		"TCP_SUNRPC_FUZZ":               47,
+		"TCP_SUNRPC_FUZZ_VERSION":       1,
+		"TCP_SUNRPC_FUZZ_F_NEW":         1,
+		"TCP_SUNRPC_FUZZ_F_RETRY":       2,
+		"TCP_SUNRPC_FUZZ_F_CANCEL":      8,
+		"TCP_SUNRPC_FUZZ_F_NEW_FINAL":   5,
+		"TCP_SUNRPC_FUZZ_F_RETRY_FINAL": 6,
+	} {
+		if got := target.GetConst(name); got != want {
+			t.Errorf("%s=%d, want %d", name, got, want)
+		}
+	}
+
+	socket := requireNFSFuzzCall(t, target, "socket$inet_nfs_fuzz_tcp")
+	if socket.CallName != "socket" {
+		t.Fatalf("socket variant calls %s, want ordinary socket", socket.CallName)
+	}
+	ret, ok := socket.Ret.(*prog.ResourceType)
+	if !ok || ret.Desc.Name != "sock_nfs_fuzz_tcp" {
+		t.Fatalf("socket return type is %T %v, want sock_nfs_fuzz_tcp", socket.Ret, socket.Ret)
+	}
+
+	setopt := requireNFSFuzzCall(t, target, "setsockopt$inet_nfs_fuzz")
+	if setopt.CallName != "setsockopt" {
+		t.Fatalf("setsockopt variant calls %s, want ordinary setsockopt", setopt.CallName)
+	}
+	requireConst(t, setopt.Args[1].Type, 6, "setsockopt level")
+	requireConst(t, setopt.Args[2].Type, 47, "setsockopt optname")
+	optval, ok := setopt.Args[3].Type.(*prog.PtrType)
+	if !ok {
+		t.Fatalf("setsockopt optval is %T, want pointer", setopt.Args[3].Type)
+	}
+	requireConst(t, optval.Elem, 1, "setsockopt optval")
+
+	connect := requireNFSFuzzCall(t, target, "connect$inet_nfs_fuzz")
+	if connect.CallName != "connect" {
+		t.Fatalf("connect variant calls %s, want ordinary connect", connect.CallName)
+	}
+	addr, ok := connect.Args[1].Type.(*prog.PtrType)
+	if !ok || addr.Elem.TemplateName() != "sockaddr_in" {
+		t.Fatalf("connect address is %T %v, want sockaddr_in pointer", connect.Args[1].Type, connect.Args[1].Type)
+	}
+
+	dataCalls := map[string]uint64{
+		"sendmsg$inet_nfs_fuzz_new":         1,
+		"sendmsg$inet_nfs_fuzz_new_final":   5,
+		"sendmsg$inet_nfs_fuzz_retry":       2,
+		"sendmsg$inet_nfs_fuzz_retry_final": 6,
+	}
+	for name, flags := range dataCalls {
+		call := requireNFSFuzzCall(t, target, name)
+		if call.CallName != "sendmsg" {
+			t.Fatalf("%s calls %s, want ordinary sendmsg", name, call.CallName)
+		}
+		requireNFSFuzzCmsg(t, call, flags)
+		header := requireStruct(t, call, "nfs_fuzz_send_msghdr")
+		iov := requireField(t, header, "msg_iov")
+		ptr, ok := iov.Type.(*prog.PtrType)
+		if !ok || ptr.Elem.TemplateName() != "iovec" {
+			t.Fatalf("%s msg_iov is %T %v, want one iovec pointer", name, iov.Type, iov.Type)
+		}
+		requireConst(t, requireField(t, header, "msg_iovlen").Type, 1, name+" msg_iovlen")
+		requireSingleCmsg(t, call, header)
+		requireSingleRPCRecords(t, call)
+	}
+
+	cancel := requireNFSFuzzCall(t, target, "sendmsg$inet_nfs_fuzz_cancel")
+	if cancel.CallName != "sendmsg" {
+		t.Fatalf("CANCEL calls %s, want ordinary sendmsg", cancel.CallName)
+	}
+	requireNFSFuzzCmsg(t, cancel, 8)
+	cancelHeader := requireStruct(t, cancel, "nfs_fuzz_cancel_msghdr")
+	requireConst(t, requireField(t, cancelHeader, "msg_iov").Type, 0, "CANCEL msg_iov")
+	requireConst(t, requireField(t, cancelHeader, "msg_iovlen").Type, 0, "CANCEL msg_iovlen")
+	requireSingleCmsg(t, cancel, cancelHeader)
+}
+
+func requireNFSFuzzCall(t *testing.T, target *prog.Target, name string) *prog.Syscall {
+	t.Helper()
+	call := target.SyscallMap[name]
+	if call == nil {
+		t.Fatalf("missing syscall %s", name)
+	}
+	return call
+}
+
+func requireNFSFuzzCmsg(t *testing.T, call *prog.Syscall, flags uint64) {
+	t.Helper()
+	cmsg := requireStruct(t, call, "tcp_sunrpc_fuzz")
+	wantNames := []string{"version", "flags", "user_tag"}
+	var gotNames []string
+	for _, field := range cmsg.Fields {
+		gotNames = append(gotNames, field.Name)
+	}
+	if !reflect.DeepEqual(gotNames, wantNames) {
+		t.Fatalf("%s CMSG fields are %v, want %v", call.Name, gotNames, wantNames)
+	}
+	if cmsg.Size() != 16 {
+		t.Fatalf("%s CMSG payload size is %d, want 16", call.Name, cmsg.Size())
+	}
+	requireConst(t, cmsg.Fields[0].Type, 1, call.Name+" version")
+	requireConst(t, cmsg.Fields[1].Type, flags, call.Name+" flags")
+	tag, ok := cmsg.Fields[2].Type.(*prog.ProcType)
+	if !ok || tag.Size() != 8 || tag.ValuesStart != 1 || tag.ValuesPerProc != 1 {
+		t.Fatalf("%s user_tag is %#v, want nonzero per-process int64", call.Name, cmsg.Fields[2].Type)
+	}
+}
+
+func requireSingleRPCRecords(t *testing.T, call *prog.Syscall) {
+	t.Helper()
+	for _, name := range []string{"rpc_tcp_nfs3_single_call", "rpc_tcp_nfs4_single_call"} {
+		record := requireStruct(t, call, name)
+		last := requireField(t, record, "last_frag")
+		requireConst(t, last.Type, 1, call.Name+" "+name+" last_frag")
+		if last.Type.BitfieldLength() != 1 {
+			t.Fatalf("%s %s last_frag is %d bits, want 1", call.Name, name, last.Type.BitfieldLength())
+		}
+	}
+}
+
+func requireSingleCmsg(t *testing.T, call *prog.Syscall, header *prog.StructType) {
+	t.Helper()
+	control := requireField(t, header, "msg_control")
+	ptr, ok := control.Type.(*prog.PtrType)
+	if !ok || ptr.Elem.TemplateName() != "cmsghdr_t" {
+		t.Fatalf("%s msg_control is %T %v, want one typed cmsghdr pointer", call.Name, control.Type, control.Type)
+	}
+	outer, ok := ptr.Elem.(*prog.StructType)
+	if !ok || len(outer.Fields) != 1 {
+		t.Fatalf("%s control wrapper is %#v, want one cmsghdr", call.Name, ptr.Elem)
+	}
+	inner, ok := outer.Fields[0].Type.(*prog.StructType)
+	if !ok || inner.TemplateName() != "cmsghdr_unaligned" {
+		t.Fatalf("%s control payload is %#v, want cmsghdr_unaligned", call.Name, outer.Fields[0].Type)
+	}
+	requireConst(t, requireField(t, inner, "cmsg_level").Type, 6, call.Name+" CMSG level")
+	requireConst(t, requireField(t, inner, "cmsg_type").Type, 47, call.Name+" CMSG type")
+}
+
+func requireStruct(t *testing.T, call *prog.Syscall, name string) *prog.StructType {
+	t.Helper()
+	var found *prog.StructType
+	prog.ForeachCallType(call, func(typ prog.Type, ctx *prog.TypeCtx) {
+		if typ.TemplateName() != name {
+			return
+		}
+		st, ok := typ.(*prog.StructType)
+		if !ok {
+			t.Fatalf("%s type %s is %T, want struct", call.Name, name, typ)
+		}
+		found = st
+	})
+	if found == nil {
+		t.Fatalf("%s does not contain %s", call.Name, name)
+	}
+	return found
+}
+
+func requireField(t *testing.T, st *prog.StructType, name string) prog.Field {
+	t.Helper()
+	for _, field := range st.Fields {
+		if field.Name == name {
+			return field
+		}
+	}
+	t.Fatalf("struct %s has no field %s", st.Name(), name)
+	return prog.Field{}
+}
+
+func requireConst(t *testing.T, typ prog.Type, want uint64, what string) {
+	t.Helper()
+	value, ok := typ.(*prog.ConstType)
+	if !ok || value.Val != want {
+		t.Fatalf("%s is %T %v, want const %d", what, typ, typ, want)
+	}
+}
diff --git a/sys/linux/socket_inet_nfs.txt b/sys/linux/socket_inet_nfs.txt
new file mode 100644
index 000000000..dce77ea84
--- /dev/null
+++ b/sys/linux/socket_inet_nfs.txt
@@ -0,0 +1,1022 @@
+# Copyright 2026 syzkaller project authors. All rights reserved.
+# Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+include <uapi/linux/in.h>
+include <uapi/linux/tcp.h>
+include <uapi/asm-generic/socket.h>
+include <linux/net.h>
+include <linux/socket.h>
+
+# NFS (SunRPC / XDR / NFSv3 / NFSv4) definitions
+
+resource sock_nfs_fuzz_tcp[sock]
+
+# TCP_SUNRPC_FUZZ must be enabled before connect.  The dedicated resource keeps
+# this opt-in lane separate from ordinary TCP sockets; the kernel still checks
+# the actual setsockopt state.
+socket$inet_nfs_fuzz_tcp(domain const[AF_INET], type const[SOCK_STREAM], proto const[IPPROTO_TCP]) sock_nfs_fuzz_tcp
+setsockopt$inet_nfs_fuzz(fd sock_nfs_fuzz_tcp, level const[SOL_TCP], optname const[TCP_SUNRPC_FUZZ], optval ptr[in, const[1, int32]], optlen len[optval])
+connect$inet_nfs_fuzz(fd sock_nfs_fuzz_tcp, addr ptr[in, sockaddr_in], addrlen len[addr])
+
+define TCP_SUNRPC_FUZZ_F_NEW_FINAL	TCP_SUNRPC_FUZZ_F_NEW | TCP_SUNRPC_FUZZ_F_FINAL
+define TCP_SUNRPC_FUZZ_F_RETRY_FINAL	TCP_SUNRPC_FUZZ_F_RETRY | TCP_SUNRPC_FUZZ_F_FINAL
+
+# NEW and RETRY are exclusive operations.  FINAL is their only valid modifier;
+# CANCEL is a standalone, zero-data operation.
+sendmsg$inet_nfs_fuzz_new(fd sock_nfs_fuzz_tcp, msg ptr[in, nfs_fuzz_send_msghdr[rpc_tcp_nfs_single_call, TCP_SUNRPC_FUZZ_F_NEW]], f const[0])
+sendmsg$inet_nfs_fuzz_new_final(fd sock_nfs_fuzz_tcp, msg ptr[in, nfs_fuzz_send_msghdr[rpc_tcp_nfs_single_call, TCP_SUNRPC_FUZZ_F_NEW_FINAL]], f const[0])
+sendmsg$inet_nfs_fuzz_retry(fd sock_nfs_fuzz_tcp, msg ptr[in, nfs_fuzz_send_msghdr[rpc_tcp_nfs_single_call, TCP_SUNRPC_FUZZ_F_RETRY]], f const[0])
+sendmsg$inet_nfs_fuzz_retry_final(fd sock_nfs_fuzz_tcp, msg ptr[in, nfs_fuzz_send_msghdr[rpc_tcp_nfs_single_call, TCP_SUNRPC_FUZZ_F_RETRY_FINAL]], f const[0])
+sendmsg$inet_nfs_fuzz_cancel(fd sock_nfs_fuzz_tcp, msg ptr[in, nfs_fuzz_cancel_msghdr], f const[0])
+recvfrom$inet_nfs_fuzz_tcp(fd sock_nfs_fuzz_tcp, buf buffer[out], len len[buf], f flags[recv_flags], addr const[0], addrlen const[0])
+
+type nfs_fuzz_send_msghdr[MSG, FLAGS] {
+	msg_name	const[0, intptr]
+	msg_namelen	const[0, int32]
+	msg_iov		ptr[in, iovec[in, MSG]]
+	msg_iovlen	const[1, intptr]
+	msg_control	ptr[in, cmsghdr_t[SOL_TCP, TCP_SUNRPC_FUZZ, tcp_sunrpc_fuzz[FLAGS]]]
+	msg_controllen	bytesize[msg_control, intptr]
+	msg_flags	const[0, int32]
+}
+
+nfs_fuzz_cancel_msghdr {
+	msg_name	const[0, intptr]
+	msg_namelen	const[0, int32]
+	msg_iov		const[0, intptr]
+	msg_iovlen	const[0, intptr]
+	msg_control	ptr[in, cmsghdr_t[SOL_TCP, TCP_SUNRPC_FUZZ, tcp_sunrpc_fuzz[TCP_SUNRPC_FUZZ_F_CANCEL]]]
+	msg_controllen	bytesize[msg_control, intptr]
+	msg_flags	const[0, int32]
+}
+
+type tcp_sunrpc_fuzz[FLAGS] {
+	version		const[TCP_SUNRPC_FUZZ_VERSION, int32]
+	flags		const[FLAGS, int32]
+	user_tag	proc[1, 1, int64]
+}
+
+# Known NFS export paths & filenames dictionary
+nfs_path_names = "export", "tmp", "root", "test", "mnt", "home", "var", "dev", "etc", "testfile", "file1", "dir1", "share", "pub", "user.test", "system.nfs4_acl", "security.selinux"
+
+# RPC Auth definitions
+rpc_auth_none {
+	flavor	const[0, int32be]
+	length	const[0, int32be]
+} [packed]
+
+rpc_auth_sys {
+	flavor	const[1, int32be]
+	length	len[data, int32be]
+	data	rpc_auth_sys_data
+} [packed]
+
+rpc_auth_sys_data {
+	stamp		int32be
+	machinename	stringnoz
+	uid		int32be
+	gid		int32be
+	gids_len	len[gids, int32be]
+	gids		array[int32be, 0:4]
+} [packed]
+
+rpcsec_gss_proc = 0, 1, 2, 3
+
+rpc_auth_gss {
+	flavor	const[6, int32be]
+	length	len[data, int32be]
+	data	rpc_auth_gss_data
+} [packed]
+
+rpc_auth_gss_data {
+	version		const[1, int32be]
+	gss_proc	flags[rpcsec_gss_proc, int32be]
+	seq_num		int32be
+	service		int32be[1:3]
+	handle_len	len[handle, int32be]
+	handle		array[int8, 0:32]
+} [packed]
+
+rpc_auth_flavors = 0, 1, 2, 3, 6, 390003, 390004, 390005
+
+rpc_auth_generic {
+	flavor	flags[rpc_auth_flavors, int32be]
+	length	len[data, int32be]
+	data	array[int8, 0:64]
+} [packed]
+
+rpc_auth [
+	none	rpc_auth_none
+	sys	rpc_auth_sys
+	gss	rpc_auth_gss
+	raw	rpc_auth_generic
+] [varlen]
+
+# NFS File Handles
+nfs_fh3 {
+	length	len[data, int32be]
+	data	array[int8, 0:64]
+} [packed]
+
+nfs_fh4 {
+	length	len[data, int32be]
+	data	array[int8, 0:128]
+} [packed]
+
+# NFSv3 Calls
+rpc_nfs3_call {
+	xid	int32be
+	mtype	const[0, int32be]
+	rpcvers	const[2, int32be]
+	prog	const[100003, int32be]
+	vers	const[3, int32be]
+	body	nfs3_call_bodies
+} [packed]
+
+nfs3_call_bodies [
+	null_call	nfs3_null_call
+	getattr		nfs3_getattr_call
+	setattr		nfs3_setattr_call
+	lookup		nfs3_lookup_call
+	access		nfs3_access_call
+	read		nfs3_read_call
+	write		nfs3_write_call
+	create		nfs3_create_call
+	mkdir		nfs3_mkdir_call
+	symlink		nfs3_symlink_call
+	mknod		nfs3_mknod_call
+	remove		nfs3_remove_call
+	rmdir		nfs3_rmdir_call
+	rename		nfs3_rename_call
+	link		nfs3_link_call
+	readdir		nfs3_readdir_call
+	readdirplus	nfs3_readdirplus_call
+	fsstat		nfs3_fsstat_call
+	fsinfo		nfs3_fsinfo_call
+	pathconf	nfs3_pathconf_call
+	commit		nfs3_commit_call
+] [varlen]
+
+type nfs3_call_t[PROC, ARGS] {
+	proc	const[PROC, int32be]
+	cred	rpc_auth
+	verf	rpc_auth
+	args	ARGS
+} [packed]
+
+type nfs3_null_call nfs3_call_t[0, nfs3_null_args]
+type nfs3_getattr_call nfs3_call_t[1, nfs3_getattr_args]
+type nfs3_setattr_call nfs3_call_t[2, nfs3_setattr_args]
+type nfs3_lookup_call nfs3_call_t[3, nfs3_lookup_args]
+type nfs3_access_call nfs3_call_t[4, nfs3_access_args]
+type nfs3_read_call nfs3_call_t[6, nfs3_read_args]
+type nfs3_write_call nfs3_call_t[7, nfs3_write_args]
+type nfs3_create_call nfs3_call_t[8, nfs3_create_args]
+type nfs3_mkdir_call nfs3_call_t[9, nfs3_mkdir_args]
+type nfs3_symlink_call nfs3_call_t[10, nfs3_symlink_args]
+type nfs3_mknod_call nfs3_call_t[11, nfs3_mknod_args]
+type nfs3_remove_call nfs3_call_t[12, nfs3_remove_args]
+type nfs3_rmdir_call nfs3_call_t[13, nfs3_rmdir_args]
+type nfs3_rename_call nfs3_call_t[14, nfs3_rename_args]
+type nfs3_link_call nfs3_call_t[15, nfs3_link_args]
+type nfs3_readdir_call nfs3_call_t[16, nfs3_readdir_args]
+type nfs3_readdirplus_call nfs3_call_t[17, nfs3_readdirplus_args]
+type nfs3_fsstat_call nfs3_call_t[18, nfs3_fsstat_args]
+type nfs3_fsinfo_call nfs3_call_t[19, nfs3_fsinfo_args]
+type nfs3_pathconf_call nfs3_call_t[20, nfs3_pathconf_args]
+type nfs3_commit_call nfs3_call_t[21, nfs3_commit_args]
+
+nfs3_null_args {
+	dummy	const[0, int32be]
+} [packed]
+
+nfs3_getattr_args {
+	fh	nfs_fh3
+} [packed]
+
+nfs3_setattr_args {
+	fh		nfs_fh3
+	mode_set	int32be[0:1]
+	mode		int32be
+	uid_set		int32be[0:1]
+	uid		int32be
+	gid_set		int32be[0:1]
+	gid		int32be
+	size_set	int32be[0:1]
+	size		int64be
+	atime_set	int32be[0:2]
+	atime_sec	int32be
+	atime_nsec	int32be
+	mtime_set	int32be[0:2]
+	mtime_sec	int32be
+	mtime_nsec	int32be
+	guard_check	int32be[0:1]
+	guard_sec	int32be
+	guard_nsec	int32be
+} [packed]
+
+nfs3_lookup_args {
+	dir	nfs_fh3
+	name	stringnoz[nfs_path_names]
+} [packed]
+
+nfs3_access_args {
+	fh	nfs_fh3
+	access	flags[nfs3_access_flags, int32be]
+} [packed]
+
+nfs3_access_flags = 0x1, 0x2, 0x4, 0x8, 0x10, 0x20
+
+nfs3_read_args {
+	fh	nfs_fh3
+	offset	int64be
+	count	int32be
+} [packed]
+
+nfs3_write_args {
+	fh	nfs_fh3
+	offset	int64be
+	count	len[data, int32be]
+	stable	flags[nfs3_stable_how, int32be]
+	data	array[int8]
+} [packed]
+
+nfs3_stable_how = 0, 1, 2
+
+nfs3_create_args {
+	dir		nfs_fh3
+	name		stringnoz[nfs_path_names]
+	create_mode	flags[nfs3_create_mode, int32be]
+	verf		array[int8, 8]
+} [packed]
+
+nfs3_create_mode = 0, 1, 2
+
+nfs3_mkdir_args {
+	dir	nfs_fh3
+	name	stringnoz[nfs_path_names]
+} [packed]
+
+nfs3_symlink_args {
+	dir	nfs_fh3
+	name	stringnoz[nfs_path_names]
+	target	stringnoz[nfs_path_names]
+} [packed]
+
+nfs3_mknod_args {
+	dir	nfs_fh3
+	name	stringnoz[nfs_path_names]
+	type	flags[nfs3_ftypes, int32be]
+	major	int32be
+	minor	int32be
+} [packed]
+
+nfs3_ftypes = 1, 2, 3, 4, 5, 6, 7
+
+nfs3_remove_args {
+	dir	nfs_fh3
+	name	stringnoz[nfs_path_names]
+} [packed]
+
+nfs3_rmdir_args {
+	dir	nfs_fh3
+	name	stringnoz[nfs_path_names]
+} [packed]
+
+nfs3_rename_args {
+	from_dir	nfs_fh3
+	from_name	stringnoz[nfs_path_names]
+	to_dir		nfs_fh3
+	to_name		stringnoz[nfs_path_names]
+} [packed]
+
+nfs3_link_args {
+	fh	nfs_fh3
+	dir	nfs_fh3
+	name	stringnoz[nfs_path_names]
+} [packed]
+
+nfs3_readdir_args {
+	dir		nfs_fh3
+	cookie		int64be
+	cookieverf	array[int8, 8]
+	count		int32be
+} [packed]
+
+nfs3_readdirplus_args {
+	dir		nfs_fh3
+	cookie		int64be
+	cookieverf	array[int8, 8]
+	dircount	int32be
+	maxcount	int32be
+} [packed]
+
+nfs3_fsstat_args {
+	fh	nfs_fh3
+} [packed]
+
+nfs3_fsinfo_args {
+	fh	nfs_fh3
+} [packed]
+
+nfs3_pathconf_args {
+	fh	nfs_fh3
+} [packed]
+
+nfs3_commit_args {
+	fh	nfs_fh3
+	offset	int64be
+	count	int32be
+} [packed]
+
+# NFSv4 Compound Call
+rpc_nfs4_call {

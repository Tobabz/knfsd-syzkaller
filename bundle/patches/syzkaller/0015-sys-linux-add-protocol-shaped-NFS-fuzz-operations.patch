diff --git a/tools/syz-nfs-corpus/syz-nfs-corpus.go b/tools/syz-nfs-corpus/syz-nfs-corpus.go
new file mode 100644
index 000000000..a2a667b30
--- /dev/null
+++ b/tools/syz-nfs-corpus/syz-nfs-corpus.go
@@ -0,0 +1,231 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+// syz-nfs-corpus validates that corpus programs retain a typed dependency on
+// the fixed NFS lane.  It deliberately parses syzkaller programs instead of
+// matching their textual serialization.
+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/google/syzkaller/prog"
+	_ "github.com/google/syzkaller/sys"
+)
+
+type programResult struct {
+	File       string   `json:"file"`
+	Calls      int      `json:"calls"`
+	LaneRoots  int      `json:"lane_roots"`
+	NFSOps     int      `json:"nfs_ops"`
+	RawSockets int      `json:"raw_sockets"`
+	RawRecords int      `json:"raw_records"`
+	Features   []string `json:"features,omitempty"`
+	Valid      bool     `json:"valid"`
+	Error      string   `json:"error,omitempty"`
+}
+
+type report struct {
+	Campaign string          `json:"campaign"`
+	Programs int             `json:"programs"`
+	Valid    int             `json:"valid"`
+	Invalid  int             `json:"invalid"`
+	Features []string        `json:"features"`
+	Missing  []string        `json:"missing_features,omitempty"`
+	Results  []programResult `json:"results"`
+}
+
+func main() {
+	input := flag.String("input", "", "program file or directory")
+	campaign := flag.String("campaign", "v41", "v41, v42, or raw")
+	flag.Parse()
+	if *input == "" || (*campaign != "v41" && *campaign != "v42" && *campaign != "raw") {
+		fmt.Fprintln(os.Stderr, "usage: syz-nfs-corpus -input FILE_OR_DIR -campaign v41|v42|raw")
+		os.Exit(2)
+	}
+	target, err := prog.GetTarget("linux", "amd64")
+	if err != nil {
+		fail(err)
+	}
+	files, err := inputFiles(*input)
+	if err != nil {
+		fail(err)
+	}
+	rep := report{Campaign: *campaign, Programs: len(files)}
+	allFeatures := make(map[string]bool)
+	for _, file := range files {
+		res := inspect(target, file, *campaign)
+		if res.Valid {
+			rep.Valid++
+		} else {
+			rep.Invalid++
+		}
+		for _, feature := range res.Features {
+			allFeatures[feature] = true
+		}
+		rep.Results = append(rep.Results, res)
+	}
+	for feature := range allFeatures {
+		rep.Features = append(rep.Features, feature)
+	}
+	sort.Strings(rep.Features)
+	for _, feature := range requiredFeatures(*campaign) {
+		if !allFeatures[feature] {
+			rep.Missing = append(rep.Missing, feature)
+		}
+	}
+	data, err := json.MarshalIndent(rep, "", "  ")
+	if err != nil {
+		fail(err)
+	}
+	fmt.Printf("%s\n", data)
+	if rep.Programs == 0 || rep.Invalid != 0 || len(rep.Missing) != 0 {
+		os.Exit(1)
+	}
+}
+
+func requiredFeatures(campaign string) []string {
+	switch campaign {
+	case "v41":
+		return []string{"commit", "data", "lock", "metadata", "namespace", "readdir", "setattr"}
+	case "v42":
+		return []string{"commit", "copy", "data", "lock", "metadata", "namespace", "readdir", "setattr", "space", "xattr"}
+	case "raw":
+		return []string{"raw_call", "raw_reply", "raw_retry"}
+	}
+	return nil
+}
+
+func inputFiles(path string) ([]string, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		return nil, err
+	}
+	if !info.IsDir() {
+		return []string{path}, nil
+	}
+	entries, err := os.ReadDir(path)
+	if err != nil {
+		return nil, err
+	}
+	var files []string
+	for _, entry := range entries {
+		if !entry.IsDir() {
+			files = append(files, filepath.Join(path, entry.Name()))
+		}
+	}
+	sort.Strings(files)
+	return files, nil
+}
+
+func inspect(target *prog.Target, file, campaign string) programResult {
+	res := programResult{File: file}
+	data, err := os.ReadFile(file)
+	if err != nil {
+		res.Error = err.Error()
+		return res
+	}
+	// syz-db canonicalization omits auto-generated padding fields.  NonStrict
+	// accepts that canonical form; structural lane/resource validation below is
+	// still performed on the parsed Prog rather than its source text.
+	p, err := target.Deserialize(data, prog.NonStrict)
+	if err != nil {
+		res.Error = err.Error()
+		return res
+	}
+	features := make(map[string]bool)
+	for _, call := range p.Calls {
+		res.Calls++
+		name := call.Meta.Name
+		switch {
+		case strings.HasPrefix(name, "syz_open_nfs_lane$"):
+			res.LaneRoots++
+		case strings.HasPrefix(name, "syz_socket_connect_nfs$"):
+			res.RawSockets++
+		case strings.HasPrefix(name, "sendmsg$inet_nfs_fuzz_") ||
+			strings.HasPrefix(name, "syz_send_nfs_fuzz$"):
+			res.RawRecords++
+		case strings.HasSuffix(name, "$nfs") || strings.HasSuffix(name, "$nfs_file") ||
+			strings.HasSuffix(name, "$nfs_dir") || strings.HasSuffix(name, "$nfs_lock") ||
+			strings.HasSuffix(name, "$nfs_user"):
+			res.NFSOps++
+		}
+		if strings.HasPrefix(name, "fallocate$nfs") {
+			features["space"] = true
+		}
+		if name == "copy_file_range" || name == "copy_file_range$nfs" {
+			features["copy"] = true
+		}
+		if strings.Contains(name, "xattr$nfs") {
+			features["xattr"] = true
+		}
+		if strings.HasPrefix(name, "read$nfs") || strings.HasPrefix(name, "pread") ||
+			strings.HasPrefix(name, "write$nfs") || strings.HasPrefix(name, "pwrite") {
+			features["data"] = true
+		}
+		if strings.HasPrefix(name, "readv$nfs") || strings.HasPrefix(name, "writev$nfs") {
+			features["vector_io"] = true
+		}
+		if strings.HasPrefix(name, "fsync$nfs") || strings.HasPrefix(name, "fdatasync$nfs") ||
+			strings.HasPrefix(name, "sync_file_range$nfs") {
+			features["commit"] = true
+		}
+		if strings.HasPrefix(name, "statx$nfs") || strings.HasPrefix(name, "fstat$nfs") ||
+			strings.HasPrefix(name, "faccessat2$nfs") {
+			features["metadata"] = true
+		}
+		if name == "getdents64" {
+			features["readdir"] = true
+		}
+		if strings.HasPrefix(name, "mkdirat$nfs") || strings.HasPrefix(name, "unlinkat$nfs") ||
+			strings.HasPrefix(name, "renameat2$nfs") || strings.HasPrefix(name, "linkat$nfs") ||
+			strings.HasPrefix(name, "symlinkat$nfs") || strings.HasPrefix(name, "readlinkat$nfs") {
+			features["namespace"] = true
+		}
+		if strings.HasPrefix(name, "flock$nfs") || strings.HasPrefix(name, "fcntl$nfs_lock") {
+			features["lock"] = true
+		}
+		if strings.HasPrefix(name, "ftruncate$nfs") || strings.HasPrefix(name, "fchmod") ||
+			strings.HasPrefix(name, "fchown") || strings.HasPrefix(name, "utimensat$nfs") {
+			features["setattr"] = true
+		}
+		if strings.HasPrefix(name, "syz_send_nfs_fuzz$") ||
+			strings.HasPrefix(name, "sendmsg$inet_nfs_fuzz_") {
+			features["raw_call"] = true
+		}
+		if strings.HasPrefix(name, "syz_send_nfs_fuzz$retry") ||
+			strings.HasPrefix(name, "sendmsg$inet_nfs_fuzz_retry") {
+			features["raw_retry"] = true
+		}
+		if strings.HasPrefix(name, "recvfrom$inet_nfs_fuzz") {
+			features["raw_reply"] = true
+		}
+	}
+	for feature := range features {
+		res.Features = append(res.Features, feature)
+	}
+	sort.Strings(res.Features)
+	switch campaign {
+	case "v41":
+		res.Valid = res.LaneRoots > 0 && res.NFSOps > 0
+	case "v42":
+		res.Valid = res.LaneRoots > 0 && res.NFSOps > 0
+	case "raw":
+		res.Valid = res.RawSockets > 0 && res.RawRecords > 0
+	}
+	if !res.Valid {
+		res.Error = "program does not retain the required typed NFS resource graph"
+	}
+	return res
+}
+
+func fail(err error) {
+	fmt.Fprintln(os.Stderr, err)
+	os.Exit(1)
+}

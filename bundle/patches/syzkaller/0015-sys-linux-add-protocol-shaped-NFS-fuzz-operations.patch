index 000000000..188c15d9a
--- /dev/null
+++ b/sys/linux/fs_nfs_fuzz.txt
@@ -0,0 +1,91 @@
+# Copyright 2026 syzkaller project authors. All rights reserved.
+# Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+include <linux/fcntl.h>
+include <linux/falloc.h>
+
+# Resources rooted in the fixed, proc-specific NFS fuzz lane.  The executor
+# imports two mounts at /nfs-lane/client{0,1}; syz_open_nfs_lane is the only
+# producer of the root resource so corpus minimization cannot silently detach
+# an NFS workload from the lane.
+resource fd_nfs[fd]
+resource fd_nfs_dir[fd_dir]
+
+# Keep the kernel ABI layout of struct flock, but do not model l_pid as a
+# producer dependency.  F_SETLK/F_SETLKW ignore the input l_pid field; using
+# the generic flock type would unnecessarily require a pid-producing syscall
+# in the NFS-only campaign.
+nfs_flock {
+	type	flags[flock_type, int16]
+	whence	flags[seek_whence, int16]
+	start	intptr
+	len	intptr
+	pid	int32
+}
+
+# Keep utimensat reachable in a narrow NFS-only campaign without requiring a
+# clock_gettime producer.  These fields have the native timeval/timespec ABI
+# width, but are intentionally plain values rather than time resources.
+nfs_timeval {
+	sec	intptr
+	usec	intptr
+}
+
+nfs_itimerval {
+	interv	nfs_timeval
+	value	nfs_timeval
+}
+
+syz_open_nfs_lane$client0(client const[0]) fd_nfs_dir
+syz_open_nfs_lane$client1(client const[1]) fd_nfs_dir
+
+openat$nfs_file(fd fd_nfs_dir, file ptr[in, filename], flags flags[open_flags], mode flags[open_mode]) fd_nfs
+openat$nfs_dir(fd fd_nfs_dir, file ptr[in, filename], flags flags[open_flags], mode flags[open_mode]) fd_nfs_dir
+
+read$nfs(fd fd_nfs, buf buffer[out], count len[buf])
+pread64$nfs(fd fd_nfs, buf buffer[out], count len[buf], pos fileoff)
+readv$nfs(fd fd_nfs, vec ptr[in, array[iovec_out]], vlen len[vec])
+preadv2$nfs(fd fd_nfs, vec ptr[in, array[iovec_out]], vlen len[vec], off_low int32, off_high int32, flags flags[rwf_flags])
+write$nfs(fd fd_nfs, buf buffer[in], count len[buf])
+pwrite64$nfs(fd fd_nfs, buf buffer[in], count len[buf], pos fileoff)
+writev$nfs(fd fd_nfs, vec ptr[in, array[iovec_in]], vlen len[vec])
+pwritev2$nfs(fd fd_nfs, vec ptr[in, array[iovec_in]], vlen len[vec], off_low int32, off_high int32, flags flags[rwf_flags])
+lseek$nfs(fd fd_nfs, offset fileoff, whence flags[seek_whence]) (ignore_return)
+copy_file_range$nfs(fd_in fd_nfs, off_in ptr[inout, fileoff[int64], opt], fd_out fd_nfs, off_out ptr[inout, fileoff[int64], opt], len intptr, flags flags[copy_file_range_flags])
+fadvise64$nfs(fd fd_nfs, offset fileoff, len intptr, advice flags[fadvise_flags])
+readahead$nfs(fd fd_nfs, off intptr, count intptr)
+fsync$nfs(fd fd_nfs)
+fdatasync$nfs(fd fd_nfs)
+sync_file_range$nfs(fd fd_nfs, off intptr, nbytes intptr, flags flags[sync_file_flags])
+ftruncate$nfs(fd fd_nfs, len intptr)
+fallocate$nfs(fd fd_nfs, mode flags[fallocate_mode], off intptr, len intptr)
+flock$nfs(fd fd_nfs, op flags[flock_op])
+fcntl$nfs_lock(fd fd_nfs, cmd flags[fcntl_lock], lock ptr[in, nfs_flock])
+fstat$nfs(fd fd_nfs, statbuf ptr[out, stat])
+fstatfs$nfs(fd fd_nfs, buf buffer[out])
+fchmod$nfs(fd fd_nfs, mode flags[open_mode])
+fchown$nfs(fd fd_nfs, uid uid, gid gid)
+
+mkdirat$nfs(fd fd_nfs_dir, path ptr[in, filename], mode flags[open_mode])
+unlinkat$nfs(fd fd_nfs_dir, path ptr[in, filename], flags flags[unlinkat_flags])
+renameat2$nfs(oldfd fd_nfs_dir, old ptr[in, filename], newfd fd_nfs_dir, new ptr[in, filename], flags flags[renameat2_flags])
+linkat$nfs(oldfd fd_nfs_dir, old ptr[in, filename], newfd fd_nfs_dir, new ptr[in, filename], flags flags[linkat_flags])
+symlinkat$nfs(old ptr[in, filename], newfd fd_nfs_dir, new ptr[in, filename])
+readlinkat$nfs(fd fd_nfs_dir, path ptr[in, filename], buf buffer[out], siz len[buf])
+statx$nfs(fd fd_nfs_dir, file ptr[in, filename], flags flags[statx_flags], mask flags[statx_mask], statxbuf ptr[out, statx])
+faccessat2$nfs(fd fd_nfs_dir, path ptr[in, filename], mode flags[open_mode], flags flags[faccessat_flags])
+fchmodat$nfs(fd fd_nfs_dir, path ptr[in, filename], mode flags[open_mode])
+fchownat$nfs(fd fd_nfs_dir, path ptr[in, filename], uid uid, gid gid, flags flags[at_flags])
+utimensat$nfs(fd fd_nfs_dir, path ptr[in, filename], times ptr[in, nfs_itimerval], flags flags[utimensat_flags])
+
+fsetxattr$nfs(fd fd_nfs, name ptr[in, xattr_name], val ptr[in, string], size len[val], flags flags[setxattr_flags])
+fgetxattr$nfs(fd fd_nfs, name ptr[in, xattr_name], val buffer[out], size len[val])
+flistxattr$nfs(fd fd_nfs, list buffer[out], size len[list])
+fremovexattr$nfs(fd fd_nfs, name ptr[in, xattr_name])
+
+# Stable user-xattr variants make RFC 8276-backed NFSv4.2 xattr operations
+# reachable from seed programs while the generic variants retain mutation of
+# namespaces and malformed names.
+fsetxattr$nfs_user(fd fd_nfs, name ptr[in, string["user.syz"]], val ptr[in, string], size len[val], flags flags[setxattr_flags])
+fgetxattr$nfs_user(fd fd_nfs, name ptr[in, string["user.syz"]], val buffer[out], size len[val])
+fremovexattr$nfs_user(fd fd_nfs, name ptr[in, string["user.syz"]])

+func TestNFSFixedLaneResources(t *testing.T) {
+	target, err := prog.GetTarget("linux", "amd64")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{
+		"syz_open_nfs_lane$client0",
+		"syz_open_nfs_lane$client1",
+	} {
+		call := requireNFSFuzzCall(t, target, name)
+		if call.CallName != "syz_open_nfs_lane" {
+			t.Fatalf("%s calls %s, want syz_open_nfs_lane", name, call.CallName)
+		}
+		ret, ok := call.Ret.(*prog.ResourceType)
+		if !ok || ret.Desc.Name != "fd_nfs_dir" {
+			t.Fatalf("%s return type is %T %v, want fd_nfs_dir", name, call.Ret, call.Ret)
+		}
+	}
+	for _, name := range []string{
+		"openat$nfs_file", "openat$nfs_dir", "read$nfs", "readv$nfs", "write$nfs", "writev$nfs",
+		"copy_file_range$nfs", "fsync$nfs", "sync_file_range$nfs", "ftruncate$nfs",
+		"flock$nfs", "fcntl$nfs_lock", "fchmod$nfs", "renameat2$nfs", "utimensat$nfs",
+		"fsetxattr$nfs",
+	} {
+		requireNFSFuzzCall(t, target, name)
+	}
+	var dir *prog.ResourceDesc
+	for _, resource := range target.Resources {
+		if resource.Name == "fd_nfs_dir" {
+			dir = resource
+			break
+		}
+	}
+	if dir == nil || !containsString(dir.Kind, "fd_dir") {
+		t.Fatalf("fd_nfs_dir kind is %#v, want fd_dir compatibility for getdents64", dir)
+	}
+	lock := requireStruct(t, requireNFSFuzzCall(t, target, "fcntl$nfs_lock"), "nfs_flock")
+	pid := requireField(t, lock, "pid")
+	if _, ok := pid.Type.(*prog.ResourceType); ok {
+		t.Fatalf("nfs_flock.pid is a resource dependency, want plain int32")
+	}
+	times := requireStruct(t, requireNFSFuzzCall(t, target, "utimensat$nfs"), "nfs_timeval")
+	for _, field := range times.Fields {
+		if _, ok := field.Type.(*prog.ResourceType); ok {
+			t.Fatalf("nfs_timeval.%s is a resource dependency, want a plain native integer", field.Name)
+		}
+	}
+}
+
+func containsString(values []string, want string) bool {
+	for _, value := range values {
+		if value == want {
+			return true
+		}
+	}
+	return false
+}

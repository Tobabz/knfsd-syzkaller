From b59716d550514ce5174910d6df9b8a391659ed11 Mon Sep 17 00:00:00 2001
From: fuzzer <fuzzer@cesrv.local>
Date: Fri, 18 Sep 2026 15:55:46 +0900
Subject: [PATCH 15/15] sys/linux: add protocol-shaped NFS fuzz operations


diff --git a/executor/common_linux.h b/executor/common_linux.h
index 295ca84b6..55a7e93f4 100644
--- a/executor/common_linux.h
+++ b/executor/common_linux.h
@@ -2824,6 +2824,123 @@ static long syz_extract_tcp_res(volatile long a0, volatile long a1, volatile lon
 #include "common_usb_linux.h"
 #endif
 
+#if SYZ_EXECUTOR || __NR_syz_open_nfs_lane || __NR_syz_socket_connect_nfs || \
+    __NR_syz_send_nfs_fuzz
+#include <fcntl.h>
+#include <sched.h>
+#include <stdio.h>
+#include <sys/socket.h>
+
+static int nfs_fuzz_netns_fds[2] = {-1, -1};
+static uint32 nfs_fuzz_server_addrs[2];
+
+static long syz_open_nfs_lane(volatile long a0)
+{
+	// syz_open_nfs_lane(client const[0:1]) fd_nfs_dir
+	unsigned long client = a0;
+	if (client > 1) {
+		errno = EINVAL;
+		return -1;
+	}
+	char path[32];
+	int len = snprintf(path, sizeof(path), "/nfs-lane/client%lu", client);
+	if (len <= 0 || len >= (int)sizeof(path)) {
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	return open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+}
+
+static long syz_socket_connect_nfs(volatile long a0)
+{
+	// syz_socket_connect_nfs(client const[0:1]) sock_nfs_fuzz_tcp
+	unsigned long client = a0;
+	if (client > 1 || nfs_fuzz_netns_fds[client] < 0 ||
+	    !nfs_fuzz_server_addrs[client]) {
+		errno = ENODEV;
+		return -1;
+	}
+
+	int current_netns = open("/proc/self/ns/net", O_RDONLY | O_CLOEXEC);
+	if (current_netns < 0)
+		return -1;
+	if (setns(nfs_fuzz_netns_fds[client], CLONE_NEWNET)) {
+		int saved_errno = errno;
+		close(current_netns);
+		errno = saved_errno;
+		return -1;
+	}
+
+	int fd = socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, IPPROTO_TCP);
+	int saved_errno = 0;
+	if (fd < 0)
+		saved_errno = errno;
+	if (fd >= 0) {
+		int enabled = 1;
+		if (setsockopt(fd, IPPROTO_TCP, 47, &enabled, sizeof(enabled))) {
+			saved_errno = errno;
+			close(fd);
+			fd = -1;
+		} else {
+			struct sockaddr_in addr = {};
+			addr.sin_family = AF_INET;
+			addr.sin_port = htons(2049);
+			addr.sin_addr.s_addr = nfs_fuzz_server_addrs[client];
+			if (connect(fd, (struct sockaddr*)&addr, sizeof(addr))) {
+				saved_errno = errno;
+				close(fd);
+				fd = -1;
+			}
+		}
+	}
+	if (setns(current_netns, CLONE_NEWNET))
+		fail("restore network namespace after NFS fuzz connect failed");
+	close(current_netns);
+	errno = saved_errno;
+	return fd;
+}
+
+static long syz_send_nfs_fuzz(volatile long a0, volatile long a1,
+			      volatile long a2, volatile long a3,
+			      volatile long a4)
+{
+	// syz_send_nfs_fuzz(fd sock_nfs_fuzz_tcp, msg ptr[in, rpc_nfs_call],
+	//                    msglen len[msg], flags const[...], user_tag proc[...])
+	int fd = a0;
+	void* payload = (void*)a1;
+	size_t payload_len = a2;
+	uint32 flags = a3;
+	uint64 user_tag = a4;
+	if (!payload || payload_len < 8 || payload_len > 0x7fffffff || !user_tag) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	uint32 marker = htonl(0x80000000U | (uint32)payload_len);
+	struct iovec iov[2] = {
+		{.iov_base = &marker, .iov_len = sizeof(marker)},
+		{.iov_base = payload, .iov_len = payload_len},
+	};
+	struct {
+		uint32 version;
+		uint32 flags;
+		uint64 user_tag;
+	} control = {1, flags, user_tag};
+	char control_buf[CMSG_SPACE(sizeof(control))] = {};
+	struct msghdr msg = {};
+	msg.msg_iov = iov;
+	msg.msg_iovlen = 2;
+	msg.msg_control = control_buf;
+	msg.msg_controllen = sizeof(control_buf);
+	struct cmsghdr* cmsg = CMSG_FIRSTHDR(&msg);
+	cmsg->cmsg_level = IPPROTO_TCP;
+	cmsg->cmsg_type = 47;
+	cmsg->cmsg_len = CMSG_LEN(sizeof(control));
+	memcpy(CMSG_DATA(cmsg), &control, sizeof(control));
+	return sendmsg(fd, &msg, 0);
+}
+#endif
+
 #if SYZ_EXECUTOR || __NR_syz_open_dev
 #include <fcntl.h>
 #include <string.h>
@@ -4375,6 +4492,32 @@ static void setup_nfs_fuzz_lane(const char* newroot)
 	if (marker_len != expected_len || memcmp(actual, expected, expected_len))
 		failmsg("NFS fuzz lane marker mismatch", "proc=%llu", procid);
 
+	for (unsigned client = 0; client < 2; client++) {
+		char metadata[192];
+		char value[64] = {};
+		if (snprintf(metadata, sizeof(metadata), "%s/.client%u_netns", source, client) >=
+		    (int)sizeof(metadata))
+			fail("NFS fuzz lane network namespace path is too long");
+		nfs_fuzz_netns_fds[client] = open(metadata, O_RDONLY | O_CLOEXEC);
+		if (nfs_fuzz_netns_fds[client] < 0)
+			failmsg("open NFS fuzz lane client network namespace failed", "client=%u", client);
+
+		if (snprintf(metadata, sizeof(metadata), "%s/.server%u_ipv4", source, client) >=
+		    (int)sizeof(metadata))
+			fail("NFS fuzz lane server address path is too long");
+		int fd = open(metadata, O_RDONLY | O_CLOEXEC);
+		if (fd < 0)
+			failmsg("open NFS fuzz lane server address failed", "client=%u", client);
+		memset(value, 0, sizeof(value));
+		ssize_t len = read(fd, value, sizeof(value) - 1);
+		close(fd);
+		unsigned a, b, c, d;
+		if (len <= 0 || sscanf(value, "%u.%u.%u.%u", &a, &b, &c, &d) != 4 ||
+		    a > 255 || b > 255 || c > 255 || d > 255)
+			failmsg("invalid NFS fuzz lane server address", "client=%u", client);
+		nfs_fuzz_server_addrs[client] = htonl((a << 24) | (b << 16) | (c << 8) | d);
+	}
+
 	char target[128];
 	if (snprintf(target, sizeof(target), "%s/nfs-lane", newroot) >= (int)sizeof(target))
 		fail("NFS fuzz lane target path is too long");

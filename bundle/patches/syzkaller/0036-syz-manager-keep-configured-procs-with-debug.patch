 	if subsystem.HasList(cfg.TargetOS) {
 		mgr.crashStore.Extractor = subsystem.MakeExtractor(subsystem.GetList(cfg.TargetOS))
 	}
-	if *flagDebug {
-		mgr.cfg.Procs = 1
-	}
 	mgr.http = &manager.HTTPServer{
 		// Note that if cfg.HTTP == "", we don't start the server.
 		Cfg:        cfg,

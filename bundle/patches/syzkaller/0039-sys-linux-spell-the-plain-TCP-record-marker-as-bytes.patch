From 218fcbb944e9cafe04507baad5f2c4393822d5c3 Mon Sep 17 00:00:00 2001
From: ci <ci@localhost>
Date: Tue, 27 Oct 2026 17:41:54 +0000
Subject: [PATCH] sys/linux: spell the plain TCP record marker as bytes

rpc_tcp_nfs3_single_call and rpc_tcp_nfs4_single_call split the RPC
record marker into frag_len int32be:31 and last_frag int32be:1.  The
second big-endian bitfield is encoded at struct offset 3, so the
last-fragment bit lands in the xid and the marker reaches the wire as
00 00 00 len: the server waits for another fragment.

Spell the marker as in rpc_tcp_nfs41_record_t (0x80, 0, int16be length)
and check the executed bytes of generated records, not the field shape.
---
 sys/linux/nfs_fuzz_test.go    | 128 ++++++++++++++++++++++++++++++++--
 sys/linux/socket_inet_nfs.txt |  12 ++--
 2 files changed, 129 insertions(+), 11 deletions(-)

diff --git a/sys/linux/nfs_fuzz_test.go b/sys/linux/nfs_fuzz_test.go
index 0209d4337..f70dd2066 100644
--- a/sys/linux/nfs_fuzz_test.go
+++ b/sys/linux/nfs_fuzz_test.go
@@ -5,6 +5,7 @@ package linux_test
 
 import (
 	"fmt"
+	"math/rand"
 	"testing"
 
 	"github.com/google/syzkaller/prog"
@@ -61,6 +62,7 @@ func TestNFSRawRPCSend(t *testing.T) {
 		t.Fatalf("write variant calls %s, want ordinary write", write.CallName)
 	}
 	requireSingleRPCRecords(t, write)
+	requireSingleRPCRecordWire(t, target)
 	for _, gone := range []string{
 		"setsockopt$inet_nfs_fuzz", "sendmsg$inet_nfs_fuzz_new",
 		"sendmsg$inet_nfs_fuzz_cancel",
@@ -142,15 +144,127 @@ func requireSingleRPCRecords(t *testing.T, call *prog.Syscall) {
 	t.Helper()
 	for _, name := range []string{"rpc_tcp_nfs3_single_call", "rpc_tcp_nfs4_single_call"} {
 		record := requireStruct(t, call, name)
-		if record.Fields[0].Name != "frag_len" || record.Fields[1].Name != "last_frag" {
-			t.Fatalf("%s %s Record Marker fields are %s/%s, want 31-bit length then MSB last_frag",
-				call.Name, name, record.Fields[0].Name, record.Fields[1].Name)
+		requireConst(t, requireField(t, record, "last_frag").Type, 0x80, call.Name+" "+name+" last_frag")
+		requireConst(t, requireField(t, record, "frag_len_hi").Type, 0, call.Name+" "+name+" frag_len_hi")
+	}
+}
+
+// requireSingleRPCRecordWire checks the bytes the executor writes, not the
+// description: the marker of every generated record is
+// 0x80000000 | (record size - 4).  A 31/1 split of one int32be passed a
+// shape check but put the last-fragment bit outside the marker.
+func requireSingleRPCRecordWire(t *testing.T, target *prog.Target) {
+	t.Helper()
+	write := requireNFSFuzzCall(t, target, "write$inet_nfs_fuzz")
+	enabled := map[*prog.Syscall]bool{
+		requireNFSFuzzCall(t, target, "socket$inet_nfs_fuzz_tcp"): true,
+		write: true,
+	}
+	ct := target.BuildChoiceTable(nil, enabled)
+	rs := rand.NewSource(1)
+	seen := 0
+	for i := 0; i < 1000; i++ {
+		p := target.Generate(rs, 4, ct)
+		seen += checkRecordMarkers(t, target, p, write, true)
+		for j := 0; j < 3; j++ {
+			p.Mutate(rs, 4, ct, nil, nil)
+		}
+		checkRecordMarkers(t, target, p, write, false)
+	}
+	if seen < 500 {
+		t.Fatalf("checked %d %s records, want at least 100", seen, write.Name)
+	}
+}
+
+// checkRecordMarkers checks the marker of each structured record of p.
+// Mutation may change frag_len like any length, so a mutated record keeps
+// only the last-fragment bit and the zero high byte.
+func checkRecordMarkers(t *testing.T, target *prog.Target, p *prog.Prog, write *prog.Syscall, exact bool) int {
+	t.Helper()
+	data, err := p.SerializeForExec()
+	if err != nil {
+		t.Fatal(err)
+	}
+	exec, err := target.DeserializeExec(data, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seen := 0
+	for i, call := range exec.Calls {
+		mem := map[uint64]byte{}
+		for _, copyin := range call.Copyin {
+			storeExecArg(t, mem, copyin.Addr, copyin.Arg)
+		}
+		if call.Meta != write {
+			continue
+		}
+		// A squashed record (ANY blob) is raw bytes: nothing spells its
+		// marker.
+		ptr, ok := p.Calls[i].Args[1].(*prog.PointerArg)
+		if !ok || ptr.Res == nil || ptr.Res.Type().TemplateName() != "rpc_tcp_nfs_single_call" {
+			continue
+		}
+		// The record's own size: mutation may change the write length.
+		buf := call.Args[1].(prog.ExecArgConst).Value
+		size := ptr.Res.Size()
+		if size < 4 {
+			t.Fatalf("%s record is %d bytes", write.Name, size)
+		}
+		var marker uint64
+		for k := uint64(0); k < 4; k++ {
+			marker = marker<<8 | uint64(mem[buf+k])
+		}
+		want, mask := 0x80000000|(size-4), uint64(0xffffffff)
+		if !exact {
+			want, mask = 0x80000000, 0xffff0000
+		}
+		if marker&mask != want {
+			t.Fatalf("%s record marker is %#08x, want %#08x\n%s", write.Name, marker, want, p.Serialize())
+		}
+		seen++
+	}
+	return seen
+}
+
+// storeExecArg stores a copyin as the executor's copyin_int and data
+// copy do.
+func storeExecArg(t *testing.T, mem map[uint64]byte, addr uint64, arg prog.ExecArg) {
+	t.Helper()
+	switch a := arg.(type) {
+	case prog.ExecArgConst:
+		load := func() uint64 {
+			var v uint64
+			for k := uint64(0); k < a.Size; k++ {
+				if a.Format == prog.FormatBigEndian {
+					v = v<<8 | uint64(mem[addr+k])
+				} else {
+					v |= uint64(mem[addr+k]) << (8 * k)
+				}
+			}
+			return v
+		}
+		value := a.Value
+		if a.BitfieldLength != 0 {
+			mask := (uint64(1)<<a.BitfieldLength - 1) << a.BitfieldOffset
+			value = load()&^mask | value<<a.BitfieldOffset&mask
+		}
+		for k := uint64(0); k < a.Size; k++ {
+			if a.Format == prog.FormatBigEndian {
+				mem[addr+k] = byte(value >> (8 * (a.Size - 1 - k)))
+			} else {
+				mem[addr+k] = byte(value >> (8 * k))
+			}
+		}
+	case prog.ExecArgData:
+		for k, b := range a.Data {
+			mem[addr+uint64(k)] = b
 		}
-		last := requireField(t, record, "last_frag")
-		requireConst(t, last.Type, 1, call.Name+" "+name+" last_frag")
-		if last.Type.BitfieldLength() != 1 {
-			t.Fatalf("%s %s last_frag is %d bits, want 1", call.Name, name, last.Type.BitfieldLength())
+	case prog.ExecArgResult:
+		for k := uint64(0); k < a.Size; k++ {
+			mem[addr+k] = 0
 		}
+	default:
+		t.Fatalf("unexpected copyin %T", arg)
 	}
 }
 
diff --git a/sys/linux/socket_inet_nfs.txt b/sys/linux/socket_inet_nfs.txt
index 367073349..86103ac72 100644
--- a/sys/linux/socket_inet_nfs.txt
+++ b/sys/linux/socket_inet_nfs.txt
@@ -333,15 +333,19 @@ rpc_nfs_call [
 
 # Tagged data actions deliberately expose only a complete, single-fragment RPC
 # record.  Fragmented or batched records are rejected by the kernel ABI.
+# The record marker is spelled as bytes, as in rpc_tcp_nfs41_record_t: a 31/1
+# split of one int32be puts the last-fragment bit in the wrong byte.
 rpc_tcp_nfs3_single_call {
-	frag_len	bytesize[msg, int32be:31]
-	last_frag	const[1, int32be:1]
+	last_frag	const[0x80, int8]
+	frag_len_hi	const[0, int8]
+	frag_len	bytesize[msg, int16be]
 	msg		rpc_nfs3_call
 } [packed]
 
 rpc_tcp_nfs4_single_call {
-	frag_len	bytesize[msg, int32be:31]
-	last_frag	const[1, int32be:1]
+	last_frag	const[0x80, int8]
+	frag_len_hi	const[0, int8]
+	frag_len	bytesize[msg, int16be]
 	msg		rpc_nfs4_call
 } [packed]
 
-- 
2.43.0


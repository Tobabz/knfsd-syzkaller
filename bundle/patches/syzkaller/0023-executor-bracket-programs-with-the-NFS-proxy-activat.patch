+++ b/executor/nfs_proxy_activation_test.go
@@ -0,0 +1,191 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package executor
+
+import (
+	"bytes"
+	"os"
+	"testing"
+)
+
+// The barrier's behaviour on every proxy answer is covered by test_nfsp_barrier
+// (executor test).  These checks pin where the executor runs it.
+
+func nfspSection(t *testing.T, file, start, end string) []byte {
+	source, err := os.ReadFile(file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	from := bytes.Index(source, []byte(start))
+	if from < 0 {
+		t.Fatalf("%s: missing %q", file, start)
+	}
+	to := bytes.Index(source[from:], []byte(end))
+	if to < 0 {
+		t.Fatalf("%s: missing %q after %q", file, end, start)
+	}
+	return source[from : from+to]
+}
+
+func nfspRequireOrder(t *testing.T, what string, body []byte, markers ...string) {
+	last := -1
+	for _, marker := range markers {
+		pos := bytes.Index(body, []byte(marker))
+		if pos < 0 {
+			t.Fatalf("%s: missing %q", what, marker)
+		}
+		if pos < last {
+			t.Fatalf("%s: %q is out of order", what, marker)
+		}
+		last = pos
+	}
+}
+
+func TestNfsProxyBarrierBracketsProgram(t *testing.T) {
+	body := nfspSection(t, "executor.cc", "void execute_one()", "thread_t* schedule_call")
+	nfspRequireOrder(t, "execute_one", body,
+		// Activation is keyed to the generation BEGIN returned and published.
+		"output_data->kcov_generation.store(generation, std::memory_order_release);",
+		// A managed program asks even with generation zero (BEGIN failed),
+		// and runs only on a yes.
+		"if (nfsp_target_mode && remote_generation_managed) {",
+		"nfsp_windowed = nfsp_program_activate(generation);",
+		"nfsp_skip_program = !nfsp_windowed;",
+		// Without an ACK no program syscall runs.
+		"if (nfsp_skip_program)\n\t\t\tbreak;",
+		"uint64 call_num = read_input(&input_pos);",
+		// A program that ran in a window hands its end to the fork server.
+		"nfsp_program_done(valid);",
+		"cover_abort_remote_generation(generation, false);",
+		"cover_finish_remote_generation(generation",
+	)
+}
+
+func TestNfsProxyOrphanReleasePrecedesKcovAbort(t *testing.T) {
+	body := nfspSection(t, "common.h", `debug("killing hanging pid %d\n", pid);`, "WEXITSTATUS(status) == kFailStatus")
+	nfspRequireOrder(t, "loop", body,
+		"kill_and_wait(pid, &status);",
+		"nfsp_broker_end();",
+		"cover_abort_remote_generation(orphan_generation, true)",
+	)
+}
+
+func TestNfsProxyEndpointConnectsBeforeChroot(t *testing.T) {
+	lane := nfspSection(t, "common_linux.h", "static void setup_nfs_fuzz_lane(", "\n}\n")
+	nfspRequireOrder(t, "setup_nfs_fuzz_lane", lane,
+		"NFS fuzz lane marker mismatch",
+		"nfsp_setup_activation(source, newroot);",
+	)
+	body := nfspSection(t, "common_linux.h", "static void sandbox_common_mount_tmpfs(void)", "\n}\n")
+	nfspRequireOrder(t, "sandbox_common_mount_tmpfs", body,
+		`setup_nfs_fuzz_lane("./syz-tmp/newroot");`,
+		`chroot("./newroot")`,
+	)
+	setup := nfspSection(t, "executor.cc", "static void nfsp_setup_activation(const char* lane_source, const char* newroot)\n{", "\n}\n")
+	nfspRequireOrder(t, "nfsp_setup_activation", setup,
+		"SOCK_SEQPACKET | SOCK_CLOEXEC",
+		"dup3(fd, kNfspActivationFd, O_CLOEXEC)",
+		"nfsp_endpoint.fd = kNfspActivationFd;",
+		"nfsp_setup_cgroup(newroot);",
+		"nfsp_target_mode = true;",
+	)
+	// Machine-check probes come without remote coverage; they must not be
+	// refused here (they run without a window).
+	if bytes.Contains(setup, []byte("flag_extra_coverage")) {
+		t.Fatal("nfsp_setup_activation must not require remote coverage")
+	}
+}
+
+// The program process runs fuzzed syscalls, so it must not hold the endpoint:
+// the fork server brokers its barrier over a per-program pair.
+func TestNfsProxyProgramProcessHasNoEndpoint(t *testing.T) {
+	body := nfspSection(t, "common.h", "nfsp_broker_prefork();", "reply_execute(0);")
+	nfspRequireOrder(t, "loop", body,
+		"int pid = fork();",
+		"nfsp_broker_child();",
+		"execute_one();",
+		"nfsp_broker_parent();",
+		"nfsp_broker_wait(10);",
+		"waitpid(-1, &status, WNOHANG | WAIT_FLAGS) == pid",
+		"nfsp_broker_end();",
+	)
+	child := nfspSection(t, "executor.cc", "static void nfsp_broker_child()\n{", "\n}\n")
+	nfspRequireOrder(t, "nfsp_broker_child", child,
+		"nfsp_cg_join(kNfspCgroupFd)",
+		"close(kNfspCgroupFd);",
+		"close(kNfspActivationFd);",
+		"close(nfsp_broker_state.fd);",
+	)
+	// The program process reaches the broker only through its pair.
+	program := nfspSection(t, "executor.cc", "void execute_one()", "thread_t* schedule_call")
+	if bytes.Contains(program, []byte("nfsp_endpoint")) || bytes.Contains(program, []byte("nfsp_act_")) {
+		t.Fatal("execute_one must not use the activation endpoint")
+	}
+	// The barrier result is published by the fork server after the program
+	// process is gone, not by the program process.
+	end := nfspSection(t, "executor.cc", "static void nfsp_broker_end()\n{", "\n}\n")
+	nfspRequireOrder(t, "nfsp_broker_end", end,
+		"nfsp_cg_empty(kNfspCgroupFd",
+		"nfsp_broker_finish(&nfsp_endpoint, &nfsp_broker_state, gone);",
+		"output_data->nfsp = nfsp_broker_state.b;",
+	)
+}
+
+func TestNfsProxyUnclearedLeaseFailsRunner(t *testing.T) {
+	body := nfspSection(t, "executor_runner.h", "void HandleCompletion(", "bool ReadResponse(")
+	nfspRequireOrder(t, "HandleCompletion", body,
+		// The result, with its barrier, reaches the manager first.
+		"conn_.Send(data.data(), data.size());",
+		"if (nfsp.lease != NFSP_ACT_LEASE_CLEAR)",
+		`failmsg("NFS proxy activation not cleared"`,
+		"resp_mem_->Reset();",
+	)
+}
+
+// DONE comes over a pair that fuzzed syscalls can write to, so it is only a
+// request: the fork server freezes the program's cgroup, ends the KCOV
+// generation and publishes, kills the program, and closes the window only once
+// the cgroup is empty.  Nothing of the program runs after its window, not even
+// the teardown of its descriptors.
+func TestNfsProxyForkServerEndsTheProgram(t *testing.T) {
+	loop := nfspSection(t, "common.h", "nfsp_broker_wait(10);", "reply_execute(0);")
+	nfspRequireOrder(t, "loop", loop,
+		"if (nfsp_broker_state.done) {",
+		"nfsp_broker_end_program();",
+		"kill_and_wait(pid, &status);",
+		"nfsp_broker_end();",
+		"!nfsp_broker_kcov_resolved()",
+	)
+	end := nfspSection(t, "executor.cc", "static void nfsp_broker_end_program()\n{", "\n}\n")
+	nfspRequireOrder(t, "nfsp_broker_end_program", end,
+		"nfsp_cg_freeze(kNfspCgroupFd",
+		"if (frozen && k->done_valid)",
+		"cover_finish_remote_generation(generation",
+		"write_extra_output();",
+	)
+	if bytes.Contains(end, []byte("nfsp_act_release")) {
+		t.Fatal("nfsp_broker_end_program must leave the window open")
+	}
+	finish := nfspSection(t, "nfs_proxy_activation.h", "static void nfsp_broker_finish(", "\n}\n")
+	nfspRequireOrder(t, "nfsp_broker_finish", finish,
+		"if (gone)",
+		"nfsp_act_release(ep, &k->b);",
+		"if (k->violation || !gone)",
+	)
+	setup := nfspSection(t, "common_linux.h", "static void setup_cgroups_loop()", "\n}\n")
+	nfspRequireOrder(t, "setup_cgroups_loop", setup,
+		"if (!nfsp_target_mode)",
+		`write_file(file, "%d", pid);`,
+	)
+	done := nfspSection(t, "executor.cc", "static NORETURN void nfsp_program_done(bool valid)\n{", "\n}\n")
+	nfspRequireOrder(t, "nfsp_program_done", done,
+		"nfsp_broker_send(kNfspBrokerFd, NFSP_BROKER_DONE",
+		"for (;;)",
+	)
+	// The program process itself never closes the window or answers for it.
+	program := nfspSection(t, "executor.cc", "void execute_one()", "thread_t* schedule_call")
+	if bytes.Contains(program, []byte("NFSP_BROKER_DONE")) {
+		t.Fatal("execute_one must end a windowed program through nfsp_program_done")
+	}
+}

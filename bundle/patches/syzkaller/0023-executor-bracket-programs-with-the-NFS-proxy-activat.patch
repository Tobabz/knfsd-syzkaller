@@ -152,6 +176,14 @@ struct alignas(8) OutputData {
 	// This lives in shared memory so the fork-server watchdog can abort a
 	// generation left behind by a killed child.
 	std::atomic<uint64> kcov_generation;
+#if GOOS_linux
+	// NFS proxy activation barrier of the executing program (nfs_proxy_activation.h).
+	// In shared memory so that the fork server can end a lease left behind by a
+	// dead child, and the runner can report the barrier and refuse to reuse a lane
+	// whose lease was not confirmed released.  Both read it only after the
+	// program process exited.
+	nfsp_act_barrier nfsp;
+#endif
 	std::atomic<flatbuffers::Offset<flatbuffers::Vector<uint8_t>>> result_offset;
 	struct {
 		// Call index in the test program (they may be out-of-order is some syscalls block).
@@ -167,6 +199,9 @@ struct alignas(8) OutputData {
 		completed.store(0, std::memory_order_relaxed);
 		num_calls.store(0, std::memory_order_relaxed);
 		kcov_generation.store(0, std::memory_order_relaxed);
+#if GOOS_linux
+		memset(&nfsp, 0, sizeof(nfsp));
+#endif
 		result_offset.store(0, std::memory_order_relaxed);
 	}
 };
@@ -301,6 +336,19 @@ static uint64 request_id;
 static rpc::RequestType request_type;
 static uint64 all_call_signal;
 static bool all_extra_signal;
+static uint64 request_prog_size;
+
+#if GOOS_linux
+// NFS proxy target mode: set when the fixture gives this proc an activation
+// endpoint (nfsp_setup_activation).  The connection is kNfspActivationFd.
+static bool nfsp_target_mode;
+static nfsp_act_endpoint nfsp_endpoint = {-1, {}, 0};
+// Fork server: the barrier of the program process it is running.
+static nfsp_broker nfsp_broker_state = {-1, NULL, 0, 0, 0, 0, {}};
+static int nfsp_broker_child_fd = -1;
+// The fork server finished or aborted the program's KCOV generation itself.
+static bool nfsp_broker_kcov_done;
+#endif
 
 // Tunable timeouts, received with execute_req.
 static uint64 syscall_timeout_ms;
@@ -453,6 +501,9 @@ struct execute_req {
 	uint64 all_call_signal;
 	bool all_extra_signal;
 	bool return_error;
+	// Length of the exec-encoded program in the input region (its SHA-256 is the
+	// NFS proxy activation's program digest).
+	uint64 prog_size;
 };
 
 struct execute_reply {
@@ -891,6 +942,7 @@ void parse_execute(const execute_req& req)
 	all_call_signal = req.all_call_signal;
 	all_extra_signal = req.all_extra_signal;
 	flag_return_error = req.return_error;
+	request_prog_size = req.prog_size;
 
 	debug("[%llums] exec opts: reqid=%llu type=%llu procid=%llu threaded=%d cover=%d comps=%d dedup=%d signal=%d "
 	      " sandbox=%d/%d/%d/%d timeouts=%llu/%llu/%llu kernel_64_bit=%d\n",
@@ -916,9 +968,10 @@ void reply_execute(uint32 status)
 		fail("control pipe write failed");
 }
 
-void realloc_output_data()
-{
 #if SYZ_EXECUTOR_USES_FORK_SERVER
+// The output region this request needs.
+static uint32 request_output_size()
+{
 	/*
 	 * A request that collects remote coverage can carry up to kExtraCoverSize
 	 * entries in the extra record alone - 8 MiB of PCs on a 64-bit host - on
@@ -937,11 +990,20 @@ void realloc_output_data()
 		(kExtraCoverSize + kRemoteCoverCallHeadroom) * (int)sizeof(uint64_t);
 
 	if (flag_comparisons)
-		mmap_output(kMaxOutputComparisons);
-	else if (flag_collect_cover)
-		mmap_output(kMaxOutputCoverage);
-	else if (flag_collect_signal)
-		mmap_output(kMaxOutputSignal);
+		return kMaxOutputComparisons;
+	if (flag_collect_cover)
+		return kMaxOutputCoverage;
+	if (flag_collect_signal)
+		return kMaxOutputSignal;
+	return 0;
+}
+#endif
+
+void realloc_output_data()
+{
+#if SYZ_EXECUTOR_USES_FORK_SERVER
+	if (uint32 size = request_output_size())
+		mmap_output(size);
 	if (close(kOutFd) < 0)
 		fail("failed to close kOutFd");
 #endif
@@ -966,6 +1028,267 @@ void execute_glob()
 	output_data->result_offset.store(off, std::memory_order_release);
 }
 
+#if GOOS_linux
+// NFS proxy target mode (knfsd-syzkaller S1a, 01-architecture.md §16 there).
+//
+// The fixture marks a proc for target mode with /syz-nfs-lanes/proc-N/activation/
+// holding the proxy's activation.sock and the installed rule_set_id.  That tree
+// stays outside the sandbox chroot, so the endpoint is reachable only through
+// kNfspActivationFd, connected here before the chroot.  Only the fork server
+// uses it: it runs each program's barrier as that program's broker
+// (nfsp_broker in nfs_proxy_activation.h), and the program process, which
+// runs the fuzzed syscalls, closes its inherited copy before anything else.
+static void nfsp_setup_cgroup(const char* newroot);
+
+static void nfsp_setup_activation(const char* lane_source, const char* newroot)
+{
+	char dir[160], path[192];
+	if (snprintf(dir, sizeof(dir), "%s/activation", lane_source) >= (int)sizeof(dir))
+		fail("NFS proxy activation path is too long");
+	if (access(dir, F_OK)) {
+		if (errno == ENOENT)
+			return;
+		failmsg("access NFS proxy activation directory failed", "path=%s", dir);
+	}
+	// Fail closed from here on: a lane that asks for target mode never runs
+	// programs without the barrier.
+	// Remote coverage is not required here: machine-check feature probes come
+	// without it.  A request without a managed KCOV generation opens no window,
+	// so the proxy relays it unmutated (execute_one).
+	if (flag_snapshot)
+		fail("NFS proxy target mode does not support snapshot mode");
+	snprintf(path, sizeof(path), "%s/rule_set_id", dir);
+	char id[NFSP_ACT_RULE_SET_ID_LEN + 2] = {};
+	int fd = open(path, O_RDONLY);
+	if (fd == -1)
+		failmsg("open NFS proxy rule_set_id failed", "path=%s", path);
+	ssize_t n = read(fd, id, sizeof(id));
+	close(fd);
+	if (n == NFSP_ACT_RULE_SET_ID_LEN + 1 && id[NFSP_ACT_RULE_SET_ID_LEN] == '\n')
+		n--;
+	if (n < 0 || !nfsp_act_valid_rule_set_id(id, n))
+		failmsg("bad NFS proxy rule_set_id", "path=%s", path);
+	memcpy(nfsp_endpoint.rule_set_id, id, NFSP_ACT_RULE_SET_ID_LEN);
+
+	struct sockaddr_un addr = {};
+	addr.sun_family = AF_UNIX;
+	if (snprintf(addr.sun_path, sizeof(addr.sun_path), "%s/activation.sock", dir) >= (int)sizeof(addr.sun_path))
+		fail("NFS proxy activation socket path is too long");
+	fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+	if (fd == -1)
+		fail("NFS proxy activation socket failed");
+	if (connect(fd, (struct sockaddr*)&addr, sizeof(addr)))
+		failmsg("connect NFS proxy activation endpoint failed", "path=%s", addr.sun_path);
+	if (dup3(fd, kNfspActivationFd, O_CLOEXEC) != kNfspActivationFd)
+		fail("dup NFS proxy activation fd failed");
+	close(fd);
+	nfsp_endpoint.fd = kNfspActivationFd;
+	nfsp_setup_cgroup(newroot);
+	nfsp_target_mode = true;
+	debug("NFS proxy target mode: proc=%llu endpoint=%s\n", procid, addr.sun_path);
+}
+
+// Whether a program process can join `dir`.  With nsdelegate (systemd's
+// cgroup2 mount) only a cgroup inside the sandbox's cgroup namespace can be.
+static bool nfsp_cgroup_joinable(int dir)
+{
+	int pid = fork();
+	if (pid < 0)
+		fail("NFS proxy cgroup probe fork failed");
+	if (pid == 0)
+		doexit(nfsp_cg_join(dir) ? 0 : 1);
+	int status = 0;
+	while (waitpid(pid, &status, __WALL) != pid) {
+	}
+	return WIFEXITED(status) && WEXITSTATUS(status) == 0;
+}
+
+// The program cgroup.  With the cgroups feature it is the one programs see as
+// ./cgroup (setup_cgroups_test), so that the cgroups they create and move into
+// stay inside it, and the fork server stays out of it (setup_cgroups_loop).
+// Otherwise, or when the sandbox cannot reach that one, it is a private one
+// under the sandbox's cgroup namespace root, from a cgroup2 mount that is
+// detached again at once.
+static void nfsp_setup_cgroup(const char* newroot)
+{
+	char path[192];
+	int dir = -1;
+	if (flag_cgroups) {
+		snprintf(path, sizeof(path), "/syzcgroup/unified/syz%llu", procid);
+		if (mkdir(path, 0777) && errno != EEXIST)
+			debug("mkdir(%s) failed: %d\n", path, errno);
+		dir = open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+		if (dir != -1 && !nfsp_cgroup_joinable(dir)) {
+			debug("NFS proxy: %s is outside the sandbox cgroup namespace\n", path);
+			close(dir);
+			dir = -1;
+		}
+	}
+	if (dir == -1) {
+		if (snprintf(path, sizeof(path), "%s/syz-nfsp-cgroup", newroot) >= (int)sizeof(path))
+			fail("NFS proxy cgroup mount path is too long");
+		if (mkdir(path, 0700) || mount("none", path, "cgroup2", 0, NULL))
+			failmsg("mount cgroup2 for NFS proxy target mode failed", "path=%s", path);
+		int root = open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+		if (umount2(path, MNT_DETACH) || rmdir(path))
+			failmsg("detach NFS proxy cgroup mount failed", "path=%s", path);
+		if (root == -1)
+			fail("open NFS proxy cgroup root failed");
+		snprintf(path, sizeof(path), "syz-nfsp%llu", procid);
+		if (mkdirat(root, path, 0700) && errno != EEXIST)
+			failmsg("mkdir NFS proxy program cgroup failed", "path=%s", path);
+		dir = openat(root, path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+		close(root);
+		if (dir == -1)
+			failmsg("open NFS proxy program cgroup failed", "path=%s", path);
+		if (!nfsp_cgroup_joinable(dir))
+			failmsg("NFS proxy program cgroup cannot be joined", "path=%s", path);
+	}
+	if (dup3(dir, kNfspCgroupFd, O_CLOEXEC) != kNfspCgroupFd)
+		fail("dup NFS proxy program cgroup fd failed");
+	close(dir);
+	// Whatever a previous executor (or the probe) left there.
+	if (!nfsp_cg_empty(kNfspCgroupFd, 1000))
+		fail("NFS proxy program cgroup does not empty");
+}
+
+// Fork server, before fork(): a fresh broker pair for this one program.  The
+// child's end is at kNfspBrokerFd.
+static void nfsp_broker_prefork()
+{
+	if (!nfsp_target_mode)
+		return;
+	int sv[2];
+	if (socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, sv))
+		fail("NFS proxy broker socketpair failed");
+	if (dup3(sv[1], kNfspBrokerFd, O_CLOEXEC) != kNfspBrokerFd)
+		fail("dup NFS proxy broker fd failed");
+	close(sv[1]);
+	nfsp_broker_child_fd = kNfspBrokerFd;
+	// The program bytes are the fork server's own copy of the request.
+	nfsp_broker_start(&nfsp_broker_state, sv[0], input_data,
+			  std::min<uint64>(request_prog_size, kMaxInput));
+	nfsp_broker_kcov_done = false;
+	// The fork server kills a program that completes no syscall for
+	// syscall_timeout_ms * 20 (loop() in common.h).  A barrier waits on the
+	// host journal, so bound it well below that.
+	nfsp_endpoint.timeout_ms = syscall_timeout_ms * 10;
+}
+
+// Program process, right after fork(): join the program cgroup and keep only
+// its end of the pair.
+static void nfsp_broker_child()
+{
+	if (!nfsp_target_mode)
+		return;
+	if (!nfsp_cg_join(kNfspCgroupFd))
+		fail("NFS proxy program process failed to join its cgroup");
+	close(kNfspCgroupFd);
+	close(kNfspActivationFd);
+	close(nfsp_broker_state.fd);
+	nfsp_endpoint.fd = -1;
+	nfsp_broker_state.fd = -1;
+}
+
+// Fork server, after fork().
+static void nfsp_broker_parent()
+{
+	if (!nfsp_target_mode)
+		return;
+	close(nfsp_broker_child_fd);
+	nfsp_broker_child_fd = -1;
+}
+
+// Fork server, in place of its 10ms watchdog sleep.  Returns with
+// nfsp_broker_state.done set once the program asked to end.
+static void nfsp_broker_wait(int timeout_ms)
+{
+	if (!nfsp_target_mode) {
+		sleep_ms(timeout_ms);
+		return;
+	}
+	uint64 start = current_time_ms();
+	nfsp_broker_serve(&nfsp_endpoint, &nfsp_broker_state, timeout_ms);
+	uint64 spent = current_time_ms() - start;
+	if (!nfsp_broker_state.done && spent < (uint64)timeout_ms)
+		sleep_ms(timeout_ms - spent);
+}
+
+// Fork server: the program asked to end (DONE, which fuzzed syscalls can also
+// send).  Freeze it, then end the KCOV generation and publish its remote
+// coverage while nothing of the program runs.  The caller then kills it, and
+// nfsp_broker_end closes the window once its cgroup is empty.  The window is
+// still open here, and only a frozen program's generation is FINISHed.
+static void nfsp_broker_end_program()
+{
+	nfsp_broker* k = &nfsp_broker_state;
+	bool frozen = nfsp_cg_freeze(kNfspCgroupFd, syscall_timeout_ms * 10);
+	if (!frozen)
+		debug("NFS proxy: program did not freeze\n");
+	uint64 generation = k->b.generation;
+	bool finished = false;
+	if (frozen && k->done_valid)
+		finished = cover_finish_remote_generation(generation, 1000 * slowdown_scale);
+	if (finished || cover_abort_remote_generation(generation, false))
+		nfsp_broker_kcov_done = true;
+	if (finished) {
+		// FINISH published the generation's aggregate into extra_cov, which
+		// this process maps too.  Append it to the program's output.
+		mmap_output(request_output_size());

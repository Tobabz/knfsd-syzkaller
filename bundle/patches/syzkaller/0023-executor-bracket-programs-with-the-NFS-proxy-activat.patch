+	activation_status	:uint32;
+	deactivation		:NfsProxyBarrierRaw;
+	deactivation_status	:uint32;
+	// The program's syscalls ran.  Without an activation ACK the program is not executed
+	// and the execution, together with any mutation evidence, is inconclusive.
+	executed		:bool;
+	// The executor confirmed that the proxy holds no activation of this generation

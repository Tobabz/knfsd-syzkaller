+// nfsProxyBarrier formats the NFS proxy activation barrier of one execution.
+// Without an ACKed activation the program did not run and the execution is
+// inconclusive; without lease_cleared the runner refused to reuse the lane.
+func nfsProxyBarrier(b *flatrpc.NfsProxyActivation) string {
+	return fmt.Sprintf("generation=%d program_digest=%x activation=%v/%d deactivation=%v/%d"+
+		" executed=%v lease_cleared=%v",
+		b.Generation, b.ProgramDigest, b.Activation, b.ActivationStatus,
+		b.Deactivation, b.DeactivationStatus, b.Executed, b.LeaseCleared)
+}

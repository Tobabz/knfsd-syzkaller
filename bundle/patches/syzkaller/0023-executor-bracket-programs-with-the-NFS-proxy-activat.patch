+}
+
+static bool nfsp_broker_kcov_resolved()
+{
+	return nfsp_target_mode && nfsp_broker_kcov_done;
+}
+
+// Fork server, once the program process is reaped: kill whatever else of the
+// program is left (helpers in their own process group or session included)
+// and close the window only once the program cgroup is empty.  That is before
+// the KCOV ABORT that follows in loop().  Only now publish the barrier, which
+// the program can no longer touch.
+static void nfsp_broker_end()
+{
+	if (!nfsp_target_mode)
+		return;
+	bool gone = nfsp_cg_empty(kNfspCgroupFd, syscall_timeout_ms * 20);
+	if (!gone)
+		debug("NFS proxy: program cgroup did not empty\n");
+	nfsp_broker_finish(&nfsp_endpoint, &nfsp_broker_state, gone);
+	output_data->nfsp = nfsp_broker_state.b;
+}
+
+// Program process: ask the fork server for an activation window of
+// `generation` (0: BEGIN failed, so no window).  True when the program may run.
+static bool nfsp_program_activate(uint64 generation)
+{
+	int answer = nfsp_broker_activate(kNfspBrokerFd, generation);
+	if (answer < 0)
+		fail("NFS proxy broker failed before the program");
+	return answer == 1;
+}
+
+// Program process: the calls are over.  The fork server freezes the program,
+// ends the KCOV generation, publishes its coverage, kills the program and then
+// closes the window; nothing here runs after DONE.
+static NORETURN void nfsp_program_done(bool valid)
+{
+	if (!nfsp_broker_send(kNfspBrokerFd, NFSP_BROKER_DONE, valid ? 1 : 0))
+		fail("NFS proxy broker failed after the program");
+	for (;;)
+		sleep_ms(1000);
+}
+#endif

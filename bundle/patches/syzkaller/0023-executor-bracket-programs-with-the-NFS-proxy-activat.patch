new file mode 100644
index 000000000..eb9b3ab06
--- /dev/null
+++ b/executor/nfs_proxy_activation.h
@@ -0,0 +1,597 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+// Client side of the knfsd-syzkaller NFS proxy activation endpoint (S1a).
+//
+// In target mode the proxy applies one immutable semantic rule set, but only
+// to NFS calls that start inside an activation window of a KCOV program
+// generation.  The executor owns that window: it activates the generation
+// before the first program syscall and deactivates it after the last one.  The
+// fork server does both on the program process's behalf (nfsp_broker below),
+// so the process that runs fuzzed syscalls never holds the endpoint.  A
+// barrier is ACKed only after the host journal stored GENERATION_OPEN or
+// GENERATION_DRAINING, so an ACK is the only evidence that the window exists.
+//
+// Wire format (tools/nfs-proxy/src/target.h in knfsd-syzkaller), one Unix
+// SOCK_SEQPACKET packet per message, integers big-endian:
+//
+//   request, 120 bytes:  "NFSPACT1", op, zero, generation,
+//                        program digest (32), rule_set_id (64 lowercase hex)
+//   answer, 24 bytes:    "NFSPACK1", op, status, generation
+//
+// Status 0 is an ACK; anything else is a refusal code from the proxy.
+//
+// This header has no executor dependencies so that the host tests of the
+// knfsd-syzkaller repository can compile it against a real proxy.
+
+#ifndef NFS_PROXY_ACTIVATION_H
+#define NFS_PROXY_ACTIVATION_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <sched.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <time.h>
+#include <unistd.h>
+
+#define NFSP_ACT_REQ_LEN 120
+#define NFSP_ACT_ANSWER_LEN 24
+#define NFSP_ACT_RULE_SET_ID_LEN 64
+
+#define NFSP_ACT_OP_ACTIVATE 1u
+#define NFSP_ACT_OP_DEACTIVATE 2u
+#define NFSP_ACT_OP_ABORT 3u
+
+// Proxy status codes the executor reacts to (enum nfsp_activation_result in
+// tools/nfs-proxy/src/activation.h, plus NFSP_TARGET_NOT_READY).
+#define NFSP_ACT_STATUS_ACK 0u
+#define NFSP_ACT_STATUS_ONE_ADMITTING 11u
+#define NFSP_ACT_STATUS_DRAINING_LIMIT 12u
+#define NFSP_ACT_STATUS_GENERATION_CAPACITY 13u
+#define NFSP_ACT_STATUS_BARRIER_IN_PROGRESS 14u
+#define NFSP_ACT_STATUS_UNKNOWN_GENERATION 18u
+#define NFSP_ACT_STATUS_CALL_ACCOUNT_PENDING 19u
+#define NFSP_ACT_STATUS_ALREADY_CLOSED 28u
+#define NFSP_ACT_STATUS_QUARANTINE 31u
+#define NFSP_ACT_STATUS_NOT_READY 1000u
+// Not a proxy code: no answer arrived before the deadline.
+#define NFSP_ACT_NO_ANSWER 0xffffffffu
+// Not a proxy answer: the program had no KCOV generation to activate (BEGIN
+// failed), so the barrier refused it without asking the proxy.
+#define NFSP_ACT_NO_GENERATION 0xfffffffeu
+
+// --- SHA-256 (FIPS 180-4), for the program digest -------------------------
+
+struct nfsp_act_sha256 {
+	uint32_t h[8];
+	uint8_t buf[64];
+	uint64_t len;
+	size_t used;
+};
+
+static const uint32_t nfsp_act_sha256_k[64] = {
+    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+};
+
+static uint32_t nfsp_act_ror(uint32_t x, int n)
+{
+	return (x >> n) | (x << (32 - n));
+}
+
+static void nfsp_act_sha256_block(struct nfsp_act_sha256* s, const uint8_t* p)
+{
+	uint32_t w[64], a, b, c, d, e, f, g, h;
+	for (int i = 0; i < 16; i++)
+		w[i] = (uint32_t)p[4 * i] << 24 | (uint32_t)p[4 * i + 1] << 16 |
+		       (uint32_t)p[4 * i + 2] << 8 | p[4 * i + 3];
+	for (int i = 16; i < 64; i++) {
+		uint32_t s0 = nfsp_act_ror(w[i - 15], 7) ^ nfsp_act_ror(w[i - 15], 18) ^ (w[i - 15] >> 3);
+		uint32_t s1 = nfsp_act_ror(w[i - 2], 17) ^ nfsp_act_ror(w[i - 2], 19) ^ (w[i - 2] >> 10);
+		w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+	}
+	a = s->h[0], b = s->h[1], c = s->h[2], d = s->h[3];
+	e = s->h[4], f = s->h[5], g = s->h[6], h = s->h[7];
+	for (int i = 0; i < 64; i++) {
+		uint32_t t1 = h + (nfsp_act_ror(e, 6) ^ nfsp_act_ror(e, 11) ^ nfsp_act_ror(e, 25)) +
+			      ((e & f) ^ (~e & g)) + nfsp_act_sha256_k[i] + w[i];
+		uint32_t t2 = (nfsp_act_ror(a, 2) ^ nfsp_act_ror(a, 13) ^ nfsp_act_ror(a, 22)) +
+			      ((a & b) ^ (a & c) ^ (b & c));
+		h = g, g = f, f = e, e = d + t1;
+		d = c, c = b, b = a, a = t1 + t2;
+	}
+	s->h[0] += a, s->h[1] += b, s->h[2] += c, s->h[3] += d;
+	s->h[4] += e, s->h[5] += f, s->h[6] += g, s->h[7] += h;
+}
+
+static void nfsp_act_sha256(const void* data, size_t len, uint8_t out[32])
+{
+	static const uint32_t init[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+					 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
+	struct nfsp_act_sha256 s;
+	const uint8_t* p = (const uint8_t*)data;
+	memcpy(s.h, init, sizeof(init));
+	s.len = (uint64_t)len * 8;
+	for (; len >= 64; p += 64, len -= 64)
+		nfsp_act_sha256_block(&s, p);
+	memset(s.buf, 0, sizeof(s.buf));
+	memcpy(s.buf, p, len);
+	s.buf[len] = 0x80;
+	if (len >= 56) {
+		nfsp_act_sha256_block(&s, s.buf);
+		memset(s.buf, 0, sizeof(s.buf));
+	}
+	for (int i = 0; i < 8; i++)
+		s.buf[56 + i] = (uint8_t)(s.len >> (56 - 8 * i));
+	nfsp_act_sha256_block(&s, s.buf);
+	for (int i = 0; i < 8; i++) {
+		out[4 * i] = (uint8_t)(s.h[i] >> 24);
+		out[4 * i + 1] = (uint8_t)(s.h[i] >> 16);
+		out[4 * i + 2] = (uint8_t)(s.h[i] >> 8);
+		out[4 * i + 3] = (uint8_t)s.h[i];
+	}
+}
+
+// --- messages -----------------------------------------------------------------
+
+// A rule_set_id is the lowercase hex SHA-256 of the installed NFSPRUL1 bytes.
+static int nfsp_act_valid_rule_set_id(const char* id, size_t len)
+{
+	if (len != NFSP_ACT_RULE_SET_ID_LEN)
+		return 0;
+	for (size_t i = 0; i < len; i++) {
+		char c = id[i];
+		if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
+			return 0;
+	}
+	return 1;
+}
+
+static void nfsp_act_put32(uint8_t* p, uint32_t v)
+{
+	for (int i = 0; i < 4; i++)
+		p[i] = (uint8_t)(v >> (24 - 8 * i));
+}
+
+static void nfsp_act_put64(uint8_t* p, uint64_t v)
+{
+	for (int i = 0; i < 8; i++)
+		p[i] = (uint8_t)(v >> (56 - 8 * i));
+}
+
+static uint64_t nfsp_act_get(const uint8_t* p, int n)
+{
+	uint64_t v = 0;
+	for (int i = 0; i < n; i++)
+		v = v << 8 | p[i];
+	return v;
+}
+
+// digest may be NULL for deactivate and abort, which carry zeros.
+static void nfsp_act_encode(uint8_t out[NFSP_ACT_REQ_LEN], uint32_t op, uint64_t generation,
+			    const uint8_t* digest, const char* rule_set_id)
+{
+	memset(out, 0, NFSP_ACT_REQ_LEN);
+	memcpy(out, "NFSPACT1", 8);
+	nfsp_act_put32(out + 8, op);
+	nfsp_act_put64(out + 16, generation);
+	if (digest)
+		memcpy(out + 24, digest, 32);
+	memcpy(out + 56, rule_set_id, NFSP_ACT_RULE_SET_ID_LEN);
+}
+
+// 1 when p is a well-formed answer.
+static int nfsp_act_decode(const uint8_t* p, size_t n, uint32_t* op, uint32_t* status,
+			   uint64_t* generation)
+{
+	if (n != NFSP_ACT_ANSWER_LEN || memcmp(p, "NFSPACK1", 8) != 0)
+		return 0;
+	*op = (uint32_t)nfsp_act_get(p + 8, 4);
+	*status = (uint32_t)nfsp_act_get(p + 12, 4);
+	*generation = nfsp_act_get(p + 16, 8);
+	return 1;
+}
+
+// --- exchanges ---------------------------------------------------------------
+
+static uint64_t nfsp_act_now_ms(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000 + (uint64_t)ts.tv_nsec / 1000000;
+}
+
+// Send one request and wait up to timeout_ms for its answer.
+//
+// Every request is answered eventually, also one whose waiter is gone: a
+// program killed while it waited, or a wait that timed out.  The connection
+// is shared by the fork server and each program process it forks, so such a
+// late answer can still be queued.  Answers for another (op, generation) are
+// that kind of leftover and are dropped.
+static uint32_t nfsp_act_exchange(int fd, uint32_t op, uint64_t generation, const uint8_t* digest,
+				  const char* rule_set_id, uint64_t timeout_ms)
+{
+	uint8_t req[NFSP_ACT_REQ_LEN], ans[NFSP_ACT_ANSWER_LEN + 1];
+	uint64_t deadline = nfsp_act_now_ms() + timeout_ms;
+
+	// Drop answers that are already queued: none of them can be for this request.
+	while (recv(fd, ans, sizeof(ans), MSG_DONTWAIT) > 0) {
+	}
+	nfsp_act_encode(req, op, generation, digest, rule_set_id);
+	ssize_t sent;
+	do
+		sent = send(fd, req, sizeof(req), MSG_NOSIGNAL);
+	while (sent < 0 && errno == EINTR);
+	if (sent != (ssize_t)sizeof(req))
+		return NFSP_ACT_NO_ANSWER;
+	for (;;) {
+		uint64_t now = nfsp_act_now_ms();
+		if (now >= deadline)
+			return NFSP_ACT_NO_ANSWER;
+		struct pollfd pfd = {fd, POLLIN, 0};
+		int ready = poll(&pfd, 1, (int)(deadline - now));
+		if (ready < 0 && errno == EINTR)
+			continue;
+		if (ready <= 0)
+			return NFSP_ACT_NO_ANSWER;
+		ssize_t n = recv(fd, ans, sizeof(ans), MSG_DONTWAIT);
+		if (n < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK))
+			continue;
+		if (n <= 0)
+			return NFSP_ACT_NO_ANSWER; // the proxy closed the endpoint
+		uint32_t a_op, a_status;
+		uint64_t a_generation;
+		if (nfsp_act_decode(ans, (size_t)n, &a_op, &a_status, &a_generation) &&
+		    a_op == op && a_generation == generation)
+			return a_status;
+	}
+}
+
+// Refusals that clear by themselves: another barrier, or the previous
+// generation's call accounting or draining, has not finished yet.  The
+// proxy decides nothing on them, so asking again is safe.
+static int nfsp_act_transient(uint32_t status)
+{
+	return status == NFSP_ACT_STATUS_BARRIER_IN_PROGRESS ||
+	       status == NFSP_ACT_STATUS_CALL_ACCOUNT_PENDING ||
+	       status == NFSP_ACT_STATUS_DRAINING_LIMIT;
+}
+
+// nfsp_act_exchange, repeated on transient refusals until timeout_ms.
+static uint32_t nfsp_act_request(int fd, uint32_t op, uint64_t generation, const uint8_t* digest,
+				 const char* rule_set_id, uint64_t timeout_ms)
+{
+	uint64_t deadline = nfsp_act_now_ms() + timeout_ms;
+	for (;;) {
+		uint64_t now = nfsp_act_now_ms();
+		uint32_t status = nfsp_act_exchange(fd, op, generation, digest, rule_set_id,
+						    now < deadline ? deadline - now : 0);
+		if (!nfsp_act_transient(status) || nfsp_act_now_ms() + 5 >= deadline)
+			return status;
+		struct timespec pause = {0, 5 * 1000 * 1000};
+		nanosleep(&pause, NULL);
+	}
+}
+
+// --- the program barrier --------------------------------------------------------
+
+// Values of rpc::NfsProxyBarrierRaw.
+#define NFSP_ACT_BARRIER_NONE 0u
+#define NFSP_ACT_BARRIER_ACKED 1u
+#define NFSP_ACT_BARRIER_REFUSED 2u
+#define NFSP_ACT_BARRIER_NO_ANSWER 3u
+
+// The proxy holds no activation of the generation.
+#define NFSP_ACT_LEASE_CLEAR 0u
+// Activation was requested and is not confirmed ended (a lost ACK is not a
+// lost request).
+#define NFSP_ACT_LEASE_HELD 1u
+// Ending it failed, or the proxy session can open no further generation: the
+// lane must not be reused.
+#define NFSP_ACT_LEASE_UNCLEARED 2u
+
+struct nfsp_act_endpoint {
+	int fd;
+	char rule_set_id[NFSP_ACT_RULE_SET_ID_LEN];
+	uint64_t timeout_ms; // per barrier
+};
+
+// One program's barrier.  The fork server runs it and, once the program
+// process is gone, publishes it in memory shared with the runner.
+struct nfsp_act_barrier {
+	uint64_t generation;
+	uint8_t digest[32];
+	uint32_t activation; // NFSP_ACT_BARRIER_*
+	uint32_t activation_status;
+	uint32_t deactivation; // NFSP_ACT_BARRIER_*
+	uint32_t deactivation_status;
+	uint32_t lease; // NFSP_ACT_LEASE_*
+	uint32_t executed;
+};
+
+static uint32_t nfsp_act_barrier_of(uint32_t status)
+{
+	if (status == NFSP_ACT_STATUS_ACK)
+		return NFSP_ACT_BARRIER_ACKED;
+	if (status == NFSP_ACT_NO_ANSWER)
+		return NFSP_ACT_BARRIER_NO_ANSWER;
+	return NFSP_ACT_BARRIER_REFUSED;
+}
+
+// Activation refusals after which this proxy session cannot open another
+// generation on the lane: a quarantined session, a lost or refused RULESET, a
+// generation we do not own still admitting, or no generation slots left.
+static int nfsp_act_lane_fatal(uint32_t status)
+{
+	return status == NFSP_ACT_STATUS_QUARANTINE || status == NFSP_ACT_STATUS_NOT_READY ||
+	       status == NFSP_ACT_STATUS_ONE_ADMITTING ||
+	       status == NFSP_ACT_STATUS_GENERATION_CAPACITY;
+}
+
+// End a held lease: deactivate an ACKed window, otherwise (or if that is not
+// ACKed) abort the generation.  The lease becomes CLEAR only when the proxy
+// confirmed that it holds no activation of the generation.
+static void nfsp_act_release(const struct nfsp_act_endpoint* ep, struct nfsp_act_barrier* b)
+{
+	if (b->lease != NFSP_ACT_LEASE_HELD)
+		return;
+	int activated = b->activation == NFSP_ACT_BARRIER_ACKED;
+	if (activated && b->deactivation == NFSP_ACT_BARRIER_NONE) {
+		uint32_t status = nfsp_act_request(ep->fd, NFSP_ACT_OP_DEACTIVATE, b->generation, NULL,
+						   ep->rule_set_id, ep->timeout_ms);
+		b->deactivation_status = status;
+		b->deactivation = nfsp_act_barrier_of(status);
+		if (status == NFSP_ACT_STATUS_ACK) {
+			b->lease = NFSP_ACT_LEASE_CLEAR;
+			return;
+		}
+	}
+	// ABORT closes the generation in any state; one the proxy already closed
+	// (a refused barrier closes it) admits nothing either.  A generation the
+	// proxy never registered is not held, but only if it was never ACKed.
+	uint32_t status = nfsp_act_request(ep->fd, NFSP_ACT_OP_ABORT, b->generation, NULL,
+					   ep->rule_set_id, ep->timeout_ms);
+	int cleared = status == NFSP_ACT_STATUS_ACK || status == NFSP_ACT_STATUS_ALREADY_CLOSED ||
+		      (!activated && status == NFSP_ACT_STATUS_UNKNOWN_GENERATION);
+	b->lease = cleared ? NFSP_ACT_LEASE_CLEAR : NFSP_ACT_LEASE_UNCLEARED;
+}
+
+// Open the activation window of `generation` for the exec-encoded program
+// `prog`.  Returns 1 when the program may run.  Otherwise the proxy may or may
+// not be mutating for it, so it must not run; the lease is already released
+// as far as the proxy confirms.
+static int nfsp_act_activate(const struct nfsp_act_endpoint* ep, struct nfsp_act_barrier* b,
+			     uint64_t generation, const void* prog, size_t prog_len)
+{
+	memset(b, 0, sizeof(*b));
+	b->generation = generation;
+	nfsp_act_sha256(prog, prog_len, b->digest);
+	// Held before the request is sent: a lost ACK is not a lost request.
+	b->lease = NFSP_ACT_LEASE_HELD;
+	uint32_t status = nfsp_act_request(ep->fd, NFSP_ACT_OP_ACTIVATE, generation, b->digest,
+					   ep->rule_set_id, ep->timeout_ms);
+	b->activation_status = status;
+	b->activation = nfsp_act_barrier_of(status);
+	if (status == NFSP_ACT_STATUS_ACK) {
+		b->executed = 1;
+		return 1;
+	}
+	nfsp_act_release(ep, b);
+	if (nfsp_act_lane_fatal(status))
+		b->lease = NFSP_ACT_LEASE_UNCLEARED;
+	return 0;
+}
+
+// The broker.  The program process runs fuzzed syscalls, so it never holds
+// the activation endpoint: any descriptor it has, those syscalls can write to.
+// Its trusted parent (the fork server) holds the endpoint and runs the barrier
+// on the program's behalf, asked over a socket pair created for that one
+// program.  The program process sends exactly
+//
+//   ACTIVATE(generation)  before its first call; answer 1 = run, 0 = skip
+//   DONE(valid)           after its calls, only if it ran; no answer.
+//                         valid: its threads bound to the KCOV generation
+//
+// ACTIVATE comes before any fuzzed syscall, so it is the program process's
+// own.  DONE is not trusted: fuzzed syscalls can send it (or a later one can
+// hide the real one).  It only asks the parent to end the program.  The
+// window is not tied to DONE at all: every task of the program runs in the
+// program's own cgroup (nfsp_cg below), and the parent closes the window only
+// once that cgroup is empty, so everything the program does, including the
+// teardown of its descriptors, happens inside the window.  Anything else on
+// the pair, which only fuzzed syscalls can send, marks the lease UNCLEARED,
+// so the lane is not reused.
+
+#define NFSP_BROKER_ACTIVATE 1u
+#define NFSP_BROKER_DONE 2u
+
+struct nfsp_broker_msg {
+	uint32_t op; // NFSP_BROKER_*
+	uint32_t zero;
+	uint64_t generation;
+};
+
+struct nfsp_broker {
+	int fd; // the parent's end of the pair
+	const void* prog; // the exec-encoded program, from the parent's own copy
+	size_t prog_len;
+	int activated; // ACTIVATE handled
+	int done; // DONE received: end the program
+	int done_valid; // DONE's claim that the KCOV generation is complete
+	int violation; // an unexpected message
+	struct nfsp_act_barrier b;
+};
+
+static void nfsp_broker_start(struct nfsp_broker* k, int fd, const void* prog, size_t prog_len)
+{
+	memset(k, 0, sizeof(*k));
+	k->fd = fd;
+	k->prog = prog;
+	k->prog_len = prog_len;
+}
+
+// A program process that does not get its answer fails by itself.
+static void nfsp_broker_answer(struct nfsp_broker* k, uint8_t answer)
+{
+	(void)!send(k->fd, &answer, 1, MSG_NOSIGNAL | MSG_DONTWAIT);
+}
+
+// Parent: wait up to timeout_ms for a message, then handle every queued one.
+static void nfsp_broker_serve(const struct nfsp_act_endpoint* ep, struct nfsp_broker* k, int timeout_ms)
+{
+	struct pollfd pfd = {k->fd, POLLIN, 0};
+	if (poll(&pfd, 1, timeout_ms) <= 0)
+		return;
+	for (;;) {
+		struct nfsp_broker_msg m;
+		ssize_t n = recv(k->fd, &m, sizeof(m), MSG_DONTWAIT | MSG_TRUNC);
+		if (n < 0 || n == 0)
+			return; // empty, or the program process closed its end
+		if (n != (ssize_t)sizeof(m) || m.zero) {
+			k->violation = 1;
+		} else if (m.op == NFSP_BROKER_ACTIVATE && !k->activated) {
+			k->activated = 1;
+			if (!m.generation) {
+				memset(&k->b, 0, sizeof(k->b));
+				k->b.activation = NFSP_ACT_BARRIER_REFUSED;
+				k->b.activation_status = NFSP_ACT_NO_GENERATION;
+				nfsp_broker_answer(k, 0);
+			} else {
+				nfsp_broker_answer(k, (uint8_t)nfsp_act_activate(ep, &k->b, m.generation,
+											  k->prog, k->prog_len));
+			}
+		} else if (m.op == NFSP_BROKER_DONE && k->b.executed && !k->done) {
+			k->done = 1;
+			k->done_valid = m.generation == 1;
+			return; // the caller stops the program before anything else
+		} else {
+			k->violation = 1;
+		}
+	}
+}
+
+// Parent, once every task of the program is gone (`gone`; nfsp_cg_empty):
+// handle what it sent last, close its window, and settle the lease.  While a
+// task may still run, the window stays open and the lane is not reused.
+static void nfsp_broker_finish(const struct nfsp_act_endpoint* ep, struct nfsp_broker* k, int gone)
+{
+	nfsp_broker_serve(ep, k, 0);
+	if (gone)
+		nfsp_act_release(ep, &k->b);
+	if (k->violation || !gone)
+		k->b.lease = NFSP_ACT_LEASE_UNCLEARED;
+	close(k->fd);
+	k->fd = -1;
+}
+
+// Program process: send one message.  0 when the pair failed.
+static int nfsp_broker_send(int fd, uint32_t op, uint64_t generation)
+{
+	struct nfsp_broker_msg m = {op, 0, generation};
+	return send(fd, &m, sizeof(m), MSG_NOSIGNAL) == (ssize_t)sizeof(m);
+}
+
+// Program process: ACTIVATE and its answer byte.  -1 when the pair failed.
+static int nfsp_broker_activate(int fd, uint64_t generation)
+{
+	uint8_t answer;
+	if (!nfsp_broker_send(fd, NFSP_BROKER_ACTIVATE, generation))
+		return -1;
+	if (recv(fd, &answer, 1, 0) != 1)
+		return -1;
+	return answer;
+}
+
+// The program's cgroup.  The fork server puts each program process into one
+// cgroup v2 directory of its own (`dir`, a descriptor only the fork server
+// keeps), which also becomes the root of the program's cgroup namespace.
+// Every task the program creates stays in it: a new process group or session
+// does not leave it, and the namespace root forbids moving a task out of it
+// (cgroup.procs and CLONE_INTO_CGROUP need the common ancestor inside the
+// namespace).  Freezing it is not undone by SIGCONT, and killing it reaches
+// every task; it is empty only after each task ran its exit, which closes its
+// descriptors.
+
+#define NFSP_CLONE_NEWCGROUP 0x02000000
+
+static int nfsp_cg_write(int dir, const char* file, const char* value)
+{
+	int fd = openat(dir, file, O_WRONLY | O_CLOEXEC);
+	if (fd == -1)
+		return 0;
+	ssize_t len = strlen(value);
+	int ok = write(fd, value, len) == len;
+	close(fd);
+	return ok;
+}
+
+// The 0/1 value of `key` in cgroup.events, or -1.
+static int nfsp_cg_event(int dir, const char* key)
+{
+	char buf[256];
+	int fd = openat(dir, "cgroup.events", O_RDONLY | O_CLOEXEC);
+	if (fd == -1)
+		return -1;
+	ssize_t n = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (n <= 0)
+		return -1;
+	buf[n] = 0;
+	size_t len = strlen(key);
+	for (const char* p = buf;;) {
+		if (!strncmp(p, key, len) && p[len] == ' ')
+			return p[len + 1] == '1';
+		p = strchr(p, '\n');
+		if (!p)
+			return -1;
+		p++;
+	}
+}
+
+static int nfsp_cg_wait(int dir, const char* key, int want, uint64_t timeout_ms)
+{
+	uint64_t start = nfsp_act_now_ms();
+	for (;;) {
+		int value = nfsp_cg_event(dir, key);
+		if (value == want)
+			return 1;
+		if (value < 0 || nfsp_act_now_ms() - start > timeout_ms)
+			return 0;
+		usleep(1000);
+	}
+}
+
+// Program process, before anything else: join the program's cgroup and make
+// it the root of a new cgroup namespace.
+static int nfsp_cg_join(int dir)
+{
+	return nfsp_cg_write(dir, "cgroup.procs", "0") && !unshare(NFSP_CLONE_NEWCGROUP);
+}
+
+// Parent: freeze every task of the program.  1 once all are frozen; a task
+// still in a syscall freezes only when that syscall returns.
+static int nfsp_cg_freeze(int dir, uint64_t timeout_ms)
+{
+	return nfsp_cg_write(dir, "cgroup.freeze", "1") && nfsp_cg_wait(dir, "frozen", 1, timeout_ms);
+}
+
+// Parent: kill every task of the program and wait until the cgroup is empty,
+// then thaw it for the next program.  0 while a task may still run.
+static int nfsp_cg_empty(int dir, uint64_t timeout_ms)
+{
+	if (!nfsp_cg_write(dir, "cgroup.kill", "1") || !nfsp_cg_wait(dir, "populated", 0, timeout_ms))
+		return 0;
+	return nfsp_cg_write(dir, "cgroup.freeze", "0");
+}
+
+#endif // NFS_PROXY_ACTIVATION_H

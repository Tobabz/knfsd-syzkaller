+
+static int test_nfsp_sha256()
+{
+	struct {
+		const char* data;
+		const char* want;
+	} tests[] = {
+	    {"", "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},
+	    {"abc", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"},
+	    {"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
+	     "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"},
+	};
+	for (size_t i = 0; i < ARRAY_SIZE(tests); i++) {
+		uint8 digest[32];
+		char hex[65];
+		nfsp_act_sha256(tests[i].data, strlen(tests[i].data), digest);
+		for (int j = 0; j < 32; j++)
+			snprintf(hex + 2 * j, 3, "%02x", digest[j]);
+		if (strcmp(hex, tests[i].want)) {
+			printf("sha256(%s) = %s, want %s\n", tests[i].data, hex, tests[i].want);
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static const char kNfspTestRuleSet[] = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
+const uint32 kNfspTestSilent = 0xfffffffeu;
+
+// One scripted proxy step: the request it expects, an optional stale answer
+// sent first, and the answer (kNfspTestSilent: none).
+struct nfsp_test_step {
+	uint32 op;
+	uint32 status;
+	bool stale_first;
+};
+
+struct nfsp_test_proxy {
+	int fd;
+	const nfsp_test_step* steps;
+	int nsteps;
+	int handled;
+	bool bad;
+	uint8 last_digest[32];
+};
+
+static void nfsp_test_answer(int fd, uint32 op, uint32 status, uint64 generation)
+{
+	uint8 ans[NFSP_ACT_ANSWER_LEN];
+	memcpy(ans, "NFSPACK1", 8);
+	nfsp_act_put32(ans + 8, op);
+	nfsp_act_put32(ans + 12, status);
+	nfsp_act_put64(ans + 16, generation);
+	send(fd, ans, sizeof(ans), MSG_NOSIGNAL);
+}
+
+static void* nfsp_test_proxy_thread(void* arg)
+{
+	nfsp_test_proxy* p = (nfsp_test_proxy*)arg;
+	for (; p->handled < p->nsteps; p->handled++) {
+		uint8 req[NFSP_ACT_REQ_LEN + 1];
+		ssize_t n = recv(p->fd, req, sizeof(req), 0);
+		if (n <= 0)
+			break;
+		const nfsp_test_step& step = p->steps[p->handled];
+		uint32 op = (uint32)nfsp_act_get(req + 8, 4);
+		uint64 generation = nfsp_act_get(req + 16, 8);
+		if (n != NFSP_ACT_REQ_LEN || memcmp(req, "NFSPACT1", 8) || op != step.op ||
+		    memcmp(req + 56, kNfspTestRuleSet, NFSP_ACT_RULE_SET_ID_LEN)) {
+			printf("proxy step %d: bad request len=%zd op=%u want op=%u\n", p->handled, n, op, step.op);
+			p->bad = true;
+			break;
+		}
+		if (op == NFSP_ACT_OP_ACTIVATE)
+			memcpy(p->last_digest, req + 24, 32);
+		if (step.stale_first) {
+			nfsp_test_answer(p->fd, op, 77, generation + 1);
+			nfsp_test_answer(p->fd, op == 1 ? 2 : 1, 77, generation);
+		}
+		if (step.status != kNfspTestSilent)
+			nfsp_test_answer(p->fd, op, step.status, generation);
+	}
+	return NULL;
+}
+
+struct nfsp_test_case {
+	const char* name;
+	nfsp_test_step steps[4];
+	int nsteps;
+	bool want_activate;
+	uint32 want_activation;
+	uint32 want_deactivation;
+	uint32 want_lease;
+};
+
+static int test_nfsp_barrier()
+{
+	// The barrier values are written as rpc::NfsProxyBarrierRaw.
+	static_assert(NFSP_ACT_BARRIER_NONE == (uint32)rpc::NfsProxyBarrierRaw::None &&
+			  NFSP_ACT_BARRIER_ACKED == (uint32)rpc::NfsProxyBarrierRaw::Acked &&
+			  NFSP_ACT_BARRIER_REFUSED == (uint32)rpc::NfsProxyBarrierRaw::Refused &&
+			  NFSP_ACT_BARRIER_NO_ANSWER == (uint32)rpc::NfsProxyBarrierRaw::NoAnswer,
+		      "NFSP_ACT_BARRIER_* != rpc::NfsProxyBarrierRaw");
+	const uint32 ack = 0, none = NFSP_ACT_BARRIER_NONE, acked = NFSP_ACT_BARRIER_ACKED,
+		     refused = NFSP_ACT_BARRIER_REFUSED, noans = NFSP_ACT_BARRIER_NO_ANSWER;
+	const uint32 clear = NFSP_ACT_LEASE_CLEAR, uncleared = NFSP_ACT_LEASE_UNCLEARED;
+	const uint32 act = NFSP_ACT_OP_ACTIVATE, deact = NFSP_ACT_OP_DEACTIVATE, abrt = NFSP_ACT_OP_ABORT;
+	const nfsp_test_case cases[] = {
+	    {"both barriers ACKed", {{act, ack, false}, {deact, ack, false}}, 2, true, acked, acked, clear},
+	    {"stale answers are skipped", {{act, ack, true}, {deact, ack, true}}, 2, true, acked, acked, clear},
+	    {"transient refusals are retried",
+	     {{act, NFSP_ACT_STATUS_BARRIER_IN_PROGRESS, false}, {act, ack, false}, {deact, NFSP_ACT_STATUS_CALL_ACCOUNT_PENDING, false}, {deact, ack, false}},
+	     4, true, acked, acked, clear},
+	    {"refused activation, never registered",
+	     {{act, 10, false}, {abrt, NFSP_ACT_STATUS_UNKNOWN_GENERATION, false}}, 2, false, refused, none, clear},
+	    {"lost activation ACK, abort ACKed", {{act, kNfspTestSilent, false}, {abrt, ack, false}}, 2, false, noans, none, clear},
+	    {"lost activation ACK, abort unknown", {{act, kNfspTestSilent, false}, {abrt, NFSP_ACT_STATUS_UNKNOWN_GENERATION, false}}, 2, false, noans, none, clear},
+	    {"lost activation ACK, abort lost", {{act, kNfspTestSilent, false}, {abrt, kNfspTestSilent, false}}, 2, false, noans, none, uncleared},
+	    {"quarantined session", {{act, NFSP_ACT_STATUS_QUARANTINE, false}, {abrt, NFSP_ACT_STATUS_UNKNOWN_GENERATION, false}}, 2, false, refused, none, uncleared},
+	    {"no generation slots", {{act, NFSP_ACT_STATUS_GENERATION_CAPACITY, false}, {abrt, NFSP_ACT_STATUS_UNKNOWN_GENERATION, false}}, 2, false, refused, none, uncleared},
+	    {"lost deactivation ACK, abort ACKed", {{act, ack, false}, {deact, kNfspTestSilent, false}, {abrt, ack, false}}, 3, true, acked, noans, clear},
+	    {"refused deactivation, already closed", {{act, ack, false}, {deact, 3, false}, {abrt, NFSP_ACT_STATUS_ALREADY_CLOSED, false}}, 3, true, acked, refused, clear},
+	    {"refused deactivation, abort lost", {{act, ack, false}, {deact, 3, false}, {abrt, kNfspTestSilent, false}}, 3, true, acked, refused, uncleared},
+	    {"ACKed generation unknown at abort", {{act, ack, false}, {deact, kNfspTestSilent, false}, {abrt, NFSP_ACT_STATUS_UNKNOWN_GENERATION, false}}, 3, true, acked, noans, uncleared},
+	};
+	static uint8 program[] = "exec-encoded program bytes";
+	uint8 want_digest[32];
+	nfsp_act_sha256(program, sizeof(program), want_digest);
+	nfsp_act_endpoint ep = {-1, {}, 50};
+	memcpy(ep.rule_set_id, kNfspTestRuleSet, NFSP_ACT_RULE_SET_ID_LEN);
+	int ret = 0;
+	for (size_t i = 0; i < ARRAY_SIZE(cases) && !ret; i++) {
+		const nfsp_test_case& c = cases[i];
+		int sv[2];
+		if (socketpair(AF_UNIX, SOCK_SEQPACKET, 0, sv)) {
+			printf("socketpair failed\n");
+			return 1;
+		}
+		ep.fd = sv[0];
+		nfsp_test_proxy proxy = {sv[1], c.steps, c.nsteps, 0, false, {}};
+		pthread_t th;
+		pthread_create(&th, NULL, nfsp_test_proxy_thread, &proxy);
+		nfsp_act_barrier b;
+		bool activated = nfsp_act_activate(&ep, &b, 42, program, sizeof(program));
+		if (activated)
+			nfsp_act_release(&ep, &b);
+		close(sv[0]);
+		pthread_join(th, NULL);
+		close(sv[1]);
+		if (proxy.bad || proxy.handled != c.nsteps || activated != c.want_activate ||
+		    b.executed != c.want_activate || b.activation != c.want_activation ||
+		    b.deactivation != c.want_deactivation || b.lease != c.want_lease ||
+		    b.generation != 42 || memcmp(b.digest, want_digest, 32) ||
+		    memcmp(proxy.last_digest, want_digest, 32)) {
+			printf("%s: handled=%d/%d activated=%d activation=%u deactivation=%u lease=%u\n", c.name,
+			       proxy.handled, c.nsteps, activated, b.activation, b.deactivation, b.lease);
+			ret = 1;
+		}
+	}
+	return ret;
+}
+
+// The fork server's broker: a program process asks over its pair, the broker
+// runs the barrier on the endpoint.  Messages the program process sends are
+// written by hand on the program's end of the pair.  DONE is only a request:
+// the broker answers nothing and closes the window later (here, at finish;
+// in the executor, once the program cgroup is empty).
+static bool nfsp_test_send(int fd, uint32 op, uint64 generation)
+{
+	nfsp_broker_msg m = {op, 0, generation};
+	return send(fd, &m, sizeof(m), MSG_NOSIGNAL) == (ssize_t)sizeof(m);
+}
+
+static int nfsp_test_answers(int fd)
+{
+	uint8 buf[8];
+	int answers = 0;
+	while (recv(fd, buf, sizeof(buf), MSG_DONTWAIT) == 1)
+		answers = answers * 10 + buf[0] + 1; // "2" for answer 1, "1" for answer 0
+	return answers;
+}
+
+static int test_nfsp_broker()
+{
+	const uint32 ack = 0, act = NFSP_ACT_OP_ACTIVATE, deact = NFSP_ACT_OP_DEACTIVATE;
+	const uint32 ACT = NFSP_BROKER_ACTIVATE, DONE = NFSP_BROKER_DONE;
+	struct {
+		const char* name;
+		uint32 sends[3][2]; // (op, generation) the program process sends, op 0 = none
+		bool program_exits; // closes its end before the broker finishes
+		nfsp_test_step steps[2];
+		int nsteps;
+		int want_answers;
+		uint32 want_activation;
+		uint32 want_lease;
+		bool left; // a task of the program is still alive at finish
+	} cases[] = {
+	    {"activate and done", {{ACT, 42}, {DONE, 1}}, false, {{act, ack, false}, {deact, ack, false}}, 2, 2, NFSP_ACT_BARRIER_ACKED, NFSP_ACT_LEASE_CLEAR},
+	    {"no KCOV generation: skipped, proxy not asked", {{ACT, 0}}, false, {}, 0, 1, NFSP_ACT_BARRIER_REFUSED, NFSP_ACT_LEASE_CLEAR},
+	    {"refused: skipped, DONE is a violation", {{ACT, 42}, {DONE, 0}}, false, {{act, 10, false}, {NFSP_ACT_OP_ABORT, NFSP_ACT_STATUS_UNKNOWN_GENERATION, false}}, 2, 1, NFSP_ACT_BARRIER_REFUSED, NFSP_ACT_LEASE_UNCLEARED},
+	    {"second DONE", {{ACT, 42}, {DONE, 1}, {DONE, 1}}, false, {{act, ack, false}, {deact, ack, false}}, 2, 2, NFSP_ACT_BARRIER_ACKED, NFSP_ACT_LEASE_UNCLEARED},
+	    {"second ACTIVATE", {{ACT, 42}, {ACT, 43}}, false, {{act, ack, false}, {deact, ack, false}}, 2, 2, NFSP_ACT_BARRIER_ACKED, NFSP_ACT_LEASE_UNCLEARED},
+	    {"DONE before ACTIVATE", {{DONE, 0}}, false, {}, 0, 0, NFSP_ACT_BARRIER_NONE, NFSP_ACT_LEASE_UNCLEARED},
+	    {"program died in its window", {{ACT, 42}}, true, {{act, ack, false}, {deact, ack, false}}, 2, 2, NFSP_ACT_BARRIER_ACKED, NFSP_ACT_LEASE_CLEAR},
+	    {"a task is left: the window stays open", {{ACT, 42}, {DONE, 1}}, false, {{act, ack, false}}, 1, 2, NFSP_ACT_BARRIER_ACKED, NFSP_ACT_LEASE_UNCLEARED, true},
+	};
+	static uint8 program[] = "exec-encoded program bytes";
+	nfsp_act_endpoint ep = {-1, {}, 50};
+	memcpy(ep.rule_set_id, kNfspTestRuleSet, NFSP_ACT_RULE_SET_ID_LEN);
+	int ret = 0;
+	for (size_t i = 0; i < ARRAY_SIZE(cases) && !ret; i++) {
+		const auto& c = cases[i];
+		int proxy_sv[2], pair[2];
+		if (socketpair(AF_UNIX, SOCK_SEQPACKET, 0, proxy_sv) ||
+		    socketpair(AF_UNIX, SOCK_SEQPACKET, 0, pair)) {
+			printf("socketpair failed\n");
+			return 1;
+		}
+		ep.fd = proxy_sv[0];
+		nfsp_test_proxy proxy = {proxy_sv[1], c.steps, c.nsteps, 0, false, {}};
+		pthread_t th;
+		pthread_create(&th, NULL, nfsp_test_proxy_thread, &proxy);
+		nfsp_broker k;
+		nfsp_broker_start(&k, pair[0], program, sizeof(program));
+		int answers = 0;
+		for (int j = 0; j < 3 && c.sends[j][0]; j++) {
+			if (!nfsp_test_send(pair[1], c.sends[j][0], c.sends[j][1])) {
+				printf("%s: send failed\n", c.name);
+				ret = 1;
+			}
+			nfsp_broker_serve(&ep, &k, 100);
+			int a = nfsp_test_answers(pair[1]);
+			if (a)
+				answers = answers * 10 + a;
+		}
+		if (c.program_exits)
+			close(pair[1]);
+		nfsp_broker_finish(&ep, &k, !c.left);
+		if (!c.program_exits)
+			close(pair[1]);
+		close(proxy_sv[0]);
+		pthread_join(th, NULL);
+		close(proxy_sv[1]);
+		uint32 want_status = c.sends[0][0] == ACT && !c.sends[0][1] ? NFSP_ACT_NO_GENERATION : k.b.activation_status;
+		// DONE asks to end the program; it is honoured only after an ACKed
+		// ACTIVATE, and carries the program's claim about its KCOV binding.
+		bool want_done = c.sends[1][0] == DONE && c.want_activation == NFSP_ACT_BARRIER_ACKED;
+		if (k.done != want_done || (want_done && !k.done_valid)) {
+			printf("%s: done=%d valid=%d\n", c.name, k.done, k.done_valid);
+			ret = 1;
+		}
+		if (ret || proxy.bad || proxy.handled != c.nsteps || answers != c.want_answers ||
+		    k.b.activation != c.want_activation || k.b.lease != c.want_lease ||
+		    k.b.activation_status != want_status || k.fd != -1) {
+			printf("%s: handled=%d/%d answers=%d activation=%u/%u lease=%u\n", c.name, proxy.handled,
+			       c.nsteps, answers, k.b.activation, k.b.activation_status, k.b.lease);
+			ret = 1;
+		}
+	}
+	return ret;
+}
+
+// A fresh cgroup v2 directory for test_nfsp_cgroup, and its parent in *root.
+// -1 without a writable cgroup v2 hierarchy (not root, or cgroup v1 only).
+static int nfsp_test_cgroup(int* root, char* name, size_t size)
+{
+	const char* roots[] = {"/sys/fs/cgroup/unified", "/sys/fs/cgroup"};
+	snprintf(name, size, "syz-nfsp-test.%d", getpid());
+	for (size_t i = 0; i < ARRAY_SIZE(roots); i++) {
+		*root = open(roots[i], O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+		if (*root == -1)
+			continue;
+		if (!mkdirat(*root, name, 0700)) {
+			int dir = openat(*root, name, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+			if (dir != -1 && !faccessat(dir, "cgroup.kill", W_OK, 0))
+				return dir;
+			if (dir != -1)
+				close(dir);
+			unlinkat(*root, name, AT_REMOVEDIR);
+		}
+		close(*root);
+	}
+	return -1;
+}
+
+// Whether the cgroup v2 hierarchy is mounted with nsdelegate (systemd does),
+// which makes a cgroup namespace root a boundary for moving tasks.
+static bool nfsp_test_nsdelegate()
+{
+	FILE* f = fopen("/proc/self/mountinfo", "r");
+	if (!f)
+		return false;
+	char line[512];
+	bool found = false;
+	while (!found && fgets(line, sizeof(line), f))
+		found = strstr(line, " - cgroup2 ") && strstr(line, "nsdelegate");
+	fclose(f);
+	return found;
+}
+
+// What a fuzzed program can do to outlive DONE: re-arm itself with a periodic
+// SIGCONT, run a helper in its own session, and (with nsdelegate) move itself
+// out of its cgroup.  The program cgroup's freeze holds through SIGCONT, its
+// kill reaches the helper, and the move is refused.
+static int test_nfsp_cgroup()
+{
+	char name[64];
+	int root = -1;
+	int dir = nfsp_test_cgroup(&root, name, sizeof(name));
+	if (dir == -1) {
+		printf("no writable cgroup v2 hierarchy\n");
+		return -1;
+	}
+	// progress[0]: the program, [1]: its helper, [2]: 1 if the move out was refused.
+	volatile uint64* progress = (volatile uint64*)mmap(NULL, SYZ_PAGE_SIZE, PROT_READ | PROT_WRITE,
+							   MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+	if (progress == MAP_FAILED) {
+		printf("mmap failed\n");
+		return 1;
+	}
+	bool nsdelegate = nfsp_test_nsdelegate();
+	int pid = fork();
+	if (pid == 0) {
+		if (!nfsp_cg_join(dir))
+			doexit(1);
+		close(dir);
+		progress[2] = !nsdelegate || !nfsp_cg_write(root, "cgroup.procs", "0");
+		close(root);
+		struct sigevent sev = {};
+		sev.sigev_notify = SIGEV_SIGNAL;
+		sev.sigev_signo = SIGCONT;
+		int timer = 0;
+		struct itimerspec every_ms = {{0, 1000000}, {0, 1000000}};
+		if (syscall(SYS_timer_create, CLOCK_MONOTONIC, &sev, &timer) ||
+		    syscall(SYS_timer_settime, timer, 0, &every_ms, NULL))
+			doexit(1);
+		if (fork() == 0) {
+			setsid();
+			for (;;) {
+				getppid();
+				progress[1]++;
+			}
+		}
+		for (;;) {
+			getppid();
+			progress[0]++;
+		}
+	}
+	int ret = 0;
+	for (int i = 0; i < 1000 && !(progress[0] && progress[1]); i++)
+		usleep(1000);
+	bool frozen = nfsp_cg_freeze(dir, 1000);
+	uint64 program = progress[0], helper = progress[1];
+	usleep(50 * 1000);
+	if (!frozen || progress[0] != program || progress[1] != helper) {
+		printf("freeze: frozen=%d program %llu -> %llu helper %llu -> %llu\n", frozen, program,
+		       (uint64)progress[0], helper, (uint64)progress[1]);
+		ret = 1;
+	}
+	bool empty = nfsp_cg_empty(dir, 1000);
+	int status = 0;
+	kill(pid, SIGKILL);
+	waitpid(pid, &status, __WALL);
+	helper = progress[1];
+	usleep(20 * 1000);
+	if (!empty || progress[1] != helper || nfsp_cg_event(dir, "frozen") != 0 || progress[2] != 1) {
+		printf("kill: empty=%d helper %llu -> %llu frozen=%d move refused=%llu nsdelegate=%d\n", empty,
+		       helper, (uint64)progress[1], nfsp_cg_event(dir, "frozen"), (uint64)progress[2], nsdelegate);
+		ret = 1;
+	}
+	if (!nsdelegate)
+		printf("no nsdelegate: moving out of the program cgroup is not tested\n");
+	close(dir);
+	unlinkat(root, name, AT_REMOVEDIR);
+	close(root);
+	munmap((void*)progress, SYZ_PAGE_SIZE);
+	return ret;
+}
+#endif
+

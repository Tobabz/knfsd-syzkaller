+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package flatrpc
+
+import (
+	"reflect"
+	"testing"
+
+	flatbuffers "github.com/google/flatbuffers/go"
+)
+
+func TestNfsProxyActivationRoundTrip(t *testing.T) {
+	want := &ProgInfo{
+		Elapsed: 7,
+		NfsProxy: &NfsProxyActivation{
+			Generation:         42,
+			ProgramDigest:      []byte{1, 2, 3},
+			Activation:         NfsProxyBarrierRawAcked,
+			Deactivation:       NfsProxyBarrierRawNoAnswer,
+			DeactivationStatus: 0xffffffff,
+			Executed:           true,
+		},
+	}
+	builder := flatbuffers.NewBuilder(0)
+	builder.Finish(want.Pack(builder))
+	got := GetRootAsProgInfoRaw(builder.FinishedBytes(), 0).UnPack()
+	if !reflect.DeepEqual(got.NfsProxy, want.NfsProxy) {
+		t.Fatalf("NfsProxy round trip: got %+v, want %+v", got.NfsProxy, want.NfsProxy)
+	}
+
+	// Without a barrier the field stays absent: old consumers see no change.
+	builder = flatbuffers.NewBuilder(0)
+	builder.Finish((&ProgInfo{Elapsed: 7}).Pack(builder))
+	if got := GetRootAsProgInfoRaw(builder.FinishedBytes(), 0).UnPack(); got.NfsProxy != nil {
+		t.Fatalf("absent barrier unpacked as %+v", got.NfsProxy)
+	}
+}
+
+func TestNfsProxyActivationClone(t *testing.T) {
+	info := &ProgInfo{NfsProxy: &NfsProxyActivation{Generation: 1, ProgramDigest: []byte{9}}}
+	clone := info.Clone()
+	clone.NfsProxy.ProgramDigest[0] = 0
+	clone.NfsProxy.Generation = 2
+	if info.NfsProxy.ProgramDigest[0] != 9 || info.NfsProxy.Generation != 1 {
+		t.Fatalf("Clone shares the barrier with the original: %+v", info.NfsProxy)
+	}
+}

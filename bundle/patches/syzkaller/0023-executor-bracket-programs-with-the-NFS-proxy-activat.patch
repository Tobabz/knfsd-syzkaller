diff --git a/executor/common.h b/executor/common.h
index 0817e121b..2234c8111 100644
--- a/executor/common.h
+++ b/executor/common.h
@@ -648,11 +648,19 @@ static void loop(void)
 #if SYZ_EXECUTOR
 		if (!flag_snapshot)
 			receive_execute();
+#endif
+#if SYZ_EXECUTOR && GOOS_linux
+		nfsp_broker_prefork();
 #endif
 		int pid = fork();
 		if (pid < 0)
 			fail("clone failed");
 		if (pid == 0) {
+#if SYZ_EXECUTOR && GOOS_linux
+			// The program process never holds the NFS proxy activation
+			// endpoint; the fork server brokers its barrier.
+			nfsp_broker_child();
+#endif
 #if SYZ_EXECUTOR || SYZ_USE_TMP_DIR
 			if (chdir(cwdbuf))
 				fail("failed to chdir");
@@ -677,6 +685,9 @@ static void loop(void)
 			doexit(0);
 		}
 		debug("spawned worker pid %d\n", pid);
+#if SYZ_EXECUTOR && GOOS_linux
+		nfsp_broker_parent();
+#endif
 
 #if SYZ_EXECUTOR
 		if (flag_snapshot)
@@ -695,7 +706,19 @@ static void loop(void)
 		uint32 executed_calls = output_data->completed.load(std::memory_order_relaxed);
 #endif
 		for (;;) {
+#if SYZ_EXECUTOR && GOOS_linux
+			// Also answers the program's NFS proxy barrier requests.
+			nfsp_broker_wait(10);
+			if (nfsp_broker_state.done) {
+				// The fork server, not the program process, ends a program
+				// that ran in an activation window.
+				nfsp_broker_end_program();
+				kill_and_wait(pid, &status);
+				break;
+			}
+#else
 			sleep_ms(10);
+#endif
 			if (waitpid(-1, &status, WNOHANG | WAIT_FLAGS) == pid)
 				break;
 #if SYZ_EXECUTOR
@@ -747,12 +770,17 @@ static void loop(void)
 			kill_and_wait(pid, &status);
 			break;
 		}
+#if SYZ_EXECUTOR && GOOS_linux
+		// Close the NFS proxy activation window once nothing of the program
+		// is left, and before the KCOV generation is aborted.
+		nfsp_broker_end();
+#endif
 #if SYZ_EXECUTOR && GOOS_linux
 		// Cover hangs, crashes, and the BEGIN-return/shared-publication race.  If
 		// the child did not publish an exact id, generation zero means "abort the
 		// current Generation attached to this inherited KCOV fd" (not BIND(0)).
 		uint64 orphan_generation = output_data->kcov_generation.load(std::memory_order_acquire);
-		if (flag_extra_coverage &&
+		if (flag_extra_coverage && !nfsp_broker_kcov_resolved() &&
 		    cover_abort_remote_generation(orphan_generation, true))
 			output_data->kcov_generation.store(0, std::memory_order_release);
 #endif

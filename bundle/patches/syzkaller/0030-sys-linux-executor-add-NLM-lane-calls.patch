diff --git a/sys/linux/nfs_fuzz_test.go b/sys/linux/nfs_fuzz_test.go
index e404840..2685542 100644
--- a/sys/linux/nfs_fuzz_test.go
+++ b/sys/linux/nfs_fuzz_test.go
@@ -370,3 +370,65 @@ func TestNFSProxyVariableLengthArm(t *testing.T) {
 func pathIs(path []string, want string) bool {
 	return len(path) == 1 && path[0] == want
 }
+
+func TestNLMLaneCalls(t *testing.T) {
+	target, err := prog.GetTarget("linux", "amd64")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for client := uint64(0); client < 2; client++ {
+		call := requireNFSFuzzCall(t, target, fmt.Sprintf("syz_socket_connect_nlm$client%d", client))
+		if call.CallName != "syz_socket_connect_nlm" || len(call.Args) != 1 {
+			t.Fatalf("%s has wrong dispatch or arity", call.Name)
+		}
+		requireConst(t, call.Args[0].Type, client, call.Name+" client")
+		if res, ok := call.Ret.(*prog.ResourceType); !ok || res.Desc.Name != "sock_nlm_tcp" {
+			t.Fatalf("%s returns %v, want sock_nlm_tcp", call.Name, call.Ret)
+		}
+	}
+	open := requireNFSFuzzCall(t, target, "syz_open_nlm_lane_file")
+	if len(open.Args) != 3 {
+		t.Fatalf("%s has arity %d", open.Name, len(open.Args))
+	}
+	if res, ok := open.Args[0].Type.(*prog.ResourceType); !ok || res.Desc.Name != "fd_nfs_dir" {
+		t.Fatalf("%s dir is %v, want fd_nfs_dir", open.Name, open.Args[0].Type)
+	}
+	if mode, ok := open.Args[2].Type.(*prog.IntType); !ok || mode.RangeBegin != 0 || mode.RangeEnd != 2 {
+		t.Fatalf("%s mode is %v, want int32[0:2]", open.Name, open.Args[2].Type)
+	}
+	fh := requireNFSFuzzCall(t, target, "syz_nlm_lane_fh")
+	if res, ok := fh.Ret.(*prog.ResourceType); !ok || res.Desc.Name != "nlm_lane_fh_id" {
+		t.Fatalf("%s returns %v, want nlm_lane_fh_id", fh.Name, fh.Ret)
+	}
+	send := requireNFSFuzzCall(t, target, "syz_send_nlm_rpc")
+	if len(send.Args) != 3 {
+		t.Fatalf("%s has arity %d", send.Name, len(send.Args))
+	}
+	// The lane file handle is 20 bytes on the wire after its length word.
+	lane := requireStruct(t, send, "nlm_lane_fh")
+	if lane.Size() != 24 {
+		t.Fatalf("nlm_lane_fh is %d bytes, want 24", lane.Size())
+	}
+}
+
+func TestNLMLaneProgramsParse(t *testing.T) {
+	target, err := prog.GetTarget("linux", "amd64")
+	if err != nil {
+		t.Fatal(err)
+	}
+	const text = `r0 = syz_open_nfs_lane_profile$client0_knfsd_v3(0x0, 0x0)
+r1 = syz_open_nlm_lane_file(r0, &(0x7f0000000000)='lock0\x00', 0x2)
+fcntl$lock(r1, 0x6, &(0x7f0000000040)={0x1, 0x0, 0x0, 0x0, 0x0})
+r2 = syz_nlm_lane_fh(r0, &(0x7f0000000080)='lock0\x00')
+r3 = syz_socket_connect_nlm$client0(0x0)
+syz_send_nlm_rpc(r3, &(0x7f0000000100)=@v4={0x1, 0x0, 0x2, 0x186b5, 0x4, @lock={0x2, @sys={0x1, 0x20, {0x0, {0x9, 'syzkaller'}, 0x0, 0x0, 0x0, []}}, @none={0x0, 0x0}, {@empty=0x0, 0x0, 0x1, {{0x9, 'syzkaller'}, @lane={0x14, 0x1000101, 0x0, r2, 0x0}, {0x4, "01020304"}, 0x4a4c, 0x0, 0x0}, 0x0, 0x1}}}, 0xa0)
+recvfrom$inet_nlm_tcp(r3, &(0x7f0000000200)=""/128, 0x80, 0x0, 0x0, 0x0)
+`
+	p, err := target.Deserialize([]byte(text), prog.Strict)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(p.Calls) != 7 {
+		t.Fatalf("parsed %d calls", len(p.Calls))
+	}
+}
diff --git a/sys/linux/socket_inet_nlm.txt b/sys/linux/socket_inet_nlm.txt
new file mode 100644
index 0000000..e47378e
--- /dev/null
+++ b/sys/linux/socket_inet_nlm.txt
@@ -0,0 +1,246 @@
+# Copyright 2026 syzkaller project authors. All rights reserved.
+# Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+# NLM (Network Lock Manager, RPC program 100021) calls to the fixed lane's
+# kernel lockd.  Only the NLM lane fixture (NFS_FIXTURE=nlm-knfsd) runs lockd
+# with locking clients; elsewhere the connect fails.  The fixture pins lockd
+# to TCP port 4045 in every lane namespace, so the destination is fixture
+# metadata, not fuzzed input; the RPC/XDR body remains mutable.  Coverage of
+# the lockd request is attributed by lane like any other lane server record.
+
+resource sock_nlm_tcp[sock]
+
+# A knfsd NFSv3 file handle of the lane export holds only two variable words:
+# the tmpfs inode generation and the low inode number.  The executor reads the
+# handle of a lane file through the NFS client, checks every constant word
+# against nlm_lane_fh, and returns the two variable words in their wire order.
+resource nlm_lane_fh_id[int64]: 0
+
+# Connect a plain TCP socket from the chosen lane client network namespace to
+# the server's lockd at 10.89.N.1:4045.
+syz_socket_connect_nlm$client0(client const[0]) sock_nlm_tcp
+syz_socket_connect_nlm$client1(client const[1]) sock_nlm_tcp
+
+# Open a regular file strictly beneath a lane directory: no symlinks, no
+# mount crossing, no "..".  The returned fd keeps the directory's lane origin,
+# so kernel NFS client byte-range locks on it (fcntl$lock) become NLM calls.
+# mode is an executor ABI value: 0 read-only, 1 read-write, 2 read-write and
+# create.
+syz_open_nlm_lane_file(dir fd_nfs_dir, file ptr[in, string[nlm_lane_file_names]], mode int32[0:2]) fd
+
+# Resolve a regular file beneath a lane directory the same way to the variable
+# part of its server file handle.
+syz_nlm_lane_fh(dir fd_nfs_dir, file ptr[in, string[nlm_lane_file_names]]) nlm_lane_fh_id
+
+# Send one record-marked NLM call; the record marker is added by the executor.
+syz_send_nlm_rpc(fd sock_nlm_tcp, msg ptr[in, rpc_nlm_call], msglen len[msg])
+recvfrom$inet_nlm_tcp(fd sock_nlm_tcp, buf buffer[out], len len[buf], f flags[recv_flags], addr const[0], addrlen const[0])
+
+nlm_lane_file_names = "lock0", "lock1", "lock2", "shared/fixture"
+
+rpc_nlm_call [
+	v4	rpc_nlm4_call
+	v3	rpc_nlm3_call
+] [varlen]
+
+rpc_nlm4_call {
+	xid	int32be
+	mtype	const[0, int32be]
+	rpcvers	const[2, int32be]
+	prog	const[100021, int32be]
+	vers	const[4, int32be]
+	body	nlm4_call_bodies
+} [packed]
+
+# Versions 1 and 3 share 32-bit offsets; version 1 has no share procedures.
+nlm_v13_versions = 1, 3
+
+rpc_nlm3_call {
+	xid	int32be
+	mtype	const[0, int32be]
+	rpcvers	const[2, int32be]
+	prog	const[100021, int32be]
+	vers	flags[nlm_v13_versions, int32be]
+	body	nlm3_call_bodies
+} [packed]
+
+type nlm_call_t[PROC, ARGS] {
+	proc	const[PROC, int32be]
+	cred	rpc_auth
+	verf	rpc_auth
+	args	ARGS
+} [packed]
+
+type nlm_void_call_t[PROC] {
+	proc	const[PROC, int32be]
+	cred	rpc_auth
+	verf	rpc_auth
+} [packed]
+
+nlm4_call_bodies [
+	null		nlm_void_call_t[0]
+	test		nlm_call_t[1, nlm_testargs[int64be]]
+	lock		nlm_call_t[2, nlm_lockargs[int64be]]
+	cancel		nlm_call_t[3, nlm_cancargs[int64be]]
+	unlock		nlm_call_t[4, nlm_unlockargs[int64be]]
+	granted		nlm_call_t[5, nlm_testargs[int64be]]
+	test_msg	nlm_call_t[6, nlm_testargs[int64be]]
+	lock_msg	nlm_call_t[7, nlm_lockargs[int64be]]
+	cancel_msg	nlm_call_t[8, nlm_cancargs[int64be]]
+	unlock_msg	nlm_call_t[9, nlm_unlockargs[int64be]]
+	granted_msg	nlm_call_t[10, nlm_testargs[int64be]]
+	test_res	nlm_call_t[11, nlm_testres[int64be]]
+	lock_res	nlm_call_t[12, nlm_res]
+	cancel_res	nlm_call_t[13, nlm_res]
+	unlock_res	nlm_call_t[14, nlm_res]
+	granted_res	nlm_call_t[15, nlm_res]
+	share		nlm_call_t[20, nlm_shareargs]
+	unshare		nlm_call_t[21, nlm_shareargs]
+	nm_lock		nlm_call_t[22, nlm_lockargs[int64be]]
+	free_all	nlm_call_t[23, nlm_notify]
+] [varlen]
+
+nlm3_call_bodies [
+	null		nlm_void_call_t[0]
+	test		nlm_call_t[1, nlm_testargs[int32be]]
+	lock		nlm_call_t[2, nlm_lockargs[int32be]]
+	cancel		nlm_call_t[3, nlm_cancargs[int32be]]
+	unlock		nlm_call_t[4, nlm_unlockargs[int32be]]
+	granted		nlm_call_t[5, nlm_testargs[int32be]]
+	test_msg	nlm_call_t[6, nlm_testargs[int32be]]
+	lock_msg	nlm_call_t[7, nlm_lockargs[int32be]]
+	cancel_msg	nlm_call_t[8, nlm_cancargs[int32be]]
+	unlock_msg	nlm_call_t[9, nlm_unlockargs[int32be]]
+	granted_msg	nlm_call_t[10, nlm_testargs[int32be]]
+	test_res	nlm_call_t[11, nlm_testres[int32be]]
+	lock_res	nlm_call_t[12, nlm_res]
+	cancel_res	nlm_call_t[13, nlm_res]
+	unlock_res	nlm_call_t[14, nlm_res]
+	granted_res	nlm_call_t[15, nlm_res]
+	share		nlm_call_t[20, nlm_shareargs]
+	unshare		nlm_call_t[21, nlm_shareargs]
+	nm_lock		nlm_call_t[22, nlm_lockargs[int32be]]
+	free_all	nlm_call_t[23, nlm_notify]
+] [varlen]
+
+# XDR opaque<1024> (netobj) and string<1024>, padded to four bytes.
+nlm_netobj {
+	len	len[data, int32be]
+	data	array[int8, 0:32]
+} [packed, align[4]]
+
+nlm_cookie [
+	empty	const[0, int32be]
+	value	nlm_netobj
+] [varlen]
+
+nlm_caller_names = "frozen-phase9-lane0-client0", "frozen-phase9-lane0-client1", "localhost", "syzkaller"
+
+nlm_caller_name {

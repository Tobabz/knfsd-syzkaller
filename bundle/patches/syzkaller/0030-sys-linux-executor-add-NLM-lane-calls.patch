+// The NLM lane fixture pins the kernel lockd to this TCP port in every lane
+// namespace.  Both clients reach the server's lockd at the .1 address.
+#define NFS_LANE_NLM_PORT 4045
+
+static long syz_socket_connect_nlm(volatile long a0)
+{
+	// syz_socket_connect_nlm(client const[0:1]) sock_nlm_tcp
+	unsigned long client = a0;
+	if (client > 1) {
+		errno = EINVAL;
+		return -1;
+	}
+	return nfs_socket_connect_port(client, 0, NFS_LANE_NLM_PORT);
+}
+
+#ifndef __NR_openat2
+#define __NR_openat2 437
+#endif
+
+struct nfs_lane_open_how {
+	uint64 flags;
+	uint64 mode;
+	uint64 resolve;
+};
+
+// Open a regular file of the NFS lane strictly beneath dirfd: no symlink,
+// magic link, mount crossing or "..".  mode: 0 read-only, 1 read-write,
+// 2 read-write and create; 3 (internal) an O_PATH reference.
+static int nfs_lane_open_file(int dirfd, const char* file, unsigned long mode)
+{
+	if (!file || mode > 3) {
+		errno = EINVAL;
+		return -1;
+	}
+	static const uint64 flags[] = {O_RDONLY, O_RDWR, O_RDWR | O_CREAT, O_PATH};
+	struct nfs_lane_open_how how = {};
+	how.flags = flags[mode] | O_CLOEXEC | O_NOFOLLOW;
+	how.mode = mode == 2 ? 0644 : 0;
+	// RESOLVE_NO_XDEV | RESOLVE_NO_MAGICLINKS | RESOLVE_NO_SYMLINKS |
+	// RESOLVE_BENEATH
+	how.resolve = 0x01 | 0x02 | 0x04 | 0x08;
+	int fd = syscall(__NR_openat2, dirfd, file, &how, sizeof(how));
+	if (fd < 0)
+		return -1;
+	struct stat st;
+	struct statfs sfs;
+	if (fstat(fd, &st) || fstatfs(fd, &sfs)) {
+		int saved_errno = errno;
+		close(fd);
+		errno = saved_errno;
+		return -1;
+	}
+	if (!S_ISREG(st.st_mode) || sfs.f_type != 0x6969) {
+		close(fd);
+		errno = EINVAL;
+		return -1;
+	}
+	return fd;
+}
+
+static long syz_open_nlm_lane_file(volatile long a0, volatile long a1, volatile long a2)
+{
+	// syz_open_nlm_lane_file(dir fd_nfs_dir, file ptr[in, string],
+	//                        mode int32[0:2]) fd
+	if ((unsigned long)a2 > 2) {
+		errno = EINVAL;
+		return -1;
+	}
+	return nfs_lane_open_file(a0, (const char*)a1, a2);
+}
+
+static long syz_nlm_lane_fh(volatile long a0, volatile long a1)
+{
+	// syz_nlm_lane_fh(dir fd_nfs_dir, file ptr[in, string]) nlm_lane_fh_id
+	// Return the variable words of a lane file's knfsd file handle: the NFS
+	// client embeds the server handle (u16 size, then the bytes) after three
+	// words of its own.  Every constant word must match the lane layout that
+	// nlm_lane_fh encodes (version 1, AUTH 0, FSID_NUM fsid 0, tmpfs FILEID
+	// type 1 with a zero high inode word); anything else fails with EPROTO.
+	int fd = nfs_lane_open_file(a0, (const char*)a1, 3);
+	if (fd < 0)
+		return -1;
+	union {
+		struct file_handle fh;
+		uint8 raw[sizeof(struct file_handle) + 128];
+	} handle = {};
+	handle.fh.handle_bytes = 128;
+	int mount_id = 0;
+	int ret = name_to_handle_at(fd, "", &handle.fh, &mount_id, AT_EMPTY_PATH);
+	int saved_errno = errno;
+	close(fd);
+	if (ret) {
+		errno = saved_errno;
+		return -1;
+	}
+	const uint8* embedded = handle.fh.f_handle + 12;
+	uint16 size = 0;
+	if (handle.fh.handle_bytes < 12 + 2 + 20) {
+		errno = EPROTO;
+		return -1;
+	}
+	memcpy(&size, embedded, sizeof(size));
+	const uint8* fh = embedded + 2;
+	static const uint8 lane_prefix[8] = {1, 0, 1, 1, 0, 0, 0, 0};
+	static const uint8 zero_word[4] = {};
+	if (size != 20 || memcmp(fh, lane_prefix, sizeof(lane_prefix)) ||
+	    memcmp(fh + 16, zero_word, sizeof(zero_word))) {
+		errno = EPROTO;
+		return -1;
+	}
+	uint64 gen_ino = 0;
+	memcpy(&gen_ino, fh + 8, sizeof(gen_ino));
+	return gen_ino;
+}
+
 static uint32 nfs_lifecycle_get32(const uint8* p)
 {
 	return ((uint32)p[0] << 24) | ((uint32)p[1] << 16) |
@@ -3134,19 +3260,8 @@ static long syz_arm_nfs_proxy_v2(volatile long a0, volatile long a1)
 	return nfs_proxy_arm_send(rule, len);
 }
 
-static long syz_send_nfs_fuzz(volatile long a0, volatile long a1,
-			      volatile long a2, volatile long a3,
-			      volatile long a4)
+static long nfs_send_record(int fd, void* payload, size_t payload_len)
 {
-	// syz_send_nfs_fuzz(fd sock_nfs_fuzz_tcp, msg ptr[in, rpc_nfs_call],
-	//                    msglen len[msg], flags const[...], user_tag proc[...])
-	// Sends one record-marked RPC call.  Server coverage is attributed by
-	// lane, so flags and user_tag are accepted for compatibility and ignored.
-	int fd = a0;
-	void* payload = (void*)a1;
-	size_t payload_len = a2;
-	(void)a3;
-	(void)a4;
 	if (!payload || payload_len < 8 || payload_len > 0x7fffffff) {
 		errno = EINVAL;
 		return -1;
@@ -3162,6 +3277,26 @@ static long syz_send_nfs_fuzz(volatile long a0, volatile long a1,
 	msg.msg_iovlen = 2;
 	return sendmsg(fd, &msg, MSG_NOSIGNAL);
 }
+
+static long syz_send_nlm_rpc(volatile long a0, volatile long a1, volatile long a2)
+{
+	// syz_send_nlm_rpc(fd sock_nlm_tcp, msg ptr[in, rpc_nlm_call],
+	//                  msglen len[msg])
+	return nfs_send_record(a0, (void*)a1, a2);
+}
+
+static long syz_send_nfs_fuzz(volatile long a0, volatile long a1,
+			      volatile long a2, volatile long a3,
+			      volatile long a4)
+{
+	// syz_send_nfs_fuzz(fd sock_nfs_fuzz_tcp, msg ptr[in, rpc_nfs_call],
+	//                    msglen len[msg], flags const[...], user_tag proc[...])
+	// Sends one record-marked RPC call.  Server coverage is attributed by
+	// lane, so flags and user_tag are accepted for compatibility and ignored.
+	(void)a3;
+	(void)a4;
+	return nfs_send_record(a0, (void*)a1, a2);
+}
 #endif
 
 #if SYZ_EXECUTOR || __NR_syz_open_dev

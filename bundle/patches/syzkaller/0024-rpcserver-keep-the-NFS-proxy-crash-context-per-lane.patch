diff --git a/pkg/rpcserver/nfs_proxy_window_test.go b/pkg/rpcserver/nfs_proxy_window_test.go
new file mode 100644
index 000000000..f5971b28f
--- /dev/null
+++ b/pkg/rpcserver/nfs_proxy_window_test.go
@@ -0,0 +1,89 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package rpcserver
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/google/syzkaller/pkg/flatrpc"
+	"github.com/google/syzkaller/pkg/report"
+	"github.com/google/syzkaller/prog"
+	_ "github.com/google/syzkaller/sys"
+	"github.com/google/syzkaller/sys/targets"
+	"github.com/stretchr/testify/assert"
+)
+
+func barrier(generation uint64) *flatrpc.NfsProxyActivation {
+	return &flatrpc.NfsProxyActivation{
+		Generation:    generation,
+		ProgramDigest: []byte{0xab, 0xcd},
+		Activation:    flatrpc.NfsProxyBarrierRawAcked,
+		Deactivation:  flatrpc.NfsProxyBarrierRawAcked,
+		Executed:      true,
+		LeaseCleared:  true,
+	}
+}
+
+// A finished program keeps its barrier; the one still running at the crash
+// has none, and a hung one keeps its lane although Proc is rewritten.
+func TestLastExecutingNfsProxyWindow(t *testing.T) {
+	last := MakeLastExecuting(prog.MaxPids, 3)
+	last.Note(1, 2, []byte("prog1"), 10)
+	b := barrier(7)
+	last.Finished(1, 2, b)
+	b.ProgramDigest[0] = 0           // the record holds its own copy
+	last.Finished(1, 3, barrier(99)) // another proc's id is not this record
+	last.Note(2, 2, []byte("prog2"), 20)
+	last.Hanged(2, 2, []byte("prog2"), 25, barrier(8))
+	last.Note(3, 2, []byte("prog3"), 30)
+	last.Finished(4, 2, barrier(9)) // not in the ring: ignored
+	records := last.Collect()
+	assert.Len(t, records, 4)
+	assert.Equal(t, 2, records[0].Lane)
+	assert.Equal(t, uint64(7), records[0].NfsProxy.Generation)
+	assert.Equal(t, []byte{0xab, 0xcd}, records[0].NfsProxy.ProgramDigest)
+	assert.Nil(t, records[1].NfsProxy) // prog2 as started; its result never came
+	assert.Equal(t, prog.MaxPids, records[2].Proc)
+	assert.Equal(t, 2, records[2].Lane)
+	assert.Equal(t, uint64(8), records[2].NfsProxy.Generation)
+	assert.Equal(t, 3, records[3].ID)
+	assert.Nil(t, records[3].NfsProxy)
+}
+
+func TestNfsProxyContextLine(t *testing.T) {
+	assert.Equal(t, "", NfsProxyContextLine(ExecRecord{Proc: 1, Lane: 1}))
+	assert.Equal(t, "nfs-proxy: lane=1", NfsProxyContextLine(ExecRecord{Proc: 33, Lane: 1}))
+	assert.Equal(t, "nfs-proxy: lane=1 generation=7 program_digest=abcd"+
+		" activation=Acked/0 deactivation=Acked/0 executed=true lease_cleared=true",
+		NfsProxyContextLine(ExecRecord{Proc: 1, Lane: 1, NfsProxy: barrier(7)}))
+	assert.NotContains(t, NfsProxyContextLine(ExecRecord{Lane: 1, NfsProxy: barrier(7)}), "id=")
+}
+
+// The context lines do not change what pkg/repro reads back from a crash log.
+func TestPrependExecutingKeepsParseLog(t *testing.T) {
+	target, err := prog.GetTarget(targets.Linux, targets.AMD64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	progs := []string{"getpid()\n", "getuid()\n", "gettid()\n"}
+	records := []ExecRecord{
+		{ID: 5, Proc: 1, Lane: 1, Prog: []byte(progs[0]), NfsProxy: barrier(3)},
+		{ID: 6, Proc: 32, Lane: 1, Prog: []byte(progs[1]), NfsProxy: barrier(4)},
+		{ID: 7, Proc: 1, Lane: 1, Prog: []byte(progs[2])},
+	}
+	rep := &report.Report{Output: []byte("crash\n")}
+	PrependExecuting(rep, records)
+	out := string(rep.Output)
+	assert.Contains(t, out, "executing program 1 (id=5):\nnfs-proxy: lane=1 generation=3 ")
+	assert.Contains(t, out, "executing program 32 (id=6):\nnfs-proxy: lane=1 generation=4 ")
+	assert.Contains(t, out, "executing program 1 (id=7):\ngettid()\n")
+	entries := target.ParseLog(rep.Output, prog.NonStrict)
+	assert.Len(t, entries, 3)
+	for i, ent := range entries {
+		assert.Equal(t, records[i].ID, ent.ID)
+		assert.Equal(t, records[i].Proc, ent.Proc)
+		assert.Equal(t, strings.TrimSpace(progs[i]), strings.TrimSpace(string(ent.P.Serialize())))
+	}
+}

 // LastExecuting keeps the given number of last executed programs
 // for each proc in a VM, and allows to query this set after a crash.
 type LastExecuting struct {
@@ -28,6 +36,15 @@ type ExecRecord struct {
 	Proc int
 	Prog []byte
 	Time time.Duration
+	// Lane is the proc the program was started on.  Hanged replaces Proc
+	// with a synthetic value; the proc's NFS lane (and with it the lane's
+	// knfsd state a crash may depend on) is the one the program ran in.
+	Lane int
+	// NfsProxy is the NFS proxy activation barrier the executor reported
+	// for this program's KCOV generation (knfsd-syzkaller S1a), when the
+	// program finished.  A program still running at a crash has none: its
+	// generation is the next one its lane opened on the host journal.
+	NfsProxy *flatrpc.NfsProxyActivation
 }
 
 func MakeLastExecuting(procs, count int) *LastExecuting {
@@ -46,6 +63,7 @@ func (last *LastExecuting) Note(id, proc int, progData []byte, now time.Duration
 		Proc: proc,
 		Prog: progData,
 		Time: now,
+		Lane: proc,
 	}
 	*pos++
 	if *pos == last.count {
@@ -53,15 +71,39 @@ func (last *LastExecuting) Note(id, proc int, progData []byte, now time.Duration
 	}
 }
 
+// Finished attaches the NFS proxy barrier of a finished program to its
+// record, if the record is still in its proc's ring.
+func (last *LastExecuting) Finished(id, proc int, nfsProxy *flatrpc.NfsProxyActivation) {
+	if nfsProxy == nil || proc < 0 || proc >= len(last.positions) {
+		return
+	}
+	for i := proc * last.count; i < (proc+1)*last.count; i++ {
+		if rec := &last.procs[i]; rec.ID == id && rec.Lane == proc && rec.Prog != nil {
+			clone := *nfsProxy
+			clone.ProgramDigest = slices.Clone(nfsProxy.ProgramDigest)
+			rec.NfsProxy = &clone
+			return
+		}
+	}
+}
+
 // Hanged notes a hung program.
-func (last *LastExecuting) Hanged(id, proc int, progData []byte, now time.Duration) {
+func (last *LastExecuting) Hanged(id, proc int, progData []byte, now time.Duration,
+	nfsProxy *flatrpc.NfsProxyActivation) {
+	if nfsProxy != nil {
+		clone := *nfsProxy
+		clone.ProgramDigest = slices.Clone(nfsProxy.ProgramDigest)
+		nfsProxy = &clone
+	}
 	last.hanged = append(last.hanged, ExecRecord{
 		ID: id,
 		// Use unique proc for these programs b/c pkg/repro will either use the program with matching ID,
 		// of take the last program from each proc, and we want the hanged programs to be included.
-		Proc: prog.MaxPids + len(last.hanged),
-		Prog: progData,
-		Time: now,
+		Proc:     prog.MaxPids + len(last.hanged),
+		Prog:     progData,
+		Time:     now,
+		Lane:     proc,
+		NfsProxy: nfsProxy,
 	})
 }
 
@@ -91,7 +133,11 @@ func PrependExecuting(rep *report.Report, lastExec []ExecRecord) {
 	buf := new(bytes.Buffer)
 	fmt.Fprintf(buf, "last executing test programs:\n\n")
 	for _, exec := range lastExec {
-		fmt.Fprintf(buf, "%v ago: executing program %v (id=%v):\n%s\n", exec.Time, exec.Proc, exec.ID, exec.Prog)
+		fmt.Fprintf(buf, "%v ago: executing program %v (id=%v):\n", exec.Time, exec.Proc, exec.ID)
+		if line := NfsProxyContextLine(exec); line != "" {
+			fmt.Fprintf(buf, "%s\n", line)
+		}
+		fmt.Fprintf(buf, "%s\n", exec.Prog)
 	}
 	fmt.Fprintf(buf, "kernel console output (not intermixed with test programs):\n\n")
 	rep.Output = append(buf.Bytes(), rep.Output...)
@@ -100,3 +146,24 @@ func PrependExecuting(rep *report.Report, lastExec []ExecRecord) {
 	rep.EndPos += n
 	rep.SkipPos += n
 }
+
+// NfsProxyContextLine describes the CrashContextWindow facts of one record
+// (knfsd-syzkaller S1c): the lane it ran in and, once it finished, the NFS
+// proxy barrier of its KCOV generation.  The Runner joins a crash's window
+// to the host journal with these values.  Records with neither (no NFS
+// proxy, and a lane equal to the printed proc) print nothing, so other
+// crash logs are unchanged.  The line is not a program: prog.ParseLog skips
+// it, and none of its keys contains "id=".
+func NfsProxyContextLine(exec ExecRecord) string {
+	if exec.NfsProxy == nil {
+		if exec.Lane == exec.Proc {
+			return ""
+		}
+		return fmt.Sprintf("nfs-proxy: lane=%d", exec.Lane)
+	}
+	b := exec.NfsProxy
+	return fmt.Sprintf("nfs-proxy: lane=%d generation=%d program_digest=%x"+
+		" activation=%s/%d deactivation=%s/%d executed=%v lease_cleared=%v",
+		exec.Lane, b.Generation, b.ProgramDigest, b.Activation, b.ActivationStatus,
+		b.Deactivation, b.DeactivationStatus, b.Executed, b.LeaseCleared)
+}

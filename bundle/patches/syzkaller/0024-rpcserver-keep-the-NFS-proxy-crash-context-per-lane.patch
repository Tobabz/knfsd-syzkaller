+const (
+	// DefaultLastExecuting programs are kept per proc unless the NFS proxy
+	// CrashContextWindow needs more (mgrconfig experimental.nfs_proxy_window).
+	DefaultLastExecuting = 6
+	MaxLastExecuting     = 64
+)

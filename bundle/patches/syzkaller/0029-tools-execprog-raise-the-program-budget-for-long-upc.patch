index 5c3d225..960fb14 100644
--- a/pkg/rpcserver/rpcserver.go
+++ b/pkg/rpcserver/rpcserver.go
@@ -17,6 +17,7 @@ import (
 	"strings"
 	"sync"
 	"sync/atomic"
+	"time"
 
 	"github.com/google/syzkaller/pkg/cover"
 	"github.com/google/syzkaller/pkg/cover/backend"
@@ -78,10 +79,14 @@ type Config struct {
 	nfsProxyEvidence *nfsProxyEvidenceWriter
 	Procs            int
 	Slowdown         int
-	ExecutorBin      string
-	Timeouts         targets.Timeouts
-	pcBase           uint64
-	localModules     []*vminfo.KernelModule
+	// ProgramTimeout raises the per-program execution budget above the
+	// slowdown-derived default, for programs that must wait out a kernel
+	// timeout.  Zero (or a shorter value) keeps the default.
+	ProgramTimeout time.Duration
+	ExecutorBin    string
+	Timeouts       targets.Timeouts
+	pcBase         uint64
+	localModules   []*vminfo.KernelModule
 
 	// RPCServer closes the channel once the machine check has begun. Used for fault injection during testing.
 	machineCheckStarted chan struct{}
@@ -239,7 +244,7 @@ func newImpl(cfg *Config, mgr Manager) *server {
 		mgr:         mgr,
 		target:      cfg.Target,
 		sysTarget:   sysTarget,
-		timeouts:    sysTarget.Timeouts(cfg.Slowdown),
+		timeouts:    ProgramTimeouts(sysTarget, cfg.Slowdown, cfg.ProgramTimeout),
 		runners:     make(map[int]*Runner),
 		checker:     checker,
 		baseSource:  baseSource,
@@ -260,6 +265,28 @@ func newImpl(cfg *Config, mgr Manager) *server {
 	}
 }
 
+// ProgramTimeouts returns the target's timeouts for slowdown with the
+// per-program budget raised to program when that is longer.
+func ProgramTimeouts(sysTarget *targets.Target, slowdown int, program time.Duration) targets.Timeouts {
+	timeouts := sysTarget.Timeouts(slowdown)
+	timeouts.Program = max(timeouts.Program, program)
+	return timeouts
+}
+
+// CheckProgramTimeout rejects a requested program budget that the default
+// already covers or that reaches the no-output hang detector.
+func CheckProgramTimeout(sysTarget *targets.Target, slowdown int, program time.Duration) error {
+	if program == 0 {
+		return nil
+	}
+	timeouts := sysTarget.Timeouts(slowdown)
+	if program <= timeouts.Program || program >= timeouts.NoOutput {
+		return fmt.Errorf("program timeout %v must be above the default %v and below the no-output timeout %v",
+			program, timeouts.Program, timeouts.NoOutput)
+	}
+	return nil
+}
+
 func (serv *server) Close() error {
 	// Unset the source so that we don't hold references to it (allowing GC)
 	// and don't serve any new requests from lingering connections.

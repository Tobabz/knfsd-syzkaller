diff --git a/tools/syz-execprog/coverage_test.go b/tools/syz-execprog/coverage_test.go
new file mode 100644
index 0000000..d9874aa
--- /dev/null
+++ b/tools/syz-execprog/coverage_test.go
@@ -0,0 +1,58 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/google/syzkaller/pkg/flatrpc"
+	"github.com/google/syzkaller/prog"
+	_ "github.com/google/syzkaller/sys"
+	"github.com/google/syzkaller/sys/targets"
+	"github.com/stretchr/testify/require"
+)
+
+func dumpedFiles(t *testing.T, dir, suffix string) []string {
+	matches, err := filepath.Glob(filepath.Join(dir, "*"+suffix))
+	require.NoError(t, err)
+	return matches
+}
+
+// Each program exports exactly one .meta, and one .extra iff the executor
+// published remote coverage.  A program stopped at its budget publishes none,
+// and its .meta says so.
+func TestDumpCoverageExportsOnePerProgram(t *testing.T) {
+	target, err := prog.GetTarget(targets.Linux, targets.AMD64)
+	require.NoError(t, err)
+	finished := flatrpc.CallFlagExecuted | flatrpc.CallFlagFinished
+	for _, test := range []struct {
+		name       string
+		info       *flatrpc.ProgInfo
+		extra      int
+		unfinished string
+	}{
+		{"published", &flatrpc.ProgInfo{
+			Calls: []*flatrpc.CallInfo{{Flags: finished}, {Flags: finished}},
+			Extra: &flatrpc.CallInfo{Cover: []uint64{0xffffffff81000010}},
+		}, 1, "unfinished_calls 0\n"},
+		{"stopped at budget", &flatrpc.ProgInfo{
+			Calls: []*flatrpc.CallInfo{{Flags: flatrpc.CallFlagExecuted}, {Error: 999}},
+		}, 0, "unfinished_calls 2\n"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			dir := t.TempDir()
+			ctx := &Context{target: target, coverFile: filepath.Join(dir, "cover")}
+			ctx.dumpCoverage(test.info)
+			require.Len(t, dumpedFiles(t, dir, ".extra"), test.extra)
+			meta := dumpedFiles(t, dir, ".meta")
+			require.Len(t, meta, 1)
+			data, err := os.ReadFile(meta[0])
+			require.NoError(t, err)
+			require.True(t, strings.Contains(string(data), test.unfinished), "%s", data)
+		})
+	}
+}

+++ b/pkg/rpcserver/program_timeout_test.go
@@ -0,0 +1,43 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package rpcserver
+
+import (
+	"testing"
+	"time"
+
+	"github.com/google/syzkaller/prog"
+	"github.com/google/syzkaller/sys/targets"
+	"github.com/stretchr/testify/require"
+)
+
+func TestProgramTimeoutRaisesBudget(t *testing.T) {
+	sysTarget := targets.Get(targets.Linux, targets.AMD64)
+	def := sysTarget.Timeouts(10)
+	// Slowdown alone cannot exceed the capped default.
+	require.Equal(t, 15*time.Second, def.Program)
+
+	got := ProgramTimeouts(sysTarget, 1, 90*time.Second)
+	require.Equal(t, 90*time.Second, got.Program)
+	require.Equal(t, sysTarget.Timeouts(1).Syscall, got.Syscall)
+	require.Equal(t, sysTarget.Timeouts(1).NoOutput, got.NoOutput)
+	require.Equal(t, sysTarget.Timeouts(1), ProgramTimeouts(sysTarget, 1, 0))
+	require.Equal(t, def, ProgramTimeouts(sysTarget, 10, time.Second))
+
+	require.NoError(t, CheckProgramTimeout(sysTarget, 1, 0))
+	require.NoError(t, CheckProgramTimeout(sysTarget, 1, 90*time.Second))
+	require.Error(t, CheckProgramTimeout(sysTarget, 1, 5*time.Second))
+	require.Error(t, CheckProgramTimeout(sysTarget, 1, 5*time.Minute))
+}
+
+func TestProgramTimeoutReachesServer(t *testing.T) {
+	target, err := prog.GetTarget(targets.TestOS, targets.TestArch64Fork)
+	require.NoError(t, err)
+	cfg := &Config{Slowdown: 1, ProgramTimeout: 90 * time.Second}
+	cfg.Target = target
+	cfg.VMArch = target.Arch
+	serv := newImpl(cfg, nil)
+	// serv.timeouts is what the handshake sends as ProgramTimeoutMs.
+	require.Equal(t, 90*time.Second, serv.timeouts.Program)
+}

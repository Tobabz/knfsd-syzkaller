--- /dev/null
+++ b/pkg/runtest/program_timeout_test.go
@@ -0,0 +1,78 @@
+// Copyright 2026 syzkaller project authors. All rights reserved.
+// Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+
+package runtest
+
+import (
+	"encoding/hex"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/google/syzkaller/pkg/csource"
+	"github.com/google/syzkaller/pkg/flatrpc"
+	"github.com/google/syzkaller/pkg/fuzzer/queue"
+	"github.com/google/syzkaller/prog"
+	"github.com/google/syzkaller/sys/targets"
+	"github.com/stretchr/testify/require"
+)
+
+// A program that blocks past the default budget (as one waiting out a kernel
+// upcall timeout does) keeps its remote coverage only with a longer
+// ProgramTimeout; at the default budget the fork server kills it first.
+func TestProgramTimeoutKeepsLongProgramExtraCoverage(t *testing.T) {
+	t.Parallel()
+	target, err := prog.GetTarget(targets.TestOS, targets.TestArch64Fork)
+	require.NoError(t, err)
+	sysTarget := targets.Get(target.OS, target.Arch)
+	if sysTarget.BrokenCompiler != "" {
+		t.Skipf("skipping, broken cross-compiler: %v", sysTarget.BrokenCompiler)
+	}
+	// Default budget at slowdown 1 is 5s; the program sleeps 7s inline.
+	require.Equal(t, 5*time.Second, sysTarget.Timeouts(1).Program)
+	pcs := []uint64{0xc0dec0dec0000001, 0xc0dec0dec0000010}
+	text := fmt.Sprintf("syz_sleep_ms(0x1b58)\nsyz_inject_remote_cover(&AUTO=\"%s\", AUTO)\n",
+		hex.EncodeToString(makeCover64(pcs...)))
+	executor := csource.BuildExecutor(t, target, "../..")
+	for _, test := range []struct {
+		name     string
+		timeout  time.Duration
+		finished bool
+	}{
+		{"raised", 30 * time.Second, true},
+		{"default", 0, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			source := queue.Plain()
+			ctx := startRPCServer(t, target, executor, source, rpcParams{
+				slowdown:       1,
+				programTimeout: test.timeout,
+			})
+			p, err := target.Deserialize([]byte(text), prog.Strict)
+			require.NoError(t, err)
+			req := &queue.Request{
+				Prog: p,
+				ExecOpts: flatrpc.ExecOpts{
+					EnvFlags:  flatrpc.ExecEnvSignal | flatrpc.ExecEnvExtraCover | flatrpc.ExecEnvSandboxNone,
+					ExecFlags: flatrpc.ExecFlagCollectSignal | flatrpc.ExecFlagCollectCover,
+				},
+			}
+			source.Submit(req)
+			res := req.Wait(ctx)
+			require.NoError(t, res.Err, "execution failed:\n%s", res.Output)
+			require.Equal(t, queue.Success, res.Status)
+			require.Len(t, res.Info.Calls, len(p.Calls))
+			for i, call := range res.Info.Calls {
+				require.Equal(t, test.finished, call.Flags&flatrpc.CallFlagFinished != 0, "call %v", i)
+			}
+			if !test.finished {
+				// The killed program never reached the remote coverage.
+				require.True(t, res.Info.Extra == nil || len(res.Info.Extra.Cover) == 0)
+				return
+			}
+			require.NotNil(t, res.Info.Extra)
+			require.Equal(t, pcs, res.Info.Extra.Cover)
+		})
+	}
+}

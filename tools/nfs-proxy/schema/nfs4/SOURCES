# NFSv4.2 extensions (RFC 8178): xattr operations and the attribute
# delegation types.  normalize.py applies them on top of rfc7863.x (the
# `extension` annotation).
extract rfc8276.x 8276 846fb7e5258d22c37a6f9ec9edc1220893cd5f070dcfed425d41d03f057d3abb grep '^ *///' $* | sed 's?^ */// ??' | sed 's?^ *///$??'
extract rfc9754.x 9754 9a40c4364ea0e0ece309ef96f9260b9c301a76907dd40fefd149b5fb8d7de236 grep '^ *///' $* | sed 's?^ */// ??' | sed 's?^ *///$??'


# Semantic annotations for NFSv4.0, NFSv4.1 and NFSv4.2.
#
# The XDR is RFC 7531, RFC 5662 and RFC 7863, extracted and pinned by
# SOURCES.  This file names things; it never states a field, offset or width.
notice Derived from the IETF Code Components of RFC 7531, RFC 5662, RFC 7863,
notice RFC 8276, RFC 9754, RFC 8435 and RFC 8154 (Copyright IETF Trust and the
notice persons identified as authors of the code) under the Simplified
notice (Revised) BSD License,
notice whose text heads tools/nfs-proxy/schema/nfs4/rfc7531.x, rfc5662.x,
notice rfc7863.x and rfc8276.x, and from two RFC 5531 definitions; see
notice THIRD-PARTY-LICENSES.md.
family nfs4
program NFS4_PROGRAM NFS_V4
procedure-prefix NFSPROC4_
leaf args result
operation request nfs_argop4 args OP_
operation response nfs_resop4 result OP_
status-type nfsstat4
minor-field COMPOUND4args minorversion
prelude prelude.x
minor 0 rfc7531.x
minor 1 rfc5662.x
minor 2 rfc7863.x
# NFSv4.2 extensions (RFC 8178) that knfsd implements: xattr operations
# (RFC 8276) and the attribute delegation types (RFC 9754).
extension 2 rfc8276.x
extension 2 rfc9754.x
# RFC 9754 adds open_delegation_type4 values 4 and 5 but no
# open_delegation4 arm for them.  knfsd encodes them with the READ and WRITE
# arms (fs/nfsd/nfs4xdr.c nfsd4_encode_open_delegation4), and so does the
# Linux client's decoder.
alias-arm open_delegation4 OPEN_DELEGATE_READ_ATTRS_DELEG OPEN_DELEGATE_READ
alias-arm open_delegation4 OPEN_DELEGATE_WRITE_ATTRS_DELEG OPEN_DELEGATE_WRITE
# pNFS layout types knfsd implements: flex files (RFC 8435) and SCSI
# (RFC 8154) add values to RFC 5662's layouttype4.  Layout bodies stay
# opaque, so nothing else changes.
extension 1 rfc8435-layouttype4.x
extension 1 rfc8154-layouttype4.x
extension 2 rfc8435-layouttype4.x
extension 2 rfc8154-layouttype4.x
# Every other case label keeps its lowercased XDR name (nfs4err_denied, ...).
branch NFS4_OK ok

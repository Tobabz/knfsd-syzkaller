# Verifies the v2 arm's OP_APPEND in struct-preserving mode (opcount bumped):
# arms a C2S/knfsd rule appending a raw GETATTR op (opcode 9, no bitmap) to
# every matching COMPOUND, then sends a single-op PUTROOTFH compound. Guest
# run (2026-10-02, kasan): proxy stats showed edit_applied=3 (this call plus
# fixture-setup mount traffic, since the predicate has no anchor), 0
# framing/relay/mutation errors; remote-cover .extra over 10 repeats hit
# nfsd4_decode_getattr/nfsd4_getattr/nfsd4_encode_getattr, confirming the
# server actually decoded and dispatched the appended op. No fatal dmesg.
r2 = syz_arm_nfs_proxy_v2$scoped(&(0x7f0000001000)={0x4e46535041524d32, 0x0, 0x0, 0x0, 0xffffffff, 0x0, 0x0, 0x0, 0x1, 0x0, '', [{0x3, 0x0, 0x0, 0x4, '', '\x00\x00\x00\x09'}]}, 0x40)
r0 = syz_open_nfs_lane_pair$client0_knfsd(0x0, 0x0)
r1 = syz_socket_connect_nfs_pair$client0_knfsd(0x0, 0x0)
syz_send_nfs_fuzz$new(r1, &(0x7f0000003000)=@nfs4={0x11111111, 0x0, 0x2, 0x186a3, 0x4, 0x1, @none={0x0, 0x0}, @none={0x0, 0x0}, {@empty=0x0, 0x1, 0x1, [@op_putrootfh={0x18, {0x0}}]}}, 0x3c, 0x1, 0x0)
nanosleep(&(0x7f0000008000)={0x0, 0x1dcd6500}, 0x0)
recvfrom(r1, &(0x7f0000009000)=""/256, 0x100, 0x40, 0x0, 0x0)
close(r1)
close(r0)
close$nfs_proxy_arm(r2)

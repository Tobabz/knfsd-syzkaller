# Same arm and send as guest-syzkaller-v2-append.prog but mode=1 (raw): the
# appended op must NOT bump the declared opcount. Registration and apply
# still succeed without error; whether the server reads only the declared
# op is NOT distinguishable from this record alone, because fixture mount
# traffic on the same (client, backend, dir) legitimately issues its own
# GETATTR during NFSv4 mount. Use an anchored rule (see
# guest-syzkaller-v2-replace.prog) to isolate one record's effect.
r2 = syz_arm_nfs_proxy_v2$scoped(&(0x7f0000001000)={0x4e46535041524d32, 0x0, 0x0, 0x0, 0xffffffff, 0x0, 0x0, 0x1, 0x1, 0x0, '', [{0x3, 0x0, 0x0, 0x4, '', '\x00\x00\x00\x09'}]}, 0x40)
r0 = syz_open_nfs_lane_pair$client0_knfsd(0x0, 0x0)
r1 = syz_socket_connect_nfs_pair$client0_knfsd(0x0, 0x0)
syz_send_nfs_fuzz$new(r1, &(0x7f0000003000)=@nfs4={0x11111111, 0x0, 0x2, 0x186a3, 0x4, 0x1, @none={0x0, 0x0}, @none={0x0, 0x0}, {@empty=0x0, 0x1, 0x1, [@op_putrootfh={0x18, {0x0}}]}}, 0x3c, 0x1, 0x0)
nanosleep(&(0x7f0000008000)={0x0, 0x1dcd6500}, 0x0)
recvfrom(r1, &(0x7f0000009000)=""/256, 0x100, 0x40, 0x0, 0x0)
close(r1)
close(r0)
close$nfs_proxy_arm(r2)

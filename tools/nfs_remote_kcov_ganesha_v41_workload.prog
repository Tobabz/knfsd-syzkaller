# tools/nfs_remote_kcov_ganesha_v41_workload.prog
#
# Adapted from tools/nfs_remote_kcov_ab_workload_markerhidden.prog for the
# NFS-Ganesha axis.  ONE change: the marker file is created inside the exported
# "shared" subdirectory instead of the NFSv4 pseudo root.
#
# Why: the two implementations genuinely differ here, and it is a finding, not
# a harness defect.  Call 5 of the AB corpus is
#
#     openat(<pseudoroot>, ".remote-kcov-ab", O_RDWR|O_CREAT|O_TRUNC)
#
# knfsd answers 0.  Ganesha 4.3 answers EROFS (30): it refuses writes that
# create an entry directly in the NFSv4 pseudo filesystem root.  Measured, with
# the request reaching the kernel either way -- the failing openat still
# produced 12393 coverage records, and the trial collected a 431 KiB coverage
# archive -- so the traffic is real and only the errno differs.
#
# The right response is to make the workload portable, not to relax the errno
# contract: loosening it would turn a gate into a rubber stamp, and the whole
# point of the harness is that a call that silently stops working is loud.
# The lane fixture already creates "shared" inside the export, so prefixing the
# three path literals is enough, and it changes NOTHING that the contract
# depends on:
#
#   * the call count is unchanged, so call indices are unchanged and
#     CONFLICT_CALL = 14 still refers to the same flock() conflict;
#   * the read lengths are unchanged (they count the payload, not the name);
#   * the peer client sees the same subtree, because client0 and client1 are
#     two mounts of the SAME export.
#
# This divergence is recorded in report/patch-forward-compat.md as an
# inter-implementation behavioural difference.

r0 = open$dir(&(0x7f0000000000)='nfs-lane/client0\x00', 0x10000, 0x0)
getdents64(r0, &(0x7f0000000100), 0x1000)
close(r0)
r1 = open$dir(&(0x7f0000001000)='nfs-lane/client0\x00', 0x10000, 0x0)
r2 = open$dir(&(0x7f0000001100)='nfs-lane/client1\x00', 0x10000, 0x0)
r3 = openat(r1, &(0x7f0000002000)='shared/.remote-kcov-ab\x00', 0x242, 0x180)
write(r3, &(0x7f0000002100)='remote KCOV A/B deterministic workload\x0a', 0x27)
fsync(r3)
statx(r1, &(0x7f0000002000)='shared/.remote-kcov-ab\x00', 0x2000, 0x7ff, &(0x7f0000003000))
lseek(r3, 0x0, 0x0)
read(r3, &(0x7f0000004000)=""/39, 0x27)
flock(r3, 0x6)
r4 = openat(r2, &(0x7f0000005000)='shared/.remote-kcov-ab\x00', 0x2, 0x0)
statx(r2, &(0x7f0000005000)='shared/.remote-kcov-ab\x00', 0x2000, 0x7ff, &(0x7f0000006000))
flock(r4, 0x6)
renameat2(r2, &(0x7f0000005000)='shared/.remote-kcov-ab\x00', r2, &(0x7f0000005100)='shared/.remote-kcov-ab-renamed\x00', 0x0)
getdents64(r2, &(0x7f0000007000), 0x1000)
lseek(r3, 0x0, 0x0)
read(r3, &(0x7f0000008000)=""/39, 0x27)
flock(r3, 0x8)
flock(r4, 0x6)
write(r4, &(0x7f0000009000)='peer update\x0a', 0xc)
fsync(r4)
flock(r4, 0x8)
statx(r2, &(0x7f0000005100)='shared/.remote-kcov-ab-renamed\x00', 0x2000, 0x7ff, &(0x7f000000a000))
unlinkat(r2, &(0x7f0000005100)='shared/.remote-kcov-ab-renamed\x00', 0x0)
lseek(r3, 0x0, 0x0)
read(r3, &(0x7f000000b000)=""/39, 0x27)
close(r4)
close(r3)
lseek(r2, 0x0, 0x0)
getdents64(r2, &(0x7f000000c000), 0x1000)
close(r2)
close(r1)

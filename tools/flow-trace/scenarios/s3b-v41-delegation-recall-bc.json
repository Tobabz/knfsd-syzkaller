{
  "scenario": "S3b v4.1 delegation recall and return over the session backchannel",
  "nfs_version": "4.1",
  "stimulus": "bundle/corpus/nfs-normal/delegation-recall-v41-tcp.prog",
  "transitions": [
    {
      "id": "S3b-01",
      "flow": "NF-D3",
      "specific": true,
      "text": "nfsd thread handling the conflicting OPEN calls nfsd_break_deleg_cb in the same task",
      "submit": {
        "event": "svc_process",
        "comm": "^nfsd$",
        "detail": "service=nfsd "
      },
      "execute": {
        "event": "break_deleg",
        "comm": "^nfsd$"
      },
      "link": "order",
      "same_task_ok": true,
      "within_us": 5000
    },
    {
      "id": "S3b-02",
      "flow": "NF-D3",
      "specific": true,
      "text": "nfsd thread queues nfsd4_run_cb_work (CB_RECALL); a kworker runs it",
      "submit": {
        "event": "workqueue_queue_work",
        "comm": "^nfsd$",
        "detail": "work struct=(?P<k>\\w+) function=nfsd4_run_cb_work workqueue=nfsd4_callbacks",
        "after": {
          "rule": "S3b-01",
          "side": "execute",
          "window_us": 2000,
          "same_task": true
        }
      },
      "execute": {
        "event": "workqueue_execute_start",
        "comm": "^kworker/",
        "detail": "work struct (?P<k>\\w+): function nfsd4_run_cb_work"
      },
      "link": "key"
    },
    {
      "id": "S3b-03",
      "flow": "NF-D1",
      "specific": true,
      "text": "callback kworker queues the CB rpc_task on rpciod; rpciod runs rpc_async_schedule",
      "submit": {
        "event": "workqueue_queue_work",
        "comm": "^kworker/",
        "detail": "work struct=(?P<k>\\w+) function=rpc_async_schedule workqueue=rpciod",
        "after": {
          "rule": "S3b-02",
          "side": "execute",
          "window_us": 2000,
          "same_task": true
        }
      },
      "execute": {
        "event": "workqueue_execute_start",
        "comm": "^kworker/",
        "detail": "work struct (?P<k>\\w+): function rpc_async_schedule"
      },
      "link": "key",
      "same_task_ok": true
    },
    {
      "id": "S3b-04",
      "flow": "NF-D2",
      "specific": true,
      "text": "server CB request (xid) on the fore-channel socket reaches the client callback svc thread with the same xid",
      "submit": {
        "event": "xprt_transmit",
        "comm": "^kworker/",
        "detail": "xid=(?P<k>0x[0-9a-f]+)",
        "after": {
          "rule": "S3b-03",
          "side": "execute",
          "window_us": 2000,
          "same_task": true
        }
      },
      "execute": {
        "event": "svc_process",
        "comm": "^NFSv4 callback$",
        "detail": "xid=(?P<k>0x[0-9a-f]+) service=NFSv4 callback"
      },
      "link": "key"
    },
    {
      "id": "S3b-05",
      "flow": "NF-D2",
      "specific": true,
      "text": "client socket data_ready (softirq) queues xs_stream_data_receive_workfn on xprtiod; a kworker runs it",
      "submit": {
        "event": "workqueue_queue_work",
        "ctx": "softirq",
        "detail": "work struct=(?P<k>\\w+) function=xs_stream_data_receive_workfn workqueue=xprtiod",
        "after": {
          "rule": "S3b-04",
          "side": "submit",
          "window_us": 2000
        }
      },
      "execute": {
        "event": "workqueue_execute_start",
        "comm": "^kworker/",
        "detail": "work struct (?P<k>\\w+): function xs_stream_data_receive_workfn"
      },
      "link": "key"
    },
    {
      "id": "S3b-06",
      "flow": "NF-D2",
      "specific": true,
      "text": "xprtiod receive worker enqueues the backchannel request; the callback svc thread runs svc_process_bc",
      "submit": {
        "event": "bc_enqueue",
        "comm": "^kworker/",
        "after": {
          "rule": "S3b-05",
          "side": "execute",
          "window_us": 2000,
          "same_task": true
        }
      },
      "execute": {
        "event": "bc_process",
        "comm": "^NFSv4 callback$"
      },
      "link": "order"
    },
    {
      "id": "S3b-07",
      "flow": "NF-F3",
      "specific": true,
      "text": "client callback svc thread handles CB_RECALL; the state manager kthread starts",
      "submit": {
        "event": "cb_recall_client",
        "comm": "^NFSv4 callback$"
      },
      "execute": {
        "event": "state_manager",
        "comm": "-manag"
      },
      "link": "order"
    },
    {
      "id": "S3b-08",
      "flow": "NF-F6",
      "specific": true,
      "text": "state manager queues the DELEGRETURN rpc_task on rpciod; rpciod runs rpc_async_schedule",
      "submit": {
        "event": "workqueue_queue_work",
        "comm": "-manag",
        "detail": "work struct=(?P<k>\\w+) function=rpc_async_schedule workqueue=rpciod",
        "after": {
          "rule": "S3b-07",
          "side": "execute",
          "window_us": 2000,
          "same_task": true
        }
      },
      "execute": {
        "event": "workqueue_execute_start",
        "comm": "^kworker/",
        "detail": "work struct (?P<k>\\w+): function rpc_async_schedule"
      },
      "link": "key"
    },
    {
      "id": "S3b-09",
      "flow": "NF-F6",
      "specific": true,
      "text": "rpciod sends DELEGRETURN; an nfsd thread runs svc_process with the same xid",
      "submit": {
        "event": "xprt_transmit",
        "comm": "^kworker/",
        "detail": "xid=(?P<k>0x[0-9a-f]+)",
        "after": {
          "rule": "S3b-08",
          "side": "execute",
          "window_us": 2000,
          "same_task": true
        }
      },
      "execute": {
        "event": "svc_process",
        "comm": "^nfsd$",
        "detail": "xid=(?P<k>0x[0-9a-f]+) service=nfsd "
      },
      "link": "key"
    },
    {
      "id": "S3b-10",
      "flow": "NF-D1",
      "specific": true,
      "text": "callback svc thread sends the CB reply; an nfsd thread wakes the waiting CB rpc_task",
      "submit": {
        "event": "xprt_transmit",
        "comm": "^NFSv4 callback$",
        "after": {
          "rule": "S3b-04",
          "side": "execute",
          "window_us": 2000,
          "same_task": true
        }
      },
      "execute": {
        "event": "rpc_task_wakeup",
        "comm": "^nfsd$",
        "detail": "queue=xprt_pending"
      },
      "link": "order"
    },
    {
      "id": "S3b-11",
      "flow": "NF-D1",
      "specific": true,
      "text": "nfsd thread queues rpc_async_schedule; rpciod finishes the CB rpc_task (nfsd4_cb_done)",
      "submit": {
        "event": "workqueue_queue_work",
        "comm": "^nfsd$",
        "detail": "work struct=(?P<k>\\w+) function=rpc_async_schedule workqueue=rpciod",
        "after": {
          "rule": "S3b-10",
          "side": "execute",
          "window_us": 2000,
          "same_task": true
        }
      },
      "execute": {
        "event": "workqueue_execute_start",
        "comm": "^kworker/",
        "detail": "work struct (?P<k>\\w+): function rpc_async_schedule"
      },
      "link": "key"
    }
  ]
}
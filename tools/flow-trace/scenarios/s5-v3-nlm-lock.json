{
  "scenario": "S5 v3 NLM lock conflict: blocked LOCK, lm_notify, GRANTED_MSG callback, NSM monitor",
  "nfs_version": "3",
  "stimulus": "tools/flow-trace/stimulus/s5-nlm-lock.sh (loopback mount in the lane 0 server namespace, rpc.statd started by the script)",
  "transitions": [
    {"id": "S5-01", "flow": "NF-G2", "specific": true,
     "text": "rpc.statd answers SM_MON; its reply makes the socket softirq queue the xprtiod receive worker",
     "submit": {"event": "workqueue_queue_work", "ctx": "softirq", "comm": "^rpc.statd$",
                "detail": "work struct=(?P<k>\\w+) function=xs_stream_data_receive_workfn workqueue=xprtiod"},
     "execute": {"event": "workqueue_execute_start", "comm": "^kworker/",
                 "detail": "work struct (?P<k>\\w+): function xs_stream_data_receive_workfn"},
     "link": "key"},
    {"id": "S5-02", "flow": "NF-G2", "specific": true,
     "text": "client lock task sends NLM LOCK; the lockd thread runs svc_process with the same xid",
     "submit": {"event": "xprt_transmit", "comm": "^flock$", "detail": "xid=(?P<k>0x[0-9a-f]+)"},
     "execute": {"event": "svc_process", "comm": "^lockd$",
                 "detail": "xid=(?P<k>0x[0-9a-f]+) service=lockd vers=4 proc=LOCK"},
     "link": "key"},
    {"id": "S5-03", "flow": "NF-G2", "specific": true,
     "text": "local lock holder releases the lock; its task calls nlmsvc_notify_blocked (lm_notify); the lockd thread runs nlmsvc_retry_blocked",
     "submit": {"event": "nlm_srv_notify", "comm": "^plock$"},
     "execute": {"event": "lockd_retry", "comm": "^lockd$"},
     "link": "order", "within_us": 5000},
    {"id": "S5-04", "flow": "NF-G2", "specific": true,
     "text": "lockd thread queues the GRANTED_MSG rpc_task on rpciod; rpciod runs rpc_async_schedule",
     "submit": {"event": "workqueue_queue_work", "comm": "^lockd$",
                "detail": "work struct=(?P<k>\\w+) function=rpc_async_schedule workqueue=rpciod",
                "after": {"rule": "S5-03", "side": "execute", "window_us": 5000, "same_task": true}},
     "execute": {"event": "workqueue_execute_start", "comm": "^kworker/",
                 "detail": "work struct (?P<k>\\w+): function rpc_async_schedule"},
     "link": "key"},
    {"id": "S5-05", "flow": "NF-G2", "specific": true,
     "text": "rpciod sends GRANTED_MSG; the lockd thread (client side of NLM) runs svc_process with the same xid",
     "submit": {"event": "xprt_transmit", "comm": "^kworker/", "detail": "xid=(?P<k>0x[0-9a-f]+)",
                "after": {"rule": "S5-04", "side": "execute", "window_us": 5000, "same_task": true}},
     "execute": {"event": "svc_process", "comm": "^lockd$",
                 "detail": "xid=(?P<k>0x[0-9a-f]+) service=lockd vers=4 proc=GRANTED_MSG"},
     "link": "key"},
    {"id": "S5-06", "flow": "NF-G2", "specific": true,
     "text": "the lockd thread runs nlmclnt_grant; the blocked lock task leaves nlmclnt_lock with LCK_GRANTED",
     "submit": {"event": "nlmclnt_grant", "comm": "^lockd$"},
     "execute": {"event": "nlmclnt_lock", "comm": "^flock$", "detail": "status=LCK_GRANTED"},
     "link": "order", "within_us": 5000},
    {"id": "S5-07", "flow": "NF-G2", "specific": true,
     "text": "rpciod sends GRANTED_RES; the lockd thread runs svc_process with the same xid",
     "submit": {"event": "xprt_transmit", "comm": "^kworker/", "detail": "xid=(?P<k>0x[0-9a-f]+)",
                "after": {"rule": "S5-05", "side": "execute", "window_us": 5000}},
     "execute": {"event": "svc_process", "comm": "^lockd$",
                 "detail": "xid=(?P<k>0x[0-9a-f]+) service=lockd vers=4 proc=GRANTED_RES"},
     "link": "key"}
  ]
}
